@article{
  title = {[{{PDF}}] {{Crystalline Order}} in {{Two Dimensions}} by {{N}}. {{David Mermin}} · 10.1103/Physrev.176.250 · {{OA}}.Mg},
  author = {Mermin, N. David},
  url = {https://oa.mg/work/10.1103/PhysRev.176.250},
  urldate = {2026-02-17},
  abstract = {If \$N\$ classical particles in two dimensions interacting through a pair potential \$\textbackslash ensuremath\{\textbackslash Phi\}(\textbackslash stackrel\{\textbackslash ensuremath\{\textbackslash rightarrow\}\}\{\textbackslash mathrm\{r\}\})\$ are in equilibrium in a parallelogram box, it is proved that every \$\textbackslash stackrel\{\textbackslash ensuremath\{\textbackslash rightarrow\}\}\{\textbackslash mathrm\{k\}\}\textbackslash ensuremath\{\textbackslash ne\}0\$ Fourier component of the density must vanish in the thermodynamic limit, provided that \$\textbackslash ensuremath\{\textbackslash Phi\}(\textbackslash stackrel\{\textbackslash ensuremath\{\textbackslash rightarrow\}\}\{\textbackslash mathrm\{r\}\})\textbackslash ensuremath\{-\}\textbackslash ensuremath\{\textbackslash lambda\}\{r\}\textasciicircum\{2\}|\{\textbackslash ensuremath\{\textbackslash nabla\}\}\textasciicircum\{2\}\textbackslash ensuremath\{\textbackslash Phi\}(\textbackslash stackrel\{\textbackslash ensuremath\{\textbackslash rightarrow\}\}\{\textbackslash mathrm\{r\}\})|\$ is integrable at \$r=\textbackslash ensuremath\{\textbackslash infty\}\$ and positive and nonintegrable at \$r=0\$, both for \$\textbackslash ensuremath\{\textbackslash lambda\}=0\$ and for some positive \$\textbackslash ensuremath\{\textbackslash lambda\}\$. This result excludes conventional crystalline long-range order in two dimensions for power-law potentials of the Lennard-Jones type, but is inconclusive for hard-core potentials. The corresponding analysis for the quantum case is outlined. Similar results hold in one dimension.},
