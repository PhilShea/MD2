  keywords = {Condensed Matter - Soft Condensed Matter,Physics - Chemical Physics},
  file = {/home/phil/snap/zotero-snap/common/Zotero/storage/2D28Y7GW/Kondrin et al. - 2025 - Extended defects in hard disk system and melting criteria.pdf;/home/phil/snap/zotero-snap/common/Zotero/storage/IEH7D6AM/2512.html}
