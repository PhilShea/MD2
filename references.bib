@article{
  title = {Direct Observation of Melting in a Two-Dimensional Driven Granular System},
  author = {Sun, Xiaoyan and Li, Yang and Ma, Yuqiang and Zhang, Zexin},
  date = {2016-04-07},
  journaltitle = {Scientific Reports},
  shortjournal = {Sci Rep},
  volume = {6},
  number = {1},
  pages = {24056},
  issn = {2045-2322},
  doi = {10.1038/srep24056},
  url = {https://www.nature.com/articles/srep24056},
  urldate = {2024-10-18},
  abstract = {Abstract             Melting is considered to be one of the most fundamental problems in physical science. Generally, dimensionality plays an important role in melting. In three-dimension, it’s well known that a crystal melts directly into a liquid via a first-order transition. In two-dimension (2D), however, the melting process has been widely debated whether it is a first-order transition or a two-step transition with an intermediate hexatic phase. Experimentally 2D melting has been intensively studied in equilibrium systems such as molecular and colloidal crystals, but rarely been explored in non-equilibrium system such as granular materials. In this paper, we experimentally studied the 2D melting in a driven granular model system at single particle level using video recording and particle tracking techniques. Measurements of orientational/translational correlation functions show evidences that the melting is a two-step transition. A novel concept of orientational/translational susceptibilities enable us to clearly resolve the intermediate hexatic phase. Our results are in excellent agreement with the two-step melting scenario predicted by KTHNY theory and demonstrate that the KTHNY melting scenario can be extended to non-equilibrium systems.},
  langid = {english},
  file = {/home/phil/snap/zotero-snap/common/Zotero/storage/ESVZ4REE/Sun et al. - 2016 - Direct observation of melting in a two-dimensional driven granular system.pdf}
}

