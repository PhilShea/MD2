  journaltitle = {Physical Review B},
  shortjournal = {Phys. Rev. B},
  volume = {24},
  number = {3},
  pages = {1530--1535},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevB.24.1530},
  url = {https://link.aps.org/doi/10.1103/PhysRevB.24.1530},
  urldate = {2026-01-29},
  abstract = {We consider the change in volume on melting for systems interacting with a repulsive 𝑟−𝑛 potential. Using the scaling property for inverse-power-law systems and the Clausius-Clapeyron equation, we show that the change in volume on melting must go to zero as 𝑛 →𝐷, the dimensionality of the system. For 𝑛 {$<$}\textasciitilde 𝐷 finite excess thermodynamic properties can be defined by using a uniform neutralizing background. We produce a system with a uniform background as the limit of a classical two-component system and again find no change in volume on melting. Possible implications of these results for simulation studies of two-dimensional melting are discussed.},
  file = {/home/phil/snap/zotero-snap/common/Zotero/storage/VSHPQZBR/weeks1981.pdf;/home/phil/snap/zotero-snap/common/Zotero/storage/V936XVK6/PhysRevB.24.html}
}

@article{
  title = {Melting and the Vector {{Coulomb}} Gas in Two Dimensions},
  author = {Young, A. P.},
  date = {1979-02-15},
  journaltitle = {Physical Review B},
  shortjournal = {Phys. Rev. B},
  volume = {19},
  number = {4},
  pages = {1855--1866},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevB.19.1855},
  url = {https://link.aps.org/doi/10.1103/PhysRevB.19.1855},
  urldate = {2025-08-09},
  abstract = {The dislocation theory of two-dimensional melting due to Kosterlitz and Thouless is investigated for the triangular lattice, paying special attention to angular forces between dislocation pairs, which are equal in magnitude to the radial forces. Generalizing the dislocation Hamiltonian to an arbitrary vector Coulomb gas with different radial and angular interactions we find 𝐾𝑖𝑅⁡(𝑇) −𝐾𝑖𝑅⁡(𝑇−𝑐)∼𝑡¯𝜈, where 𝐾𝑖𝑅 is a renormalized coupling which includes the screening effect of bound dislocation pairs, the superscript 𝑖 signifies either a radial, 𝑟, or angular, 𝜃 part and 𝑡 is the reduced temperature, 𝑡 =(𝑇𝑐−𝑇)𝑇𝑐. The exponent ¯𝜈 varies as the ratio 𝐾𝜃𝑅⁡(𝑇−𝑐)𝐾𝑟𝑅⁡(𝑇−𝑐) is changed and is equal to 0.3696... for the physical value of 𝐾𝜃 =𝐾𝑟. In this case the shear and bulk elastic constants have the same temperature dependence as the 𝐾𝑖𝑅. We find that 𝐾𝑟𝑅 has finite universal value at 𝑇𝑐 and 𝐾𝑖𝑅 =0 for 𝑇 {$>$}𝑇𝑐, corresponding to metallic behavior of the vector Coulomb gas.},
  file = {/home/phil/snap/zotero-snap/common/Zotero/storage/KXXG6NH2/PhysRevB.19.html}
}

