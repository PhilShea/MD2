  url = {http://ieeexplore.ieee.org/document/6111319/},
  urldate = {2024-09-18},
  abstract = {Although equalizers promise to improve the signalto-noise energy ratio, zero forcing equalizers are derived classically in a deterministic setting minimizing intersymbol interference, while minimum mean square error (MMSE) equalizer solutions are derived in a stochastic context based on quadratic Wiener cost functions. In this paper, we show that it is possible---and in our opinion even simpler---to derive the classical results in a purely deterministic setup, interpreting both equalizer types as least squares solutions. This, in turn, allows the introduction of a simple linear reference model for equalizers, which supports the exact derivation of a family of iterative and recursive algorithms with robust behavior. The framework applies equally to multiuser transmissions and multiple-input multiple-output (MIMO) channels. A major contribution is that due to the reference approach the adaptive equalizer problem can equivalently be treated as an adaptive system identification problem for which very precise statements are possible with respect to convergence, robustness and -stability. Robust adaptive equalizers are much more desirable as they guarantee a much stronger form of stability than conventional in the mean square sense convergence. Even some blind channel estimation schemes can now be included in the form of recursive algorithms and treated under this general framework. Index Terms---Blind channel estimation, convergence, iterative adaptive filters, least mean squares, linear equalizers, -stability, minimum mean square error (MMSE), recursive adaptive filters, reference modeling, robustness, zero forcing (ZF).},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
  file = {C:\Users\phils\Zotero\storage\8KP7HC3W\Rupp - 2012 - Robust Design of Adaptive Equalizers.pdf}
}

