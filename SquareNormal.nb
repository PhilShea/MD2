Cell[TextData[{
 "Wikipidia\[CloseCurlyQuote]s article on ",
 ButtonBox["Circular uniform distribution",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Circular_uniform_distribution"], None},
  
  ButtonNote->"https://en.wikipedia.org/wiki/Circular_uniform_distribution"],
 " indicates that the mean of samples from a circle will be ",
 ButtonBox["Rayleigh distributed",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Rayleigh_distribution"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Rayleigh_distribution"],
 " with scale parameter \[Sigma] = ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{
     RowBox[{"1", "/", "2"}], "N"}]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "3e9c20cc-9a04-42a8-9e78-a0fb491b9bda"],
 ". In the above, g6[7] would be with ",
 StyleBox["N ",
  FontSlant->"Italic"],
 "= 7. The variance of a Rayleigh distribution is (",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"4", "-", "\[Pi]"}], "2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "b18dc2d8-ef9f-4fd5-a936-7bbddafede84"],
 ")",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", "2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "bb1008d8-21e8-4ee2-ba57-c4e50218e035"],
 ", and the mean is \[Sigma]",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"\[Pi]", "/", "2"}]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "65988875-d09c-4f6f-a1a0-71a5c18241d7"]
}], "Text",
 CellChangeTimes->{{3.9905386240942907`*^9, 3.990538802035448*^9}, {
  3.9905389000819263`*^9, 3.9905390603157387`*^9}, {3.9905391800515547`*^9, 
  3.9905391981085377`*^9}, {3.990539241332122*^9, 
  3.990539243636221*^9}},ExpressionUUID->"14e5e5bb-4f6f-4566-9865-\
c3949ce942fd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      SqrtBox[
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "7"}], ")"}]}]], ")"}], 
     SqrtBox[
      RowBox[{"\[Pi]", "/", "2"}]]}], ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "7"}], ")"}]}], ")"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", "-", "\[Pi]"}], ")"}], "/", "4"}]}]}], "}"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.990539066459136*^9, 3.990539129082703*^9}, {
  3.9905392075323753`*^9, 3.990539221715804*^9}, {3.9905392556201477`*^9, 
