9131aa04e742"],

Cell["\<\
It concerned me that the five and seven summed so close to zero. Here is a \
symbolic analysis.\
\>", "Text",
 CellChangeTimes->{{3.980840490283877*^9, 3.980840507291778*^9}, {
  3.981468910849304*^9, 
  3.981468920673394*^9}},ExpressionUUID->"d4aed539-c418-4863-bbcf-\
cfce4bdc6bcb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{"6", "I", " ", 
     RowBox[{"(", 
      RowBox[{"2", "j", " ", 
       RowBox[{"\[Pi]", "/", "7"}]}], ")"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.980664696145109*^9, 3.980664863378089*^9}, {
  3.980664934890328*^9, 3.9806649528972282`*^9}, {3.980665059059099*^9, 
  3.980665063537981*^9}, {3.980665105475554*^9, 3.980665109354948*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"441d04a7-663d-4ed9-a71b-db29715b8e2f"],

Cell[BoxData[
 RowBox[{"1", "+", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "7"]}]], "+", 
  SuperscriptBox["\[ExponentialE]", 
   FractionBox[
    RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "7"]], "+", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"4", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "7"]}]], "+", 
  SuperscriptBox["\[ExponentialE]", 
   FractionBox[
    RowBox[{"4", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "7"]], "+", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"6", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "7"]}]], "+", 
  SuperscriptBox["\[ExponentialE]", 
   FractionBox[
    RowBox[{"6", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "7"]]}]], "Output",
 CellChangeTimes->{{3.980664865210766*^9, 3.980664893980832*^9}, {
   3.980664940340461*^9, 3.980664954093573*^9}, 3.980665064779828*^9, 
   3.9806651105819607`*^9, 3.981444001056075*^9, 3.981625704243664*^9, 
   3.9900901598647423`*^9, 3.990261031568371*^9, 3.9905132859367447`*^9, 
   3.9906275925109*^9, 3.990628773776806*^9, 3.990692317898898*^9, 
   3.9919935640410213`*^9},
 CellLabel->"Out[60]=",ExpressionUUID->"12408738-832d-4df8-a808-4656eb78f2f7"]
}, Open  ]],

