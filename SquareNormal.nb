Cell[TextData[{
 "The solid does not decay, so we will just generate a number of samples that \
are all the same. We will set the number of samples of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "6"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "d859a93f-a0f4-40e6-ba46-a0756e7669fc"],
 " (",
 StyleBox["ns", "Input"],
 ") and the total ",
 StyleBox["range", "Input"],
 ", which we will use for all three curves."
}], "Text",
 CellChangeTimes->{{3.992097769280019*^9, 
  3.992097933944991*^9}},ExpressionUUID->"d897b037-0a9a-4159-b30f-\
354517d9d848"],

