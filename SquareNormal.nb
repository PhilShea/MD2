Cell[BoxData[
 RowBox[{
  RowBox[{"inCircle", "[", 
   RowBox[{"index1_", ",", "index2_", ",", "index3_", ",", "index4_"}], "]"}],
   ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x1", "=", 
     RowBox[{"x", "[", "index1", "]"}]}], ";", " ", 
    RowBox[{"x2", "=", 
     RowBox[{"x", "[", "index2", "]"}]}], ";", " ", 
    RowBox[{"x3", "=", 
     RowBox[{"x", "[", "index3", "]"}]}], ";", " ", 
    RowBox[{"x4", "=", 
     RowBox[{"x", "[", "index4", "]"}]}], ";", 
    RowBox[{"y1", "=", 
     RowBox[{"y", "[", "index1", "]"}]}], ";", " ", 
    RowBox[{"y2", "=", 
     RowBox[{"y", "[", "index2", "]"}]}], ";", " ", 
    RowBox[{"y3", "=", 
     RowBox[{"y", "[", "index3", "]"}]}], ";", " ", 
    RowBox[{"y4", "=", 
     RowBox[{"y", "[", "index4", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"testMatrix", "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          SuperscriptBox["x4", "2"], "+", 
          SuperscriptBox["y4", "2"]}], "x4", "y4", "1"},
        {
         RowBox[{
          SuperscriptBox["x1", "2"], "+", 
          SuperscriptBox["y1", "2"]}], "x1", "y1", "1"},
        {
         RowBox[{
          SuperscriptBox["x2", "2"], "+", 
          SuperscriptBox["y2", "2"]}], "x2", "y2", "1"},
        {
         RowBox[{
          SuperscriptBox["x3", "2"], "+", 
          SuperscriptBox["y3", "2"]}], "x3", "y3", "1"}
       }], ")"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"sign", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"clockwise", "[", 
         RowBox[{"index1", ",", "index2", ",", "index3"}], "]"}], "\[Equal]", 
        "True"}], ",", "1", ",", 
       RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"testResult", "=", 
     RowBox[{"sign", " ", 
      RowBox[{"Det", "[", "testMatrix", "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"testResult", ">", "0"}]}], "\[IndentingNewLine]", 
   ")"}]}]], "Input",
 CellChangeTimes->{{3.9912142637442923`*^9, 3.991214347127694*^9}, {
  3.991214404976748*^9, 3.991214786847912*^9}, {3.991214832246441*^9, 
