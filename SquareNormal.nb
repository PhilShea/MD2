Cell["\<\
Here is a plot of the constellation of 6 points around a center point.\
\>", "Text",
 CellChangeTimes->{{3.990119941916768*^9, 
  3.990120002725444*^9}},ExpressionUUID->"f6c003ce-ab4f-4d62-851d-\
e746dcec4f1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", "#", "]"}], ",", 
       RowBox[{"Im", "[", "#", "]"}]}], "}"}], "]"}], "]"}], "&"}], "[", 
  RowBox[{"Exp", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"I", 
      RowBox[{"(", 
       RowBox[{"\[Theta]1", "+", 
        RowBox[{"2", "\[Pi]", " ", 
         RowBox[{"k", "/", "6"}]}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", 
       RowBox[{"6", "-", "1"}]}], "}"}]}], "]"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.99009415275905*^9, 3.9900941679192*^9}, {
   3.990094237544531*^9, 3.9900942387435513`*^9}, {3.990118993798019*^9, 
