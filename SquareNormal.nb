Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"True", " ", "if", " ", "Clockwise"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"clockwise", "[", 
    RowBox[{"index1_", ",", "index2_", ",", "index3_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x1", "=", 
      RowBox[{"x", "[", "index1", "]"}]}], ";", " ", 
     RowBox[{"x2", "=", 
      RowBox[{"x", "[", "index2", "]"}]}], ";", " ", 
     RowBox[{"x3", "=", 
      RowBox[{"x", "[", "index3", "]"}]}], ";", 
     RowBox[{"y1", "=", 
      RowBox[{"y", "[", "index1", "]"}]}], ";", " ", 
     RowBox[{"y2", "=", 
      RowBox[{"y", "[", "index2", "]"}]}], ";", " ", 
     RowBox[{"y3", "=", 
      RowBox[{"y", "[", "index3", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ux", "=", 
      RowBox[{"x2", "-", "x1"}]}], ";", " ", 
     RowBox[{"uy", "=", 
      RowBox[{"y2", "-", "y1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vx", "=", 
      RowBox[{"x3", "-", "x2"}]}], ";", " ", 
     RowBox[{"vy", "=", 
      RowBox[{"y3", "-", "y2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"crossProduct", "=", 
      RowBox[{
       RowBox[{"ux", " ", "vy"}], "-", 
       RowBox[{"uy", " ", "vx"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"crossProduct", "<", "0"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.991211383870631*^9, 3.991211555134056*^9}, {
  3.9912159999043427`*^9, 3.991216009879669*^9}, {3.9912161215772343`*^9, 
