Cell[CellGroupData[{

Cell["Trajectories", "Subchapter",
 CellChangeTimes->{{3.981629185419754*^9, 
  3.981629188227757*^9}},ExpressionUUID->"bd499d8d-c6d8-44ff-84fa-\
e3dec3a22e8f"],

Cell["\<\
Here are three different trajectories, one constant, one power law, and one \
exponential. The number of samples we have been working with are 70, with \
each ring getting a different number of particles.\
\>", "Text",
 CellChangeTimes->{{3.981559616377801*^9, 3.981559652529521*^9}, {
  3.991996305173061*^9, 
  3.991996359893675*^9}},ExpressionUUID->"f10fc643-02dd-4b71-8623-\
1284615de95d"],

Cell[TextData[{
 "the swath at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "i"], "=", 
    RowBox[{"i", " ", 
     StyleBox[
      RowBox[{
       StyleBox["\[Delta]",
        FontSlant->"Plain"], 
       StyleBox["r",
        FontSlant->"Italic"]}]]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "5b1ff00e-99ea-42d7-a9c5-c75f32a43037"],
 " takes in all particles found between (",
 StyleBox["i",
  FontSlant->"Italic"],
 " -1)\[Delta]",
 StyleBox["r",
  FontSlant->"Italic"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]],ExpressionUUID->
  "d94e1ad7-0bf7-488b-a86f-fd54e4a22a2a"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.991996408694593*^9, 3.991996449110564*^9}, {
  3.991996601967883*^9, 3.991996604543998*^9}, {3.992010303043589*^9, 
  3.992010339603668*^9}, {3.992011427764524*^9, 
  3.992011428805586*^9}},ExpressionUUID->"d1325cd8-a911-4ae6-b930-\
f4eac23fbcf6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "swath", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "[", "\[Rho]_", "]"}], ":=", 
   SqrtBox[
    RowBox[{"2", "/", 
     RowBox[{"(", 
      RowBox[{"\[Rho]", 
       SqrtBox["3"]}], ")"}]}]]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "This", " ", "is", " ", "the", " ", "crystal", " ", "spacing", " ", "at", 
    " ", "density", " ", "\[Rho]"}], " ", "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"swath", "[", 
   RowBox[{"r_", ",", "\[Delta]r_", ",", 
    RowBox[{"\[Rho]_:", 
     RowBox[{"1", "/", "\[Pi]"}]}]}], "]"}], "=", " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "swath", " ", "width", " ", "at", " ", "crystal", " ", "spacing", " ", 
    "radius"}], " ", "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{"\[Rho]", " ", "\[Pi]", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"r", " ", 
         RowBox[{"a", "[", "\[Rho]", "]"}]}], ")"}], "2"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r", " ", 
          RowBox[{"a", "[", "\[Rho]", "]"}]}], "-", "\[Delta]r"}], ")"}], 
       "2"]}], ",", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"r", ">", "0"}], ",", 
        RowBox[{"\[Delta]r", ">", "0"}], ",", 
        RowBox[{"\[Rho]", ">", "0"}]}], "}"}]}]}], "]"}]}]}]}], "Input",
 CellChangeTimes->{
  3.9919963795988417`*^9, {3.991996474582741*^9, 3.99199656494602*^9}, {
   3.99199661849605*^9, 3.9919966785927467`*^9}, {3.991996725706058*^9, 
   3.991996808833806*^9}, {3.991996865706826*^9, 3.991996897586383*^9}, {
   3.992006677140366*^9, 3.9920067263980637`*^9}, {3.992006893815193*^9, 
   3.992006905431137*^9}, {3.992007073073332*^9, 3.9920071203131447`*^9}, {
   3.992007281851409*^9, 3.992007358931469*^9}, {3.992007555933505*^9, 
   3.992007611013893*^9}, {3.9920076533033533`*^9, 3.992007695094906*^9}, 
   3.992007750400298*^9, {3.9920077913141747`*^9, 3.99200779370398*^9}, {
   3.992009546262774*^9, 3.992009551190092*^9}, {3.992010406100814*^9, 
   3.99201044759709*^9}, 3.992010487869288*^9, {3.992010567933669*^9, 
   3.9920106188868856`*^9}},ExpressionUUID->"a2ee00b2-ab1c-4342-82b8-\
0ba246d8ba7d"],

Cell[BoxData[
 RowBox[{"\[Pi]", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["\[Delta]r", "2"]}], "+", 
    FractionBox[
     RowBox[{"2", " ", 
      SqrtBox["2"], " ", "r", " ", "\[Delta]r"}], 
     RowBox[{
      SuperscriptBox["3", 
       RowBox[{"1", "/", "4"}]], " ", 
      SqrtBox["\[Rho]"]}]]}], ")"}], " ", "\[Rho]"}]], "Output",
 CellChangeTimes->{
  3.992006906326353*^9, {3.992007084426661*^9, 3.9920071232669764`*^9}, 
   3.9920076153259478`*^9, {3.9920076702586107`*^9, 3.992007697064023*^9}, 
   3.992007752320792*^9, 3.992007795287408*^9, 3.9920095539853697`*^9, 
   3.992010179258265*^9},
 CellLabel->
  "Out[213]=",ExpressionUUID->"8fd832c4-885e-4248-9392-38a71b24493f"]
}, Open  ]],

