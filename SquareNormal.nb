Cell["No way to simplify it though.", "Text",
 CellChangeTimes->{{3.98144432660034*^9, 
  3.9814443335364523`*^9}},ExpressionUUID->"fbede3c8-ae72-4656-9c32-\
98150a546218"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"p", ",", " ", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"\[Sigma]", ">", "0"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.980506683952264*^9, 3.9805066941118717`*^9}, {
  3.980507401245482*^9, 3.98050747330223*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"e1653f91-9218-4c44-a391-c1c715959b16"],

Cell[BoxData[
 RowBox[{"TransformedDistribution", "[", 
  RowBox[{
   SuperscriptBox["\[FormalX]", "2"], ",", 
   RowBox[{"\[FormalX]", "\[Distributed]", 
    RowBox[{"NormalDistribution", "[", 
     RowBox[{"0", ",", "\[Sigma]"}], "]"}]}]}], "]"}]], "Output",
 CellChangeTimes->{3.980507415334958*^9, 3.980507475112616*^9, 
  3.9806041580838842`*^9, 3.981443998735919*^9, 3.98162570166437*^9, 
  3.9900901574975147`*^9, 3.990261029001268*^9, 3.990513283562399*^9, 
  3.990627589802931*^9, 3.9906287712344112`*^9, 3.990692313979126*^9, 
  3.991993561147996*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"ea3fd077-2158-4636-b8bf-9372517d7c70"]
}, Open  ]],

Cell[TextData[{
 "This looks like a Gamma Distribution with (using the ",
 ButtonBox["Wikipedia",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Gamma_distribution"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Gamma_distribution"],
 " definition) \[Alpha] = 1/2, and \[Theta] = 2",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", "2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "068bf4ad-9751-49f3-842f-fa6a0ca253a9"],
 "."
}], "Text",
 CellChangeTimes->{{3.980579634597395*^9, 3.980579641565619*^9}, {
  3.980585632387395*^9, 3.980585657795308*^9}, {3.980589374463523*^9, 
  3.9805894328479757`*^9}, {3.98058947082402*^9, 3.980589494064445*^9}, {
  3.980595556919448*^9, 
  3.980595556919772*^9}},ExpressionUUID->"541e9a0d-28e6-475d-83cd-\
c29aeaec54e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PDF", "[", 
  RowBox[{
   RowBox[{"GammaDistribution", "[", 
    RowBox[{"\[Alpha]", ",", " ", "\[Theta]"}], "]"}], ",", "x"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.99009107940487*^9, 3.990091113412807*^9}, {
  3.9900911531339397`*^9, 3.99009115373316*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"e6d38067-b00b-4da0-91b4-b75a893632b7"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\[Piecewise]", GridBox[{
       {
        FractionBox[
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox["x", "\[Theta]"]}]], " ", 
          SuperscriptBox["x", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "\[Alpha]"}]], " ", 
          SuperscriptBox["\[Theta]", 
           RowBox[{"-", "\[Alpha]"}]]}], 
         RowBox[{"Gamma", "[", "\[Alpha]", "]"}]], 
        RowBox[{"x", ">", "0"}]},
       {"0", 
        TagBox["True",
         "PiecewiseDefault",
         AutoDelete->True]}
      },
      AllowedDimensions->{2, Automatic},
      Editable->True,
      GridBoxAlignment->{
       "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
        "RowsIndexed" -> {}},
      GridBoxItemSize->{
       "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
        "RowsIndexed" -> {}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.84]}, 
          Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}, "RowsIndexed" -> {}},
      Selectable->True]}
   },
   GridBoxAlignment->{
    "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
     "RowsIndexed" -> {}},
   GridBoxItemSize->{
    "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
     "RowsIndexed" -> {}},
   GridBoxSpacings->{"Columns" -> {
       Offset[0.27999999999999997`], {
        Offset[0.35]}, 
       Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
       Offset[0.2], {
        Offset[0.4]}, 
       Offset[0.2]}, "RowsIndexed" -> {}}],
  "Piecewise",
  DeleteWithContents->True,
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",
 CellChangeTimes->{3.990091114678406*^9, 3.9900911559569902`*^9, 
  3.990261029030768*^9, 3.99051328358502*^9, 3.990627589831028*^9, 
  3.9906287712572107`*^9, 3.990692314011942*^9, 3.991993561179038*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"65554fab-397a-4d2d-b879-21f63999d9e4"]
}, Open  ]],

Cell["While that looks pretty well behaved, Gamma(x) = (x-1)!, so", "Text",
 CellChangeTimes->{{3.990091458423979*^9, 3.990091513440632*^9}, 
   3.990255503209319*^9},ExpressionUUID->"3b6d9d86-efb6-46f7-a78b-\
285181e2763e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"GammaDistribution", "[", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", 
       RowBox[{"2", 
        RowBox[{"\[Sigma]", "^", "2"}]}]}], "]"}], ",", "x"}], "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.980527423361813*^9, 3.980527524650599*^9}, {
  3.980527559082541*^9, 3.9805275966991796`*^9}, {3.980579765231518*^9, 
  3.9805797693507833`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"5dc7073d-8025-4710-bc5a-f7a401269e56"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\[Piecewise]", GridBox[{
       {
        FractionBox[
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"-", 
           FractionBox["x", 
            RowBox[{"2", " ", 
             SuperscriptBox["\[Sigma]", "2"]}]]}]], 
         RowBox[{
          SqrtBox[
           RowBox[{"2", " ", "\[Pi]"}]], " ", 
          SqrtBox[
           RowBox[{"x", " ", 
            SuperscriptBox["\[Sigma]", "2"]}]]}]], 
        RowBox[{"x", ">", "0"}]},
       {"0", 
        TagBox["True",
         "PiecewiseDefault",
         AutoDelete->True]}
      },
      AllowedDimensions->{2, Automatic},
      Editable->True,
      GridBoxAlignment->{
       "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
        "RowsIndexed" -> {}},
      GridBoxItemSize->{
       "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
        "RowsIndexed" -> {}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.84]}, 
          Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}, "RowsIndexed" -> {}},
      Selectable->True]}
   },
   GridBoxAlignment->{
    "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
     "RowsIndexed" -> {}},
   GridBoxItemSize->{
    "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
     "RowsIndexed" -> {}},
   GridBoxSpacings->{"Columns" -> {
       Offset[0.27999999999999997`], {
        Offset[0.35]}, 
       Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
       Offset[0.2], {
        Offset[0.4]}, 
       Offset[0.2]}, "RowsIndexed" -> {}}],
  "Piecewise",
  DeleteWithContents->True,
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",
 CellChangeTimes->{{3.98052749194265*^9, 3.980527525093967*^9}, 
   3.980527560173676*^9, 3.98052759719592*^9, 3.980579658697218*^9, 
   3.980579770951661*^9, 3.980604158196929*^9, 3.981443998853207*^9, 
   3.981625701937748*^9, 3.990090157605762*^9, 3.9902610291350803`*^9, 
   3.990513283690811*^9, 3.990627589937842*^9, 3.99062877136208*^9, 
   3.9906923141243134`*^9, 3.991993561490839*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"33a81402-a210-48cd-8e86-c487869a0bd2"]
}, Open  ]],

Cell["\<\
The expression below proves that the square of a Normal is a Gamma \
Distribution\
\>", "Text",
 CellChangeTimes->{{3.980579968952017*^9, 3.980579983320135*^9}, {
  3.9814443424642277`*^9, 3.9814443480486803`*^9}, {3.990090730984969*^9, 
  3.990090735041225*^9}},ExpressionUUID->"80f984a6-0ea7-4271-9cc5-\
3918d8fab704"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"g", "\[Equal]", 
    RowBox[{"pdf", "[", 
     RowBox[{"\[Sigma]", ",", "x"}], "]"}]}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Sigma]", ">", "0"}], ",", " ", 
      RowBox[{"x", ">", "0"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.980579661230422*^9, 3.980579689790056*^9}, {
  3.980579775623343*^9, 3.9805797987186613`*^9}, {3.980579881776482*^9, 
  3.9805798865915537`*^9}, {3.980579929920343*^9, 3.980579955400791*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"ad8a96d7-f605-477e-a927-f7809da699cb"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.98057995657381*^9, 3.980603515270854*^9, 
  3.980604158496863*^9, 3.981443999227116*^9, 3.981625702249694*^9, 
  3.990090157990653*^9, 3.990261029456596*^9, 3.9905132840072603`*^9, 
  3.9906275902441587`*^9, 3.9906287716482563`*^9, 3.990692315553892*^9, 
  3.991993561788046*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"2cbd1ec1-a955-423b-a1a5-e985becb4ad2"]
}, Open  ]],

Cell["\<\
Here is an example of a sum of squares of a normal distribution with a small \
variance.\
\>", "Text",
 CellChangeTimes->{{3.980582053865744*^9, 3.9805820688338842`*^9}, {
  3.980589589481126*^9, 3.9805896035852747`*^9}, {3.980603544293107*^9, 
  3.980603547261237*^9}, {3.981444366776945*^9, 
  3.981444371344981*^9}},ExpressionUUID->"3aced6ac-c4cf-44da-bb72-\
bb9019df40b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RandomVariate", "[", 
  RowBox[{
   RowBox[{"NormalDistribution", "[", 
    RowBox[{"0", ",", 
     RowBox[{"\[Pi]", "/", "20"}]}], "]"}], ",", "10"}], "]"}]], "Input",
 CellChangeTimes->{{3.9806028637686567`*^9, 3.980602864728009*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"c6f7bac3-4df7-423b-82f6-439fcb1637ea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "0.043174655181307815`"}], ",", 
   RowBox[{"-", "0.11546482925395565`"}], ",", 
   RowBox[{"-", "0.003125212170188722`"}], ",", "0.018659849620799952`", ",", 
   
   RowBox[{"-", "0.08563943944918498`"}], ",", 
   RowBox[{"-", "0.010966318675073626`"}], ",", "0.13517574843179078`", ",", 
   RowBox[{"-", "0.06600675386406708`"}], ",", "0.45496880918045446`", ",", 
   RowBox[{"-", "0.17812476364492186`"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9806028678052263`*^9, 3.980603016401847*^9, 
  3.9806041585161543`*^9, 3.981443999247464*^9, 3.98144442224874*^9, 
  3.9816257022780533`*^9, 3.990090158016385*^9, 3.990261029559218*^9, 
  3.9905132841001453`*^9, 3.9906275903510303`*^9, 3.990628771761595*^9, 
  3.990692315592875*^9, 3.991993561816584*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"7523d14f-3f7d-44d5-b6dd-aa113386347f"]
}, Open  ]],

Cell["We can square each point thus:", "Text",
 CellChangeTimes->{{3.980603553517623*^9, 
  3.980603560093347*^9}},ExpressionUUID->"79409872-4bae-4020-81a9-\
c6f0341e70c0"],

