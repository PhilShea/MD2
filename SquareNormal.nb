Cell[TextData[{
 "Here is the seven particle version of the histogram.  The five particle \
looked similar (re-evaluate the cell below with ",
 StyleBox["g6[5]", "Input"],
 " instead of ",
 StyleBox["g6[7]", "Input"],
 "), and they both look like Rayleigh distributions."
}], "Text",
 CellChangeTimes->{{3.980840447171686*^9, 3.98084047707589*^9}, {
  3.981467958667266*^9, 3.981467973611293*^9}, {3.981468168300845*^9, 
