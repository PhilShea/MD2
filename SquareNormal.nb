  3.9805247161627703`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"07a75554-3abd-43c3-9df9-59934ec39b1c"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\[Piecewise]", GridBox[{
       {
        FractionBox[
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"-", 
           FractionBox["x", 
            RowBox[{"2", " ", 
             SuperscriptBox["w", "2"]}]]}]], 
         RowBox[{
          SqrtBox[
           RowBox[{"2", " ", "\[Pi]"}]], " ", "w", " ", 
          SqrtBox["x"]}]], 
        RowBox[{"x", ">", "0"}]},
       {"0", 
        RowBox[{"x", "<", "0"}]},
       {"Indeterminate", 
        TagBox["True",
         "PiecewiseDefault",
         AutoDelete->True]}
      },
      AllowedDimensions->{2, Automatic},
