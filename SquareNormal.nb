Cell[TextData[{
 "Symbolic Analysis of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "6"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "adb8e565-b22d-40c3-9c4b-838c6bae3940"]
}], "Subsubsection",
