Cell["That small variance is due to the random angle. ", "Text",
 CellChangeTimes->{
  3.9905527011466312`*^9},ExpressionUUID->"50184ef4-9929-433d-9cf4-\
953df5d3e127"],

Cell[TextData[{
 "The plot below shows the same for the ",
 StyleBox["n",
  FontSlant->"Italic"],
 " = 7 version.  The ",
 StyleBox["g6[7,\[Pi]/72,0]", "Code"],
 " cluster is very close to the origin as rotating the constellation of 7 \
evenly spaced particles still sums to zero."
}], "Text",
 CellChangeTimes->{{3.990552569912443*^9, 
  3.99055268284142*^9}},ExpressionUUID->"4dbfd242-5bc5-4a10-96ca-\
77ab9b37da66"],

