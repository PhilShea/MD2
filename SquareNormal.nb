Cell[TextData[{
 "We\[CloseCurlyQuote]ll make a compiled version of ",
 StyleBox["g6[n]", "Code"],
 " because the histogram below was very slow to compute."
}], "Text",
 CellChangeTimes->{{3.981545490015245*^9, 3.9815455090787983`*^9}, {
  3.990553051540889*^9, 3.9905530738528347`*^9}, {3.990601580443082*^9, 
  3.990601582204804*^9}},ExpressionUUID->"9532d263-6d5c-4065-bd8f-\
03cbae39ff40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g6c", "=", 
  RowBox[{"Compile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", "_Integer"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", "_Real"}], "}"}]}], "}"}], ",", "\n", "\t", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]1", "=", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", "a"}], "]"}], "]"}]}], ",", "c", ",", "d"}], 
       "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "\[Theta]1", " ", "is", " ", "a", " ", "random", " ", "rotation"}], 
       " ", "*)"}], "\[IndentingNewLine]", "\t\t   ", 
      RowBox[{
       RowBox[{"c", "=", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Theta]1", "+", 
             RowBox[{"2", "\[Pi]", " ", 
              RowBox[{"k", "/", "n"}]}]}], ")"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", 
             RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "+", 
         "\[IndentingNewLine]", "\t\t\t ", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", "b"}], "]"}], ",", "n"}], "]"}]}]}], ";", "\n", 
       "\t\t   ", 
       RowBox[{"d", "=", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Map", "[", 
           RowBox[{"Exp", ",", 
            RowBox[{"6", "I", 
             RowBox[{"(", "c", ")"}]}]}], "]"}], "]"}], "/", "n"}]}]}]}], 
     "]"}], ",", "\n", "\t\t\t", 
    RowBox[{"CompilationTarget", "\[Rule]", "\"\<C\>\""}], ",", 
    RowBox[{"RuntimeOptions", "\[Rule]", "\"\<Speed\>\""}]}], "]"}]}]], "Code",\

 CellChangeTimes->{{3.981545018932568*^9, 3.9815450871730623`*^9}, {
   3.9901203017208223`*^9, 3.9901203181203547`*^9}, {3.990120492617753*^9, 
   3.990120500481956*^9}, {3.990120567162504*^9, 3.9901205762106247`*^9}, {
