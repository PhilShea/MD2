Cell[BoxData[{
 RowBox[{
  RowBox[{"ns", "=", "70"}], ";", 
  RowBox[{"range", "=", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"solid", " ", "=", " ", 
  RowBox[{
   RowBox[{"tmgn6", "[", 
    RowBox[{"20", ",", "0.9", ",", "175"}], "]"}], "[", 
   RowBox[{"All", ",", "\"\<g6\>\""}], "]"}]}]}], "Input",
