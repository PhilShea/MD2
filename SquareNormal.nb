Cell[BoxData[
 RowBox[{
  RowBox[{"circleParameters", "[", 
   RowBox[{"index1_", ",", "index2_", ",", "index3_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x1", "=", 
     RowBox[{"x", "[", "index1", "]"}]}], ";", " ", 
    RowBox[{"x2", "=", 
     RowBox[{"x", "[", "index2", "]"}]}], ";", " ", 
    RowBox[{"x3", "=", 
     RowBox[{"x", "[", "index3", "]"}]}], ";", 
    RowBox[{"y1", "=", 
     RowBox[{"y", "[", "index1", "]"}]}], ";", " ", 
    RowBox[{"y2", "=", 
     RowBox[{"y", "[", "index2", "]"}]}], ";", " ", 
    RowBox[{"y3", "=", 
     RowBox[{"y", "[", "index3", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"xCenter", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["x3", "2"], 
         RowBox[{"(", 
          RowBox[{"y1", "-", "y2"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x1", "2"], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"y1", "-", "y2"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"y1", "-", "y3"}], ")"}]}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"y2", "-", "y3"}], ")"}]}], "+", 
        RowBox[{
         SuperscriptBox["x2", "2"], 
         RowBox[{"(", 
          RowBox[{"y3", "-", "y1"}], ")"}]}]}], ")"}], "/", 
      "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x3", 
           RowBox[{"(", 
            RowBox[{"y1", "-", "y2"}], ")"}]}], "+", 
          RowBox[{"x1", 
           RowBox[{"(", 
            RowBox[{"y2", "-", "y3"}], ")"}]}], "+", 
          RowBox[{"x2", 
           RowBox[{"(", 
            RowBox[{"y3", "-", "y1"}], ")"}]}]}], ")"}]}], ")"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"yCenter", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["x2", "2"]}], "x3"}], "+", 
        RowBox[{
         SuperscriptBox["x1", "2"], 
         RowBox[{"(", 
          RowBox[{"x3", "-", "x2"}], ")"}]}], "+", 
        RowBox[{"x3", 
         RowBox[{"(", 
          RowBox[{"y1", "-", "y2"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"y1", "+", "y2"}], ")"}]}], "+", 
        RowBox[{"x1", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x2", "2"], "-", 
           SuperscriptBox["x3", "2"], "+", 
           SuperscriptBox["y2", "2"], "-", 
           SuperscriptBox["y3", "2"]}], ")"}]}], "+", 
        RowBox[{"x2", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x3", "2"], "-", 
           SuperscriptBox["y1", "2"], "+", 
           SuperscriptBox["y3", "2"]}], ")"}]}]}], ")"}], "/", 
      "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x3", 
           RowBox[{"(", 
            RowBox[{"y1", "-", "y2"}], ")"}]}], "+", 
          RowBox[{"x1", 
           RowBox[{"(", 
            RowBox[{"y2", "-", "y3"}], ")"}]}], "+", 
          RowBox[{"x2", 
           RowBox[{"(", 
            RowBox[{"y3", "-", "y1"}], ")"}]}]}], ")"}]}], ")"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"R", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x1", "-", "x2"}], ")"}], "2"], "+", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"y1", "-", "y2"}], ")"}], "2"]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x1", "-", "x3"}], ")"}], "2"], "+", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"y1", "-", "y3"}], ")"}], "2"]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x2", "-", "x3"}], ")"}], "2"], "+", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"y2", "-", "y3"}], ")"}], "2"]}], ")"}]}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x3", 
            RowBox[{"(", 
             RowBox[{"y2", "-", "y1"}], ")"}]}], "+", 
           RowBox[{"x2", 
            RowBox[{"(", 
             RowBox[{"y1", "-", "y3"}], ")"}]}], "+", 
           RowBox[{"x1", 
            RowBox[{"(", 
             RowBox[{"y3", "-", "y2"}], ")"}]}]}], ")"}], "2"]]]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Return", "[", 
     RowBox[{"{", 
      RowBox[{"xCenter", ",", "yCenter", ",", "R"}], "}"}], "]"}]}], 
   ")"}]}]], "Input",
