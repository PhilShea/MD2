Cell[TextData[{
 "This is fundamental to the DFT, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"N", "-", "1"}]], 
     SuperscriptBox["e", 
      RowBox[{
       RowBox[{"j2\[Pi]i", "(", 
        RowBox[{"m", "-", "n"}], ")"}], "/", "N"}]]}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"f76773fb-eaa1-4b71-b9df-4e6a4aedddb0"],
 " unless ",
 StyleBox["n",
  FontSlant->"Italic"],
 " = ",
 StyleBox["m ",
  FontSlant->"Italic"],
 "(j is the imaginary unit). It is so as the finite geometric sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"N", "-", "1"}]], 
     SuperscriptBox["r", "i"]}], " ", "=", 
    FractionBox[
     RowBox[{"1", "-", 
      SuperscriptBox["r", "N"]}], 
     RowBox[{"1", "-", "r"}]]}], TraditionalForm]],ExpressionUUID->
  "b825e586-e11a-4214-9d47-bd23cbf41410"],
 "for r\[NotEqual]1.  Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SuperscriptBox["e", 
     RowBox[{
      RowBox[{"j2\[Pi]", "(", 
       RowBox[{"m", "-", "n"}], ")"}], "/", "N"}]]}], TraditionalForm]],
  ExpressionUUID->"a02141f7-bbf9-4c7e-a275-d0d6c4e41459"],
 ", so when ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["N",
  FontSlant->"Italic"],
 " are integers, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["r", "N"], "="}], TraditionalForm]],ExpressionUUID->
  "05b7fbd5-5588-4906-83f6-4173f577cead"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{"j2\[Pi]", "(", 
      RowBox[{"m", "-", "n"}], ")"}]], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"0cd07878-5e38-4250-abe8-3af99273e41a"],
 ", so the numerator is zero, the denominator is a complex number, but the \
quotient is zero."
}], "Text",
 CellChangeTimes->{{3.980666429477869*^9, 3.980666594905384*^9}, {
  3.980666636286415*^9, 3.9806666958315763`*^9}, {3.980666728201885*^9, 
  3.9806667902493763`*^9}, {3.9806668224086657`*^9, 3.980666886096933*^9}, {
  3.980666918425466*^9, 3.980667028994307*^9}, {3.9806670590769*^9, 
  3.9806671113230257`*^9}, {3.981469025906392*^9, 
  3.981469074251532*^9}},ExpressionUUID->"916249c0-c650-46e0-aee2-\
fc7a67bde092"]
}, Open  ]],

