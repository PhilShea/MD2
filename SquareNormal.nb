Cell[TextData[{
 "This function will create a ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "6"], TraditionalForm]],ExpressionUUID->
  "f01c962b-5b49-4e24-b407-12ff044be0bd"],
 " with ",
 StyleBox["n",
  FontSlant->"Italic"],
 " evenly spaced particles, randomly rotated and adding a bit of noise to \
each particle\[CloseCurlyQuote]s position, with a normally distributed angles."
}], "Text",
 CellChangeTimes->{{3.980840252601913*^9, 3.9808403763148117`*^9}, {
  3.9814729219023733`*^9, 3.98147293222263*^9}, {3.990522287229383*^9, 
  3.9905223048535624`*^9}, {3.990778513248757*^9, 
  3.9907785623611307`*^9}},ExpressionUUID->"7ed2a412-4039-48dc-bcaf-\
c571e7f6f79f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "g6", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g6", "::", "usage"}], "=", 
   "\"\<g6[n,a,b] returns a single complex number representing the 6-fold \
order function \non a constellation of n particles, with the constellation \
rotated by a angle \[Theta]1 drawn\nfrom a Normal[0,a] distribution, with \
each particle's position deviated by an angle\n\[Phi] drawn from a \
Normal[0,b] distribution. a and b both default to \[Pi]/72.\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"g6", "[", 
   RowBox[{"n_", ",", 
    RowBox[{"a_:", 
     RowBox[{"\[Pi]", "/", "72"}]}], ",", 
    RowBox[{"b_:", 
     RowBox[{"\[Pi]", "/", "72"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Theta]1", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"0", ",", "a"}], "]"}], "]"}]}], ",", "c", ",", "d"}], "}"}],
     ",", 
    RowBox[{"(*", 
     RowBox[{
     "\[Theta]1", " ", "is", " ", "a", " ", "random", " ", "rotation"}], " ", 
     "*)"}], "\[IndentingNewLine]", "\t\t\t\t", 
    RowBox[{
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Theta]1", "+", 
           RowBox[{"2", "\[Pi]", " ", 
            RowBox[{"k", "/", "n"}]}]}], ")"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "+", 
       "\[IndentingNewLine]", "\t\t\t\t\t   ", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "b"}], "]"}], ",", "n"}], "]"}]}]}], ";", "\n", 
     "\t\t\t\t", 
     RowBox[{"d", "=", 
      RowBox[{
       RowBox[{"Apply", "[", 
        RowBox[{"Plus", ",", 
         RowBox[{"Map", "[", 
          RowBox[{"Exp", ",", 
           RowBox[{"6", "I", 
            RowBox[{"(", "c", ")"}]}]}], "]"}]}], "]"}], "/", "n"}]}]}]}], 
   "]"}]}]}], "Code",
 CellChangeTimes->{{3.980605805208943*^9, 3.98060609008282*^9}, {
   3.980606145011325*^9, 3.98060619947575*^9}, {3.98061176622571*^9, 
   3.9806117667685747`*^9}, {3.980612003884589*^9, 3.9806120352830667`*^9}, {
   3.9806121509488897`*^9, 3.9806121543081417`*^9}, {3.980612394295295*^9, 
   3.980612414566217*^9}, {3.980612473447754*^9, 3.9806124751667757`*^9}, {
   3.980663594824778*^9, 3.9806636291921587`*^9}, {3.980663846466722*^9, 
   3.980663853097706*^9}, {3.980663909546927*^9, 3.9806639805705137`*^9}, {
   3.981473934630003*^9, 3.9814739405015583`*^9}, {3.9900940908629093`*^9, 
   3.990094128879168*^9}, {3.990120037830284*^9, 3.990120054622354*^9}, {
   3.9902556100617037`*^9, 3.9902556154609528`*^9}, {3.990512751255518*^9, 
   3.990512823375547*^9}, {3.9905128745443497`*^9, 3.990512894096004*^9}, {
   3.99051315297834*^9, 3.9905131535779457`*^9}, {3.990522047379899*^9, 
