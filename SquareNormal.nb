Cell[TextData[{
 "The plot below overlays that PDF with a histogram created by 1,000 samples \
of summing fifty ",
 StyleBox["\[CapitalGamma]",
  FontWeight->"Bold"],
 "[1/2, \[Pi]/20] random variables."
}], "Text",
 CellChangeTimes->{{3.980583755475916*^9, 3.980583848932618*^9}, {
  3.9808400990645523`*^9, 
  3.9808400997607107`*^9}},ExpressionUUID->"db598a3e-5581-4160-bf42-\
e8be65f7d71f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pgn50h", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"Histogram", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"sg", "[", "50", "]"}], ",", " ", "1000"}], "]"}], ",", 
      "Automatic", ",", "\"\<PDF\>\""}], "]"}], ",", "pgn50"}], 
