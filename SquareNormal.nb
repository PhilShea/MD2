Cell["First, the distribution of the square.", "Text",
 CellChangeTimes->{
  3.981444206679574*^9},ExpressionUUID->"845e3349-75bc-4798-8177-\
854556e56538"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"p", "=", 
  RowBox[{"TransformedDistribution", "[", 
   RowBox[{
    RowBox[{"x", "^", "2"}], ",", " ", 
    RowBox[{"x", "\[Distributed]", 
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "\[Sigma]"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.980504834893765*^9, 3.980504866106455*^9}, {
  3.9805049192557707`*^9, 3.98050495905121*^9}, {3.9805049903877993`*^9, 
  3.980505005491371*^9}, {3.9805051782212753`*^9, 3.980505205476755*^9}, {
  3.980505649880436*^9, 3.9805056681043158`*^9}, {3.980505938083564*^9, 
  3.9805059838988256`*^9}, {3.980506525343306*^9, 3.9805065492627172`*^9}, {
  3.980524430362186*^9, 3.98052447017765*^9}, {3.980525133511518*^9, 
  3.980525133718515*^9}, {3.98052558500384*^9, 3.9805255852272377`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"7644c32f-1ab0-41d3-b82c-ac335274a0aa"],

Cell[BoxData[
 RowBox[{"TransformedDistribution", "[", 
  RowBox[{
   SuperscriptBox["\[FormalX]", "2"], ",", 
   RowBox[{"\[FormalX]", "\[Distributed]", 
    RowBox[{"NormalDistribution", "[", 
     RowBox[{"0", ",", "\[Sigma]"}], "]"}]}]}], "]"}]], "Output",
 CellChangeTimes->{3.980505984814948*^9, 3.980506552591866*^9, 
  3.9805244408931704`*^9, 3.9805244713472424`*^9, 3.980525134393832*^9, 
  3.980525586566965*^9, 3.980579579792162*^9, 3.980604156852838*^9, 
  3.981443997812892*^9, 3.981625700625355*^9, 3.990090156508492*^9, 
  3.9902610283184347`*^9, 3.990513282789467*^9, 3.990627589070557*^9, 
  3.990628770505281*^9, 3.9906923127688093`*^9, 3.991993560308367*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"01fa425f-ab0b-477f-82a1-3e602ecf6d52"]
}, Open  ]],

Cell[TextData[{
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " does not recognize this as an existing distribution."
}], "Text",
 CellChangeTimes->{{3.980579545860951*^9, 3.980579555180732*^9}, {
  3.980603323403507*^9, 
  3.9806033361958103`*^9}},ExpressionUUID->"c616c1b2-9195-4760-9751-\
df6b1f626b10"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pdf", "[", 
    RowBox[{"s_", ",", " ", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"PDF", "[", 
     RowBox[{"p", ",", "x"}], "]"}], "//.", " ", 
    RowBox[{"\[Sigma]", "\[Rule]", " ", "s"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"pdf", "[", 
  RowBox[{"w", ",", "x"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9805050262997637`*^9, 3.980505045427639*^9}, {
  3.980505113676888*^9, 3.980505114331957*^9}, {3.980506093451893*^9, 
