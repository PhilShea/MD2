 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"6", "I", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Pi]", "/", "10.0"}], "+", 
      RowBox[{"k", " ", 
       RowBox[{"\[Pi]", "/", "6"}]}]}], ")"}]}], ",", 
   RowBox[{"{", 
