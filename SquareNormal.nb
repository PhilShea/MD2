Cell["\<\
This function will create a list of random normal samples, square them, and \
add them.\
\>", "Text",
 CellChangeTimes->{{3.980603567053151*^9, 
  3.980603598077579*^9}},ExpressionUUID->"3412d4cc-0b61-49d8-a9f9-\
bd4deb65330f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sg", "[", "n_", "]"}], ":=", 
   RowBox[{"Apply", "[", " ", 
    RowBox[{"Plus", ",", 
     RowBox[{"Map", "[", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "^", "2"}], "&"}], ",", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", 
           RowBox[{"\[Pi]", "/", "20"}]}], "]"}], ",", "n"}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.980580066193931*^9, 3.980580113257351*^9}, {
  3.980580149050544*^9, 3.980580254130477*^9}, {3.98058029755476*^9, 
  3.980580329107242*^9}, {3.9805805545266647`*^9, 3.9805805665015717`*^9}, {
  3.98058059817467*^9, 3.980580602230031*^9}, {3.980580690463969*^9, 
  3.980580760768037*^9}, {3.980581977858162*^9, 3.980582031617672*^9}, {
  3.98058222780483*^9, 3.980582296627626*^9}, {3.9806027472014713`*^9, 
  3.980602757184082*^9}, {3.9806030351778507`*^9, 3.980603058225917*^9}, {
  3.980603614846834*^9, 3.980603621285837*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"e460a63a-7305-440a-92a3-b8ba2f83332d"],

