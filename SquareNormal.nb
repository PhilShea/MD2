Cell[TextData[{
 "The function below will generate a sample of correlation function ",
 StyleBox["g6g6",
  FontSlant->"Italic"],
 "* for ",
 StyleBox["p",
  FontSlant->"Italic"],
 " percentage of six particle groups, and (1-",
 StyleBox["p",
  FontSlant->"Italic"],
 ") percentage of six and five particle groups and six and seven for ",
 StyleBox["n",
  FontSlant->"Italic"],
 " total samples:"
}], "Text",
 CellChangeTimes->{{3.980926664373358*^9, 3.980926801958452*^9}, {
  3.981473095839641*^9, 3.981473104367597*^9}, {3.9816273590710783`*^9, 
  3.981627364974753*^9}},ExpressionUUID->"1b5738cd-49de-44b7-b579-\
044d2c99e95c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"mgn6", ",", "mgn6c"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mgn6", "[", 
   RowBox[{"p_", ",", "n_Integer", ",", 
    RowBox[{"a_:", 
     RowBox[{"\[Pi]", "/", "72"}]}], ",", 
    RowBox[{"b_:", 
     RowBox[{"\[Pi]", "/", "72"}]}]}], "]"}], ":=", "\n", "\t", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n6t", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{"BinomialDistribution", "[", 
         RowBox[{"n", ",", "p"}], "]"}], "]"}]}], ",", "n5", ",", "n6", ",", 
      "n7", ",", "n55", ",", "n56", ",", "n57", ",", "n66", ",", "n67", ",", 
      "n77", ",", "nt"}], "}"}], ",", "\n", "\t\t\t", 
    RowBox[{
     RowBox[{"n6", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n6t", "\[Equal]", "0"}], ",", "0", ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OddQ", "[", "n6t", "]"}], ",", 
          RowBox[{"n6t", "+", "1"}], ",", "n6t"}], "]"}]}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"ensure", " ", "n6", " ", "even"}], " ", "*)"}], "\n", "\t\t\t", 
     RowBox[{"n5", "=", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"n", "-", "n6"}], ")"}], "/", "2"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"5", " ", "particle", " ", "samples"}], " ", "*)"}], "\n", 
     "\t\t\t", 
     RowBox[{"n7", "=", 
      RowBox[{"n", "-", "n6", "-", "n5"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"7", " ", "particle", " ", "samples"}], " ", "*)"}], "\n", 
     "\t\t\t", 
     RowBox[{"n55", "=", 
      RowBox[{"pairs", "[", "n5", "]"}]}], ";", " ", 
     RowBox[{"n56", "=", 
      RowBox[{"n6", "*", "n5"}]}], ";", " ", 
     RowBox[{"n66", "=", 
      RowBox[{"pairs", "[", "n6", "]"}]}], ";", " ", 
     RowBox[{"n57", "=", 
      RowBox[{"n5", "*", "n7"}]}], ";", " ", 
     RowBox[{"n67", "=", 
      RowBox[{"n6", "*", "n7"}]}], ";", " ", 
     RowBox[{"n77", "=", 
      RowBox[{"pairs", "[", "n7", "]"}]}], ";", "\n", "\t\t\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<n5=\>\"", ",", "n5", ",", "\"\<, n6= \>\"", ",", "n6", ",", 
         "\"\<, n7=\>\"", ",", "n7", ",", 
         RowBox[{"{", 
          RowBox[{
          "n55", ",", "n56", ",", "n57", ",", "n66", ",", "n67", ",", "n77"}],
           "}"}]}], "]"}], ";"}], "*)"}], "\n", "\t\t\t", 
     RowBox[{"nt", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"{", 
        RowBox[{
        "n55", ",", "n56", ",", "n57", ",", "n66", ",", "n67", ",", "n77"}], 
        "}"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Print", "[", "nt", "]"}], ";"}], " ", "*)"}], "\n", "\t\t\t", 
     
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<g6\>\"", "\[Rule]", 
        RowBox[{"Abs", "[", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Take", " ", "absolute", " ", "value", " ", "of", " ", "the", " ", 
           "Total"}], " ", "*)"}], "\n", "\t\t\t\t", 
         RowBox[{
          RowBox[{"Total", "[", " ", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Sum", " ", "all", " ", "results", " ", "together", " ", "to", 
             " ", "get", " ", "a", " ", "single", " ", "complex", " ", 
             "number"}], " ", "*)"}], "\n", "\t\t\t\t\t", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"g6c", "[", 
                  RowBox[{"5", ",", "a", ",", "b"}], "]"}], 
                 RowBox[{"Conjugate", "[", 
                  RowBox[{"g6c", "[", 
                   RowBox[{"5", ",", "a", ",", "b"}], "]"}], "]"}]}], ",", 
                "n55"}], "]"}], "]"}], ",", "\n", "\t\t\t\t\t\t ", 
             RowBox[{"Total", "[", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"g6c", "[", 
                  RowBox[{"5", ",", "a", ",", "b"}], "]"}], 
                 RowBox[{"Conjugate", "[", 
                  RowBox[{"g6c", "[", 
                   RowBox[{"6", ",", "a", ",", "b"}], "]"}], "]"}]}], ",", 
                "n56"}], "]"}], "]"}], ",", "\n", "\t\t\t\t\t\t ", 
             RowBox[{"Total", "[", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"g6c", "[", 
                  RowBox[{"5", ",", "a", ",", "b"}], "]"}], 
                 RowBox[{"Conjugate", "[", 
                  RowBox[{"g6c", "[", 
                   RowBox[{"7", ",", "a", ",", "b"}], "]"}], "]"}]}], ",", 
                "n57"}], "]"}], "]"}], ",", "\n", "\t\t\t\t\t\t ", 
             RowBox[{"Total", "[", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"g6c", "[", 
                  RowBox[{"6", ",", "a", ",", "b"}], "]"}], 
                 RowBox[{"Conjugate", "[", 
                  RowBox[{"g6c", "[", 
                   RowBox[{"6", ",", "a", ",", "b"}], "]"}], "]"}]}], ",", 
                "n66"}], "]"}], "]"}], ",", "\n", "\t\t\t\t\t\t ", 
             RowBox[{"Total", "[", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"g6c", "[", 
                  RowBox[{"6", ",", "a", ",", "b"}], "]"}], 
