Cell[TextData[{
 "For each particle, we generate a potential energy ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "0"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "fe32e446-0465-4eed-bd56-47b42f545bb3"],
 " increase from the exponential distribution, generate a random direction, \
and then place the particle along that direction such that its excess PE \
matches ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "0"], TraditionalForm]],ExpressionUUID->
  "c39cda77-bc09-4bd4-b548-6b5199803e47"],
 ". We would like an inverse function for that."
}], "Text",
 CellChangeTimes->{{3.96719344427337*^9, 3.9671936225145597`*^9}, {
  3.9671953701495953`*^9, 
  3.96719537882967*^9}},ExpressionUUID->"6e682ba4-2fb6-42ef-8cc0-\
e95ed436123a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InverseFunction", "[", 
  RowBox[{"xTx2", "[", "x", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.967194483890936*^9, 3.9671945221137466`*^9}, {
   3.967194643854508*^9, 3.967194723246772*^9}, 3.967617317372058*^9},
 CellLabel->
  "In[265]:=",ExpressionUUID->"549d85a8-6d26-4c0a-97c3-513eb2af733c"],

Cell[BoxData[
 RowBox[{"InverseFunction", "[", 
  RowBox[{"0.14406046502730224`", " ", "x", " ", 
   RowBox[{"Tan", "[", 
    RowBox[{"1.4884904931325253`", " ", "x"}], "]"}]}], "]"}]], "Output",
 CellChangeTimes->{
  3.9671945235411777`*^9, {3.967194656952525*^9, 3.967194724049074*^9}, 
   3.967617318575728*^9, 3.967631665881342*^9, 3.967634038476989*^9, 
   3.967637001526742*^9, 3.967966820068721*^9, 3.968754338801898*^9},
 CellLabel->
  "Out[265]=",ExpressionUUID->"9a5b9850-370c-4a32-a1fa-61d7e418ad2a"]
}, Open  ]],

Cell["\<\
That was useless.  We can use FinddRoot[] to perform the inverse for us.\
\>", "Text",
 CellChangeTimes->{{3.9672742837898417`*^9, 
  3.967274311701729*^9}},ExpressionUUID->"208d7fa1-f8f8-4654-bed4-\
975bdfd50429"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NumberForm", "[", 
  RowBox[{
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"xTx2", "[", "x", "]"}], "\[Equal]", "0.2"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", ".3"}], "}"}]}], "]"}], ",", " ", "15"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.967195392537795*^9, 3.9671954180467873`*^9}, 
   3.967295112929268*^9, {3.967296031616764*^9, 3.967296049119399*^9}},
 CellLabel->
  "In[266]:=",ExpressionUUID->"20666d87-2539-4aa1-9501-b9354f6cc2e1"],

Cell[BoxData[
 TagBox[
  RowBox[{"{", 
   RowBox[{"x", "\[Rule]", 
    InterpretationBox["\<\"0.730052667340978\"\>",
     0.7300526673409775,
     AutoDelete->True]}], "}"}],
