 RowBox[{
  FractionBox["1", "12"], " ", "n", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    SuperscriptBox["n", "2"]}], ")"}]}]], "Output",
