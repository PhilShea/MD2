Cell[CellGroupData[{

Cell["Nelson-Halperin Order Parameter", "Subsection",
 CellChangeTimes->{{3.9497506384103928`*^9, 
  3.949750657922071*^9}},ExpressionUUID->"600546c5-a82c-4e78-bbeb-\
1a9df1cb3e3a"],

Cell[TextData[{
 "\[CapitalPsi]=",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"k", "\[NotEqual]", "j"}]], 
    RowBox[{"exp\:f000", " ", "i", " ", "6", " ", 
     SubscriptBox["\[CapitalTheta]", "jk"], " ", "\:f006"}]}], 
   TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "324d7ca1-420d-490f-ac85-52bc8869ac5c"],
 "/",
 Cell[BoxData[
  FormBox[
   UnderscriptBox["\[Sum]", 
    RowBox[{"k", "\[NotEqual]", "j"}]], TraditionalForm]],ExpressionUUID->
  "504f7afe-eeba-4acb-bad4-3055f8bc0dc4"],
 "1, where the sum is over all particle pairs ",
 StyleBox["j",
  FontSlant->"Italic"],
 " and ",
 StyleBox["k",
  FontSlant->"Italic"],
 " (and the i in the exponent is the\nimaginary unit) and \[CapitalTheta]",
 StyleBox["jj ",
  FontSlant->"Italic"],
 "is the angle of the vector from particle ",
 StyleBox["k",
  FontSlant->"Italic"],
 " to particle ",
 StyleBox["j",
  FontSlant->"Italic"],
 " with the x axis. Note that the\nangle from particle ",
 StyleBox["k",
  FontSlant->"Italic"],
 " to ",
 StyleBox["j ",
  FontSlant->"Italic"],
 "is the compliment of the angle from particle ",
 StyleBox["j",
  FontSlant->"Italic"],
 " to ",
 StyleBox["k",
  FontSlant->"Italic"],
 ", so we only need to look at\neach pair."
}], "Text",
 CellChangeTimes->{{3.9497506830949097`*^9, 3.949750704218972*^9}, {
  3.949750789096636*^9, 
  3.949751001765329*^9}},ExpressionUUID->"33e27124-59b1-48a1-bb6a-\
ebfbec2b16d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Theta]", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"n", " ", 
     RowBox[{"\[Pi]", "/", "3"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "0", ",", "5"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.949751019363447*^9, 3.949751076006674*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"2f35fc49-8607-429f-a933-c536b2c514cc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   FractionBox["\[Pi]", "3"], ",", 
   FractionBox[
    RowBox[{"2", " ", "\[Pi]"}], "3"], ",", "\[Pi]", ",", 
   FractionBox[
    RowBox[{"4", " ", "\[Pi]"}], "3"], ",", 
   FractionBox[
    RowBox[{"5", " ", "\[Pi]"}], "3"]}], "}"}]], "Output",
 CellChangeTimes->{{3.949751065972207*^9, 3.9497510774877043`*^9}, 
   3.9497600444437733`*^9, 3.964688717478629*^9, 3.9651166156351013`*^9, 
   3.965123770515852*^9, 3.9657226159275723`*^9, 3.965900167089143*^9, 
   3.966670560511786*^9, 3.966843677047573*^9, 3.967631656102314*^9, 
   3.967634028627091*^9, 3.967636990570908*^9, 3.9679668099488573`*^9, 
   3.968754327553205*^9},
 CellLabel->
  "Out[183]=",ExpressionUUID->"3e8aeb1a-9dbc-4113-9de2-be7c2cfd2db2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ArcTan", "[", " ", 
  RowBox[{
   RowBox[{"Cos", "[", 
