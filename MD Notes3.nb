Cell["\<\
The expression below will will take each deviation and angle and form an \
{x,y} pair.\
\>", "Text",
 CellChangeTimes->{{3.9672742119343643`*^9, 
  3.967274250014638*^9}},ExpressionUUID->"34b697f4-f4e1-4bc5-bad5-\
2c9fbbf3c5cd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dev2", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#1", 
         RowBox[{"Cos", "[", "#2", "]"}]}], ",", 
        RowBox[{"#1", 
         RowBox[{"Sin", "[", "#2", "]"}]}]}], "}"}], "&"}], "[", 
     RowBox[{"r", ",", "angles"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"dev2", "\[LeftDoubleBracket]", 
  RowBox[{"1", ";;", "10"}], "\[RightDoubleBracket]"}]}], "Input",
