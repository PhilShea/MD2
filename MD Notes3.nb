Cell[TextData[{
 "The mean is simply 256 times the mean energy per particle (i.e., ",
 StyleBox["T",
  FontSlant->"Italic"],
 ")."
}], "Text",
 CellChangeTimes->{{3.968760654367387*^9, 
  3.9687606865515223`*^9}},ExpressionUUID->"d9856f9e-1a82-43f4-9b24-\
23780be548b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"%", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "/", 
  "256"}]], "Input",
 CellChangeTimes->{{3.9429552600417423`*^9, 3.94295526548673*^9}, {
  3.968760458486926*^9, 3.968760494614725*^9}},
 CellLabel->
  "In[336]:=",ExpressionUUID->"620e3e4f-0c39-461a-ac20-20024c7574d3"],

Cell[BoxData["0.015`"], "Output",
 CellChangeTimes->{3.9429552663969564`*^9, 3.9430945992171707`*^9, 
  3.9431127444360447`*^9, 3.943342582089465*^9, 3.943426113480322*^9, 
  3.944659266009329*^9, 3.945685676141293*^9, 3.945692204495332*^9, 
  3.949746102880415*^9, 3.949760042765188*^9, 3.9646887158252087`*^9, 
  3.965116614008811*^9, 3.965123768841535*^9, 3.9657226142504997`*^9, 
  3.96590016535675*^9, 3.9666705588335047`*^9, 3.9668436754139957`*^9, 
  3.967631654248015*^9, 3.967634027044538*^9, 3.967636988840034*^9, 
  3.967966808320506*^9, 3.9687543258301563`*^9, 3.968760463935814*^9, 
  3.968760500774*^9},
 CellLabel->
  "Out[336]=",ExpressionUUID->"bfae0dc1-f752-45dd-807b-bca5034ddea8"]
}, Open  ]],

Cell[TextData[{
 "The function below will generate 2",
 StyleBox["n",
  FontSlant->"Italic"],
 " random deviates (an x & y for each particle) with variance ",
 StyleBox["T",
  FontSlant->"Italic"],
 ", and create the sum of squares divided by two (the total kinetic energy)."
}], "Text",
 CellChangeTimes->{{3.9687608122083683`*^9, 3.968760828888426*^9}, {
  3.968760934273041*^9, 3.968760952105103*^9}, {3.9687610066896753`*^9, 
  3.968761077098153*^9}},ExpressionUUID->"71d1fa11-47a1-4427-a54b-\
5fa4bb5a0b18"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ns", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ns", "[", 
    RowBox[{"n_", ",", "T_"}], "]"}], ":=", 
   RowBox[{"Apply", "[", 
    RowBox[{"Plus", ",", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "^", "2"}], "/", "2"}], "&"}], ",", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", 
           SqrtBox["T"]}], "]"}], ",", 
         RowBox[{"2", "n"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n0", "=", "256"}], ";", 
  RowBox[{"T0", "=", "0.015"}], ";", 
  RowBox[{"ns", "[", 
   RowBox[{"n0", ",", "T0"}], "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9429554417327743`*^9, 3.9429555005748367`*^9}, 
   3.942955571683465*^9, 3.942955603738058*^9, {3.9687609772176523`*^9, 
   3.968760979201989*^9}, {3.968761053754568*^9, 3.968761054426338*^9}},
 CellLabel->
  "In[341]:=",ExpressionUUID->"cdd888e7-e107-49c5-9af1-ca32ebc3042d"],

Cell[BoxData["4.346535576760178`"], "Output",
 CellChangeTimes->{3.968760980555066*^9, 3.968761082839267*^9},
 CellLabel->
  "Out[343]=",ExpressionUUID->"0edfd452-7487-4d41-9336-d0ee17e45cd2"]
}, Open  ]],

Cell[TextData[{
 "The resulting energy looks like a normal distribution with mean ",
 StyleBox["nT",
  FontSlant->"Italic"],
 " and variance ",
 StyleBox["n",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "8cb83ec8-31da-4536-ac21-82fffdf5cf74"],
 "."
}], "Text",
 CellChangeTimes->{{3.968761144826195*^9, 
  3.968761266275597*^9}},ExpressionUUID->"63c1330d-d92c-4034-8c17-\
7802d4fa6629"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ns", "[", 
      RowBox[{"n0", ",", "T0"}], "]"}], ",", "10000"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Histogram", "[", 
    RowBox[{"data", ",", "20", ",", "\"\<PDF\>\""}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{
         RowBox[{"n0", " ", "T0"}], ",", 
         RowBox[{
          SqrtBox["n0"], " ", "T0"}]}], "]"}], ",", "x"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"Min", "[", "data", "]"}], ",", 
       RowBox[{"Max", "[", "data", "]"}]}], "}"}]}], "]"}]}], 
  "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.9429556609028215`*^9, 3.942955813590339*^9}, {
  3.9429558586082153`*^9, 3.9429558788159776`*^9}, {3.9687611098271837`*^9, 
  3.9687611212912283`*^9}},
