Cell["And here are some interesting values of that. ", "Text",
 CellChangeTimes->{{3.928335097446002*^9, 3.9283351158700213`*^9}, {
  3.9429160354274316`*^9, 
  3.9429160369069805`*^9}},ExpressionUUID->"1245f17d-cc99-4249-af68-\
19ec589fc2ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"test", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "/", "2"}], ",", " ", "1", ",", " ", "2", ",", "a79", ",", 
     " ", "3", ",", " ", "3.4999", ",", " ", 
     RowBox[{"7", "/", "2"}], ",", " ", "4", ",", " ", 
     RowBox[{"nnnd", " ", "\[Alpha]79"}], ",", " ", "tnnnd"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"test", "::", "usage"}], "=", 
   "\"\<test = {1/2, 1, 2, a79, 3, 3.4999, 7/2, 4, nnnd \[Alpha]79, tnnnd}\n\t\
The explicit rationals are good test values whose results are easily done in \
your head (except for 7/2, which is the skin distance). \[Alpha]79 is the 1/\
\[Pi] density as exact number (\!\(\*SqrtBox[\(2  \
\[Pi]/\*SqrtBox[\(3\)]\)]\)), a79 as floating point. 3.4999 is just inside \
the 3.5 skin value. nnnd is the next nearest neighbor distance in a79 units, \
and tnnnd is the third net nearest neighbor distance (i.e., \
2\[Cross]a79).\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Map", "[", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"rn", "[", 
     RowBox[{"#", ",", "5"}], "]"}], "&"}], ",", "test"}], "]"}]}], "Input",
