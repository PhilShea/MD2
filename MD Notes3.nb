307a2cc2eb38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"i", "=", "1"}], "n"], 
   RowBox[{"(", 
    RowBox[{"i", "-", 
     FractionBox[
      RowBox[{"n", "+", "1"}], "2"]}], ")"}]}], " ", "]"}]], "Input",
