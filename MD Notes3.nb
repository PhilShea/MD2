 RowBox[{"{", 
  RowBox[{
   RowBox[{"Erfc", "[", 
    RowBox[{"10", " ", 
     SqrtBox[
      FractionBox["15", "7"]]}], "]"}], ",", "2.359663790649756`*^-31"}], 
