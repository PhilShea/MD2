Cell[TextData[{
 "Again, let\[CloseCurlyQuote]s plug in 5 for ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", and add constraints on ",
 StyleBox["T",
  FontSlant->"Italic"],
 "1, ",
 StyleBox["P",
  FontSlant->"Italic"],
 "1, ",
 StyleBox["P",
  FontSlant->"Italic"],
 "2, & \[Rho]1."
}], "Text",
 CellChangeTimes->{{3.9616923559768057`*^9, 3.961692433249015*^9}, {
  3.961692465081113*^9, 
  3.961692483993208*^9}},ExpressionUUID->"ff833d58-92db-4fe2-a47d-\
271c2694ea36"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Rho]1", " ", 
       RowBox[{"T1", "^", 
        RowBox[{"(", 
         RowBox[{"2", "/", "5"}], ")"}]}]}], "==", 
      RowBox[{"\[Rho]2", " ", 
       RowBox[{"T2", "^", 
        RowBox[{"(", 
         RowBox[{"2", "/", "5"}], ")"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"P1", "/", 
       RowBox[{"(", 
        RowBox[{"\[Rho]1", " ", "T1"}], ")"}]}], "\[Equal]", 
      RowBox[{"P2", "/", 
       RowBox[{"(", 
        RowBox[{"\[Rho]2", " ", "T2"}], ")"}]}]}], ",", 
     RowBox[{"n", "\[GreaterEqual]", "1"}], ",", 
     RowBox[{"P1", ">", "0"}], ",", 
     RowBox[{"T1", ">", "0"}], ",", " ", 
     RowBox[{"\[Rho]1", ">", "0"}], ",", 
     RowBox[{"P2", ">", "0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Rho]2", ",", "T2"}], "}"}], ",", "Reals"}], "]"}]], "Input",
 CellChangeTimes->{{3.961687773315338*^9, 3.961687775035368*^9}, {
  3.9616879567846947`*^9, 3.961687963983981*^9}, {3.961688209655588*^9, 
  3.961688242231914*^9}, {3.961688309690076*^9, 3.961688314409586*^9}, {
  3.961688497415062*^9, 3.961688528127966*^9}, {3.961688665716812*^9, 
  3.961688707661208*^9}, {3.96169245374611*^9, 3.961692454217551*^9}, {
  3.961692625727056*^9, 3.961692646542152*^9}},
 CellLabel->
  "In[322]:=",ExpressionUUID->"179b0096-40ca-4538-8236-2bccdb0bc692"],

Cell[BoxData[
 RowBox[{
  RowBox[{"n", "\[GreaterEqual]", "1"}], "&&", 
  RowBox[{"\[Rho]1", ">", "0"}], "&&", 
  RowBox[{"T1", ">", "0"}], "&&", 
  RowBox[{"P2", ">", "0"}], "&&", 
  RowBox[{"P1", ">", "0"}], "&&", 
  RowBox[{"\[Rho]2", "\[Equal]", 
   RowBox[{"Root", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["P1", "2"]}], " ", 
        SuperscriptBox["\[Rho]1", "3"]}], "+", 
       RowBox[{
        SuperscriptBox["P2", "2"], " ", 
        SuperscriptBox["#1", "3"]}]}], "&"}], ",", "1"}], "]"}]}], "&&", 
  RowBox[{"T2", "\[Equal]", 
   FractionBox[
    RowBox[{"P2", " ", "T1", " ", "\[Rho]1"}], 
    RowBox[{"P1", " ", "\[Rho]2"}]]}]}]], "Output",
 CellChangeTimes->{3.961688530992044*^9, 3.961688710314166*^9, 
  3.961692456283435*^9, 3.961692652889967*^9, 3.964688723494515*^9, 
  3.9651166220625277`*^9, 3.965123777011077*^9, 3.9657226222813797`*^9, 
  3.965900173578491*^9, 3.966670566591146*^9, 3.966843683516473*^9, 
  3.967631676271399*^9, 3.967634048237267*^9, 3.967637011608761*^9, 
  3.967966830534657*^9, 3.968754349418046*^9},
 CellLabel->
  "Out[322]=",ExpressionUUID->"3165d0b0-ed5a-410c-85c6-6a5f7d62171e"]
}, Open  ]],

Cell["\<\
 So T2 gives us the expected result.  The new density though is the root of a \
third order polynomial\
\>", "Text",
 CellChangeTimes->{{3.961692888276658*^9, 3.9616929029963493`*^9}, {
  3.9619244686727962`*^9, 
  3.961924512509924*^9}},ExpressionUUID->"4d6ebe45-1802-4f01-9bad-\
ef8f68ea12e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["P1", "2"]}], " ", 
     SuperscriptBox["\[Rho]1", "3"]}], "+", 
    RowBox[{
     SuperscriptBox["P2", "2"], " ", 
     SuperscriptBox["#1", "3"]}]}], "&"}], "[", "x", "]"}]], "Input",
 CellChangeTimes->{
  3.961692921091498*^9, {3.961692994657229*^9, 3.961692995952273*^9}},
 CellLabel->
  "In[323]:=",ExpressionUUID->"815f15fb-675e-49a8-84b4-79659d72c3b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["P2", "2"], " ", 
   SuperscriptBox["x", "3"]}], "-", 
  RowBox[{
   SuperscriptBox["P1", "2"], " ", 
   SuperscriptBox["\[Rho]1", "3"]}]}]], "Output",
 CellChangeTimes->{3.961692922840901*^9, 3.9616929969156427`*^9, 
  3.9646887235153427`*^9, 3.9651166220778112`*^9, 3.965123777037839*^9, 
  3.965722622302362*^9, 3.965900173598084*^9, 3.96667056660445*^9, 
  3.966843683532713*^9, 3.967631676297113*^9, 3.967634048254569*^9, 
  3.967637011633008*^9, 3.967966830554195*^9, 3.9687543494436626`*^9},
 CellLabel->
  "Out[323]=",ExpressionUUID->"8ea9a393-d85f-41b4-8f33-61f4d31ce9de"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Application of the Virial Theorem", "Section",
 CellChangeTimes->{{3.942956045445721*^9, 
  3.9429560554528255`*^9}},ExpressionUUID->"089726ec-314a-4085-ad0a-\
5563f646c3a8"],

Cell[TextData[{
 "The Virial Theorem for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "n"}]], TraditionalForm]],ExpressionUUID->
  "a08e6567-351b-41bd-9c96-cd3975be49f7"],
 " potentials states that the total kinetic energy is related to the total \
potential energy as 2\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "T"], TraditionalForm]],ExpressionUUID->
  "1906f6f3-cd02-4c54-b5b3-3624ee677fb7"],
 "\[RightAngleBracket]=-n\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "T"], TraditionalForm]],ExpressionUUID->
  "34eb3434-6ae2-404e-988e-04ba3037cdf7"],
 "\[RightAngleBracket], where the angle brackets denote averages. Combine \
this with the pressure equation P = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", 
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox["K", "T"], "\[RightAngleBracket]"}], "("}], 
   TraditionalForm]],ExpressionUUID->"e05b93d4-f183-4732-aa21-2a9a6072d137"],
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", 
    FractionBox[
     RowBox[{"n", 
      RowBox[{"\[LeftAngleBracket]", 
       FormBox[
        SubscriptBox["U", "T"],
        TraditionalForm], "\[RightAngleBracket]"}]}], 
     RowBox[{"2", 
      RowBox[{"\[LeftAngleBracket]", 
       FormBox[
        SubscriptBox["K", "T"],
        TraditionalForm], "\[RightAngleBracket]"}]}]]}], TraditionalForm]],
  ExpressionUUID->"36a027ff-44de-4d41-8922-9bd90ef82855"],
 "), where \[Rho] is the density, the pressure becomes simply 2\[Rho]\
\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "T"], TraditionalForm]],ExpressionUUID->
  "db1cdcbb-749d-4e11-b841-ec26bc39842f"],
 "\[RightAngleBracket]"
}], "Text",
 CellChangeTimes->{{3.942956069209253*^9, 3.942956308809636*^9}, {
  3.961924352103654*^9, 
  3.961924388423624*^9}},ExpressionUUID->"adb313e2-6bcd-4c25-aeac-\
b0c954956daf"],

