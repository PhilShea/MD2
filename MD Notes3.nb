  RowBox[{
   RowBox[{
    RowBox[{"#1", "/", "#2"}], "&"}], ",", 
   RowBox[{"{", 
    RowBox[{"origtime", ",", " ", 
     RowBox[{"Drop", "[", 
      RowBox[{"FastCorr", ",", " ", 
       RowBox[{"-", "1"}]}], "]"}]}], "}"}], ",", "2"}], "]"}]], "Input",
