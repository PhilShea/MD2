Cell["\<\
We can make a three input version of rn[] to account for the skin depth.\
\>", "Text",
 CellChangeTimes->{{3.966846697823599*^9, 
  3.966846724936047*^9}},ExpressionUUID->"db059066-dedf-4c30-adaa-\
aedc49361d79"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "rn", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rn", "::", "usage"}], "=", 
   "\"\<rn[\!\(\*StyleBox[\"r\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\",\",\
FontSlant->\"Italic\"]\)\!\(\*StyleBox[\" \
\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"n\",FontSlant->\"Italic\"]\)]=\!\(\
\*SuperscriptBox[\(r\), \(-n\)]\).\n\
rn[\!\(\*StyleBox[\"r_\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\",\",\
FontSlant->\"Italic\"]\)\!\(\*StyleBox[\" \
\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"n_:\",FontSlant->\"Italic\"]\)\!\(\
\*StyleBox[\"5\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\",\",FontSlant->\"\
Italic\"]\)\!\(\*StyleBox[\" \",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"Rskn\
\",FontSlant->\"Italic\"]\)\!\(\(\(_\)\(:\)\)\)3.5] respects the skin depth \
and causes the potential to be zero at the skin depth range.\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rn", "[", 
    RowBox[{"r_", ",", "n_"}], "]"}], ":=", 
   SuperscriptBox["r", 
    RowBox[{"-", "n"}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rn", "[", 
   RowBox[{"r_", ",", 
    RowBox[{"n_:", "5"}], ",", 
    RowBox[{"Rskn_:", "3.5"}]}], "]"}], ":=", 
  TagBox[GridBox[{
     {"\[Piecewise]", GridBox[{
        {"0", 
         RowBox[{"r", "\[GreaterEqual]", "Rskn"}]},
        {
         RowBox[{
          RowBox[{"rn", "[", 
           RowBox[{"r", ",", "n"}], "]"}], "-", 
          RowBox[{"rn", "[", 
           RowBox[{"Rskn", ",", "n"}], "]"}]}], "True"}
       },
       AllowedDimensions->{2, Automatic},
       Editable->True,
       GridBoxAlignment->{
        "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}},
          "RowsIndexed" -> {}},
       GridBoxItemSize->{
        "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
         "RowsIndexed" -> {}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.84]}, 
           Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}, "RowsIndexed" -> {}},
       Selectable->True]}
    },
    GridBoxAlignment->{
     "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
      "RowsIndexed" -> {}},
    GridBoxItemSize->{
     "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
      "RowsIndexed" -> {}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.35]}, 
        Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}, "RowsIndexed" -> {}}],
   "Piecewise",
   DeleteWithContents->True,
   Editable->False,
   SelectWithContents->True,
   Selectable->False]}]}], "Code",
 CellChangeTimes->{{3.966846730657242*^9, 3.966846732849774*^9}, {
   3.966846777625618*^9, 3.966846803137945*^9}, {3.966846861875658*^9, 
   3.966846912612856*^9}, {3.9668469495825872`*^9, 3.966847036428176*^9}, {
   3.966946445318396*^9, 3.966946704656053*^9}, 3.967015116164444*^9},
 CellLabel->
  "In[211]:=",ExpressionUUID->"01b4147d-a4ec-4bf1-8206-d56cccc26c61"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"?", "test"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "test", "]"}], ";", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"rn", "[", 
      RowBox[{"#", ",", "5", ",", "3.5"}], "]"}], "&"}], ",", " ", "test"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.96684747413409*^9, 3.9668474996219893`*^9}, {
  3.966847965568466*^9, 3.966847990485091*^9}, {3.9670151599567833`*^9, 
  3.9670151726600647`*^9}, {3.9670158116984873`*^9, 3.96701584428185*^9}, {
  3.967015887427436*^9, 3.9670159190181627`*^9}, {3.9670162440691347`*^9, 
