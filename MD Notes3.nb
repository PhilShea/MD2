  RowBox[{"ClearAll", "[", "sxTx6", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sxTx6", "[", "x_", "]"}], ":=", 
  RowBox[{"Evaluate", "[", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"xTx2", "[", "x", "]"}], ",", 
