Cell[TextData[{
 "We can quickly eliminate particles whose distance is greater than the ",
 StyleBox["shell",
  FontSlant->"Italic"],
 " (or the ",
 StyleBox["skin",
  FontSlant->"Italic"],
 " for that matter) in  either the ",
 StyleBox["x",
  FontSlant->"Italic"],
 " or ",
 StyleBox["y",
  FontSlant->"Italic"],
 " direction, and can include those whose ",
 StyleBox["x",
  FontSlant->"Italic"],
 " and ",
 StyleBox["y",
  FontSlant->"Italic"],
 " distance are both less than the 1/",
 Cell[BoxData[
  FormBox[
   SqrtBox["2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "bf03fb17-0ab1-426f-b639-61ceff3d711c"],
 " of the ",
 StyleBox["shell",
  FontSlant->"Italic"],
 " distance."
}], "Text",
 CellChangeTimes->{{3.9651167933376017`*^9, 3.9651169463310127`*^9}, 
   3.965117035364094*^9},ExpressionUUID->"283a911a-791b-42d9-b9a8-\
852b3c8c100b"],

