Cell[TextData[{
 "Here is a 256 particle array, with a focus on particle 189.  The red circle \
is the ",
 StyleBox["skin",
  FontSlant->"Italic"],
 " range of 3.5, and the green circle is the correlation range (the ",
 StyleBox["shell",
  FontSlant->"Italic"],
 ") of 5.  The magenta circled particle is the next nearest particle on the \
row, and the blue circled particle is the second next nearest particle, just \
inside the ",
 StyleBox["skin",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.942746233133216*^9, 3.9427462939565983`*^9}, {
