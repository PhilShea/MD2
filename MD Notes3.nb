Cell["\<\
We need a function that will plot a rectangle of a particular size with its \
center at a particular place and its coordinate printed at its center.\
\>", "Text",
 CellChangeTimes->{{3.9658121246426907`*^9, 
  3.965812200356265*^9}},ExpressionUUID->"b4125318-41e4-4546-9c7e-\
3aa0f59a458b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "plotrect", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"plotrect", "::", "usage"}], "=", 
  "\"\<plotrect[{xc,yc},{lx,ly},txt] plots a rectangle centered on {xc,yc} \
with \nsides {lx,ly} and labeled in the center with txt.\>\""}], "\n", 
 RowBox[{
  RowBox[{"plotrect", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"xc_", ",", "yc_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"lsx_", ",", "lsy_"}], "}"}], ",", " ", "txt_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"EdgeForm", "[", 
     RowBox[{"Thickness", "[", "Tiny", "]"}], "]"}], ",", "Blue", ",", " ", 
    RowBox[{"FaceForm", "[", 
     RowBox[{"Opacity", "[", "0.1", "]"}], "]"}], ",", " ", "\n", "  ", 
    RowBox[{"Rectangle", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"lsx", "/", "2"}], ",", 
          RowBox[{"lsy", "/", "2"}]}], "}"}]}], "+", 
       RowBox[{"{", 
        RowBox[{"xc", ",", "yc"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"lsx", "/", "2"}], ",", 
         RowBox[{"lsy", "/", "2"}]}], "}"}], "+", 
       RowBox[{"{", 
        RowBox[{"xc", ",", "yc"}], "}"}]}]}], "]"}], ",", " ", 
    RowBox[{"Text", "[", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"txt", ",", "Tiny"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"xc", ",", "yc"}], "}"}]}], "]"}]}], "}"}]}]}], "Code",
 CellChangeTimes->{{3.965812210454509*^9, 3.9658124638206987`*^9}, {
   3.965815740337734*^9, 3.965815745464281*^9}, {3.9658158208159733`*^9, 
