Cell[BoxData[
 RowBox[{"Function", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x$", ",", "y$"}], "}"}], ",", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dev$", "=", 
        RowBox[{"point$12713", "+", 
         RowBox[{"{", 
          RowBox[{"x$", ",", "y$"}], "}"}]}]}], ",", "skinlst$"}], "}"}], ",", 
     RowBox[{
      RowBox[{"skinlst$", "=", 
       RowBox[{"Nearest", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Delete", "[", 
           RowBox[{"pntarry$12713", ",", "190"}], "]"}], 
          "\[Rule]", "\<\"Distance\"\>"}], ",", "dev$", ",", 
         RowBox[{"{", 
          RowBox[{"All", ",", "3.5`"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"Plus", "@@", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"rn", "[", 
            RowBox[{"#1", ",", "5", ",", "3.5`"}], "]"}]}], "&"}], ")"}], "/@",
         "skinlst$"}]}]}]}], "]"}]}], "]"}]], "Output",
