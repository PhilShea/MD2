   3.9276105218226213`*^9}, {3.9276107812548313`*^9, 3.927611034671511*^9}, {
   3.9276116009119363`*^9, 3.9276116327978797`*^9}, {3.9276116807047873`*^9, 
   3.927611681472663*^9}, {3.92761171820957*^9, 3.9276117698877516`*^9}, {
   3.9276118184625793`*^9, 3.927611849644639*^9}, {3.927612138319522*^9, 
   3.9276122894197516`*^9}, {3.927612403688133*^9, 3.9276124277995143`*^9}, {
   3.92761247850417*^9, 3.92761247887914*^9}, 3.927612546768545*^9, {
   3.9276126071099195`*^9, 3.927612631836424*^9}, {3.9276127876639504`*^9, 
   3.927612851864234*^9}, {3.9276246162133503`*^9, 3.927624621045087*^9}, {
   3.9427457241719866`*^9, 3.9427457407276373`*^9}, {3.9427458706475935`*^9, 
   3.9427459377273097`*^9}, 3.942916922700946*^9, {3.942916987570388*^9, 
