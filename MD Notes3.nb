Cell[CellGroupData[{

Cell["Using the Boltzmann Distribution to Initialize", "Subsubsection",
 CellChangeTimes->{{3.967185327464862*^9, 
  3.967185345553604*^9}},ExpressionUUID->"bdd5564b-ffb3-404f-a47c-\
8a2538910bbd"],

Cell[TextData[{
 "Simply using a Gaussian  was hoped to achieve a good-enough distribution of \
particles that was not starting in the odd state of passing through the \
minimum PE state. We turn now to the Boltzman distribution, which states that \
the energy will be an exponential distribution ",
 StyleBox["P",
  FontSlant->"Italic"],
 "(",
 StyleBox["E",
  FontSlant->"Italic"],
 ") = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{"-", "E"}], "/", "\[Beta]"}]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "95219a26-9b53-40d8-80a1-918feab3d4c9"],
 ", where \[Beta] is 1/",
 StyleBox["T",
  FontSlant->"Italic"],
 " (in scaled units).  The PE is roughly circular out to about a total PE of \
0.2.  The ",
 StyleBox["E",
  FontSlant->"Italic"],
 " here is the excess PE above the minimum PE."
}], "Text",
 CellChangeTimes->{{3.967185351937621*^9, 3.967185370201807*^9}, {
  3.96719270139251*^9, 3.967192932460778*^9}, {3.967193307749165*^9, 
  3.9671933798262157`*^9}, {3.9671953144202414`*^9, 
  3.9671953190688334`*^9}},ExpressionUUID->"83cfdf86-9413-4a24-9cf2-\
2cd16406571d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"0.2", "-", "pe12o"}]], "Input",
 CellChangeTimes->{{3.967193236931229*^9, 3.967193246840756*^9}},
 CellLabel->
  "In[263]:=",ExpressionUUID->"161df0f1-c2b6-47db-a2f6-44e93dc89e80"],

Cell[BoxData["0.08405121155395953`"], "Output",
 CellChangeTimes->{3.9671932480212393`*^9, 3.967295446173606*^9, 
  3.967631665827923*^9, 3.96763403843582*^9, 3.967637001475162*^9, 
  3.967966820027399*^9, 3.968754338747854*^9},
 CellLabel->
  "Out[263]=",ExpressionUUID->"a4375313-12c2-46d7-8d2e-405ee4750db8"]
}, Open  ]],

