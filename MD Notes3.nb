   3.964689277398978*^9, 3.964689339742816*^9}, {3.964689607192471*^9, 
   3.964689669235173*^9}, {3.96468972057052*^9, 3.964689999622734*^9}, {
   3.964690137553213*^9, 3.964690230722687*^9}, {3.964776330826476*^9, 
   3.964776372147835*^9}, {3.9647764348542624`*^9, 3.9647764364940557`*^9}, {
   3.964776478527444*^9, 3.9647764996636467`*^9}, {3.9647765537858477`*^9, 
   3.964776570402547*^9}, {3.964776649891603*^9, 3.964776651691313*^9}, {
   3.966935161558639*^9, 3.9669352540779247`*^9}, {3.966935798876821*^9, 
