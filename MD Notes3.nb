Cell[TextData[{
 "With this now in the mainline CorrShell!() code, the BaselineSpeed was a \
bit faster:\n\[LineSeparator]",
 StyleBox["13.940024 seconds (20.15 M allocations: 1.577 GiB, 3.52% gc time, \
199 lock conflicts)\n\n", "CodeText"],
 "After adding ",
 StyleBox["inrangeq()",
  FontFamily->"Courier"],
 " to the ",
 StyleBox["GetForce!()",
  FontFamily->"Courier"],
 " function, we got:\n\n",
 StyleBox["13.441450 seconds (20.15 M allocations: 1.577 GiB, 3.65% gc time, \
193 lock conflicts)", "CodeText"]
}], "Text",
 CellChangeTimes->{{3.9652126067886753`*^9, 3.965212638916157*^9}, {
   3.965212723868411*^9, 3.965212841724285*^9}, {3.96521310939226*^9, 
   3.965213178238638*^9}, {3.9652276524890738`*^9, 3.9652276619293222`*^9}, {
   3.965227785426258*^9, 3.965227787994046*^9}, 3.9652278659344587`*^9, {
   3.9652290199403954`*^9, 3.965229020132038*^9}, {3.965229115309061*^9, 
   3.965229143244837*^9}, 3.965229186665864*^9, {3.965231944713091*^9, 
   3.9652320279490128`*^9}, {3.9655480736237392`*^9, 3.965548075991782*^9}, {
   3.965548597016521*^9, 3.965548628912788*^9}, {3.966673169972178*^9, 
   3.966673192364257*^9}},ExpressionUUID->"a74c800e-9129-4dbe-b701-\
761a83b95977"],

Cell[TextData[{
 "The first running of ",
 StyleBox["FastCorr!()",
  FontFamily->"Courier"],
 " based on sorting and searching was not a success:\n\n",
 StyleBox["julia> SpeedTest.FastCorrSpeedTest1(2^18,1/pi)\n\
\[VerticalEllipsis]\n577.738706 seconds (8.14 M allocations: 664.980 GiB, \
4.34% gc time)\n784385", "CodeText"]
}], "Text",
 CellChangeTimes->{{3.96554808251952*^9, 3.965548139751362*^9}, {
  3.965548304351911*^9, 3.965548356696171*^9}, {3.9657208352970667`*^9, 
  3.965720856161046*^9}},ExpressionUUID->"52f41e00-28a6-4690-8994-\
3ecef3106bef"],

Cell[TextData[{
 "That was over seven times longer, and a lot of allocations.  There doesn\
\[CloseCurlyQuote]t seem to be an easy way of getting ",
 StyleBox["Julia",
  FontSlant->"Italic"],
 " to pre-allocate sets, so I\[CloseCurlyQuote]m abandoning this approach."
}], "Text",
 CellChangeTimes->{{3.965548220039611*^9, 3.9655482366239443`*^9}, {
  3.965548699160625*^9, 3.965548711016263*^9}, {3.965720861193055*^9, 
  3.965720994042199*^9}, {3.965722062769721*^9, 3.96572206340956*^9}, {
  3.9683060624362698`*^9, 3.968306101960864*^9}, {3.968307949772018*^9, 
  3.9683080018765078`*^9}, {3.968308081142193*^9, 3.9683081795822573`*^9}, {
  3.968308212999055*^9, 3.968308213662961*^9}, {3.968318165096734*^9, 
