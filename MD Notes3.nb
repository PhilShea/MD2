   3.9497600453891573`*^9, 3.964688718262432*^9, 3.9651166165136023`*^9, 
   3.965123771416307*^9, 3.965722616745068*^9, 3.965900167973333*^9, 
   3.966670561195486*^9, 3.966843677950366*^9, 3.967631670481249*^9, 
   3.967634042785376*^9, 3.967637005998695*^9, 3.967966824739192*^9, 
   3.96875434367658*^9},
 CellLabel->
  "Out[301]=",ExpressionUUID->"283e0d21-a016-43cc-a3c0-955489b3d66c"]
}, Open  ]],

