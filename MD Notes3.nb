 RowBox[{"step", "=", 
  RowBox[{"N", "[", 
   RowBox[{"12", 
    RowBox[{
     RowBox[{"rn", "[", 
      RowBox[{
       RowBox[{"7", "/", "2"}], ",", "5"}], "]"}], "/", "2"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9429446640127516`*^9, 3.942944748253991*^9}, {
