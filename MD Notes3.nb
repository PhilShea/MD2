Cell[TextData[{
 "That is the probability that one particle is outside the envelope,  The \
probability that no particles are outside the envelope is 1 - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "e"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "85de4162-7214-4910-96b2-58faee8cecd8"],
 ".  While that will be a number very close to one, we need to raise it to \
the power of a billion. We can approximate this using Taylor series, such \
that  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Log", "[", 
     RowBox[{"1", "-", "x"}], "]"}], "\[TildeTilde]", 
    RowBox[{"-", "x"}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "f561f39a-dbcc-49ce-8c5a-b3c6871c6cdf"],
 " for small ",
 StyleBox["x",
  FontSlant->"Italic"],
 ". Multiplying that by the power gives us the logarithm of the probability \
that the event will not happen to any particle in the 4M steps."
}], "Text",
 CellChangeTimes->{{3.9688237048130817`*^9, 3.9688239412544117`*^9}, {
  3.968824461155881*^9, 3.968824499188332*^9}, {3.968824843866479*^9, 
  3.9688249113125887`*^9}, {3.968824943081048*^9, 
  3.9688250362738123`*^9}},ExpressionUUID->"d711248c-a36e-48b4-9995-\
c46948ee2f4f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"256", "*", "4000000", "*", "%"}]], "Input",
 CellChangeTimes->{{3.968823400018299*^9, 3.9688234194723997`*^9}},
 CellLabel->
  "In[373]:=",ExpressionUUID->"0efd4e65-682e-4b3e-b767-4d0d56b13b4b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3.405004077331154`*^-86", ",", "2.4162957216253497`*^-22"}], 
  "}"}]], "Output",
