Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Beta]e2", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"\[Beta]e", "//.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["x", "i"], "\[Rule]", " ", "i"}], ",", 
       RowBox[{"Sx", "\[Rule]", 
        SqrtBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["n", "2"], "-", "1"}], ")"}], "/", "12"}]]}], ",", 
       RowBox[{
        OverscriptBox["x", "_"], "\[Rule]", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", "+", "1"}], ")"}], "/", "2"}]}], ",", " ", 
       RowBox[{
        OverscriptBox["y", "_"], "\[Rule]", " ", 
        RowBox[{
         FractionBox["1", "n"], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "1"}], "n"], 
          SubscriptBox["y", "i"]}]}]}]}], "}"}]}], ",", 
    RowBox[{"Assumptions", "\[Rule]", " ", 
     RowBox[{"n", ">", "3"}]}]}], "]"}]}]], "Input",
