Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"i", "=", "1"}], "n"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"i", "-", 
      FractionBox[
       RowBox[{"n", "+", "1"}], "2"]}], ")"}], "2"]}], " ", "]"}]], "Input",
