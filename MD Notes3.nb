  3.9446592659943943`*^9, 3.945685676124337*^9, 3.9456922044742527`*^9, 
  3.949746102863555*^9, 3.949760042737464*^9, 3.96468871580822*^9, 
  3.9651166139876947`*^9, 3.9651237688243303`*^9, 3.9657226142325077`*^9, 
