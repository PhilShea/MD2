Cell["\<\
We can also find a formula for the inverse curve.  The very large \
coefficients mean it is a poor formula.\
\>", "Text",
 CellChangeTimes->{{3.967274479859564*^9, 
  3.9672745295233307`*^9}},ExpressionUUID->"d1e8416a-9e4a-4da5-b288-\
4b4676862174"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"invfit", "=", 
  RowBox[{"FindFormula", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"P256", "[", 
         RowBox[{"x", ",", "0"}], "]"}], ",", "x"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "0.55", ",", "0.001"}], "}"}]}], "]"}], 
    ",", "x"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.967197082017448*^9, 3.967197089482099*^9}, {
  3.967197170085269*^9, 3.967197171675952*^9}},
