Cell["See Fukshansky 2011", "Text",
 CellChangeTimes->{{3.9274493102782993`*^9, 
  3.927449321926408*^9}},ExpressionUUID->"53da6fab-c150-4242-aa9f-\
cd57ae4892d4"],

Cell[TextData[{
 "The hypotenuse (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "1"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "52b13ac3-8138-483c-aab9-6b120499050f"],
 " - ",
 StyleBox["E",
  FontSlant->"Italic"],
 ") is given by the following:"
}], "Text",
 CellChangeTimes->{{3.9275354356981916`*^9, 3.9275354513786354`*^9}, {
  3.927535497954034*^9, 
  3.927535547068039*^9}},ExpressionUUID->"6e56d301-4863-4d28-a261-\
c03ebc0a0c74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "/", "2"}], " ", "\[Equal]", 
    RowBox[{"r", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"30", " ", "Degree"}], "]"}]}]}], ",", "r"}], "]"}]], "Input",
 CellChangeTimes->{{3.9274493008919983`*^9, 3.9274493057102776`*^9}, {
  3.9274501305511713`*^9, 3.9274501549376*^9}, {3.9274501872030315`*^9, 
  3.927450234264818*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"e110982e-81e8-4d43-96c5-1b1e19e4f193"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"r", "\[Rule]", 
    FractionBox["a", 
     SqrtBox["3"]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.92745086649584*^9, 3.94274453151956*^9, 
  3.942754190997468*^9, 3.9430945970124454`*^9, 3.9431127435145106`*^9, 
  3.9433425708268356`*^9, 3.943426111581113*^9, 3.944659263012598*^9, 
  3.9456856736799784`*^9, 3.9456922032485504`*^9, 3.94974610222913*^9, 
  3.949760041574608*^9, 3.964688714957127*^9, 3.965116604105115*^9, 
  3.965123758707728*^9, 3.965722604735777*^9, 3.9659001550879602`*^9, 
  3.966670543560575*^9, 3.9668436645711813`*^9, 3.967631638885322*^9, 
  3.967634017401123*^9, 3.9676369784728813`*^9, 3.967966795553463*^9, 
  3.96875431491779*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"cc59fa60-c206-4716-81eb-b33aaacd179b"]
}, Open  ]],

Cell["The short side is therefore", "Text",
 CellChangeTimes->{{3.927535565012191*^9, 
  3.9275355790187607`*^9}},ExpressionUUID->"d35ceeee-d24f-404e-89ed-\
27839f3bfc85"],

