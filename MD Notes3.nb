 CellChangeTimes->{{3.968760629431305*^9, 
  3.968760647895351*^9}},ExpressionUUID->"6745e66f-63a9-46ba-91ad-\
af3738272291"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Mean", "[", "ngt1", "]"}], ",", 
   RowBox[{"Variance", "[", "ngt1", "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.942955236706627*^9, 3.9429552536951046`*^9}},
