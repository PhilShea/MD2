}, Open  ]],

Cell["\<\
Of course, this is an upper limit, as it would have to sustain that velocity \
for 50 steps (breaking the independence criterion).\
\>", "Text",
 CellChangeTimes->{{3.968825750298123*^9, 3.9688258007405453`*^9}, {
  3.968825832550795*^9, 
  3.968825834550763*^9}},ExpressionUUID->"334b8d49-bdea-4cc4-8b81-\
cc2e49ac85eb"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Initialization", "Section",
 CellChangeTimes->{{3.9429547353590975`*^9, 
  3.9429547400625267`*^9}},ExpressionUUID->"21e6c9f2-69cb-465b-8fff-\
9e0f9bedbc88"],

Cell[TextData[{
 "For the following, see Reif, pg. 249, eq. 7.5.7. The mean kinetic energy of \
a particle in any dimension is (1/2)",
 StyleBox["kT",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["k",
  FontSlant->"Italic"],
 " is in units of temperature per unit of energy, and ",
 StyleBox["T",
  FontSlant->"Italic"],
 " is the temperature in units defined by ",
 StyleBox["k",
  FontSlant->"Italic"],
 ". The energy of a particle of mass ",
 StyleBox["m",
  FontSlant->"Italic"],
 " = 1 is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["v", "2"], "/", "2"}], TraditionalForm]],ExpressionUUID->
  "f12a21eb-aaf0-4003-8888-947b9a655b44"],
 " which can be broken into x and y components (\[LeftAngleBracket]E\
\[RightAngleBracket] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      SubsuperscriptBox["v", "x", "2"]}], "+", 
     RowBox[{
      FractionBox["1", "2"], 
      SubsuperscriptBox["v", "y", "2"]}]}], "\[RightAngleBracket]"}], 
   TraditionalForm]],ExpressionUUID->"ad5d3023-8e39-4f5a-889b-dd5081ca6fb3"],
 " = ",
 StyleBox["kT",
  FontSlant->"Italic"],
 " ), so that defining ",
 StyleBox["k",
  FontSlant->"Italic"],
 " = 1, each component has an expected velocity squared of ",
 StyleBox["T",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.94295475659188*^9, 3.942954832840407*^9}, {
   3.9429549048866634`*^9, 3.942955016399521*^9}, 3.9429550511669893`*^9, {
   3.9456873571129603`*^9, 3.9456873626653395`*^9}, 3.9519296630145273`*^9, {
   3.9687586357761297`*^9, 3.968758644415243*^9}, {3.9687603542785482`*^9, 
   3.96876035467059*^9}, {3.968763396550251*^9, 
   3.968763435980385*^9}},ExpressionUUID->"efc1b200-f557-41d5-90d9-\
aa34350a12d1"],

Cell[TextData[{
 "If we have ",
 StyleBox["n",
  FontSlant->"Italic"],
 " particles, the total energy will have a gamma distribution with \[Alpha]=",
 StyleBox["n",
  FontSlant->"Italic"],
 ", and \[Beta]=",
 StyleBox["T. ",
  FontSlant->"Italic"],
 "Unfortunately, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " cannot figure that out."
}], "Text",
 CellChangeTimes->{{3.968756822316925*^9, 3.968756834525214*^9}, {
   3.968756893637871*^9, 3.9687569353262787`*^9}, {3.968758578102151*^9, 
   3.968758604422173*^9}, {3.9687599054817953`*^9, 3.968759931378793*^9}, 
   3.968760440614739*^9},ExpressionUUID->"6f636410-3393-45ac-9301-\
d32d53284398"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransformedDistribution", "[", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"x1", "^", "2"}], "+", 
    RowBox[{"x2", "^", "2"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x1", ",", " ", "x2"}], "}"}], "\[Distributed]", 
    RowBox[{"NormalDistribution", "[", 
     RowBox[{"0", ",", 
      SuperscriptBox["T", "2"]}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9687586779124393`*^9, 3.9687587568001204`*^9}, {
  3.9687598891713543`*^9, 3.9687598996744823`*^9}, {3.9687609040182133`*^9, 
  3.968760908537071*^9}},
 CellLabel->
  "In[337]:=",ExpressionUUID->"0ae2442c-76cd-4bff-912e-0970ccd37588"],

Cell[BoxData[
 RowBox[{"TransformedDistribution", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["\[FormalX]1", "2"], "+", 
    SuperscriptBox["\[FormalX]2", "2"]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[FormalX]1", ",", "\[FormalX]2"}], "}"}], "\[Distributed]", 
    RowBox[{"NormalDistribution", "[", 
     RowBox[{"0", ",", 
      SuperscriptBox["T", "2"]}], "]"}]}]}], "]"}]], "Output",
 CellChangeTimes->{3.968758757094655*^9, 3.968759901401258*^9, 
  3.968760910037561*^9},
 CellLabel->
  "Out[337]=",ExpressionUUID->"9c876381-fa39-4ca3-b05b-3b75119310cd"]
}, Open  ]],

Cell[TextData[{
 "Nevertheless, we can create one for our purposes. The mean is ",
 StyleBox["nT",
  FontSlant->"Italic"],
 ", variance ",
 StyleBox["n",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "7b04521d-755c-42d9-92d5-3c82b93d6ab5"]
}], "Text",
 CellChangeTimes->{{3.968760146148532*^9, 3.96876017942892*^9}, {
  3.9687605174704514`*^9, 
  3.968760541687446*^9}},ExpressionUUID->"fb4411bd-42ce-4b1b-8ba5-\
236444158620"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ngt", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ngt", "[", 
    RowBox[{"n_", ",", "T_"}], "]"}], "=", 
   RowBox[{"GammaDistribution", "[", 
    RowBox[{"n", ",", "T"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Mean", "[", 
    RowBox[{"ngt", "[", 
     RowBox[{"n", ",", "T"}], "]"}], "]"}], ",", 
   RowBox[{"Variance", "[", 
    RowBox[{"ngt", "[", 
     RowBox[{"n", ",", "T"}], "]"}], "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.9429550533417025`*^9, 3.942955184833103*^9}, {
  3.9687604453188753`*^9, 3.968760446486631*^9}},
 CellLabel->
  "In[328]:=",ExpressionUUID->"f3734364-e7c8-4f93-8305-abd1cea08f90"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"n", " ", "T"}], ",", 
   RowBox[{"n", " ", 
    SuperscriptBox["T", "2"]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.942955174245143*^9, 3.9429551855088177`*^9}, 
   3.9430945991323986`*^9, 3.9431127443682256`*^9, 3.9433425819644966`*^9, 
   3.9434261133801603`*^9, 3.94465926592655*^9, 3.9456856759542985`*^9, 
   3.9456922044104238`*^9, 3.949746102830349*^9, 3.9497600426781263`*^9, 
   3.964688715771059*^9, 3.965116613946187*^9, 3.965123768790237*^9, 
   3.9657226141916227`*^9, 3.9659001652821083`*^9, 3.966670558793009*^9, 
   3.966843675326511*^9, 3.967631654183599*^9, 3.9676340269956503`*^9, 
   3.967636988751156*^9, 3.967966808245968*^9, 3.9687543257618027`*^9, 
   3.9687604474835653`*^9},
 CellLabel->
  "Out[330]=",ExpressionUUID->"094be65f-bf63-4730-80f3-551128376471"]
}, Open  ]],

Cell["There are some big exponents in the distribution.", "Text",
 CellChangeTimes->{{3.968760565494542*^9, 
  3.968760583758833*^9}},ExpressionUUID->"92452f51-9524-40c9-901a-\
dce4a96b85c2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ngt1", "=", 
   RowBox[{"ngt", "[", 
    RowBox[{"256", ",", "0.015"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ngtpdf1", "=", 
  RowBox[{"PDF", "[", 
   RowBox[{"ngt1", ",", "x"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9429551941778126`*^9, 3.9429552297199802`*^9}},
