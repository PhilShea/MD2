}, Open  ]],

Cell["We can combine the two sums in the numerator:", "Text",
 CellChangeTimes->{{3.9428311055138817`*^9, 3.942831120478923*^9}, 
   3.9428312584305096`*^9, {3.9433429113914075`*^9, 
   3.94334291406263*^9}},ExpressionUUID->"7b491b81-af46-42a5-865c-\
d758cc41dc5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Beta]e3", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"12", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], "n"], 
       RowBox[{
        SubscriptBox["y", "i"], 
        RowBox[{"(", 
         RowBox[{"i", "-", 
          FractionBox[
           RowBox[{"n", "+", "1"}], "2"]}], ")"}]}]}]}], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "n"}], ")"}]}]], ",", 
    RowBox[{"Assumptions", "\[Rule]", " ", 
     RowBox[{"n", ">", "3"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.942831265004998*^9, 3.9428313439728994`*^9}, 
   3.9428318432704897`*^9, {3.9430947365488358`*^9, 3.9430947436194143`*^9}, 
   3.943350024193986*^9, {3.9433506330347567`*^9, 3.9433507567239885`*^9}},
 CellLabel->
  "In[298]:=",ExpressionUUID->"935747bb-a27e-43a3-ac7a-012429ead1db"],

Cell[BoxData[
 FractionBox[
  RowBox[{"12", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "n"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"i", "+", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "-", "n"}], ")"}]}]}], ")"}], " ", 
     SubscriptBox["y", "i"]}]}]}], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "n"}], ")"}]}]]], "Output",
 CellChangeTimes->{
  3.9428314611416883`*^9, 3.9430946035902295`*^9, 3.9430947495082545`*^9, 
   3.943112746817005*^9, 3.943342595873417*^9, {3.9433507342605915`*^9, 
   3.9433507626610074`*^9}, 3.9434261171234207`*^9, 3.944659271171401*^9, 
   3.9456856803246593`*^9, 3.945692207229046*^9, 3.949746105312785*^9, 
   3.9497600453165483`*^9, 3.964688718207539*^9, 3.9651166164482517`*^9, 
   3.965123771341692*^9, 3.9657226166794357`*^9, 3.9659001679024*^9, 
   3.9666705611537037`*^9, 3.966843677898753*^9, 3.967631670393344*^9, 
   3.9676340427311153`*^9, 3.967637005925592*^9, 3.967966824680388*^9, 
   3.968754343589361*^9},
 CellLabel->
  "Out[298]=",ExpressionUUID->"0dba0d3e-e828-43d3-b5a7-32e250ca52f9"]
}, Open  ]],

Cell[TextData[{
 "The coefficients of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "940924bf-6d8e-443e-9872-b1a8649da773"],
 " will sum to be the multiplier of the mean of ",
 StyleBox["y",
  FontSlant->"Italic"],
 " (which is the average temperature), sums to zero (so the slope doesn\
\[CloseCurlyQuote]t depend on the average temperature)."
}], "Text",
 CellChangeTimes->{{3.9430947712265406`*^9, 3.9430949120396595`*^9}, {
  3.9433551105786347`*^9, 3.9433551248833857`*^9}, {3.967279932531254*^9, 
