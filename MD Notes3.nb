Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Rho]1", " ", 
       RowBox[{"T1", "^", 
        RowBox[{"(", 
         RowBox[{"2", "/", "n"}], ")"}]}]}], "==", 
      RowBox[{"\[Rho]2", " ", 
       RowBox[{"T2", "^", 
        RowBox[{"(", 
         RowBox[{"2", "/", "n"}], ")"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"P1", "/", 
       RowBox[{"(", 
        RowBox[{"\[Rho]1", " ", "T1"}], ")"}]}], "\[Equal]", 
      RowBox[{"P2", "/", 
       RowBox[{"(", 
        RowBox[{"\[Rho]2", " ", "T2"}], ")"}]}]}], ",", 
     RowBox[{"n", "\[GreaterEqual]", "1"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Rho]2", ",", " ", "T2"}], "}"}], ",", " ", "Reals"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.961687773315338*^9, 3.961687775035368*^9}, {
  3.9616879567846947`*^9, 3.961687963983981*^9}, {3.961688209655588*^9, 
