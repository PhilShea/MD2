  FormBox[
   SuperscriptBox["n", 
    RowBox[{"-", "3"}]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "3495ccab-e6ce-4b27-949a-d2c4ff3dd3b1"],
