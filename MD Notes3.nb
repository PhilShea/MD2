Cell[TextData[{
 "Where is the point half-way between the nearest neighbors and next nearest \
neighbors? The next\nnearest neighbor to a point at {0, 0} is at {3 ",
 StyleBox["a",
  FontSlant->"Italic"],
 " /2, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], 
    RowBox[{"a", "/", "2"}]}], TraditionalForm]],ExpressionUUID->
  "cc3c937e-ae3e-498c-ad79-9ce7669aee3b"],
 "}, a distance of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], "a"}], TraditionalForm]],ExpressionUUID->
  "712d8212-f7d4-4679-9619-361ef68603ad"],
 " from {0,0}. The half-way distance between the nearest neighbors at ",
 StyleBox["a",
  FontSlant->"Italic"],
 " and the next nearest neighbors at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], "a"}], TraditionalForm]],ExpressionUUID->
  "60c50072-82f7-45e4-8b73-b2bf3e193e2a"],
 " is (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], "-", "1"}], TraditionalForm]],ExpressionUUID->
  "895ed8a3-3fde-4b38-81fd-c8123e7077af"],
 ")",
 StyleBox["a,",
  FontSlant->"Italic"],
 " and adding half that distance to ",
 StyleBox["a",
  FontSlant->"Italic"],
 " yields (1+ ",
 Cell[BoxData[
  FormBox[
   SqrtBox["3"], TraditionalForm]],ExpressionUUID->
  "92b8cb3d-0dd3-4e23-98d5-bafef1cc6ae2"],
 " )",
 StyleBox["a",
  FontSlant->"Italic"],
 "/2."
}], "Text",
 CellChangeTimes->{{3.9497512599557877`*^9, 3.949751300639637*^9}, {
  3.949751332759759*^9, 3.949751467024612*^9}, {3.9497515405076523`*^9, 
  3.9497515405084963`*^9}, {3.949759893191924*^9, 
  3.949759999232657*^9}},ExpressionUUID->"a6254195-aaf1-4f5a-87e0-\
7152eaa1a85f"],

