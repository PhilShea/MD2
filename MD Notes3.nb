Cell[TextData[{
 "So here is the first challenge with the technique.  We may not have found \
the correct limits as many elements are repeated due to particles being in \
home position.  We need to search from there and find the correct starting \
point. Again, we\[CloseCurlyQuote]ll wait until we implement in ",
 StyleBox["Julia",
  FontSlant->"Italic"],
 " for this fiddly code, and we\[CloseCurlyQuote]ll simply dither the \
positions a bit."
}], "Text",
 CellChangeTimes->{{3.9647802238509607`*^9, 3.9647802720916348`*^9}, {
  3.964788853424304*^9, 3.964788856207951*^9}, {3.9647890082178307`*^9, 
  3.964789128540326*^9}},ExpressionUUID->"155cc8ac-7826-4909-81e2-\
7cf3f2dfaeae"],

