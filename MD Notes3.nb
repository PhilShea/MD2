498cf9f1d8b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"F2", "=", 
  FractionBox[
   RowBox[{
    SubscriptBox["\[Nu]", "2"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{"(", 
      RowBox[{"Expand", "[", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["y", "i"], "-", 
            OverscriptBox["y", "_"]}], ")"}], "2"], "-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["y", "i"], "-", 
            SubscriptBox[
             OverscriptBox["y", "^"], "i"]}], ")"}], "2"]}], "]"}], "]"}], 
      ")"}]}]}], 
   RowBox[{
    SubscriptBox["\[Nu]", "1"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["y", "i"], "-", 
        SubscriptBox[
         OverscriptBox["y", "^"], "i"]}], ")"}], "2"]}]}]]}]], "Input",
 CellChangeTimes->{{3.9435341417067204`*^9, 3.9435343101235127`*^9}, {
