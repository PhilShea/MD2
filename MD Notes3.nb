  3.9687549048428097`*^9}},ExpressionUUID->"c43990e6-f605-435e-83dc-\
59c962e6349c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Second Attempt", "Subsubsection",
 CellChangeTimes->{{3.968755460175577*^9, 
  3.968755464023538*^9}},ExpressionUUID->"f31f24bf-25a3-46bf-8e03-\
b3b83c2b5b1c"],

Cell[BoxData[
 StyleBox[
  RowBox[{
  "The", " ", "next", " ", "approach", " ", "will", " ", "be", " ", "to", " ",
    "divide", " ", "the", " ", "field", " ", "into", " ", "overlapping", " ", 
   "boxes", " ", "of", " ", "sides", 
   FormBox[
    SubscriptBox["R", "shell"],
    TraditionalForm], "and", " ", "spaced", " ", "by", 
   RowBox[{
    FormBox[
     SubscriptBox["R", "shell"],
     TraditionalForm], ".", " ", "We"}], " ", 
   StyleBox[
    RowBox[{"w", "ill"}]], " ", "want", " ", "at", " ", "least", " ", "three",
    " ", "boxes", " ", "in", " ", "each", " ", "dimension", " ", "so", 
   FormBox[
    SubscriptBox["b", "x"],
    TraditionalForm], "and", 
   FormBox[
    SubscriptBox["b", "y"],
    TraditionalForm], "must", " ", "both", " ", "be", " ", "greater", " ", 
   "than", 
   FormBox[
    RowBox[{
     SubscriptBox["R", "shell"], "/", "2"}],
    TraditionalForm], "and", " ", "the", " ", "box", " ", "sides", " ", 
   "must", " ", "be", " ", "greater", " ", "than", 
   RowBox[{
    FormBox[
     SubscriptBox["R", "shell"],
     TraditionalForm], ".", 
    StyleBox[
     RowBox[{" ", " "}]], "Thus"}], " ", "the", " ", "boxes", " ", "will", 
   " ", "extend", " ", "beyond", " ", "the", " ", 
   RowBox[{"field", ".", " ", "The"}], " ", "minimum", " ", "number", " ", 
   "of", " ", "boxes", " ", "in", " ", "each", " ", "direction", " ", "can", 
   " ", "be", " ", "found", " ", "by", " ", "solving", " ", "the", " ", 
   RowBox[{"following", ":"}]}],
  FontFamily->"Utopia"]], "Text",
 CellChangeTimes->{{3.9687549199962273`*^9, 3.968754968275249*^9}, {
  3.9687551105886183`*^9, 3.968755253445962*^9}, {3.968755337254871*^9, 
  3.96875542739163*^9}},ExpressionUUID->"83c3b3b7-f606-4c8f-ac38-\
3851c6ebf630"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Rs", ">", "0"}], "&&", " ", 
    RowBox[{"l", "\[GreaterEqual]", "Rs"}], "&&", 
    RowBox[{
     RowBox[{"2", "b"}], ">", "Rs"}], "&&", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "n"}], "+", "1"}], ")"}], " ", "l"}], "\[Equal]", 
     RowBox[{"2", "b"}]}], " ", "&&", 
    RowBox[{"n", "\[GreaterEqual]", "3"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", "l"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968306109032899*^9, 3.968306154353451*^9}, {
