Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Map", "[", 
   RowBox[{"Norm", ",", 
    RowBox[{"N", "[", "pnts256arr", "]"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.942954588414214*^9, 3.942954633847855*^9}, 
   3.9646904544416733`*^9},
 CellLabel->"In[88]:=",ExpressionUUID->"ccc47457-1594-47af-bc91-545f2856c3e1"],

