  3.967636978546159*^9, 3.9679667956721067`*^9, 3.968754315004879*^9},
 CellLabel->"Out[34]=",ExpressionUUID->"911c3d1a-362a-4f44-afe8-ecb11cb197b4"]
}, Open  ]],

