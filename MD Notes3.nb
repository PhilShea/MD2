Cell["\<\
This next expression will map them through FindRoot[] to the xTx2[] input \
which would have caused them.\
\>", "Text",
 CellChangeTimes->{{3.967274565922686*^9, 3.967274596098669*^9}, {
  3.967639892018116*^9, 
  3.967639897298092*^9}},ExpressionUUID->"f7087853-7795-4b34-b9cd-\
81c4ddfd0210"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "/.", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"xTx2", "[", "x", "]"}], "\[Equal]", "#"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0.3"}], "}"}]}], "]"}]}], "&"}], " ", ",", 
     "e256"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"r", "\[LeftDoubleBracket]", 
  RowBox[{"1", ";;", "10"}], "\[RightDoubleBracket]"}]}], "Input",
 CellChangeTimes->{{3.967217401465478*^9, 3.967217465711732*^9}, 
