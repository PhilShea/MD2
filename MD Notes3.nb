Cell[TextData[{
 "Below is a look at the shape of a few versions of models we might use. We \
see the justification for the calling the PE field circular, as the ",
 StyleBox["Pdx",
  FontSlant->"Italic"],
 " and ",
 StyleBox["Pdy",
  FontSlant->"Italic"],
 " plots are nearly identical of the range of interest.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["r", 
     RowBox[{"-", "2"}]], "/", "4"}], TraditionalForm]],ExpressionUUID->
  "3feedfbb-17f7-4e7c-9679-7b8f9addc8a9"],
 " does not fit very well, and the function which is the potential between \
two particles spaced a 2",
 StyleBox["a",
  FontSlant->"Italic"],
 " (rn2[], defined below) appears slightly slow.  We will now plot only the \
excess energy."
}], "Text",
 CellChangeTimes->{{3.967102950563459*^9, 3.967102993564228*^9}, {
  3.967103048484445*^9, 3.96710314714123*^9}, {3.967103185245783*^9, 
  3.967103191717433*^9}, {3.9671058782134*^9, 3.967105879829874*^9}, {
  3.96721799666991*^9, 3.967218010854259*^9}, {3.967787523017805*^9, 
  3.967787525026298*^9}, {3.967787671399979*^9, 
  3.9677877812708817`*^9}},ExpressionUUID->"6af5eafe-d5a1-4631-87d6-\
30d0826828c1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rn2", "[", 
   RowBox[{"x_", ",", "a_", ",", "n_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"rn", "[", 
      RowBox[{
       RowBox[{"a", "-", "x"}], ",", "n"}], "]"}], "-", 
     RowBox[{"2", 
      RowBox[{"rn", "[", 
       RowBox[{"a", ",", "n"}], "]"}]}], "+", 
     RowBox[{"rn", "[", 
      RowBox[{
       RowBox[{"a", "+", "x"}], ",", "n"}], "]"}]}], ")"}], "/", 
   "2"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rna79", "=", 
   RowBox[{"rn", "[", 
    RowBox[{"a79", ",", "5"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"pz2", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"rn2", "[", 
       RowBox[{"x", ",", "a79", ",", "5"}], "]"}], ",", 
      RowBox[{
       RowBox[{"P256", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "-", "pe12o"}], ",", 
      RowBox[{
       RowBox[{"P256", "[", 
        RowBox[{"0", ",", "x"}], "]"}], "-", "pe12o"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"a79", "-", "x"}], ")"}], 
          RowBox[{"-", "2"}]], "-", 
         SuperscriptBox["a79", 
          RowBox[{"-", "2"}]]}], ")"}], "/", "4"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "0", ",", "0.8"}], "}"}], ",", 
    RowBox[{"PlotLegends", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
      "\"\<rn2\>\"", ",", "\"\<Pdx\>\"", ",", "\"\<Pdy\>\"", ",", 
       "\"\<\!\(\*SuperscriptBox[\(r\), \(2\)]\)\>\""}], "}"}]}], ",", 
    RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
