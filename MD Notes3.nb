          RowBox[{"P2", ">", "0"}], "&&", 
          RowBox[{"T1", ">", "0"}]}], ")"}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"P1", "<", "0"}], "&&", 
          RowBox[{"P2", "<", "0"}], "&&", 
          RowBox[{"T1", ">", "0"}]}], ")"}]}]}], "]"}]}]}], "}"}], 
  "}"}]], "Output",
