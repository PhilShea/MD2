Cell[CellGroupData[{

Cell["Problems with Large Number of Particles", "Subsection",
 CellChangeTimes->{{3.9645335943928223`*^9, 3.964533605361627*^9}, {
  3.9646918141630497`*^9, 
  3.9646918152990007`*^9}},ExpressionUUID->"a303a4f5-64c8-458a-9295-\
9a392ed5eefe"],

Cell["\<\
While 256 particles was relatively straight forward, there are some issues as \
we try to scale to one million particles.\
\>", "Text",
 CellChangeTimes->{{3.964533612409856*^9, 3.964533616161193*^9}, {
  3.9645336548580647`*^9, 
  3.9645336947374*^9}},ExpressionUUID->"055db021-8cd9-4426-bf7b-d9dfa470ad6c"],

Cell[CellGroupData[{

Cell["Correlation Array Length", "Subsubsection",
 CellChangeTimes->{{3.964533705600971*^9, 
  3.9645337146656647`*^9}},ExpressionUUID->"d4793fa1-8a7f-4e21-b374-\
3e669e4212ce"],

Cell[TextData[{
 "The correlation array records all inter-particle interactions once each.  \
That is, if particle one interacts with particle two but not particle three, \
and particle two interacts with one and three, particle \
two\[CloseCurlyQuote]s list only includes particle three.  Interactions are \
limited by the the shell radius ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "shell"], TraditionalForm]],ExpressionUUID->
  "05b192e1-7480-40a5-8111-90d7fac28ad2"],
 ".  Since the overall density is fixed, the average number of interactions \
per particle is simply ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", " ", "\[Rho]", " ", 
    SuperscriptBox[
     SubscriptBox["R", "shell"], "2"]}], TraditionalForm]],ExpressionUUID->
  "1611e9e2-9b3f-4909-8f83-665262c8b96e"],
 ", where \[Rho] is the density. For the 1980 system, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "shell"], TraditionalForm]],ExpressionUUID->
  "57f963b9-54f1-4394-acb8-222449d37a84"],
 "=5 and \[Rho]=1/\[Pi], so this number is simply 25.  With 256 particles, \
and each interaction only counting once, there should be no more than 255 \
\[CenterDot] 25 / 2 = 3,187.5.  In fact, in 17,472 executions (of varying \
number of steps up to 50,000), the maximum we have observed is 3,115.  This \
was determined through the steps below."
}], "Text",
 CellChangeTimes->{{3.9645930384373493`*^9, 3.9645933471775513`*^9}, {
   3.964593377593397*^9, 3.964593408080982*^9}, {3.964598043014537*^9, 
   3.9645980964224367`*^9}, {3.964598132175323*^9, 3.964598358034513*^9}, 
   3.9646884284155893`*^9},ExpressionUUID->"91c05b54-3a9b-47b9-9ee1-\
d337c294ee11"],

Cell[BoxData[{
 RowBox[{"home", ":", 
  RowBox[{"$", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"cd", " ", "~"}], "/", "MD"}], "/", "Data"}], "/", 
    "1980"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"~", 
      RowBox[{"/", "MD"}]}], "/", "Data"}], "/", "1980"}], "$", " ", "grep", 
   " ", "\"\<Max number of interactions:\>\"", " ", "*", 
   RowBox[{".", "txt"}]}], " ", ">", " ", 
  RowBox[{"MNI", ".", "txt"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"~", 
     RowBox[{"/", "MD"}]}], "/", "Data"}], "/", "1980"}], "$", " ", "R", " ", 
  "#", " ", "Start", " ", "R"}], "\n", 
 RowBox[{"R", " ", "version", " ", "4.5", ".1", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"2025", "-", "06", "-", "13"}], ")"}], " ", "--"}], " ", 
  "\"\<Great Square Root\>\""}], "\n", 
 RowBox[{"Copyright", " ", 
  RowBox[{"(", "C", ")"}], " ", "2025", " ", "The", " ", "R", " ", 
  "Foundation", " ", "for", " ", "Statistical", " ", "Computing"}], "\n", 
 RowBox[{
  RowBox[{"Platform", ":", " ", 
   RowBox[{
    RowBox[{"x86_", "64"}], "-", "pc", "-", "linux", "-", "gnu"}]}], 
  "\n"}], "\n", 
 RowBox[{">", " ", "td", " ", "<", 
  RowBox[{
  "-", " ", 
   "\"\</media/phil/Original/Users/phils/Documents/DSP/MD/Data/1980\>\""}]}], \
"\n", 
 RowBox[{">", " ", "x", " ", "<", 
  RowBox[{
   RowBox[{"-", " ", 
    RowBox[{"read", ".", "delim"}]}], 
   RowBox[{"(", " ", 
    RowBox[{
     RowBox[{"paste", 
      RowBox[{"(", " ", 
       RowBox[{"td", ",", " ", "\"\<MNI.txt\>\"", ",", " ", 
        RowBox[{"sep", " ", "=", " ", "\"\</\>\""}]}], ")"}]}], ",", " ", 
     "\"\<:\>\"", ",", " ", 
     RowBox[{"header", "=", "FALSE"}]}], ")"}]}]}], "\n", 
 RowBox[{">", " ", 
  RowBox[{"max", 
   RowBox[{"(", "x$V3", ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{"[", "1", "]"}], " ", "3115"}]}], "Code",
 Evaluatable->False,
 CellChangeTimes->{{3.9645983910027637`*^9, 3.964598435914662*^9}, {
  3.964598469654701*^9, 3.964598541259985*^9}, {3.964615985014884*^9, 
  3.9646160211674423`*^9}, {3.964616052167863*^9, 3.964616059535825*^9}},
 EmphasizeSyntaxErrors->True,
 CellLabel->
  "In[197]:=",ExpressionUUID->"65d4e0ce-13f6-4b45-a707-2021624ab3d2"],

Cell[TextData[{
 "The current minimum the program allows (as of August 2025) is double this: ",
 StyleBox["N ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", " ", "\[Rho]", " ", 
    SuperscriptBox[
     SubscriptBox["R", "shell"], "2"]}], TraditionalForm]],ExpressionUUID->
  "91ef5395-6ce8-4602-9268-682d040b5483"],
 ", where N is the number of particles (6,400) in the current system), and \
the executions have been using 9,728 (",
 StyleBox["N * round(1.5 * pi * density *Rshell^2)", "CodeText"],
 ").  So, as we get to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "20"], TraditionalForm]],ExpressionUUID->
  "d8ab1bbe-aad6-4853-8685-2213b6f0453d"],
 " (one million) particles, we need to have a tighter bound, and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", " ", "\[Pi]", " ", "\[Rho]", " ", 
    SuperscriptBox[
     SubscriptBox["R", "shell"], "2"]}], TraditionalForm]],ExpressionUUID->
  "f18b91d7-04a4-43c7-b84a-9e1aaf48f277"],
 "/2 would occupy about 105MB of memory (assuming 4 bytes per integer), \
large, but doable. A 10% margin should be added as we \
wouldn\[CloseCurlyQuote]t want a calculation to fail after hours of work just \
because this limit was too tight."
}], "Text",
 CellChangeTimes->{{3.964598674837111*^9, 3.964598686029235*^9}, {
  3.9645987410857353`*^9, 3.964598752293777*^9}, {3.964598860568984*^9, 
  3.964599024832469*^9}, {3.96459921121117*^9, 3.964599232202017*^9}, {
  3.96459926345048*^9, 3.9645993023626328`*^9}, {3.964599337266642*^9, 
  3.9645993921311283`*^9}, {3.964599466771739*^9, 3.9645995916931133`*^9}, {
  3.96461613593754*^9, 
  3.964616147210353*^9}},ExpressionUUID->"e3027d6c-b5b3-428a-a366-\
38b9189e9c1f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Correlation Algorithm", "Subsubsection",
 CellChangeTimes->{{3.964616170944585*^9, 
  3.964616178480719*^9}},ExpressionUUID->"c58a49f4-3ca6-4ddc-a047-\
86e478ba2f1c"],

Cell["\<\
Currently, the simulation stops every 50 steps and calculates the distance \
between all particle pairs to create the list of those within each particle\
\[CloseCurlyQuote]s shell.  So particle one looks at the the distance to the \
other 255 particles. Particle two looks at 254, and so on.\
\>", "Text",
 CellChangeTimes->{{3.9646161842090807`*^9, 
  3.964616291450264*^9}},ExpressionUUID->"28a7c76c-d43c-4682-bab2-\
0c6af1768f23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", " ", 
  RowBox[{"Sum", "[", " ", 
   RowBox[{"i", ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "1", ",", " ", 
      RowBox[{"N", "-", "1"}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.964599449055386*^9, 3.964599455211463*^9}, {
  3.964616296658966*^9, 3.9646163256101*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"bcf0b90c-3cfc-4fd3-b453-329424a9dd5d"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "N"}], ")"}], " ", "N"}]], "Output",
 CellChangeTimes->{3.9645994599426117`*^9, 3.964616326517527*^9, 
  3.9646887157296352`*^9, 3.965116605011648*^9, 3.9651237598447227`*^9, 
  3.965722605720373*^9, 3.965900156367594*^9, 3.96667054485515*^9, 
  3.966843665888653*^9, 3.9676316398154383`*^9, 3.967634018233068*^9, 
  3.967636979413465*^9, 3.967966797013164*^9, 3.9687543159375353`*^9},
 CellLabel->"Out[90]=",ExpressionUUID->"83f109d3-9128-4762-ae23-60fbd67e714d"]
}, Open  ]],

Cell[TextData[{
 "So this dependence on (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["N", "2"], "-", "N"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "2f736765-501d-420c-b915-aa681642211c"],
 ")/2 can get big."
}], "Text",
 CellChangeTimes->{{3.96461635145855*^9, 
  3.964616415507144*^9}},ExpressionUUID->"b79f800f-e2a5-4005-89c1-\
bbfbed3ab444"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"paircnt", "[", "N_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     FormBox[
      RowBox[{
       SuperscriptBox["N", "2"], "-", "N"}],
      TraditionalForm], ")"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"i", ",", 
     SuperscriptBox["2", "i"], ",", 
     RowBox[{"paircnt", "[", 
      SuperscriptBox["2", "i"], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"i", ",", "8", ",", "20", ",", "2"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.964616404796226*^9, 3.9646164439076357`*^9}, {
  3.9646164957321978`*^9, 3.964616715983328*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"238a4351-628b-402d-a7b5-b3075c5bf17a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"8", ",", "256", ",", "32640"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "1024", ",", "523776"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"12", ",", "4096", ",", "8386560"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"14", ",", "16384", ",", "134209536"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"16", ",", "65536", ",", "2147450880"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"18", ",", "262144", ",", "34359607296"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"20", ",", "1048576", ",", "549755289600"}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.964616691985813*^9, 3.964616718080677*^9}, 
   3.964688715749576*^9, 3.9651166050365553`*^9, 3.965123759867*^9, 
   3.965722605800415*^9, 3.96590015638424*^9, 3.96667054487915*^9, 
   3.966843665914053*^9, 3.9676316398904753`*^9, 3.967634018251749*^9, 
   3.967636979435505*^9, 3.96796679704738*^9, 3.9687543160118103`*^9},
 CellLabel->"Out[92]=",ExpressionUUID->"1c8b64e6-7ca2-4614-993f-fdeaad8b8a2a"]
}, Open  ]],

Cell[TextData[{
 "We might be able to correlate 16K particles in a reasonable amount of time \
(134M correlations), but the million particle system requires over a half ",
 StyleBox["trillion",
  FontSlant->"Italic"],
 " comparisons, each of which requiring two squaring operations. There are a \
few references of faster ways (see ",
 ButtonBox["Kim2025",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://journals.plos.org/plosone/article?id=10.1371/journal.pone.\
0311163"], None},
  ButtonNote->
   "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.\
0311163"],
 ", ",
 ButtonBox["Awhile2012",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.sciencedirect.com/science/article/abs/pii/\
S0010465512000057"], None},
  ButtonNote->
   "https://www.sciencedirect.com/science/article/abs/pii/S0010465512000057"],
 ", or ",
 ButtonBox["Gro\[SZ]2019",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://diglib.eg.org/server/api/core/bitstreams/79528ffd-9609-4232-\
bb81-57819e7ae747/content"], None},
  ButtonNote->
   "https://diglib.eg.org/server/api/core/bitstreams/79528ffd-9609-4232-bb81-\
57819e7ae747/content"],
 ") that include divide and conquer, spatial hashing, and various tree based \
algorithms. ",
 ButtonBox["Gro\[SZ]2019",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://diglib.eg.org/server/api/core/bitstreams/79528ffd-9609-4232-\
bb81-57819e7ae747/content"], None},
  ButtonNote->
   "https://diglib.eg.org/server/api/core/bitstreams/79528ffd-9609-4232-bb81-\
57819e7ae747/content"],
 " appears closest to the amount of effort I\[CloseCurlyQuote]m willing to \
expend in this regard. The idea is to sort the particles by both x and y \
coordinates, and find those within the square grid defined by the particles \
position {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "31b71616-b380-413b-95c4-4f8d1ed41b52"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "b8cbf871-dd70-4acd-8fa6-51b5f654eafc"],
 "}\[PlusMinus]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "shell"], TraditionalForm]],ExpressionUUID->
  "cce6e893-fe4a-4eb7-837e-83cc19cf297e"],
 ".  This is bigger than the circle currently used, as its size is 4",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["R", "shell"], "2"], TraditionalForm]],ExpressionUUID->
  "9ac7a4cc-479b-4dd5-a4b3-c369050f3730"],
 " vs. \[Pi]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["R", "shell"], "2"], TraditionalForm]],ExpressionUUID->
  "27c1de72-a355-420a-a4b5-6656658c5203"],
 ". At our density of 1/\[Pi], that is "
}], "Text",
 CellChangeTimes->{{3.9646885425938272`*^9, 3.964688685652487*^9}, {
  3.964769291584115*^9, 3.9647693304326487`*^9}, {3.964769361872889*^9, 
  3.964769406399987*^9}, {3.964769461537891*^9, 3.9647694778739634`*^9}, {
  3.9647701566886*^9, 3.9647701630882*^9}, {3.9647703631381063`*^9, 
  3.964770375418066*^9}, {3.9647704153054867`*^9, 3.964770459314995*^9}, {
  3.964770669556881*^9, 3.9647708091263533`*^9}, {3.964771494895393*^9, 
  3.964771808440263*^9}, {3.964772000853086*^9, 
  3.964772010797872*^9}},ExpressionUUID->"b9a227cc-2fc7-4378-80a1-\
ee2244aed23b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"4", 
      SuperscriptBox["Rshell", "2"]}], " ", "-", " ", 
     RowBox[{"\[Pi]", " ", 
      SuperscriptBox["Rshell", "2"]}]}], ")"}], "/", "\[Pi]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9647718783368473`*^9, 3.964771952296439*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"fdb1b657-8195-4f08-be99-ae51b9f1721a"],

Cell[BoxData["6.830988618379068`"], "Output",
 CellChangeTimes->{3.9647719529283133`*^9, 3.965116605114895*^9, 
  3.9651237598917437`*^9, 3.965722605819954*^9, 3.9659001564043837`*^9, 
  3.966670544903841*^9, 3.9668436659407*^9, 3.967631639907298*^9, 
  3.967634018267712*^9, 3.967636979453411*^9, 3.967966797080557*^9, 
  3.968754316029842*^9},
 CellLabel->"Out[93]=",ExpressionUUID->"e8d751df-866b-45a4-a055-32288d65294a"]
}, Open  ]],

Cell[TextData[{
 "almost seven extra particles.  The procedure requires two sorts, a search \
of the sorted list for the box limits in both lists, and then building the \
list of of particles in the box. We need to keep the particle interaction \
list in more-or-less ascending order too.  That is, particle ",
 StyleBox["i",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s list of interacting particles should only contain \
particle numbers greater then ",
 StyleBox["i",
  FontSlant->"Italic"],
 ". The particles within ",
 StyleBox["i",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s list need not be in any order.\n\n\
Let\[CloseCurlyQuote]s look at the ten particle system created ",
 ButtonBox["above",
  BaseStyle->"Hyperlink",
  ButtonData->"pnts10"],
 " as an example."
}], "Text",
 CellChangeTimes->{{3.964771958970283*^9, 3.9647720674831457`*^9}, {
  3.96477211272861*^9, 3.9647722708519697`*^9}, {3.964774802932749*^9, 
  3.9647749127083282`*^9}, {3.964775206853672*^9, 3.964775219830312*^9}, {
  3.96477525562201*^9, 
  3.964775255623856*^9}},ExpressionUUID->"c5aef00b-29ff-4dc3-87a8-\
3b2b208f53f3"],

Cell[CellGroupData[{

Cell[BoxData["pnts10"], "Input",
 CellChangeTimes->{{3.964772643828978*^9, 3.964772717520653*^9}, {
   3.964773002855254*^9, 3.964773003590864*^9}, {3.964775071270183*^9, 
   3.964775079796451*^9}, 3.9647752011904573`*^9},
 CellLabel->"In[94]:=",ExpressionUUID->"3af34654-7049-468b-ad7e-812d9ce33098"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"\[Rho]\"\>", "\[Rule]", 
    FractionBox["1", 
