Cell[TextData[{
 " The number of points in these limits at a distance of R is 4",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["R", "2"], "/", "\[Rho]"}], TraditionalForm]],
  ExpressionUUID->"f07d6c25-a973-48da-93e2-3d4aa473c90f"],
 " for the outer square, \[Pi]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["R", "2"], "/", "\[Rho]"}], TraditionalForm]],
  ExpressionUUID->"9fa163d1-3e5c-40d4-b771-93dd76da84a7"],
 " for the circle.  The inner square\[CloseCurlyQuote]s diagonal is 2",
 StyleBox["R, ",
  FontSlant->"Italic"],
 "so  4",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["R", "2"], "=", 
    RowBox[{"2", 
     SuperscriptBox["x", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "781bdbd6-6ed4-4c77-a46f-81fa7666f843"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     SqrtBox["2"], "R"}]}], TraditionalForm]],ExpressionUUID->
  "a7cb0585-c249-470c-8c05-901d37982a1e"],
 ", and the area is 2",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "32405dfa-e1fa-43ce-843f-1bff13fdfb3a"],
 ", or half the area of the green square.  If this seems odd, not that the \
green wide strip at the bottom is 2",
 StyleBox["R",
  FontSlant->"Italic"],
 " wide, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"1", "/", 
       SqrtBox["2"]}]}], ")"}], "R"}], TraditionalForm]],ExpressionUUID->
  "ca1243b8-9476-4644-b7c9-316753f43166"],
 " tall, and there are two, and the two vertical strips are as wide as the \
latter were tall, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["2"], "R"}], TraditionalForm]],ExpressionUUID->
  "ec904916-9b67-42cd-8fb3-afdbf050e553"],
 " tall.  Their area is:"
}], "Text",
 CellChangeTimes->{{3.96511826727919*^9, 3.965118374752222*^9}, {
   3.965118456408856*^9, 3.965118456408894*^9}, {3.965118562857987*^9, 
