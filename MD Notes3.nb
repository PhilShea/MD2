Cell[TextData[{
 "Using the above comparison based testing, the 65K run was reduced to 5.1s, \
a factor of four.  While hopeful, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "18"], TraditionalForm]],ExpressionUUID->
  "1a3b08cd-8756-4156-96a8-27cd8477e6e3"],
 " particle (262,144) ",
 StyleBox["CorrShell!()", "CodeText"],
 " took 80.8s (per particle about four times longer than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "16"], TraditionalForm]],ExpressionUUID->
  "8333f1ab-ea7c-42f0-8f8c-d02a6b129476"],
 ").  "
}], "Text",
 CellChangeTimes->{
  3.966673215389042*^9},ExpressionUUID->"33236f50-4278-45d1-af50-\
f55d575e9981"],

