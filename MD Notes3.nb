Cell["\<\
We will want to mark a few particular distances, and we\[CloseCurlyQuote]ll \
define a function to help do that.\
\>", "Text",
 CellChangeTimes->{{3.967966729769925*^9, 
  3.9679667559702*^9}},ExpressionUUID->"54b05633-0d36-46a7-9528-9d72675e9959"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "Vline", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Vline", "::", "usage"}], "=", 
  "\"\<Vlin[\!\(\*StyleBox[\"x\",FontSlant->\"Italic\"]\)] can be used to \
draw a vertical line at \!\(\*StyleBox[\"x\",FontSlant->\"Italic\"]\) in a \
plot.  Suggested use is \n\
Prolog\[Rule]{Directive[Gray,Dashed],Vline[x1],Vline[x2]} inside a Plot[] \
function call.\>\""}], "\n", 
 RowBox[{
  RowBox[{"Vline", "[", "x_", "]"}], ":=", 
  RowBox[{"Line", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Scaled", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Scaled", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0"}], "}"}]}], "]"}]}], "}"}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.966947407039814*^9, 3.966947407879938*^9}, {
   3.9669480037627907`*^9, 3.966948052324045*^9}, {3.966948125284934*^9, 
   3.966948128212409*^9}, {3.9669595042765427`*^9, 3.966959628957329*^9}, 
   3.9676370250036907`*^9},
 CellLabel->
  "In[231]:=",ExpressionUUID->"212a4ce5-dab0-430b-a909-42c9c4c051d6"],

Cell[BoxData["\<\"Vlin[\\!\\(\\*StyleBox[\\\"x\\\",FontSlant->\\\"Italic\\\"]\
\\)] can be used to draw a vertical line at \
\\!\\(\\*StyleBox[\\\"x\\\",FontSlant->\\\"Italic\\\"]\\) in a plot.  \
Suggested use is \\nProlog\[Rule]{Directive[Gray,Dashed],Vline[x1],Vline[x2]} \
inside a Plot[] function call.\"\>"], "Output",
 CellChangeTimes->{{3.9676316387824497`*^9, 3.9676316570644207`*^9}, {
  3.9676340173236227`*^9, 3.967634029352625*^9}, {3.9676369784181004`*^9, 
  3.967636991601153*^9}, {3.967966795453587*^9, 3.967966810832202*^9}, {
  3.9687543148596783`*^9, 3.968754328458871*^9}},
 CellLabel->
  "Out[232]=",ExpressionUUID->"9291ab12-7585-4246-b799-457042dd9f02"]
}, Open  ]],

Cell[TextData[{
 "The plot below shows the challenge.  While moving along the x-axis, we are \
moving directly toward the next particle and the energy quickly diverges, \
starting to grow rapidly once it gets half way.  On the other hand, as it \
moves along the y-axis, the potential follows an ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "2"}]], TraditionalForm]],ExpressionUUID->
  "07783e21-2d52-4634-8f25-542abc703860"],
 "profile, oscillates a bit as it slips between adjacent particles, and then \
starts diverging as it approaches the particle two rows above."
}], "Text",
 CellChangeTimes->{{3.966959669429098*^9, 3.966959686845359*^9}, {
  3.966959716853875*^9, 3.966959722966012*^9}, {3.966960014032028*^9, 
  3.966960023704558*^9}, {3.966960346186695*^9, 3.966960381571843*^9}, {
  3.966960421764063*^9, 
  3.9669606341898727`*^9}},ExpressionUUID->"880cdbbe-9d7d-4ef5-80fa-\
72ef2e023bc5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"rn", "[", 
       RowBox[{
        RowBox[{"a79", "-", "x"}], ",", "5"}], "]"}], "/", "2"}], ",", 
     RowBox[{
      RowBox[{"P256", "[", 
       RowBox[{"x", ",", "0"}], "]"}], "-", "pe12o"}], ",", 
     RowBox[{
      RowBox[{"P256", "[", 
       RowBox[{"0", ",", "x"}], "]"}], "-", "pe12o"}], ",", 
     RowBox[{
      SuperscriptBox["x", "2"], "/", "2"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "0", ",", " ", 
     RowBox[{"2", "a79"}]}], "}"}], ",", "\[IndentingNewLine]", "\t", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\!\(\*SuperscriptBox[\(r\), \(5\)]\)\>\"", ",", "\"\<Pdx\>\"", ",", 
      "\"\<Pdy\>\"", ",", "\"\<\!\(\*SuperscriptBox[\(r\), \(2\)]\)\>\""}], 
     "}"}]}], ",", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", "\[IndentingNewLine]", 
   "\t", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"2", "a79"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "4"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "\"\<PE\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
   "\t", 
   RowBox[{"Prolog", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"Gray", ",", "Dashed"}], "]"}], ",", 
      RowBox[{"Vline", "[", 
       RowBox[{"a79", "/", "2"}], "]"}], ",", 
      RowBox[{"Vline", "[", "a79", "]"}], ",", 
      RowBox[{"Vline", "[", 
       RowBox[{"3", 
        RowBox[{"a79", "/", "2"}]}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9668459940040703`*^9, 3.9668460623854847`*^9}, {
