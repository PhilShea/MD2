Cell[TextData[{
 "The temperature is defined by  \[LeftAngleBracket]E\[RightAngleBracket] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "m", " ", 
     RowBox[{"\[LeftAngleBracket]", 
      SubsuperscriptBox["v", "x", "2"], "\[RightAngleBracket]"}]}], "+"}], 
   TraditionalForm]],ExpressionUUID->"ac6e2187-6331-4cb0-90c8-0a975701fd79"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "m", " ", 
    RowBox[{"\[LeftAngleBracket]", 
     SubsuperscriptBox["v", "y", "2"], "\[RightAngleBracket]"}]}], 
   TraditionalForm]],ExpressionUUID->"4107d584-30e9-42bd-8145-8e210ff14899"],
 "=",
 StyleBox["k",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["", "b"], TraditionalForm]],ExpressionUUID->
  "8215ec94-de58-4a56-a238-31943fc18e1d"],
 StyleBox[" T.",
  FontSlant->"Italic"],
 "  In our units, ",
 StyleBox["m",
  FontSlant->"Italic"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "b"], TraditionalForm]],ExpressionUUID->
  "aed60266-1a27-4856-9007-bbccc584a560"],
 " are one.  The other useful fact is that the velocities are Gaussian \
distributed with zero mean and "
}], "Text",
