Cell[CellGroupData[{

Cell["Finding an Energy Step", "Subsubsubsection",
 CellChangeTimes->{{3.994437259072481*^9, 
  3.994437268088664*^9}},ExpressionUUID->"32bf7f5e-04b3-49ce-b65e-\
e71bd0e9d087"],

Cell[TextData[{
 "While testing the two particle dislocation in Julia, a few energy steps \
showed up in the total energy.  The per-particle magnitude  was ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4.48", "\[Cross]", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "68d8d90c-a0ad-4f95-a8e7-624cad6552c4"],
 ", so if it were just two particles in a 100 particle system, it would be ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2.26", "\[Cross]", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "943d6386-0930-4da6-a00b-406907c5f952"],
 "."
}], "Text",
 CellChangeTimes->{{3.994437274355654*^9, 
  3.9944374900904093`*^9}},ExpressionUUID->"5f35e0f8-b97b-4627-a4cc-\
75de5223d81f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"rn", "[", 
    RowBox[{"x", ",", "5", ",", "3.5"}], "]"}], "\[Equal]", 
   RowBox[{"2.26", " ", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.994437175183736*^9, 3.994437207888254*^9}, {
  3.994437494722522*^9, 3.9944375400586023`*^9}},
 CellLabel->
  "In[512]:=",ExpressionUUID->"86aef48a-2eeb-4adc-aaac-928857cff12e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"x", "\[Rule]", "3.499169695184254`"}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.9944389256503973`*^9, 3.994438961356576*^9}},
 CellLabel->
  "Out[512]=",ExpressionUUID->"dcee75c2-4a3d-4377-968e-697d45facde9"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rn", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"%", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", " ", "All", ",", " ", "2"}], "]"}], "]"}], 
    "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", "5", ",", 
   "3.5"}], "]"}]], "Input",
