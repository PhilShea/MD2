   3.970391013444708*^9, 3.970402269351046*^9, 3.970820310521435*^9, 
   3.970997742224728*^9, 3.9711724288190613`*^9, 3.971336036855453*^9, 
   3.97169128916518*^9, 3.97194755573136*^9, 3.9719535946854477`*^9, 
   3.971973758795361*^9, 3.972210313612564*^9, 3.9726490157251663`*^9, 
   3.973069708744607*^9, 3.975412198422263*^9, 3.9779993891061783`*^9, 
   3.978007323389982*^9, 3.978008031075637*^9, 3.978506482722348*^9, 
