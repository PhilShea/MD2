Cell[TextData[{
 "So we want to move particle ",
 StyleBox["p2c", "Input"],
 " (particle 169) down so it is just inside particle ",
 StyleBox["p5c", "Input"],
 "\[CloseCurlyQuote]s ",
 StyleBox["NHOPr", "Input"],
 " and just outside ",
 StyleBox["p4c", "Input"],
 "\[CloseCurlyQuote]s ",
 StyleBox["NHOPr", "Input"],
 ". Particle ",
 StyleBox["p2c", "Input"],
 " is two rows above ",
 StyleBox["p1c", "Input"],
 " and one half column to the right. "
}], "Text",
 CellChangeTimes->{{3.993136272108596*^9, 3.993136315155272*^9}, {
