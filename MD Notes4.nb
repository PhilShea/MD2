Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    RowBox[{"2", " ", "i"}]}], ")"}], " ", "\[Pi]", " ", 
  SuperscriptBox["\[Delta]r", "2"]}]], "Output",
 CellChangeTimes->{{3.9716951187243967`*^9, 3.971695131851033*^9}, 
   3.971947598011382*^9, 3.971953631536821*^9, 3.971956840267774*^9, 
   3.971973791304111*^9, 3.972210359253462*^9, 3.972649053862323*^9, 
   3.973069740913376*^9, 3.975412228935556*^9, 3.978008065715589*^9, 
   3.978506518720077*^9, 3.9900893665096188`*^9, 3.993051997903944*^9, 
   3.993222298818585*^9, 3.993981231290296*^9, 3.994166456930002*^9, 
   3.994323761253334*^9, 3.994419651024444*^9, 3.994436805408778*^9},
 CellLabel->
  "Out[389]=",ExpressionUUID->"515b04ec-66b1-42d2-89bc-2957ffe8d27d"]
}, Open  ]],

Cell["\<\
To use this, we need to divide each element by the above values, and also the \
number of particles over which we take the average. Since we do not count \
each interaction twice,we will divide by N/2 instead of N.\
\>", "Text",
 CellChangeTimes->{{3.971964537748951*^9, 
  3.971964654773879*^9}},ExpressionUUID->"5cc4500a-a78c-43fc-8495-\
290be5109d6a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "g", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "::", "usage"}], "=", 
   "\"\<g[pa,Ng] returns a length Ng array r such that r[i] contains the \n\
avereage number of particles per unit area of pa that are within iz/Ng \
distance from each \nother, where z is the smaller of the Bx or By distances.\
\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"pa_", ",", "Ng_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"gc", "[", 
        RowBox[{"pa", ",", " ", "Ng"}], "]"}]}], ",", 
      RowBox[{"drs", "=", 
       RowBox[{"N", "[", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"pa", "[", "\"\<By\>\"", "]"}], "/", "Ng"}], ")"}], "2"], 
        "]"}]}], ",", 
      RowBox[{"Np", "=", 
       RowBox[{"Length", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"pa", "[", "\"\<pn\>\"", "]"}], ",", "1"}], "]"}], 
        "]"}]}]}], "}"}], ",", "\n", "\t", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"2", 
       RowBox[{
        RowBox[{"r", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
        "/", 
        RowBox[{"(", 
         RowBox[{"Np", " ", "drs", " ", "\[Pi]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "i"}], "-", "1"}], ")"}]}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "Ng"}], "}"}]}], "]"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.971340949675425*^9, 3.971340986356092*^9}, {
   3.971341228885716*^9, 3.971341267086071*^9}, {3.971341300118246*^9, 
