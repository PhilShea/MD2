 RowBox[{
  RowBox[{
   RowBox[{"pnts288p2c", " ", "=", "pnts288"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"copy", " ", "the", " ", "array"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
     "pnts288p2c", "\[LeftDoubleBracket]", "\"\<pn\>\"", 
      "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
     RowBox[{"11", ",", "9"}], "\[RightDoubleBracket]"}], "=", "pip1"}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "replace", " ", "p2c", " ", "coordinates", " ", "with", " ", "pip1"}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{
   "pnts288p2c", "\[LeftDoubleBracket]", "\"\<pn\>\"", 
    "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
   RowBox[{"11", ",", "9"}], "\[RightDoubleBracket]"}], "]"}]}], "Input",
