Cell[TextData[{
 "Below is the 288 particle system with a center particle (purple) and an \
adjacent cell highlighted, both with their Nelson-Halperin radii (",
 StyleBox["NHOPr", "Input"],
 ") drawn in cyan. The point circled in magenta will be moved down to cross \
both cell's ",
 StyleBox["NHOPr", "Input"],
 "."
}], "Text",ExpressionUUID->"b5fa2bf9-ed96-4895-89ab-84a4e34a10d3"],

