Cell[TextData[{
 "Where is the point half-way between the nearest neighbors and next nearest \
neighbors? The next nearest neighbor to a point at {0, 0} is at {3 ",
 StyleBox["a",
  FontSlant->"Italic"],
 " /2, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], 
    RowBox[{"a", "/", "2"}]}], TraditionalForm]],ExpressionUUID->
  "17e7eecb-0225-41b5-b803-5a19c11ad6e6"],
 "}, a distance of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], "a"}], TraditionalForm]],ExpressionUUID->
  "1c448f7d-99e8-44de-aa14-17aff6785da2"],
 " from {0,0}. The half-way distance between the nearest neighbors at ",
 StyleBox["a",
  FontSlant->"Italic"],
 " and the next nearest neighbors at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], "a"}], TraditionalForm]],ExpressionUUID->
  "db028d63-edaf-43d5-bc36-87b9128ae96e"],
 " is (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], "-", "1"}], TraditionalForm]],ExpressionUUID->
  "eac8f9a5-c51c-4828-93b5-edd7b7eed132"],
 ")",
 StyleBox["a,",
  FontSlant->"Italic"],
 " and adding half that distance to ",
 StyleBox["a",
  FontSlant->"Italic"],
 " yields (1+ ",
 Cell[BoxData[
  FormBox[
   SqrtBox["3"], TraditionalForm]],ExpressionUUID->
  "acb200f9-9314-4737-bf86-4f1782483b01"],
 " )",
 StyleBox["a",
  FontSlant->"Italic"],
 "/2."
}], "Text",
 CellChangeTimes->{{3.9497512599557877`*^9, 3.949751300639637*^9}, {
  3.949751332759759*^9, 3.949751467024612*^9}, {3.9497515405076523`*^9, 
  3.9497515405084963`*^9}, {3.949759893191924*^9, 3.949759999232657*^9}, {
  3.972648914807764*^9, 
  3.972648914959484*^9}},ExpressionUUID->"a6254195-aaf1-4f5a-87e0-\
7152eaa1a85f"],

