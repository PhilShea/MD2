Cell[TextData[{
 "Below is a look at the shape of a few versions of models we might use. We \
see the justification for calling the PE field circular, as the ",
 StyleBox["Pdx", "Code"],
 " and ",
 StyleBox["Pdy", "Code"],
 " plots are nearly identical in the range of interest.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["r", 
     RowBox[{"-", "2"}]], "/", "4"}], TraditionalForm]],ExpressionUUID->
  "3feedfbb-17f7-4e7c-9679-7b8f9addc8a9"],
 " does not fit very well, and the function which is the potential between \
two particles placed at \[PlusMinus]",
 StyleBox["a",
  FontSlant->"Italic"],
 " (named ",
 StyleBox["rn2[]", "Code"],
 ", defined below) appears slightly slow.  We will now plot only the excess \
energy."
}], "Text",
 CellChangeTimes->{{3.967102950563459*^9, 3.967102993564228*^9}, {
   3.967103048484445*^9, 3.96710314714123*^9}, {3.967103185245783*^9, 
   3.967103191717433*^9}, {3.9671058782134*^9, 3.967105879829874*^9}, {
   3.96721799666991*^9, 3.967218010854259*^9}, {3.967787523017805*^9, 
   3.967787525026298*^9}, {3.967787671399979*^9, 3.9677877812708817`*^9}, {
   3.970316894468549*^9, 3.970316895444374*^9}, {3.977988588351163*^9, 
   3.97798858937499*^9}, 3.977988624863349*^9, {3.993548786500393*^9, 
   3.993548793749708*^9}, {3.994168008082945*^9, 
   3.994168008994989*^9}},ExpressionUUID->"6af5eafe-d5a1-4631-87d6-\
30d0826828c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "rn2", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rn2", "::", "usage"}], "=", 
   "\"\<rn2[x_,a_,n_] computes the change in potential energy of a particle \
with a 1/\!\(\*SuperscriptBox[\(r\), \(n\)]\) potential\nthat is moved a \
distance x from its origin when there are identical particles at \
\[PlusMinus]a. \nThe potential at x=0 (which is the result of two \
interactions at a distance of a) is \nsubtracted and thus \
rn2[0,a,n]=0.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rn2", "[", 
    RowBox[{"x_", ",", "a_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"rn", "[", 
       RowBox[{
        RowBox[{"a", "-", "x"}], ",", "n"}], "]"}], "+", 
      RowBox[{"rn", "[", 
       RowBox[{
        RowBox[{"a", "+", "x"}], ",", "n"}], "]"}], "-", 
      RowBox[{"2", 
       RowBox[{"rn", "[", 
        RowBox[{"a", ",", "n"}], "]"}]}]}], ")"}], "/", "2"}]}], 
  ";"}]}], "Code",
 CellChangeTimes->{{3.9935410222682457`*^9, 3.9935413234930487`*^9}, {
  3.9935420937349663`*^9, 3.9935421006548367`*^9}, {3.9935421813356457`*^9, 
  3.993542219072424*^9}},
 CellLabel->
  "In[294]:=",ExpressionUUID->"c0f44d14-93cf-4c9d-a463-d69096622679"],

