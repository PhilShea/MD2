Cell[TextData[{
 "The plot below shows the challenge.  While moving along the x-axis (line ",
 StyleBox["Pdx", "Code"],
 "), we are moving directly toward the next particle and the energy quickly \
diverges, starting to grow rapidly once it gets half way (that line rides the \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", "5"], TraditionalForm]],ExpressionUUID->
  "c8c9a6c6-224e-4304-97be-b8a720892965"],
 " line below ",
 StyleBox["x",
  FontSlant->"Italic"],
 " = 2).  On the other hand, as it moves along the y-axis (",
 StyleBox["Pdy", "Code"],
 "), the potential follows an ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "2"}]], TraditionalForm]],ExpressionUUID->
  "07783e21-2d52-4634-8f25-542abc703860"],
 " profile, oscillates a bit as it slips between adjacent particles, and then \
starts diverging as it approaches the particle two rows above. The figure \
includes dashed green vertical lines at ",
 StyleBox["a",
  FontSlant->"Italic"],
 "/2, ",
 StyleBox["a",
  FontSlant->"Italic"],
 ", and 3",
 StyleBox["a",
  FontSlant->"Italic"],
 "/2, and a dotted blue line ad ",
 StyleBox["NHOPr", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.966959669429098*^9, 3.966959686845359*^9}, {
  3.966959716853875*^9, 3.966959722966012*^9}, {3.966960014032028*^9, 
  3.966960023704558*^9}, {3.966960346186695*^9, 3.966960381571843*^9}, {
  3.966960421764063*^9, 3.9669606341898727`*^9}, {3.9779983618423147`*^9, 
  3.977998489122044*^9}, {3.977998539881899*^9, 3.977998572082695*^9}, {
  3.993222141694347*^9, 
  3.9932221644863*^9}},ExpressionUUID->"880cdbbe-9d7d-4ef5-80fa-72ef2e023bc5"],

