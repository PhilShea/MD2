Cell[TextData[{
 "The difficulty with the ",
 StyleBox["x",
  FontSlant->"Italic"],
 "Tan(",
 StyleBox["x",
  FontSlant->"Italic"],
 ") function is that it is very specific to the density and exponent."
}], "Text",
 CellChangeTimes->{{3.967787329499147*^9, 3.967787361562684*^9}, {
  3.9677874302262983`*^9, 3.96778745748974*^9}, {3.977988741470192*^9, 
  3.9779887425035667`*^9}},ExpressionUUID->"1957469e-3b3b-46c4-a17f-\
911b3fa2e4b5"],

Cell[TextData[{
 "The mean excess PE will be equal to the mean temperature, and the highest \
we are interested in simulating is around ",
 StyleBox["T",
  FontSlant->"Italic"],
 " = 0.02. The distance from the minimum PE will be given by the solution to \
the following:"
}], "Text",
 CellChangeTimes->{{3.9671948759255047`*^9, 
  3.967195012422934*^9}},ExpressionUUID->"84972480-620e-4764-89ea-\
d025a8dfb899"],

