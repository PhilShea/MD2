Cell[TextData[{
 "The long-range order is calculated by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["G", "6"], "(", "r", ")"}], "=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Psi]", "6"], "(", 
       StyleBox["r",
        FontWeight->"Bold"], ")"}], 
      RowBox[{
       SubsuperscriptBox["\[Psi]", "6", "*"], "(", "0", ")"}]}], 
     "\[RightAngleBracket]"}]}], TraditionalForm]],
  InitializationCell->True,
  FormatType->"TraditionalForm",ExpressionUUID->
  "693da40a-55af-4fa2-8800-a9949252f256"],
 " [",
 StyleBox["Keim2007 ",
  FontWeight->"Bold"],
 "(eq. 7)",
 StyleBox[", Halperin1978, Kapfer2015",
  FontWeight->"Bold"],
 "] where the bold ",
 StyleBox["r",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " is a vector, and the ensemble average is presumed to be over all vectors \
of length ",
 StyleBox["r",
  FontSlant->"Italic"],
 ".  [",
 StyleBox["Toledno2021",
  FontWeight->"Bold"],
 ", (eq. 2)] has the a similar construct: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Eta]", "(", "r", ")"}], "=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        OverscriptBox["\[Psi]", "\[RightVector]"], "i"], "\[CenterDot]", 
       SubscriptBox[
        OverscriptBox["\[Psi]", "\[RightVector]"], "j"]}], 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", 
         StyleBox["ij",
          FontSlant->"Italic"]]}], ")"}]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]],
  InitializationCell->True,ExpressionUUID->
  "91675017-08da-4743-a4de-199f1b3f1b74"],
 ", where here ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["\[Psi]", "i"], "\[RightVector]"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "b50b4c7c-93c3-4c70-b807-57ae9ef3b610"],
 " is a vector formed from the real and imaginary parts of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "6"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "552393a1-bbb9-4953-a3f4-e9ea6cd75656"],
 ". This second form is nice because it is a real number, but the complex \
result contains more information, and its real component is equivalent to the \
dot product form. "
}], "Text",
 CellChangeTimes->{{3.9730040460339737`*^9, 3.9730041807554398`*^9}, {
   3.973004259708007*^9, 3.9730043269588203`*^9}, {3.9730045222053003`*^9, 
   3.973004540973563*^9}, 3.973004640022058*^9, {3.9730046893908157`*^9, 
   3.973004705678836*^9}, {3.973005171305936*^9, 3.973005226418631*^9}, {
   3.973005334707423*^9, 3.973005432532817*^9}, {3.973005501283223*^9, 
   3.9730057146786118`*^9}, {3.973005878983778*^9, 3.973005882008505*^9}, {
   3.973005945264489*^9, 3.9730059716969957`*^9}, {3.973068480140943*^9, 
   3.9730685100694427`*^9}, {3.97306854608803*^9, 3.973068577230411*^9}, {
   3.973068616142166*^9, 3.9730686440545607`*^9}, {3.973069225875574*^9, 
   3.9730692391874228`*^9}, {3.973069275635831*^9, 3.9730692767083406`*^9}, {
   3.9730696508312397`*^9, 3.973069681687533*^9}, {3.973069887657072*^9, 
   3.9730699588578653`*^9}, {3.973070082418989*^9, 3.973070107509488*^9}, {
   3.973072845207011*^9, 3.973072860663349*^9}, {3.973073908741901*^9, 
   3.973074014601192*^9}},ExpressionUUID->"f48931c5-4cdc-4427-a005-\
87e0dd1b7a6d"],

Cell[TextData[{
 "The 6-fold symmetry of the hexagonal lattice means that crystal can only \
rotate \[PlusMinus]30\[Degree] before it starts to be closer to the baseline \
orientation. For example if particle ",
 StyleBox["i",
  FontSlant->"Italic"],
 " to ",
 StyleBox["j",
  FontSlant->"Italic"],
 " had a 10\[Degree] angle, we would have:"
}], "Text",
 CellChangeTimes->{{3.9730040460339737`*^9, 3.9730041807554398`*^9}, {
   3.973004259708007*^9, 3.9730043269588203`*^9}, {3.9730045222053003`*^9, 
   3.973004540973563*^9}, 3.973004640022058*^9, {3.9730046893908157`*^9, 
   3.973004705678836*^9}, {3.973005171305936*^9, 3.973005226418631*^9}, {
   3.973005334707423*^9, 3.973005432532817*^9}, {3.973005501283223*^9, 
   3.9730057146786118`*^9}, {3.973005878983778*^9, 3.973005882008505*^9}, {
   3.973005945264489*^9, 3.9730059716969957`*^9}, {3.973068480140943*^9, 
   3.9730685100694427`*^9}, {3.97306854608803*^9, 3.973068577230411*^9}, {
   3.973068616142166*^9, 3.9730686440545607`*^9}, {3.973069225875574*^9, 
   3.9730692391874228`*^9}, {3.973069275635831*^9, 3.9730692767083406`*^9}, {
   3.9730696508312397`*^9, 3.973069681687533*^9}, {3.973069887657072*^9, 
   3.9730699588578653`*^9}, {3.973070082418989*^9, 3.973070107509488*^9}, {
   3.973072845207011*^9, 3.973072860663349*^9}, {3.973073908741901*^9, 
   3.97307401255916*^9}},ExpressionUUID->"3d92025e-f05b-4eac-91b3-\
46feca586e85"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"y", "=", 
   RowBox[{"10.0", " ", "Degree"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Psi]", "=", 
  RowBox[{"Exp", "[", 
   RowBox[{"6", " ", "I", " ", "y"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.973069776296076*^9, 3.973069844488443*^9}, {
  3.97307004378021*^9, 3.973070058434848*^9}, {3.973070758713397*^9, 
  3.973070774840431*^9}, {3.973072524037363*^9, 3.973072525996306*^9}},
 CellLabel->
  "In[213]:=",ExpressionUUID->"39c6f6bb-0fd6-4fbe-bdee-2e559fa04f48"],

Cell[BoxData[
 RowBox[{"0.5000000000000001`", "\[VeryThinSpace]", "+", 
  RowBox[{"0.8660254037844386`", " ", "\[ImaginaryI]"}]}]], "Output",
 CellChangeTimes->{
  3.9730698454520473`*^9, {3.973070051550346*^9, 3.973070059235153*^9}, {
   3.973070760993835*^9, 3.973070776280892*^9}, 3.973072527774097*^9, 
   3.975412210360907*^9, 3.977999407095359*^9, 3.978007338261829*^9, 
   3.978008045544383*^9, 3.978506499714313*^9, 3.990089346576872*^9, 
   3.993051978043892*^9, 3.993222277852594*^9, 3.993981205512149*^9, 
   3.994166437816782*^9, 3.994323740916381*^9, 3.994419630529276*^9, 
   3.994436785615672*^9},
 CellLabel->
  "Out[214]=",ExpressionUUID->"e8956170-2496-4c3e-a224-63ec490d0513"]
}, Open  ]],

Cell[TextData[{
 "The reverse has particle ",
 StyleBox["j",
  FontSlant->"Italic"],
 " to ",
 StyleBox["i",
  FontSlant->"Italic"],
 " with 180\[Degree] negative angle less the 10\[Degree] ( -170\[Degree]), \
and so the result is the same. "
}], "Text",
 CellChangeTimes->{{3.973070213859481*^9, 3.973070242771872*^9}, {
  3.973072402587215*^9, 3.9730724068191423`*^9}, {3.973072710829384*^9, 
  3.973072756133821*^9}, {3.973072815702405*^9, 3.9730728395267982`*^9}, {
  3.9730728730546618`*^9, 
  3.973072926215344*^9}},ExpressionUUID->"6bb7f7b1-246b-4f17-9adf-\
787dde0d8c02"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"y", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"180", "-", "10.0"}], ")"}]}], " ", "Degree"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Psi]", "=", 
  RowBox[{"Exp", "[", 
   RowBox[{"6", " ", "I", " ", "y"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.973069776296076*^9, 3.973069844488443*^9}, {
   3.97307004378021*^9, 3.973070058434848*^9}, 3.973070173027555*^9, {
   3.973070782584827*^9, 3.973070784584518*^9}, {3.973072531613529*^9, 
   3.973072533916213*^9}, {3.973072613965334*^9, 3.973072647725415*^9}},
 CellLabel->
  "In[215]:=",ExpressionUUID->"fb1589f3-08ff-4510-b9a1-91a46df1d2dc"],

Cell[BoxData[
 RowBox[{"0.5000000000000004`", "\[VeryThinSpace]", "+", 
  RowBox[{"0.8660254037844384`", " ", "\[ImaginaryI]"}]}]], "Output",
 CellChangeTimes->{
  3.973070174063271*^9, 3.973070785392037*^9, 3.973072535444448*^9, {
   3.973072624031*^9, 3.973072649236425*^9}, 3.975412210381672*^9, 
   3.977999407121223*^9, 3.978007338297015*^9, 3.978008045572713*^9, 
   3.978506499735756*^9, 3.990089346615484*^9, 3.9930519780719357`*^9, 
   3.9932222778845453`*^9, 3.9939812055523663`*^9, 3.994166437840912*^9, 
   3.9943237409456778`*^9, 3.994419630553975*^9, 3.994436785638427*^9},
 CellLabel->
  "Out[216]=",ExpressionUUID->"c15601c3-5088-4d0b-8750-d6f061493922"]
}, Open  ]],

Cell[TextData[{
 "This is so since the baseline position of each nearest neighbor is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "i"], "=", 
    RowBox[{"i", " ", 
     RowBox[{"\[Pi]", "/", "3"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "e58de571-594a-41b0-9b72-7d78f282634b"],
 ", where ",
 StyleBox["i",
  FontSlant->"Italic"],
 " goes from 0 to 5. If a crystal is rotated by an amount -\[Pi]/3 < \[Phi] <\
\[Pi]/3, then 6(\[Theta] + \[Phi]) = i(2\[Pi]) + 6\[Phi] which is equivalent \
to 6\[Phi], now ranging \[PlusMinus]2\[Pi].  When computing the total ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "6"], TraditionalForm]],ExpressionUUID->
  "9d3b1e47-8038-452e-a7a8-e9b67d21913d"],
 " for each particle ",
 StyleBox["i",
  FontSlant->"Italic"],
 ", we do not need to recompute it for each particle ",
 StyleBox["j",
  FontSlant->"Italic"],
 ", merely record the same \[Psi] for both particles."
}], "Text",
 CellChangeTimes->{{3.9730702008673058`*^9, 3.973070205131483*^9}, {
  3.973070315629109*^9, 3.9730704167093697`*^9}, {3.9730729311433268`*^9, 
  3.9730732009851294`*^9}, {3.973073247793701*^9, 3.973073283529825*^9}, {
  3.973073328010062*^9, 3.973073351969946*^9}, {3.9730737545809*^9, 
  3.973073878445862*^9}},ExpressionUUID->"1a0e8c4c-8785-4b82-9de1-\
a2b371a0fba0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{"6", " ", "I", " ", 
     RowBox[{"(", 
      RowBox[{"y", "+", ".01"}], ")"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0.0", ",", " ", 
     RowBox[{"5.0", "*", "60", " ", "Degree"}], ",", 
     RowBox[{"60", " ", "Degree"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.973070987953652*^9, 3.973071085138266*^9}, {
  3.973071276820005*^9, 3.973071398252277*^9}},
 CellLabel->
  "In[217]:=",ExpressionUUID->"2fd4e511-eb44-404a-ba08-7381fd9953f9"],

