Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"paircnt", "[", "N_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     FormBox[
      RowBox[{
       SuperscriptBox["N", "2"], "-", "N"}],
      TraditionalForm], ")"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"i", ",", 
     SuperscriptBox["2", "i"], ",", 
     RowBox[{"paircnt", "[", 
      SuperscriptBox["2", "i"], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"i", ",", "8", ",", "20", ",", "2"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.964616404796226*^9, 3.9646164439076357`*^9}, {
  3.9646164957321978`*^9, 3.964616715983328*^9}},
 CellLabel->
  "In[129]:=",ExpressionUUID->"238a4351-628b-402d-a7b5-b3075c5bf17a"],

