Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pnts256arr", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
     "pnts256", "\[LeftDoubleBracket]", "\"\<pn\>\"", 
      "\[RightDoubleBracket]"}], ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p1", "=", 
    RowBox[{
    "pnts256arr", "\[LeftDoubleBracket]", "189", "\[RightDoubleBracket]"}]}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Focal", " ", "point"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p2", "=", 
    RowBox[{
    "pnts256arr", "\[LeftDoubleBracket]", "190", "\[RightDoubleBracket]"}]}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Next", " ", "point", " ", "on", " ", "row"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p3", "=", 
    RowBox[{
    "pnts256arr", "\[LeftDoubleBracket]", "207", "\[RightDoubleBracket]"}]}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"next", " ", "nearest", " ", "neighbor"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p4", "=", 
    RowBox[{"pnts256arr", "\[LeftDoubleBracket]", 
     RowBox[{"189", "-", "4"}], "\[RightDoubleBracket]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"secondary", " ", "shell", " ", "center"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p5", "=", 
    RowBox[{
    "pnts256arr", "\[LeftDoubleBracket]", "120", "\[RightDoubleBracket]"}]}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"By", " ", "radius", " ", "center"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rskin", " ", "=", " ", "3.5"}], ";", " ", 
  RowBox[{"Rshell", " ", "=", " ", "5"}], ";", 
  RowBox[{"NHOPr", "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      SqrtBox["3"]}], ")"}], " ", 
    RowBox[{
    "pnts256", "\[LeftDoubleBracket]", "\"\<a\>\"", 
     "\[RightDoubleBracket]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"p256", ",", "\[IndentingNewLine]", 
