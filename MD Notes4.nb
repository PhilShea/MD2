Cell["Now we generate 256 angles between zero and 2\[Pi].", "Text",
 CellChangeTimes->{{3.9672746032103863`*^9, 
  3.967274626850154*^9}},ExpressionUUID->"3285e3b0-b9e5-4616-b61a-\
fa94e4c51a36"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"angles", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"UniformDistribution", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"2", "\[Pi]"}]}], "}"}], "]"}], ",", "256"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"angles", "\[LeftDoubleBracket]", 
  RowBox[{"1", ";;", "10"}], "\[RightDoubleBracket]"}]}], "Input",
