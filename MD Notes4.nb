552498dde49e"],

Cell[TextData[{
 "The purple circle above shows that we could get a few more columns into the \
radial distribution calculation if there were a few more rows of particles. \
The box height is only about 87% of its width when the number of rows and \
columns are the same.  If there were two more rows (i.e., 18), the box \
dimensions would be given by setting ",
 StyleBox["by", "Code"],
 " to the number of rows times the row height of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", 
    RowBox[{
     SqrtBox["3"], "/", "4"}]}], TraditionalForm]],ExpressionUUID->
  "708fab07-7f9e-4f3b-a348-b16b79f630e7"],
 " (",
 StyleBox["by", "Code"],
 " is half of the box side):"
}], "Text",
 CellChangeTimes->{{3.977561829816834*^9, 3.9775619060989532`*^9}, {
  3.977561946021285*^9, 3.977562009521925*^9}, {3.977567659828322*^9, 
  3.9775678144378223`*^9}, {3.9931092338695793`*^9, 
  3.993109238837908*^9}},ExpressionUUID->"d958d52c-57d5-4356-b750-\
c37f2b3ec84f"],

