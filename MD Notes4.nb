Cell[TextData[{
 "Above is a 256 particle array in the defined box (light blue field \
encompassed by dashed line), with a focus on particle 189 (upper right \
plotted in red).  The red circle is the ",
 StyleBox["skin",
  FontSlant->"Italic"],
 " range of 3.5, and the green circle is the correlation range (the ",
 StyleBox["shell",
  FontSlant->"Italic"],
 ") of 5.  The magenta circled particle is one of the six nearest neighbor \
particles, and the blue circled particle is one of the six next nearest \
neighbor particles, just inside the ",
 StyleBox["skin",
  FontSlant->"Italic"],
 ". The cyan circle is the radius used to count nearest neighbors and compute \
the Nelson-Halperin order parameter (",
 StyleBox["NHOPr", "Input"],
 ", see below)[",
 StyleBox["Halperin1978",
  FontWeight->"Bold"],
 "].  The purple circle (around the purple particle just below left center) \
is the radius at ",
 StyleBox["By", "Input"],
 " (used in radial distribution calculation)."
}], "Text",
 CellChangeTimes->{{3.942746233133216*^9, 3.9427462939565983`*^9}, {
  3.942746328069157*^9, 3.9427463915410285`*^9}, {3.9429179455763564`*^9, 
  3.9429180217921295`*^9}, {3.949746127039822*^9, 3.949746127383781*^9}, {
  3.96469112388739*^9, 3.964691133687118*^9}, {3.971951471049036*^9, 
  3.9719514846569347`*^9}, {3.97195152981693*^9, 3.971951570537341*^9}, {
  3.97195167095376*^9, 3.971951685985849*^9}, {3.972647997291209*^9, 
  3.9726479983921347`*^9}, {3.972648287890452*^9, 3.972648306194604*^9}, {
  3.972648468116562*^9, 3.972648468548094*^9}, {3.972648509868422*^9, 
  3.97264856445434*^9}, {3.972648655205489*^9, 3.9726486814870243`*^9}, {
  3.977560240117461*^9, 3.977560302013825*^9}, {3.97756033793577*^9, 
  3.977560370254218*^9}, {3.977561718225773*^9, 
  3.97756175621764*^9}},ExpressionUUID->"8da80821-6b84-4a06-b731-\
03db7cafc4ea"],

Cell[TextData[{
 "The ",
 StyleBox["skin",
  FontSlant->"Italic"],
 " range (red circles) above show that they do not overlap at four particle \
spacings. They could be set to 2",
 StyleBox["a",
  FontSlant->"Italic"],
 " so that they would touch.  There would be a few more interacting particles \
then, and, at initialization, six particles would sit on the ",
 StyleBox["skin",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.942943825336157*^9, 3.9429438351578074`*^9}, {
  3.964690684952805*^9, 3.964690701008895*^9}, {3.977560083411687*^9, 
  3.977560131980124*^9}},ExpressionUUID->"e9de53f8-4e82-4efb-b9ac-\
087f40b61857"],

