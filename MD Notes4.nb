 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       SqrtBox["2"], 
       RowBox[{
        SuperscriptBox["3", 
         RowBox[{"1", "/", "4"}]], " ", 
        SqrtBox["\[Rho]"]}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", "\[Rule]", 
     FractionBox[
      SqrtBox["2"], 
      RowBox[{
       SuperscriptBox["3", 
        RowBox[{"1", "/", "4"}]], " ", 
       SqrtBox["\[Rho]"]}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9274509882484026`*^9, 3.9274510041838627`*^9}, 
