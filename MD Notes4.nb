Cell[CellGroupData[{

Cell["Velocity Verlet", "Subsubsection",
 CellChangeTimes->{{3.9704001722282343`*^9, 
  3.970400175756218*^9}},ExpressionUUID->"71058c4c-6a19-442c-89ac-\
d7b76395b4bb"],

Cell[TextData[{
 "This algorithm claims to be more accurate (from the ",
 StyleBox["wayback machine",
  FontSlant->"Italic"],
 ": (",
 ButtonBox["https://web.archive.org/web/20211023234749/https://embnet.vital-\
it.ch/MD_tutorial/pages/MD.Part1.html",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://web.archive.org/web/20211023234749/https://embnet.vital-it.\
ch/MD_tutorial/pages/MD.Part1.html"], None},
  ButtonNote->
   "https://web.archive.org/web/20211023234749/https://embnet.vital-it.ch/MD_\
tutorial/pages/MD.Part1.html"],
 ", that\[CloseCurlyQuote]s the 23 October 2021: \
\[OpenCurlyDoubleQuote]20211023\[CloseCurlyDoubleQuote]). It is a two step \
process:\n",
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    RowBox[{"n", "+", "1"}]], TraditionalForm]], "Item1Numbered",
  ExpressionUUID->"64df2830-9c77-4201-8676-a1f325995673"], "Item1Numbered"],
 StyleBox[" = ", "Item1Numbered"],
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["r", "n"], TraditionalForm]], "Item1Numbered",ExpressionUUID->
  "98adb20f-b69e-4aa0-8fbd-376a509377a7"], "Item1Numbered"],
 StyleBox[" + ", "Item1Numbered"],
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["v", "n"], TraditionalForm]], "Item1Numbered",ExpressionUUID->
  "817c0826-ebd3-47e9-afc7-9c8a5d7a89f8"], "Item1Numbered"],
 StyleBox["\[Delta]", "Item1Numbered"],
 StyleBox["t", "Item1Numbered",
  FontSlant->"Italic"],
 StyleBox[" + ", "Item1Numbered"],
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["a", "n"], TraditionalForm]], "Item1Numbered",ExpressionUUID->
  "d86da9ef-84aa-40d3-94a3-b7bf899b56b1"], "Item1Numbered"],
 StyleBox["\[Delta]", "Item1Numbered"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["t", "2"], "/", "2"}], TraditionalForm]], "Item1Numbered",
  ExpressionUUID->"f4e78260-9eb9-4681-b056-74fa4e6870d9"], "Item1Numbered"],
 "\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", 
    RowBox[{"n", "+", "1"}]], TraditionalForm]],ExpressionUUID->
  "34fcdd07-c80e-4281-af5d-6a6fc7229814"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "n"], TraditionalForm]],ExpressionUUID->
  "c40cc01b-4368-4ead-9edd-fec770c320ad"],
 " + ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["a", "n"], " ", "+", " ", 
     SubscriptBox["a", 
      RowBox[{"n", "+", "1"}]]}], ")"}], TraditionalForm]],ExpressionUUID->
  "2e51b3f8-7e37-4c4c-8dad-866a0b1922e4"],
 "\[Delta]",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "/", "2"}], TraditionalForm]],ExpressionUUID->
  "4d623cbb-55c8-4aaf-b375-3ec3898e014f"]
}], "Text",
 CellChangeTimes->{{3.970400229044615*^9, 3.9704002858615932`*^9}, {
  3.9704008360972977`*^9, 3.970400925467032*^9}, {3.9704009878100443`*^9, 
  3.970400988762046*^9}, {3.970838758638892*^9, 3.9708388101431026`*^9}, {
  3.970840783129406*^9, 3.970840955170168*^9}, {3.9708409868190393`*^9, 
  3.970841016476303*^9}, {3.971171597386397*^9, 3.971171607352522*^9}, {
  3.971172107228236*^9, 3.971172133836246*^9}, {3.982241128393364*^9, 
  3.982241128394956*^9}, {3.982241224003532*^9, 
  3.9822414330667667`*^9}},ExpressionUUID->"cf2ba84c-c8bc-401c-a60b-\
29458442b7ef"],

Cell["\<\
This may not take more computer time because we compute the velocity at each \
step of the Verlet process anyway.\
\>", "Text",
 CellChangeTimes->{{3.97040130813186*^9, 
  3.970401341340127*^9}},ExpressionUUID->"d5a4f999-ae0a-4545-84e0-\
22e87f27ada0"],

Cell[TextData[{
 "Going back to the original paper describing the velocity Verlet ",
 StyleBox["[", "Reference"],
 StyleBox["Swope1982", "Reference",
  FontWeight->"Bold"],
 StyleBox["] ", "Reference"],
 "we see the derivation of the algorithm.  Swope defines ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", "n"], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["r", 
        RowBox[{"n", "+", "1"}]], "-", 
       SubscriptBox["r", "n"]}], ")"}], "/", 
     StyleBox[" ",
      FontSlant->"Italic"], 
     StyleBox[
      RowBox[{"\[Delta]", 
       StyleBox["t",
        FontSlant->"Italic"]}]]}]}], TraditionalForm]],ExpressionUUID->
  "3146a6c3-8605-4e17-8e94-54501d0dbc43"],
 " (a velocity sometime between ",
 StyleBox["n",
  FontSlant->"Italic"],
 " and ",
 StyleBox["n",
  FontSlant->"Italic"],
 "+1), and substitutes equation 3 above (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", 
     RowBox[{"n", "+", "1"}]], "=", 
    RowBox[{
     RowBox[{"2", 
      SubscriptBox["r", "n"]}], "-", 
     SubscriptBox["r", 
      RowBox[{"n", "-", "1"}]], "+", 
     RowBox[{
      SubscriptBox["a", "n"], 
      SuperscriptBox["\[Delta]t", "2"]}]}]}], TraditionalForm]],
  ExpressionUUID->"fa59e7f8-3d83-4ecd-96bc-54461d3d39a6"],
 ", eq. A3 in Swope) into the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    RowBox[{"n", "+", "1"}]], TraditionalForm]],ExpressionUUID->
  "c5683c1a-3d63-45ba-8dd3-0be019bfebd9"],
 " term of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "n"], TraditionalForm]],ExpressionUUID->
  "033ca86f-2997-478e-aadb-551a22ac873b"],
 "."
}], "Text",
 CellChangeTimes->{{3.970401810215229*^9, 3.9704018694811077`*^9}, {
   3.970838905111561*^9, 3.9708389609603853`*^9}, {3.970838996552259*^9, 
   3.9708390036884108`*^9}, {3.970840022987273*^9, 3.970840042729726*^9}, {
   3.970840094443388*^9, 3.9708401906704884`*^9}, {3.970840254317584*^9, 
   3.970840276912743*^9}, {3.970840743186666*^9, 3.9708407433845387`*^9}, {
   3.9708423639732943`*^9, 3.970842476415085*^9}, {3.970843574032284*^9, 
   3.9708435988568983`*^9}, {3.970843633656743*^9, 3.9708436615464973`*^9}, {
   3.970844684113842*^9, 3.97084470090868*^9}, {3.970845974697377*^9, 
   3.9708459905451393`*^9}, {3.9708528726151133`*^9, 
   3.9708528832713327`*^9}, {3.970853071537367*^9, 3.970853126400661*^9}, 
   3.970853488140415*^9, {3.970853717638452*^9, 3.9708537291745853`*^9}, {
   3.970900146888556*^9, 3.970900206072694*^9}, {3.971172212724535*^9, 
   3.971172228348209*^9}},ExpressionUUID->"3f321f79-5560-4e3c-98a5-\
a77c25dc6dc0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", "n"], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", 
        SubscriptBox["r", "n"]}], "-", 
       SubscriptBox["r", 
        RowBox[{"n", "-", "1"}]], "+", 
       RowBox[{
        SubscriptBox["a", "n"], 
        SuperscriptBox["\[Delta]t", "2"]}], "-", 
       SubscriptBox["r", "n"]}], ")"}], "/"}]}], TraditionalForm]],
  ExpressionUUID->"cd98cfe5-9ca1-42ce-9561-4cf632ac6675"],
 " \[Delta]t"
}], "Text",
 CellChangeTimes->{{3.970401810215229*^9, 3.9704018694811077`*^9}, {
   3.970838905111561*^9, 3.9708389609603853`*^9}, {3.970838996552259*^9, 
   3.9708390036884108`*^9}, {3.970840022987273*^9, 3.970840042729726*^9}, {
