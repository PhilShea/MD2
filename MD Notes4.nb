Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"??", "rn"}]], "Input",
 CellChangeTimes->{{3.994438065192621*^9, 3.994438081158999*^9}},
 CellLabel->
  "In[495]:=",ExpressionUUID->"ff34e35b-7703-4cdb-9434-e311d4306703"],

Cell[CellGroupData[{

Cell[BoxData["\<\"rn[\\!\\(\\*StyleBox[\\\"r\\\",FontSlant->\\\"Italic\\\"]\\)\
\\!\\(\\*StyleBox[\\\",\\\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\
\" \\\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\"n\\\",FontSlant->\\\
\"Italic\\\"]\\)]=\\!\\(\\*SuperscriptBox[\\(r\\), \
\\(-n\\)]\\).\\nrn[\\!\\(\\*StyleBox[\\\"r_\\\",FontSlant->\\\"Italic\\\"]\\)\
\\!\\(\\*StyleBox[\\\",\\\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\
\" \\\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\"n_:\\\",FontSlant->\
\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\"5\\\",FontSlant->\\\"Italic\\\"]\\)\\!\
\\(\\*StyleBox[\\\",\\\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\" \
\\\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\"Rskn\\\",FontSlant->\\\
\"Italic\\\"]\\)\\!\\(\\(\\(_\\)\\(:\\)\\)\\)3.5] respects the skin depth and \
causes the potential to be zero \\nat the skin depth range \\!\\(\\*StyleBox[\
\\\"Rskn\\\",FontSlant->\\\"Italic\\\"]\\).\"\>"], "Print", "PrintUsage",
 CellChangeTimes->{3.9944380819064827`*^9},
 CellTags->
  "Info4953994423681-8551224",ExpressionUUID->"f964e62c-fd19-4bc9-b141-\
b3d750374d0b"],

Cell[BoxData[
 InterpretationBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{"rn", "[", 
          RowBox[{"r_", ",", "n_"}], "]"}], ":=", 
         SuperscriptBox["r", 
          RowBox[{"-", "n"}]]}]},
       {" "},
       {
        RowBox[{
         RowBox[{"rn", "[", 
          RowBox[{"r_", ",", 
           RowBox[{"n_", ":", "5"}], ",", 
           RowBox[{"Rskn_", ":", "3.5`"}]}], "]"}], ":=", 
         RowBox[{"Piecewise", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"r", "\[GreaterEqual]", "Rskn"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"rn", "[", 
                RowBox[{"r", ",", "n"}], "]"}], "-", 
               RowBox[{"rn", "[", 
                RowBox[{"Rskn", ",", "n"}], "]"}]}], ",", "True"}], "}"}]}], 
           "}"}], "]"}]}]}
      },
      BaselinePosition->{Baseline, {1, 1}},
      GridBoxAlignment->{
       "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
        "RowsIndexed" -> {}},
      GridBoxItemSize->{"Columns" -> {{
           Scaled[0.999]}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
        "RowsIndexed" -> {}}]}
   },
   BaselinePosition->{Baseline, {1, 1}},
   GridBoxAlignment->{
    "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
     "RowsIndexed" -> {}}],
  Definition[$CellContext`rn],
  Editable->False]], "Print",
 CellChangeTimes->{3.9944380819499483`*^9},
 CellTags->
  "Info4953994423681-8551224",ExpressionUUID->"18b34264-bac4-4f6b-99e4-\
d524f2d995ba"]
}, Open  ]]
}, Open  ]],

