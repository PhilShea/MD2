Cell[CellGroupData[{

Cell["Problems with Large Number of Particles", "Subsection",
 CellChangeTimes->{{3.9645335943928223`*^9, 3.964533605361627*^9}, {
  3.9646918141630497`*^9, 
  3.9646918152990007`*^9}},ExpressionUUID->"a303a4f5-64c8-458a-9295-\
9a392ed5eefe"],

Cell["\<\
While 256 particles was relatively straight forward, there are some issues as \
we try to scale to one million particles.\
\>", "Text",
 CellChangeTimes->{{3.964533612409856*^9, 3.964533616161193*^9}, {
  3.9645336548580647`*^9, 
  3.9645336947374*^9}},ExpressionUUID->"055db021-8cd9-4426-bf7b-d9dfa470ad6c"],

Cell[CellGroupData[{

Cell["Correlation Array Length", "Subsubsection",
 CellChangeTimes->{{3.964533705600971*^9, 
  3.9645337146656647`*^9}},ExpressionUUID->"d4793fa1-8a7f-4e21-b374-\
3e669e4212ce"],

Cell[TextData[{
 "The correlation array records all inter-particle interactions once each.  \
That is, if particle one interacts with particle two but not particle three, \
and particle two interacts with one and three, particle \
two\[CloseCurlyQuote]s list only includes particle three.  Interactions are \
limited by the the shell radius ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "shell"], TraditionalForm]],ExpressionUUID->
  "05b192e1-7480-40a5-8111-90d7fac28ad2"],
 ".  Since the overall density is fixed, the average number of interactions \
per particle is simply ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", " ", "\[Rho]", " ", 
    SuperscriptBox[
     SubscriptBox["R", "shell"], "2"]}], TraditionalForm]],ExpressionUUID->
  "1611e9e2-9b3f-4909-8f83-665262c8b96e"],
 ", where \[Rho] is the density. For the 1980 system, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "shell"], TraditionalForm]],ExpressionUUID->
  "57f963b9-54f1-4394-acb8-222449d37a84"],
 "=5 and \[Rho]=1/\[Pi], so this number is simply 25.  With 256 particles, \
and each interaction only counting once, there should be no more than 255 \
\[CenterDot] 25 / 2 = 3,187.5.  In fact, in 17,472 executions (of varying \
number of steps up to 50,000), the maximum we have observed is 3,115.  This \
was determined through the steps below."
}], "Text",
 CellChangeTimes->{{3.9645930384373493`*^9, 3.9645933471775513`*^9}, {
   3.964593377593397*^9, 3.964593408080982*^9}, {3.964598043014537*^9, 
   3.9645980964224367`*^9}, {3.964598132175323*^9, 3.964598358034513*^9}, 
   3.9646884284155893`*^9},ExpressionUUID->"91c05b54-3a9b-47b9-9ee1-\
d337c294ee11"],

Cell["\<\
home : $ cd ~/MD/Data/1980
~/MD/Data/1980 $ grep \"Max number of interactions:\" *.txt > MNI.txt
~/MD/Data/1980 $ R # Start R
R version 4.5 .1 (2025 - 06 - 13) -- \"Great Square Root\"
Copyright (C) 2025 The R Foundation for Statistical Computing
Platform : x86_ 64 - pc - linux - gnu

> td < - \"/media/phil/Original/Users/phils/Documents/DSP/MD/Data/1980\"
> x < - read.delim ( paste ( td, \"MNI.txt\", sep = \"/\"), \":\", header = \
FALSE)
> max (x$V3)
[1] 3115\
\>", "Program",
 Evaluatable->False,
 CellChangeTimes->{{3.9645983910027637`*^9, 3.964598435914662*^9}, {
   3.964598469654701*^9, 3.964598541259985*^9}, {3.964615985014884*^9, 
   3.9646160211674423`*^9}, {3.964616052167863*^9, 3.964616059535825*^9}, 
   3.971949785842724*^9, {3.971949860647923*^9, 
   3.971949885208992*^9}},ExpressionUUID->"65d4e0ce-13f6-4b45-a707-\
2021624ab3d2"],

Cell[TextData[{
 "The current minimum the program allows (as of August 2025) is double this: ",
 StyleBox["N ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", " ", "\[Rho]", " ", 
    SuperscriptBox[
     SubscriptBox["R", "shell"], "2"]}], TraditionalForm]],ExpressionUUID->
  "91ef5395-6ce8-4602-9268-682d040b5483"],
 ", where N is the number of particles (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "shell"], "=", "5"}], TraditionalForm]],ExpressionUUID->
  "d43389c4-a596-45d6-8290-8b76911f0a61"],
 " and \[Rho]=1/\[Pi], ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Pi]", " ", "\[Rho]", " ", 
     SuperscriptBox[
      SubscriptBox["R", "shell"], "2"]}], "=", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["R", "shell"], "2"], "=", "25"}]}], TraditionalForm]],
  ExpressionUUID->"f3cb3a16-0487-40e4-8e66-b4bcaf562011"],
 ", and for N = 256,  ",
 StyleBox["N ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Pi]", " ", "\[Rho]", " ", 
     SuperscriptBox[
      SubscriptBox["R", "shell"], "2"]}], "="}], TraditionalForm]],
  ExpressionUUID->"694d999a-b656-4c57-a501-f5ccec1d330e"],
 " 6,400), and the executions have been using 9,728 (",
 StyleBox["N * round(1.5 * pi * density *Rshell^2)", "CodeText"],
 ").  So, as we get to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "20"], TraditionalForm]],ExpressionUUID->
  "d8ab1bbe-aad6-4853-8685-2213b6f0453d"],
 " (one million) particles, we need to have a tighter bound, and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", " ", "\[Pi]", " ", "\[Rho]", " ", 
    SuperscriptBox[
     SubscriptBox["R", "shell"], "2"]}], TraditionalForm]],ExpressionUUID->
  "f18b91d7-04a4-43c7-b84a-9e1aaf48f277"],
 "/2 would occupy about 105MB of memory (assuming 4 bytes per integer), \
large, but doable. A 10% margin should be added as we \
wouldn\[CloseCurlyQuote]t want a calculation to fail after hours of work just \
because this limit was too tight."
}], "Text",
 CellChangeTimes->{{3.964598674837111*^9, 3.964598686029235*^9}, {
  3.9645987410857353`*^9, 3.964598752293777*^9}, {3.964598860568984*^9, 
  3.964599024832469*^9}, {3.96459921121117*^9, 3.964599232202017*^9}, {
  3.96459926345048*^9, 3.9645993023626328`*^9}, {3.964599337266642*^9, 
  3.9645993921311283`*^9}, {3.964599466771739*^9, 3.9645995916931133`*^9}, {
  3.96461613593754*^9, 3.964616147210353*^9}, {3.9730016863534107`*^9, 
  3.9730017589376097`*^9}, {3.973001843394457*^9, 3.973001950547414*^9}, {
  3.973002096652783*^9, 3.9730021153965807`*^9}, {3.973002149813046*^9, 
  3.973002153252716*^9}},ExpressionUUID->"e3027d6c-b5b3-428a-a366-\
38b9189e9c1f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Correlation Algorithm", "Subsubsection",
 CellChangeTimes->{{3.964616170944585*^9, 
  3.964616178480719*^9}},ExpressionUUID->"c58a49f4-3ca6-4ddc-a047-\
86e478ba2f1c"],

Cell["\<\
Currently, the simulation stops every 50 steps and calculates the distance \
between all particle pairs to create the list of those within each particle\
\[CloseCurlyQuote]s shell.  So particle one looks at the the distance to the \
other 255 particles. Particle two looks at 254, and so on.\
\>", "Text",
 CellChangeTimes->{{3.9646161842090807`*^9, 
  3.964616291450264*^9}},ExpressionUUID->"28a7c76c-d43c-4682-bab2-\
0c6af1768f23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", " ", 
  RowBox[{"Sum", "[", " ", 
   RowBox[{"i", ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "1", ",", " ", 
      RowBox[{"N", "-", "1"}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.964599449055386*^9, 3.964599455211463*^9}, {
  3.964616296658966*^9, 3.9646163256101*^9}},
 CellLabel->
  "In[128]:=",ExpressionUUID->"bcf0b90c-3cfc-4fd3-b453-329424a9dd5d"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "N"}], ")"}], " ", "N"}]], "Output",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmVkYGDQBuIHmnVT7ne+dZzaf+HCcyCtE1muyd311jEnfoH4HSD9
g/331PtA2od3+1/mnreOIYe710cB6ZRY6VuXet863si3SVLve+soJPFLaUX/
W0fvUneflUBa2jp33yogfT17wUnvCW8dvRjqAs9MfOtYz8rUdnTKW0eF/Wem
HQPSZ46eu34GSCtGrq15DaRPFaz6/QFIB0efk9o79a1jncnRvcLT3joWes7k
zATSFftnvdkBpNdXqSSnTX/rKLehrOUxkH50JqT8GZC2cb7h/wFIl5w1upg8
A0j//8pmNfOt43nW6YXss946WnScsamfB3RH9qLmvMVAfkR2chGQtprycDeI
ZqsLk0tb8tbx3o/kc7W73jpeuKqbrnLgrWN+inFvOZBW2nRQ/tXBt45Na+5N
cjn01rGjojFuIpA+toPR5ACQXlVwefIJIA0AuGS8CA==
  "],
 CellLabel->
  "Out[128]=",ExpressionUUID->"e4355e4d-d0ef-441d-9f80-33494629cc97"]
}, Open  ]],

Cell[TextData[{
 "So this dependence on (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["N", "2"], "-", "N"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "2f736765-501d-420c-b915-aa681642211c"],
 ")/2 can get big."
}], "Text",
 CellChangeTimes->{{3.96461635145855*^9, 
  3.964616415507144*^9}},ExpressionUUID->"b79f800f-e2a5-4005-89c1-\
bbfbed3ab444"],

