  3.971340845335805*^9, 3.9713408915228853`*^9, 3.971341244658041*^9, {
   3.971343064476686*^9, 3.9713430746437607`*^9}, {3.971343114716494*^9, 
   3.9713431686844797`*^9}, 3.971343340294194*^9},
 CellLabel->
  "In[373]:=",ExpressionUUID->"07d13361-166a-495f-b67e-fe0b2af239f1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "2"}], ",", 
   RowBox[{"{", 
    RowBox[{"13", ",", 
     RowBox[{"-", "11"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.971343075313443*^9, 3.9713431171080112`*^9}, 
   3.971343169286992*^9, 3.971343341186302*^9, 3.9716913387143793`*^9, 
   3.971947597627612*^9, 3.971947946618456*^9, 3.971953630905061*^9, 
   3.9719737906761703`*^9, 3.972210358715469*^9, 3.972649053419456*^9, 
   3.97306974039924*^9, 3.975412228365415*^9, 3.978008065173015*^9, 
   3.978506518144518*^9, 3.990089365785083*^9, 3.993051997275797*^9, 
   3.993222298190064*^9, 3.993981230517194*^9, 3.994166456344934*^9, 
   3.9943237604589863`*^9, 3.9944196503833113`*^9, 3.994436804792266*^9},
