Cell["\<\
This function will fill a rectangle, and the two parameter version will make \
the standard rectangle.\
\>", "Text",
 CellChangeTimes->{{3.942745646806391*^9, 3.942745650269972*^9}, {
  3.9427456873819847`*^9, 3.942745698549962*^9}, {3.942745778910468*^9, 
  3.9427458145977263`*^9}},ExpressionUUID->"a3c02cc8-a8b7-43bb-afe7-\
d2024d156bf7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", " ", "fill", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fill", "::", "usage"}], "=", 
   "\"\<fill[ \!\(\*StyleBox[\"Bx\",FontSlant->\"Italic\"]\), \!\(\*StyleBox[\
\"By\",FontSlant->\"Italic\"]\), n] will place \
\!\(\*StyleBox[\"n\",FontSlant->\"Italic\"]\) particles in a hexagonal grid \
in a \nrectangle of size 2\!\(\*StyleBox[\"Bx\",FontSlant->\"Italic\"]\) by 2\
\!\(\*StyleBox[\"By\",FontSlant->\"Italic\"]\).  If \
\!\(\*StyleBox[\"n\",FontSlant->\"Italic\"]\) is not a perfect square such \
that all the \nrows have the same number of particles, the number of \
particles may be adjusted \nto fit the dimensions. Returns a seven element \
association \n{\\\"\[Rho]\\\", \\\"a\\\", \\\"Nc\\\", \\\"Nr\\\", \\\"Bx\\\", \
\\\"By\\\", \\\"pn\\\"}, repectivley the density, \nparticle spacing, number \
of columns and rows, and the input box parameters (note \nthe quotes are \
required). \\\"pn\\\" is a nested list of {x, y} coordinates of the n \n\
particle positions in lists of rows.\n\nfill[...]\[LeftDoubleBracket]\\\"pn\\\
\"\[RightDoubleBracket] is pnts = {{{x11,y11},[x12,y12}...{x1Nc,y1Nc}},\n\
{{x21,y21},...},...{{xNr1,yNr1},...,{xNrNc,yNrNc}}}.  Thus, point one's \
coordinates \nare best accessed via Flatten[ pnts,1]\[LeftDoubleBracket]1\
\[RightDoubleBracket]).\n\nfill[ Bx, n] (the two parameter version) will set \
By to the default of (\!\(\*SqrtBox[\(3\)]\)/2)Bx.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fill", "[", 
    RowBox[{"Bx_", ",", " ", "By_", ",", " ", "n_"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]", "=", 
        RowBox[{"n", "/", 
         RowBox[{"(", 
          RowBox[{"4", "Bx", " ", "By"}], ")"}]}]}], ",", "a", ",", "Nc", ",",
        "Nr", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"a", "=", 
       SqrtBox[
        RowBox[{"2", "/", 
         RowBox[{"(", 
          RowBox[{"\[Rho]", 
           SqrtBox["3"]}], ")"}]}]]}], ";", " ", 
      RowBox[{"c", "=", 
       RowBox[{
        SqrtBox["3"], "/", "2"}]}], ";", " ", 
      RowBox[{"Nc", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"2", " ", 
         RowBox[{"Bx", "/", "a"}]}], "]"}]}], ";", " ", 
      RowBox[{"Nr", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"n", "/", "Nc"}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"Association", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<\[Rho]\>\"", "\[Rule]", "\[Rho]"}], ",", " ", 
         RowBox[{"\"\<a\>\"", "\[Rule]", "a"}], ",", " ", 
         RowBox[{"\"\<Nr\>\"", "\[Rule]", "Nr"}], ",", " ", 
         RowBox[{"\"\<Nc\>\"", "\[Rule]", "Nc"}], ",", " ", 
         RowBox[{"\"\<Bx\>\"", "\[Rule]", "Bx"}], ",", " ", 
         RowBox[{"\"\<By\>\"", "\[Rule]", "By"}], ",", "\n", "\t\t", 
         RowBox[{"\"\<pn\>\"", "->", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"placeR", "[", 
             RowBox[{"Nc", ",", " ", "a", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"a", "/", "4"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"2", 
                   RowBox[{"Mod", "[", 
                    RowBox[{"i", ",", "2"}], "]"}]}]}], ")"}]}], "-", "Bx"}], 
              ",", 
              RowBox[{
               RowBox[{"a", " ", "c", 
                RowBox[{"(", 
                 RowBox[{"i", "+", 
                  RowBox[{"1", "/", "2"}]}], ")"}]}], "-", "By"}]}], "]"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{"Nr", "-", "1"}]}], "}"}]}], "]"}]}]}], "}"}], 
       "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fill", "[", 
   RowBox[{"Bx_", ",", " ", "n_"}], "]"}], ":=", " ", 
  RowBox[{"fill", "[", 
   RowBox[{"Bx", ",", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SqrtBox["3"], "/", "2"}], ")"}], "Bx"}], ",", "n"}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.9274517737321415`*^9, 3.927451971047587*^9}, {
   3.9274520365123625`*^9, 3.927452060785068*^9}, {3.9274520990161605`*^9, 
