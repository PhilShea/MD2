Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Rho]2", "\[Rule]", 
     RowBox[{"ConditionalExpression", "[", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["T1", 
          RowBox[{"2", "/", "5"}]], " ", "\[Rho]1"}], 
        SuperscriptBox[
         RowBox[{"Root", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox["P2", "5"]}], " ", 
              SuperscriptBox["T1", "3"]}], "+", 
             RowBox[{
              SuperscriptBox["P1", "5"], " ", 
              SuperscriptBox["#1", "3"]}]}], "&"}], ",", "1"}], "]"}], 
         RowBox[{"2", "/", "5"}]]], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"P1", ">", "0"}], "&&", 
          RowBox[{"P2", ">", "0"}], "&&", 
          RowBox[{"T1", ">", "0"}]}], ")"}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"P1", "<", "0"}], "&&", 
          RowBox[{"P2", "<", "0"}], "&&", 
          RowBox[{"T1", ">", "0"}]}], ")"}]}]}], "]"}]}], ",", 
    RowBox[{"T2", "\[Rule]", 
     RowBox[{"ConditionalExpression", "[", 
      RowBox[{
       RowBox[{"Root", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox["P2", "5"]}], " ", 
            SuperscriptBox["T1", "3"]}], "+", 
           RowBox[{
            SuperscriptBox["P1", "5"], " ", 
            SuperscriptBox["#1", "3"]}]}], "&"}], ",", "1"}], "]"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"P1", ">", "0"}], "&&", 
          RowBox[{"P2", ">", "0"}], "&&", 
          RowBox[{"T1", ">", "0"}]}], ")"}], "||", 
        RowBox[{"(", 
