 "The resulting energy looks like a normal distribution with mean ",
 StyleBox["nT",
  FontSlant->"Italic"],
 " and variance ",
 StyleBox["n",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "2"], TraditionalForm]],ExpressionUUID->
  "5648040a-a84e-4257-9e72-6b7ec26dc332"],
