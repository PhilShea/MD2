Cell[TextData[{
 "The function below will generate 2",
 StyleBox["n",
  FontSlant->"Italic"],
 " random deviates (an x & y for each particle) with variance ",
 StyleBox["T",
  FontSlant->"Italic"],
 ", and create the sum of squares divided by two (the total kinetic energy)."
}], "Text",
 CellChangeTimes->{{3.9687608122083683`*^9, 3.968760828888426*^9}, {
  3.968760934273041*^9, 3.968760952105103*^9}, {3.9687610066896753`*^9, 
  3.968761077098153*^9}},ExpressionUUID->"71d1fa11-47a1-4427-a54b-\
5fa4bb5a0b18"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ns", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ns", "[", 
    RowBox[{"n_", ",", "T_"}], "]"}], ":=", 
   RowBox[{"Apply", "[", 
    RowBox[{"Plus", ",", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "^", "2"}], "/", "2"}], "&"}], ",", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", 
           SqrtBox["T"]}], "]"}], ",", 
         RowBox[{"2", "n"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n0", "=", "256"}], ";", 
  RowBox[{"T0", "=", "0.015"}], ";", 
  RowBox[{"ns", "[", 
   RowBox[{"n0", ",", "T0"}], "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9429554417327743`*^9, 3.9429555005748367`*^9}, 
   3.942955571683465*^9, 3.942955603738058*^9, {3.9687609772176523`*^9, 
   3.968760979201989*^9}, {3.968761053754568*^9, 3.968761054426338*^9}},
 CellLabel->
  "In[228]:=",ExpressionUUID->"cdd888e7-e107-49c5-9af1-ca32ebc3042d"],

