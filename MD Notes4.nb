Cell[TextData[{
 StyleBox["FindFormula[]", "Code"],
 " uses some randomization, and it can be difficult to repeat results.  One \
very hopeful result on some prior work was a simple ",
 StyleBox["a+b x Tan[x]", "Code"],
 ", but I lost the parameters.  I added another parameter and used ",
 StyleBox["FindFit[]", "Code"],
 " to get estimates of the parameters. In practice, the ",
 StyleBox["a",
  FontSlant->"Italic"],
 " parameter was small and negative, which give the analog a negative value \
for small energies, and this is of course where the function will live.  \
Therefor, we fit ",
 StyleBox["b x Tan[c x].", "Code"]
}], "Text",
 CellChangeTimes->{{3.9672241431678133`*^9, 3.967224292145494*^9}, {
  3.967617714615291*^9, 3.967617834062718*^9}, {3.967787913245318*^9, 
  3.967787917813347*^9}},ExpressionUUID->"982db803-93b7-4df6-9852-\
f4dfecd148a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fit2", "=", 
  RowBox[{"FindFit", "[", 
   RowBox[{"tabP256", ",", 
    RowBox[{"b", " ", "x", " ", 
     RowBox[{"Tan", "[", 
      RowBox[{"c", " ", "x"}], "]"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"b", ",", "c"}], "}"}], ",", "x"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.967223766839958*^9, 3.9672238539037323`*^9}, {
