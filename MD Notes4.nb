Cell["\<\
We will want to mark a few particular distances, and we\[CloseCurlyQuote]ll \
define a function to help do that.\
\>", "Text",
 CellChangeTimes->{{3.967966729769925*^9, 
  3.9679667559702*^9}},ExpressionUUID->"54b05633-0d36-46a7-9528-9d72675e9959"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "Vline", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Vline", "::", "usage"}], "=", 
  "\"\<Vlin[\!\(\*StyleBox[\"x\",FontSlant->\"Italic\"]\)] can be used to \
draw a vertical line at \!\(\*StyleBox[\"x\",FontSlant->\"Italic\"]\) in a \
plot.  Suggested use is \n\
Prolog\[Rule]{Directive[Gray,Dashed],Vline[x1],Vline[x2]} inside a Plot[] \
function call.\>\""}], "\n", 
 RowBox[{
  RowBox[{"Vline", "[", "x_", "]"}], ":=", 
  RowBox[{"Line", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Scaled", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Scaled", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0"}], "}"}]}], "]"}]}], "}"}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.966947407039814*^9, 3.966947407879938*^9}, {
