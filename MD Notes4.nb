Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]1", " ", 
      RowBox[{"T1", "^", 
       RowBox[{"(", 
        RowBox[{"2", "/", "5"}], ")"}]}]}], "==", 
     RowBox[{"\[Rho]2", " ", 
      RowBox[{"T2", "^", 
       RowBox[{"(", 
        RowBox[{"2", "/", "5"}], ")"}]}]}]}], "&&", 
    RowBox[{
     RowBox[{"P1", "/", 
      RowBox[{"(", 
       RowBox[{"\[Rho]1", " ", "T1"}], ")"}]}], "\[Equal]", 
     RowBox[{"P2", "/", 
      RowBox[{"(", 
       RowBox[{"\[Rho]2", " ", "T2"}], ")"}]}]}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Rho]2", ",", " ", "T2"}], "}"}], ",", " ", "Reals"}], 
