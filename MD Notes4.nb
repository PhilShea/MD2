Cell[TextData[{
 "A function to plot the points returned by ",
 StyleBox["fill[]", "Input"],
 " will be useful:"
}], "Text",
 CellChangeTimes->{{3.942746113628935*^9, 
  3.9427461548453875`*^9}},ExpressionUUID->"96597893-a4d6-433d-babf-\
