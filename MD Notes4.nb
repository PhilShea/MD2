Cell[TextData[{
 "The row height is the distance ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "b56ffcb3-3029-46b8-8656-0ced2acbfcef"],
 " to ",
 StyleBox["K",
  FontSlant->"Italic"],
 ", a 30-60-90 triangle with hypotenuse (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "1"], TraditionalForm]],ExpressionUUID->
  "e01bc22d-f277-4ebd-9dff-44b290a707f1"],
 " - ",
 StyleBox["J",
  FontSlant->"Italic"],
 ") of length ",
 StyleBox["a",
  FontSlant->"Italic"],
 ", so the row height is ",
 StyleBox["a ",
  FontSlant->"Italic"],
 "Sin(60) = ",
 StyleBox["a",
  FontSlant->"Italic"],
 Cell[BoxData[
  FractionBox[
   SqrtBox["3"], "2"]], "Output",
  CellChangeTimes->{3.994324785483802*^9},ExpressionUUID->
  "b947c680-2d40-4b4a-ae7e-fa87135dfa01"],
 ". The box dimensions can be decided for a desired density.  \[Rho] = N/(4 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "x"], TraditionalForm]],ExpressionUUID->
  "282d871e-a92e-4b88-8962-62cabaece390"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "y"], TraditionalForm]],ExpressionUUID->
  "0d13698d-508c-4361-bceb-4a5b5ebefe81"],
 ") = ",
 StyleBox["N",
  FontSlant->"Italic"],
 "/(2",
 Cell[BoxData[
  FormBox[
   SqrtBox["3"], TraditionalForm]],ExpressionUUID->
  "e3ea0a4f-3982-4618-98e5-ae3dda235ce0"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["b", "x", "2"], TraditionalForm]],ExpressionUUID->
  "b709a499-8987-4b92-8460-2bf7668df918"],
 ") (where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "y"], " "}], TraditionalForm]],ExpressionUUID->
  "24df03b8-7016-4d45-b506-78ebeeb845cc"],
 "= ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], 
    RowBox[{
     SubscriptBox["b", "x"], "/", "2"}]}], TraditionalForm]],ExpressionUUID->
  "38c8bbfa-cb92-4784-8cc8-d70fbd89dcd6"],
 "k; ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["b", "x"], "/", 
    FormBox[
     SubscriptBox["b", "y"],
     TraditionalForm]}], "=", 
   RowBox[{"2", "/", 
    SqrtBox["3"]}]}]],ExpressionUUID->"4ee4800e-3272-41fc-a215-6ecf133d7513"],
 " )"
}], "Text",
 CellChangeTimes->{{3.927639970214085*^9, 3.9276401100700855`*^9}, {
  3.9276401857071857`*^9, 3.9276402704140744`*^9}, {3.972210665837832*^9, 
  3.972210783695993*^9}, {3.994324512586228*^9, 3.994324685507411*^9}, {
  3.994324724540065*^9, 3.994324762812331*^9}, {3.994324810865432*^9, 
  3.99432482591387*^9}},ExpressionUUID->"d208f14f-4df2-497a-bd37-\
c4f627531c05"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "Bx", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Bx", "::", "usage"}], "=", 
   "\"\<Bx[n\!\(\*StyleBox[\",\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"\
\[Rho]\",FontSlant->\"Italic\"]\)] will create the x dimension for an array \
of n particles at density \n\[Rho]. \
\!\(\*StyleBox[\"n\",FontSlant->\"Italic\"]\) should be an integer.\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Bx", "[", 
   RowBox[{"n_", ",", "\[Rho]_"}], "]"}], ":=", 
  SqrtBox[
   FractionBox["n", 
    RowBox[{"2", 
     SqrtBox["3"], "\[Rho]"}]]]}]}], "Code",
 CellChangeTimes->{{3.927640393010669*^9, 3.927640505560068*^9}, {
  3.966938318585843*^9, 3.9669384181619587`*^9}, {3.9669384541466227`*^9, 
