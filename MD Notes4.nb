  RowBox[{
   RowBox[{
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{"Clip", "[", 
       RowBox[{
        RowBox[{"P256", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "#"}], ",", "#"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"-", "#"}], ",", "#"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Contours", "\[Rule]", "30"}], ",", 
      RowBox[{"ColorFunction", "\[Rule]", "Hue"}], ",", 
      RowBox[{"PlotLegends", "\[Rule]", "Automatic"}]}], "]"}], "&"}], "[", 
