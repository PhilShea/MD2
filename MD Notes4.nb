Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "rn", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rn", "::", "usage"}], "=", 
   "\"\<rn[\!\(\*StyleBox[\"r\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\",\",\
FontSlant->\"Italic\"]\)\!\(\*StyleBox[\" \
\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"n\",FontSlant->\"Italic\"]\)]=\!\(\
\*SuperscriptBox[\(r\), \(-n\)]\).\n\
rn[\!\(\*StyleBox[\"r_\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\",\",\
FontSlant->\"Italic\"]\)\!\(\*StyleBox[\" \
\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"n_:\",FontSlant->\"Italic\"]\)\!\(\
\*StyleBox[\"5\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\",\",FontSlant->\"\
Italic\"]\)\!\(\*StyleBox[\" \",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"Rskn\
\",FontSlant->\"Italic\"]\)\!\(\(\(_\)\(:\)\)\)3.5] respects the skin depth \
and causes the potential to be zero \nat the skin depth range \!\(\*StyleBox[\
\"Rskn\",FontSlant->\"Italic\"]\).\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rn", "[", 
    RowBox[{"r_", ",", "n_"}], "]"}], ":=", 
   SuperscriptBox["r", 
    RowBox[{"-", "n"}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rn", "[", 
   RowBox[{"r_", ",", 
    RowBox[{"n_:", "5"}], ",", 
    RowBox[{"Rskn_:", "3.5"}]}], "]"}], ":=", 
  TagBox[GridBox[{
     {"\[Piecewise]", GridBox[{
        {"0", 
         RowBox[{"r", "\[GreaterEqual]", "Rskn"}]},
        {
         RowBox[{
          RowBox[{"rn", "[", 
           RowBox[{"r", ",", "n"}], "]"}], "-", 
          RowBox[{"rn", "[", 
           RowBox[{"Rskn", ",", "n"}], "]"}]}], "True"}
       },
