Cell[TextData[{
 "By definition, ",
 StyleBox["p2d", "Input"],
 " is now moved to the edge of ",
 StyleBox["p4d", "Input"],
 "\[CloseCurlyQuote]s ",
 StyleBox["NHOPr", "Input"],
 ", and thus ",
 StyleBox["p4d", "Input"],
 " has only five particles in its orbit. ",
 StyleBox["p2d", "Input"],
 " now has ",
 StyleBox["p5d", "Input"],
 " in its orbit, and so it has six particles. ",
 StyleBox["p5d", "Input"],
 " has ",
 StyleBox["p2c", "Input"],
 ", so it has seven. So by moving the one particle, we created a pair of \
dislocations."
}], "Text",
 CellChangeTimes->{{3.993719308789151*^9, 3.993719358006181*^9}, {
  3.9937194102066317`*^9, 3.993719481087515*^9}, {3.993719546799938*^9, 
  3.9937195833997793`*^9}, {3.993719665496519*^9, 
  3.993719687940611*^9}},ExpressionUUID->"73fc68ad-d664-4217-9479-\
a63e81d2c335"],

Cell[CellGroupData[{

Cell[TextData[{
 "Replicating the ",
 StyleBox["MD2", "Input"],
 " Experiment"
}], "Subsubsubsection",
 CellChangeTimes->{{3.99381749389172*^9, 
  3.993817503434616*^9}},ExpressionUUID->"5e0c4e31-7a6a-4685-8b40-\
2e15eb76e86e"],

Cell[TextData[{
 "The experiment moving a particle between two particles added energy of \
0.01256 \[Epsilon] per particle. We can use ",
 Cell[BoxData[
  FormBox[
   StyleBox["Pdx", "Input"], TraditionalForm]],ExpressionUUID->
  "41c7461c-3f45-418b-85d4-3a03db9f823c"],
 " to estimate that too.  In that scenario, we moved a particle up (y only) \
by 1.6547. This experiment was performed on a small system of 100 particles."
}], "Text",
 CellChangeTimes->{{3.993561894826157*^9, 3.99356199235563*^9}, {
   3.993562054988378*^9, 3.9935620662282057`*^9}, {3.993636824481319*^9, 
   3.993636901724874*^9}, 3.993637430137562*^9, {3.9936381212474194`*^9, 
   3.9936381808643217`*^9}, {3.993978537169303*^9, 
   3.9939785381286573`*^9}},ExpressionUUID->"7b2ee61d-42af-4c91-82f3-\
28d5292e2d59"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"p5cfunc", "[", 
   RowBox[{"0", ",", "1.6547"}], "]"}], "/", "100"}]], "Input",
 CellChangeTimes->{{3.99356207298042*^9, 3.993562082652472*^9}, {
  3.993636784928355*^9, 3.993636813681723*^9}, {3.9936375950843983`*^9, 
  3.993637596066464*^9}, {3.993638088541093*^9, 3.9936380903511467`*^9}},
 CellLabel->
  "In[470]:=",ExpressionUUID->"aeef9486-77f3-4e42-a707-d35dd455b2e8"],

Cell[BoxData["0.013350160343118141`"], "Output",
 CellChangeTimes->{{3.993636805033408*^9, 3.993636814830352*^9}, 
   3.993637597648965*^9, 3.993638091267869*^9, 3.993981235737962*^9, 
   3.994166461146044*^9, 3.9943237653893013`*^9, 3.994419655732472*^9, 
   3.9944368099248867`*^9},
 CellLabel->
  "Out[470]=",ExpressionUUID->"1b4039cc-5114-48bb-869d-a7a58dd4f6cc"]
}, Open  ]],

Cell["\<\
That is a bit bigger than we saw.  It is likely that the initial motion was \
large enough that some energy was lost in the first few steps.\
\>", "Text",
 CellChangeTimes->{{3.9936382021745043`*^9, 
  3.993638268056879*^9}},ExpressionUUID->"df29641a-d52c-45fd-b6f3-\
e19074afddc5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Moving Two Particles", "Subsubsection",
 CellChangeTimes->{{3.9938162060498734`*^9, 
  3.99381621291405*^9}},ExpressionUUID->"9a9215c5-d993-4c49-95d9-\
24f602778400"],

Cell[TextData[{
 "A more likely scenario is if two particles were displaced toward each \
other, and thus the distance is halved (",
 StyleBox["p2c", "Input"],
 " would remain in ",
 StyleBox["p4c", "Input"],
 "'s ",
 StyleBox["NHOPr", "Input"],
 " range)."
}], "Text",
 CellChangeTimes->{{3.993816219826251*^9, 
  3.993816220330278*^9}},ExpressionUUID->"c498f45f-3429-4a7e-a145-\
d75507744ca4"],

Cell[TextData[{
 StyleBox["rn2[]", "Input"],
 "\[CloseCurlyQuote]s estimate of that is high:"
}], "Text",
