Cell[TextData[{
 "almost seven extra particles.  The procedure requires two sorts, a search \
of the sorted list for the box limits in both lists, and then building the \
list of of particles in the box. We need to keep the particle interaction \
list in more-or-less ascending order too.  That is, particle ",
 StyleBox["i",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s list of interacting particles should only contain \
particle numbers greater then ",
 StyleBox["i",
  FontSlant->"Italic"],
 ". The particles within ",
 StyleBox["i",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s list need not be in any order.\n\n\
Let\[CloseCurlyQuote]s look at the ten particle system created ",
 ButtonBox["above",
  BaseStyle->"Hyperlink",
  ButtonData->"pnts10"],
 " as an example."
}], "Text",
 CellChangeTimes->{{3.964771958970283*^9, 3.9647720674831457`*^9}, {
  3.96477211272861*^9, 3.9647722708519697`*^9}, {3.964774802932749*^9, 
  3.9647749127083282`*^9}, {3.964775206853672*^9, 3.964775219830312*^9}, {
  3.96477525562201*^9, 
  3.964775255623856*^9}},ExpressionUUID->"c5aef00b-29ff-4dc3-87a8-\
3b2b208f53f3"],

