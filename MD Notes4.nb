Cell[TextData[{
 "The energy of moving ",
 StyleBox["p2c", "Input"],
 " to ",
 StyleBox["pip1", "Input"],
 " (and no other changes) can be estimated using ",
 StyleBox["Pdx[]", "Input"],
 ", which returns a function of a vector for a chosen particle number. If we \
consider moving to ",
 StyleBox["pip1", "Input"],
 " puts ",
 StyleBox["p2c", "Input"],
 " outside ",
 StyleBox["p4c", "Input"],
 "\[CloseCurlyQuote]s range and moves it into ",
 StyleBox["p5c", "Input"],
 "\[CloseCurlyQuote]s range, we have the minimum energy of such an occurrence."
}], "Text",
 CellChangeTimes->{{3.9932201695107737`*^9, 3.993220237421356*^9}, {
   3.9932205012793617`*^9, 3.993220538719606*^9}, {3.993220600840439*^9, 
   3.993220635696558*^9}, {3.993220982763887*^9, 3.9932209872198*^9}, {
   3.9932210189321947`*^9, 3.993221019468112*^9}, {3.993543210681857*^9, 
   3.993543281053801*^9}, {3.993547229385812*^9, 3.993547234657867*^9}, {
   3.9937197072804937`*^9, 3.993719754369177*^9}, {3.993719797225506*^9, 
   3.993719812985721*^9}, 
   3.9939777097911654`*^9},ExpressionUUID->"549f0f8b-e498-48bb-b164-\
4adc2a0cb3a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Pdx"}]], "Input",
 CellChangeTimes->{{3.993220391952149*^9, 3.993220399286716*^9}, {
  3.9932207948737173`*^9, 3.9932207986262712`*^9}, {3.993220843355321*^9, 
  3.993220851250766*^9}, {3.993220992716851*^9, 3.99322099742*^9}},
 CellLabel->
  "In[452]:=",ExpressionUUID->"866f8cbd-b586-4161-8727-9e57438853b0"],

Cell[BoxData["\<\"Pdx[\\!\\(\\*StyleBox[\\\"p_Integer\\\",FontSlant->\\\"\
Italic\\\"]\\)\\!\\(\\*StyleBox[\\\",\\\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\
\\*StyleBox[\\\"pnts_Association\\\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\\*\
StyleBox[\\\",\\\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\"Rskn_\\\
\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\",\\\",FontSlant->\\\"\
Italic\\\"]\\)\\!\\(\\*StyleBox[\\(\\*StyleBox[\\\"n_\\\",FontSlant->\\\"\
Italic\\\"] : \\)]\\)5] returns a function of \
{\\!\\(\\*StyleBox[\\\"x\\\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\
\",\\\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\"y\\\",FontSlant->\\\
\"Italic\\\"]\\)} which computes the \\npotential energy of particle number \
\\!\\(\\*StyleBox[\\\"p\\\",FontSlant->\\\"Italic\\\"]\\) moved a distance of \
{\\!\\(\\*StyleBox[\\\"x\\\",FontSlant->\\\"Italic\\\"]\\), \
\\!\\(\\*StyleBox[\\\"y\\\",FontSlant->\\\"Italic\\\"]\\)} from its home \
(crystaline) position \\nbased on all the other particles being in their home \
positions with a potential function of 1/\\!\\(\\*SuperscriptBox[\\(r\\), \
\\(n\\)]\\) and a \\nrange of \
\\!\\(\\*StyleBox[\\\"Rskn\\\",FontSlant->\\\"Italic\\\"]\\). The function \
does not enforce periodic boundary conditions.\"\>"], "Print", "PrintUsage",
 CellChangeTimes->{3.994436809514613*^9},
 CellTags->
  "Info4523994422409-8551224",ExpressionUUID->"a43111b1-8671-45ae-9350-\
9645c1a118b8"]
}, Open  ]],

Cell[TextData[{
 "We are moving particle ",
 StyleBox["p2c", "Input"],
 " (169)."
}], "Text",
 CellChangeTimes->{{3.993543289842431*^9, 3.9935433283389606`*^9}, {
  3.993547419634892*^9, 3.99354745479536*^9}, {3.9935583945563*^9, 
  3.9935583972443447`*^9}},ExpressionUUID->"e44f2312-142c-440a-93a7-\
cccec68bb45d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"p5cfunc", "=", 
  RowBox[{"Pdx", "[", 
   RowBox[{"169", ",", "pnts288", ",", "3.5", ",", "5"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.993221071917891*^9, 3.993221110757018*^9}, {
  3.993221151013001*^9, 3.993221179141776*^9}, {3.9935474460445547`*^9, 
  3.993547447667368*^9}},
 CellLabel->
  "In[453]:=",ExpressionUUID->"b8ab609f-5106-4f18-90aa-a11314397d20"],

Cell[BoxData[
 RowBox[{"Function", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x$", ",", "y$"}], "}"}], ",", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dev$", "=", 
        RowBox[{"point$166946", "+", 
         RowBox[{"{", 
          RowBox[{"x$", ",", "y$"}], "}"}]}]}], ",", "skinlst$"}], "}"}], ",", 
     RowBox[{
      RowBox[{"skinlst$", "=", 
       RowBox[{"Nearest", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Delete", "[", 
           RowBox[{"pntarry$166946", ",", "169"}], "]"}], 
          "\[Rule]", "\<\"Distance\"\>"}], ",", "dev$", ",", 
         RowBox[{"{", 
          RowBox[{"All", ",", "3.5`"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"Plus", "@@", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"rn", "[", 
            RowBox[{"#1", ",", "5", ",", "3.5`"}], "]"}]}], "&"}], ")"}], "/@",
         "skinlst$"}]}]}]}], "]"}]}], "]"}]], "Output",
 CellChangeTimes->{3.993221180441511*^9, 3.993222303328018*^9, 
  3.9935474633060713`*^9, 3.993981235440955*^9, 3.994166460885769*^9, 
  3.994323765153306*^9, 3.994419655399722*^9, 3.994436809553738*^9},
 CellLabel->
  "Out[453]=",ExpressionUUID->"1c4b5e1d-1eda-40af-a41a-b26d3592ac98"]
}, Open  ]],

