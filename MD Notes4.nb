Cell["\<\
 Let\[CloseCurlyQuote]s say that the particle is moving fast to the left \
(negative velocity) of -0.6 (hot run of S4.0021 max speed) at -a79/2 (that \
is, it is quite near a particle).\
\>", "Text",
 CellChangeTimes->{{3.9703180214938517`*^9, 3.970318081701005*^9}, {
  3.9703183507112103`*^9, 3.970318387791641*^9}, {3.970318442840123*^9, 
  3.970318463968075*^9}},ExpressionUUID->"6ff2f2f1-6559-4b6f-8f85-\
48cef12a5383"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Verlet", "[", 
   RowBox[{"p_", ",", "v_", ",", " ", "dt_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{"f", "[", 
        RowBox[{"p", ",", "a79", ",", "5"}], "]"}]}], 
      RowBox[{"(*", 
       RowBox[{"acceleration", " ", "at", " ", "time", " ", "n"}], "*)"}], 
      ",", " ", "pnm1", ",", "pen", ",", "ken", ",", "ten", ",", "pnp1", ",", 
      "vnp1", ",", "kenp1", ",", "penp1", ",", "tenp1"}], "}"}], ",", 
    "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"pnm1", "=", 
      RowBox[{"p", "-", 
       RowBox[{"v", "*", "dt"}]}]}], 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"position", " ", "at", " ", "step", " ", "n"}], " ", "-", " ", 
       "1"}], "*)"}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"pen", "=", 
      RowBox[{"rn2", "[", 
       RowBox[{"p", ",", "a79", ",", "5"}], "]"}]}], 
     RowBox[{"(*", " ", 
      RowBox[{"potential", " ", "energy", " ", "at", " ", "step", " ", "n"}], 
      "*)"}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"ken", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], 
       SuperscriptBox["v", "2"]}]}], 
     RowBox[{"(*", " ", 
      RowBox[{
      "kinetic", " ", "energy", " ", "at", " ", "step", " ", "n", " ", "for", 
       " ", "unity", " ", "mass"}], "*)"}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"ten", "=", 
      RowBox[{"pen", "+", "ken"}]}], 
     RowBox[{"(*", " ", 
      RowBox[{"total", " ", "energy", " ", "at", " ", "step", " ", "n"}], 
      "*)"}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"pnp1", "=", 
      RowBox[{
       RowBox[{"2", "p"}], "-", "pnm1", "+", 
       RowBox[{"a", " ", 
        SuperscriptBox["dt", "2"]}]}]}], 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"position", " ", "at", " ", "step", " ", "n"}], " ", "+", " ", 
       "1"}], "*)"}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"vnp1", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"pnp1", "-", "p"}], ")"}], "/", "dt"}]}], " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"velocity", " ", "at", " ", "step", " ", "n"}], "+", "1"}], 
      " ", "*)"}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"kenp1", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], 
       SuperscriptBox["vnp1", "2"]}]}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"penp1", "=", 
      RowBox[{"rn2", "[", 
       RowBox[{"pnp1", ",", "a79", ",", "5"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"tenp1", "=", 
      RowBox[{"kenp1", "+", "penp1"}]}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<pn\>\"", "\[Rule]", "p"}], ",", 
       RowBox[{"\"\<pnm1\>\"", "\[Rule]", "pnm1"}], ",", 
       RowBox[{"\"\<pen\>\"", "\[Rule]", "pen"}], ",", 
       RowBox[{"\"\<ken\>\"", "\[Rule]", "ken"}], ",", 
       RowBox[{"\"\<ten\>\"", "\[Rule]", "ten"}], ",", 
       RowBox[{"\"\<pnp1\>\"", "\[Rule]", "pnp1"}], ",", 
       RowBox[{"\"\<vnp1\>\"", "\[Rule]", "vnp1"}], ",", 
       RowBox[{"\"\<kenp1\>\"", "\[Rule]", "kenp1"}], ",", "\n", "\t", 
       RowBox[{"\"\<penp1\>\"", "\[Rule]", "penp1"}], ",", 
       RowBox[{"\"\<tenp1\>\"", "\[Rule]", "tenp1"}], ",", 
       RowBox[{"\"\<dte%\>\"", "\[Rule]", 
        RowBox[{"100", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"tenp1", "-", "ten"}], ")"}], "/", "ten"}]}]}]}], 
      "|>"}]}]}], "]"}]}]], "Code",
 CellChangeTimes->{{3.970323086348854*^9, 3.970323120219694*^9}, {
