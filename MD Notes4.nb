  3.970901008846601*^9}},ExpressionUUID->"3ba6cd46-bd23-4715-94af-\
bd91027358b6"],

Cell[TextData[{
 "What have we accomplished here? The update to the positions also updates \
the velocity, and in the velocity Verlet that update is scaled by \[Delta]t \
instead of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Delta]t", "2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "ae45b5d6-b272-4110-9550-35b3222df3ea"],
 "."
}], "Text",
 CellChangeTimes->{{3.970901111846553*^9, 3.9709011185825644`*^9}, {
  3.9710907220553703`*^9, 3.9710908299528923`*^9}, {3.971090991881963*^9, 
  3.9710910578107*^9}},ExpressionUUID->"b7bb8bad-82a5-499d-86fa-80528ceee646"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VVerlet", "[", 
   RowBox[{"p_", ",", "v_", ",", " ", "dt_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"an", "=", 
       RowBox[{"f", "[", 
        RowBox[{"p", ",", "a79", ",", "5"}], "]"}]}], 
      RowBox[{"(*", 
       RowBox[{"acceleration", " ", "at", " ", "time", " ", "n"}], "*)"}], 
      ",", "\n", "\t ", 
      RowBox[{"pen", "=", 
       RowBox[{"rn2", "[", 
        RowBox[{"p", ",", "a79", ",", "5"}], "]"}]}], 
      RowBox[{"(*", " ", 
       RowBox[{"potential", " ", "energy", " ", "at", " ", "step", " ", "n"}],
        "*)"}], ",", "\[IndentingNewLine]", "\t ", 
      RowBox[{"ken", "=", 
       RowBox[{
        SuperscriptBox["v", "2"], "/", "2"}]}], 
      RowBox[{"(*", " ", 
       RowBox[{
       "kinetic", " ", "energy", " ", "at", " ", "step", " ", "n", " ", "for",
         " ", "unity", " ", "mass"}], "*)"}], ",", "\n", "\t ", "anp1", ",", 
      "ten", ",", "pnp1", ",", "vnp1", ",", "kenp1", ",", "penp1", ",", 
      "tenp1"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"ten", "=", 
      RowBox[{"pen", "+", "ken"}]}], 
     RowBox[{"(*", " ", 
      RowBox[{"total", " ", "energy", " ", "at", " ", "step", " ", "n"}], 
      "*)"}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"pnp1", "=", 
      RowBox[{"p", "+", 
       RowBox[{"v", "*", "dt"}], "+", 
       RowBox[{"an", "*", 
        RowBox[{
         SuperscriptBox["dt", "2"], "/", "2"}]}]}]}], 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"position", " ", "at", " ", "step", " ", "n"}], " ", "+", " ", 
       "1"}], "*)"}], ";", "\n", "\t", 
     RowBox[{"anp1", "=", 
      RowBox[{"f", "[", 
       RowBox[{"pnp1", ",", "a79", ",", "5"}], "]"}]}], " ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"acceleration", " ", "at", " ", "n"}], "+", "1"}], "*)"}], ";",
      "\[IndentingNewLine]", "\t", 
     RowBox[{"vnp1", "=", 
      RowBox[{"v", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"an", "+", "anp1"}], ")"}], 
        RowBox[{"dt", "/", "2"}]}]}]}], " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"velocity", " ", "at", " ", "step", " ", "n"}], "+", "1"}], 
      " ", "*)"}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"kenp1", "=", 
      RowBox[{
       SuperscriptBox["vnp1", "2"], "/", "2"}]}], ";", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"penp1", "=", 
      RowBox[{"rn2", "[", 
       RowBox[{"pnp1", ",", "a79", ",", "5"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"tenp1", "=", 
      RowBox[{"kenp1", "+", "penp1"}]}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<pn\>\"", "\[Rule]", "p"}], ",", 
       RowBox[{"\"\<pen\>\"", "\[Rule]", "pen"}], ",", 
       RowBox[{"\"\<ken\>\"", "\[Rule]", "ken"}], ",", 
       RowBox[{"\"\<ten\>\"", "\[Rule]", "ten"}], ",", 
       RowBox[{"\"\<pnp1\>\"", "\[Rule]", "pnp1"}], ",", "\n", "\t  ", 
       RowBox[{"\"\<vnp1\>\"", "\[Rule]", "vnp1"}], ",", 
       RowBox[{"\"\<kenp1\>\"", "\[Rule]", "kenp1"}], ",", "\n", "\t  ", 
       RowBox[{"\"\<penp1\>\"", "\[Rule]", "penp1"}], ",", 
       RowBox[{"\"\<tenp1\>\"", "\[Rule]", "tenp1"}], ",", 
       RowBox[{"\"\<dte%\>\"", "\[Rule]", 
        RowBox[{"100", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"tenp1", "-", "ten"}], ")"}], "/", "ten"}]}]}]}], 
      "|>"}]}]}], "]"}]}]], "Code",
 CellChangeTimes->{{3.970323086348854*^9, 3.970323120219694*^9}, {
   3.970323157524685*^9, 3.970323165987753*^9}, {3.9703232104615602`*^9, 
   3.970323266988761*^9}, {3.9703233323177967`*^9, 3.9703233996702957`*^9}, {
