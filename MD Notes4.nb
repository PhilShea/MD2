Cell["Here is the equation we need to solve: ", "Text",
 CellChangeTimes->{{3.993139498319804*^9, 
  3.9931395150708723`*^9}},ExpressionUUID->"03888f04-d936-459e-b10f-\
b81a6c83c3ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ss", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{
           "p5c", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          ")"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{
           "p5c", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          ")"}], "2"]}], "==", 
       SuperscriptBox["NHOPr", "2"]}], ")"}], "&&", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{
           "p4c", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          ")"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{
           "p4c", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          ")"}], "2"]}], "==", 
       SuperscriptBox["NHOPr", "2"]}], ")"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.993137439316811*^9, 3.99313744453255*^9}, {
  3.993137523709783*^9, 3.993137691399562*^9}, {3.993137722481045*^9, 
  3.993137724103774*^9}, {3.993137838673009*^9, 3.9931378805698147`*^9}, {
  3.993138085851788*^9, 3.993138095114684*^9}, {3.993138465343528*^9, 
  3.993138472278298*^9}, {3.993138865162176*^9, 3.993138868009457*^9}, {
  3.993139408534593*^9, 3.993139409150378*^9}},
 CellLabel->
  "In[447]:=",ExpressionUUID->"5fb39e76-3433-4334-bf7d-05bbd6d58c4f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", 
      RowBox[{
       FractionBox["1", "28"], " ", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{"14", " ", 
           SqrtBox[
            RowBox[{"2", " ", "\[Pi]"}]]}], 
          SuperscriptBox["3", 
           RowBox[{"1", "/", "4"}]]], "-", 
         RowBox[{"3", " ", 
          SqrtBox[
           RowBox[{"14", " ", 
            RowBox[{"(", 
             RowBox[{"6", "-", 
              RowBox[{"3", " ", 
               SqrtBox["3"]}]}], ")"}], " ", "\[Pi]"}]]}]}], ")"}]}]}], ",", 
     RowBox[{"y", "\[Rule]", 
      RowBox[{
       FractionBox["1", "28"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"14", " ", 
          SuperscriptBox["3", 
           RowBox[{"1", "/", "4"}]], " ", 
          SqrtBox[
           RowBox[{"2", " ", "\[Pi]"}]]}], "+", 
         SqrtBox[
          RowBox[{"14", " ", 
           RowBox[{"(", 
            RowBox[{"2", "-", 
             SqrtBox["3"]}], ")"}], " ", "\[Pi]"}]]}], ")"}]}]}]}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", 
      RowBox[{
       FractionBox["1", "28"], " ", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{"14", " ", 
           SqrtBox[
            RowBox[{"2", " ", "\[Pi]"}]]}], 
          SuperscriptBox["3", 
           RowBox[{"1", "/", "4"}]]], "+", 
         RowBox[{"3", " ", 
          SqrtBox[
           RowBox[{"14", " ", 
            RowBox[{"(", 
             RowBox[{"6", "-", 
              RowBox[{"3", " ", 
               SqrtBox["3"]}]}], ")"}], " ", "\[Pi]"}]]}]}], ")"}]}]}], ",", 
     RowBox[{"y", "\[Rule]", 
      RowBox[{
       FractionBox["1", "28"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"14", " ", 
          SuperscriptBox["3", 
           RowBox[{"1", "/", "4"}]], " ", 
          SqrtBox[
           RowBox[{"2", " ", "\[Pi]"}]]}], "-", 
         SqrtBox[
          RowBox[{"14", " ", 
           RowBox[{"(", 
            RowBox[{"2", "-", 
             SqrtBox["3"]}], ")"}], " ", "\[Pi]"}]]}], ")"}]}]}]}], "}"}]}], 
