Cell[CellGroupData[{

Cell["Other Topics", "Section",
 CellChangeTimes->{{3.9703152092309017`*^9, 
  3.9703152115911217`*^9}},ExpressionUUID->"3a640333-700e-4168-9028-\
fb0c999b6fd2"],

Cell[CellGroupData[{

Cell["Pair Distribution Function", "Subsection",
 CellChangeTimes->{{3.971336738037979*^9, 
  3.971336767718121*^9}},ExpressionUUID->"b7a5dc2b-b7fb-4b45-9fad-\
d9d86ec1f674"],

Cell["\<\
The exact pair distribution function is a sum of Dirac delta functions based \
on the particle location:\
\>", "Text",
 CellChangeTimes->{{3.971336780129263*^9, 3.9713368011025333`*^9}, {
  3.971336916839563*^9, 
  3.971336933183762*^9}},ExpressionUUID->"6edc61be-82c0-432a-8bda-\
ebbdfd764c96"],

Cell[TextData[{
 StyleBox["g",
  FontSlant->"Italic"],
 "(",
 StyleBox["r",
  FontSlant->"Italic"],
 ") = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"2", "N"}]], TraditionalForm]],ExpressionUUID->
  "e3410fc9-26d2-43d0-a539-3e6dc6c410df"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], 
     RowBox[{"N", "-", "1"}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", 
       RowBox[{"i", "+", "1"}]}], "N"], 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox[
          StyleBox["r",
           FontWeight->"Bold"], "ij"], "\[RightBracketingBar]"}], "-", "r"}], 
       ")"}], "\[RightAngleBracket]"}]}]}], TraditionalForm]],ExpressionUUID->
  "af832a5f-822f-4a5d-9bdf-77387eba2c05"]
}], "Text",
 CellChangeTimes->{{3.971336938081506*^9, 3.971336975336528*^9}, {
  3.971337022212048*^9, 3.9713372211139107`*^9}, {3.971337442643293*^9, 
  3.971337460803287*^9}},ExpressionUUID->"47859eaf-d46d-458d-a949-\
578ef6096637"],

Cell[TextData[{
 "where N is the number of particles, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["r",
     FontWeight->"Bold"], "ij"], TraditionalForm]],ExpressionUUID->
  "48b4dd1c-842b-411b-a4a1-f035f5cb64f9"],
 "is the vector between particles ",
 StyleBox["i",
  FontSlant->"Italic"],
 " & ",
 StyleBox["j",
  FontSlant->"Italic"],
 ", and the angle brackets indicate the expectation or average. In our \
simulation system, we can compute this directly, but this isn\
\[CloseCurlyQuote]t really useful, as ",
 StyleBox["g",
  FontSlant->"Italic"],
 "(",
 StyleBox["r",
  FontSlant->"Italic"],
 ") is zero everywhere but where there are particles. With a small number of \
particles, we would not expect this function to \[OpenCurlyDoubleQuote]fill \
in\[CloseCurlyDoubleQuote] the gaps."
}], "Text",
 CellChangeTimes->{{3.971337196915959*^9, 3.971337341914735*^9}, {
  3.971337380666739*^9, 3.971337410074994*^9}, {3.971337470723398*^9, 
  3.971337570324246*^9}, {3.971337644694531*^9, 
  3.971337644695113*^9}},ExpressionUUID->"83046d35-1160-4970-8202-\
d3daeafdc2cf"],

Cell[TextData[{
 "If we discretize ",
 StyleBox["r",
  FontSlant->"Italic"],
 " such that an array r[i] has the number of points found between (",
 StyleBox["i",
  FontSlant->"Italic"],
 "-1)\[Delta]r < ",
 StyleBox["r ",
  FontSlant->"Italic"],
 "< ",
 StyleBox["i ",
  FontSlant->"Italic"],
 "\[Delta]",
 StyleBox["r",
  FontSlant->"Italic"],
 ", we might find a useful function.We can walk over all particle pairs as \
above, but increment r[Floor[",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    SubscriptBox["r", "ij"], "\[RightBracketingBar]"}], TraditionalForm]],
  ExpressionUUID->"a1d84bc8-7444-4a08-8541-010b386bf165"],
 "/\[Delta]",
 StyleBox["r",
  FontSlant->"Italic"],
 "]+1] (that is, if the ratio is less than one, increment the first location, \
and so on)."
}], "Text",
 CellChangeTimes->{{3.971337196915959*^9, 3.971337341914735*^9}, {
  3.971337380666739*^9, 3.971337410074994*^9}, {3.971337470723398*^9, 
  3.971337570324246*^9}, {3.971337646340599*^9, 3.971337713948883*^9}, {
  3.971337765253446*^9, 3.971337876974347*^9}, {3.97133791088028*^9, 
  3.9713380153354073`*^9}, {3.971338854325695*^9, 3.971338917502293*^9}, {
  3.9713389743266478`*^9, 
  3.971339022711076*^9}},ExpressionUUID->"57fffda3-f5ec-45a6-ac29-\
45a5c12bb9c5"],

Cell[TextData[{
 "Recall that the fill[] function will place particles in a grid and return \
an ",
 StyleBox["association",
  FontSlant->"Italic"],
 " of the main parameters. We will use the \[OpenCurlyDoubleQuote]Bx\
\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]By\[CloseCurlyDoubleQuote], \
and \[OpenCurlyDoubleQuote]pn\[CloseCurlyDoubleQuote] elements, the x and y \
box lengths and the particles themselves. First, we need to establish \
periodic boundary conditions."
}], "Text",
 CellChangeTimes->{{3.971339622475998*^9, 3.9713397713956347`*^9}, {
  3.971340868579337*^9, 3.971340883395465*^9}, {3.97169135858848*^9, 
  3.97169136890856*^9}, {3.9719478080042887`*^9, 3.971947839628076*^9}, {
  3.9719478723566227`*^9, 
  3.971947901348351*^9}},ExpressionUUID->"9dde925a-76ea-467b-9287-\
640b07d12f94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "pbc", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pbc", "::", "usage"}], "=", 
   "\"\<pbc[{x,y},Bx,By] will return a pair {xi,yi} that obey the \nperiodic \
boundary conditions on Bx and By.}\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pbc", "[", 
    RowBox[{"x_", ",", "B_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", "x", "]"}], "<=", "B"}], ",", "0", ",", 
     RowBox[{
      RowBox[{"Sign", "[", "x", "]"}], "2", "B"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pbc", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], ",", "Bx_", ",", "By_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "-", 
     RowBox[{"pbc", "[", 
      RowBox[{"x", ",", "Bx"}], "]"}]}], ",", 
    RowBox[{"y", "-", 
     RowBox[{"pbc", "[", 
      RowBox[{"y", ",", "By"}], "]"}]}]}], "}"}]}]}], "Code",
 CellChangeTimes->{{3.971339801451511*^9, 3.9713398328756847`*^9}, {
   3.971340505320546*^9, 3.971340509592392*^9}, {3.971340542248588*^9, 
   3.971340561353009*^9}, {3.971340651617096*^9, 3.971340742442518*^9}, {
   3.97134079103472*^9, 3.971340840795163*^9}, {3.971341034358507*^9, 
   3.971341243846261*^9}, {3.971341274526553*^9, 3.971341294894475*^9}, 
   3.971343099748289*^9, {3.97194792530177*^9, 3.9719479297564983`*^9}, 
   3.971952088513208*^9, 3.971954378668313*^9},
 CellLabel->
  "In[369]:=",ExpressionUUID->"b685dad3-f172-4570-9324-ce27f0d9c049"],

Cell["Here is an example:", "Text",
 CellChangeTimes->{{3.971947938964664*^9, 
  3.971947943636447*^9}},ExpressionUUID->"90f12f23-ac88-4f91-b023-\
c113edd87714"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"12", "-", 
    RowBox[{"pbc", "[", 
     RowBox[{"12", ",", "7"}], "]"}]}], ",", 
