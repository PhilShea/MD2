Cell[TextData[{
 "The contour plot below shows the energy (clipped to a maximum value of 2) \
around the center of particle 120.  The six large red circles are \
more-or-less centered on the adjacent particles. A black dot shows the six \
surrounding particles, and the black dashed lines show each surrounding \
particle\[CloseCurlyQuote]s ",
 StyleBox["NHOPr", "Input"],
 ". BTW, those ",
 StyleBox["NHOPr", "Input"],
 " lines are a distance ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", 
    FractionBox[
     RowBox[{
      SqrtBox["3"], "-", "1"}], "2"]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "5af8fb56-6960-4c28-b5ba-0147e03bcb4b"],
 " from the center."
}], "Text",
 CellChangeTimes->{{3.966960863151276*^9, 3.966960954048811*^9}, {
  3.9670122048632603`*^9, 3.967012237759714*^9}, {3.993129939291049*^9, 
  3.993130001699469*^9}, {3.993130236042285*^9, 3.9931302876624537`*^9}, {
  3.9931303508724546`*^9, 3.993130389129818*^9}, {3.993222178296404*^9, 
  3.993222178398596*^9}, {3.993546025755869*^9, 
  3.993546027363324*^9}},ExpressionUUID->"9a94c605-81dc-4798-a799-\
7531609e63eb"],

