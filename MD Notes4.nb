Cell[TextData[{
 "Going back to the original definition of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "n"], TraditionalForm]],ExpressionUUID->
  "40cec0ff-cc3b-4ad1-afcb-e5e4b048238d"],
 ", we can simply rearrange that definition to get"
}], "Text",
 CellChangeTimes->{{3.970853199923573*^9, 3.970853228457399*^9}, {
   3.970853282524642*^9, 3.970853307899364*^9}, {3.970853521220306*^9, 
   3.970853540444859*^9}, 3.970853647485362*^9, {3.971090715655995*^9, 
   3.971090716151577*^9}},ExpressionUUID->"ce90edc5-8f0e-4079-a1c2-\
d1c524d4b15e"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["r", 
    RowBox[{"n", "+", "1"}]], "=", 
   RowBox[{
    SubscriptBox["r", "n"], "+", 
    RowBox[{
     SubscriptBox["z", "n"], 
     StyleBox[
      RowBox[{"\[Delta]", 
       StyleBox["t",
        FontSlant->"Italic"]}]]}]}]}], 
  TraditionalForm]],ExpressionUUID->"5975b24f-ff71-435c-94e4-e7850d58063d"]], \
"Text",
 CellChangeTimes->{{3.970853199923573*^9, 3.970853228457399*^9}, {
  3.970853282524642*^9, 3.9708534174515877`*^9}, {3.970853655342161*^9, 
