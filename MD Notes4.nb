Cell[TextData[{
 "We can try to make a series and invert that.  Here is a sixth order series \
for ",
 StyleBox["xTx[]", "Code"],
 ":"
}], "Text",
 CellChangeTimes->{{3.967274332933384*^9, 
  3.967274352997322*^9}},ExpressionUUID->"14810f28-f874-41fe-bcb7-\
6d7c3fd35824"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "sxTx6", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sxTx6", "[", "x_", "]"}], ":=", 
  RowBox[{"Evaluate", "[", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"xTx2", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}], 
   "]"}]}]}], "Input",
