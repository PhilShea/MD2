Cell[TextData[{
 "In ",
 StyleBox["Julia",
  FontSlant->"Italic"],
 ", the root can be found with the ",
 StyleBox["Roots.jl", "CodeText"],
 " package (note: xTx2 changed from this snapshot):\n\n",
 StyleBox["julia> xTx(x) = 0.138006 * x * tan(1.55419 * x)\n\njulia> f(x,p) = \
xTx(x) - p\nf (generic function with 2 methods)\n\njulia> find_zero( f, 0.3, \
0.02)\n0.2949171886685355", "CodeText"]
}], "Text",
 CellChangeTimes->{{3.967279951347135*^9, 3.9672800472836933`*^9}, {
   3.967639233484193*^9, 3.967639255564144*^9}, 
   3.977998968741118*^9},ExpressionUUID->"6c2c0fcf-42bb-4444-b893-\
ef03382199ee"],

Cell[CellGroupData[{

Cell[TextData[{
 "Using  ",
 StyleBox["rn2[]", "Code",
  FontSlant->"Plain"],
 " Instead"
}], "Subsubsubsection",
 CellChangeTimes->{{3.9779989807731028`*^9, 
  3.977999014253077*^9}},ExpressionUUID->"cba698e0-952d-4eef-8671-\
42aa57093d90"],

Cell[TextData[{
 "The xTx2[] function does not scale well, and certainly \
won\[CloseCurlyQuote]t work for other values of ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", so we dropped back to ",
 StyleBox["rn2[]", "Code"],
 ".  Following the procedure above, we will make a one argument ",
 StyleBox["rn2[]", "Code"],
 " function to use in ",
 StyleBox["Findroot[]", "Code"],
 "."
}], "Text",
 CellChangeTimes->{{3.9779990197014093`*^9, 3.9779991065815573`*^9}, {
  3.9780077727068653`*^9, 3.9780077908942432`*^9}, {3.993111776164229*^9, 
  3.993111783748147*^9}},ExpressionUUID->"7e15031d-500d-42ad-8981-\
30b641b15d0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rn2a5", "[", "x_", "]"}], "=", " ", 
  RowBox[{"rn2", "[", 
   RowBox[{"x", ",", "a79", ",", "5"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9780076885204687`*^9, 3.978007698662355*^9}, {
  3.9780078094398813`*^9, 3.978007888878771*^9}},
 CellLabel->
  "In[350]:=",ExpressionUUID->"a66e4764-6efe-4ac1-9ade-9415fabeb76a"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "0.07979614175514187`"}], "+", 
    FractionBox["1", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1.9046256137279145`", "\[VeryThinSpace]", "-", "x"}], ")"}], 
      "5"]], "+", 
    FractionBox["1", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1.9046256137279145`", "\[VeryThinSpace]", "+", "x"}], ")"}], 
      "5"]]}], ")"}]}]], "Output",
 CellChangeTimes->{3.978007891828372*^9, 3.978008063810075*^9, 
  3.9785065168148737`*^9, 3.990089364098069*^9, 3.993051995814994*^9, 
