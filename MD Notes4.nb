    RowBox[{"0.0599640064794388`", " ", "\[ImaginaryI]"}]}], ",", 
   RowBox[{"0.9982005399352045`", "\[VeryThinSpace]", "+", 
    RowBox[{"0.05996400647943855`", " ", "\[ImaginaryI]"}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.973071092268598*^9, {3.973071284543412*^9, 3.973071398992652*^9}, 
   3.9754122104031057`*^9, 3.977999407149867*^9, 3.9780073383329144`*^9, 
