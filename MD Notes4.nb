Cell[CellGroupData[{

Cell["Particle Propagation", "Subsection",
 CellChangeTimes->{{3.9703156958187933`*^9, 
  3.970315703154969*^9}},ExpressionUUID->"77af8ff6-e22d-4ecf-b817-\
5e646439eb35"],

Cell[CellGroupData[{

Cell["Verlet Algorithm", "Subsubsection",
 CellChangeTimes->{{3.970316259366951*^9, 
  3.970316265975335*^9}},ExpressionUUID->"27212870-5ac9-4da8-be6a-\
5baa28c92f68"],

Cell[TextData[{
 "The initial design used the Verlet algorithm [",
 StyleBox["Verlet1967",
  FontWeight->"Bold"],
 "]. This starts with the following simple statements:\n1) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", 
     RowBox[{"n", "+", "1"}]], "="}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "de608ac5-0e3f-4da7-b5bb-1425c175a7fd"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "n"], TraditionalForm]],ExpressionUUID->
  "2aa48cd9-adfc-4ad4-91ee-9853ca5e77ac"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "n"], TraditionalForm]],ExpressionUUID->
  "11eca522-ab66-4fe1-9550-bf1401542e75"],
 "\[Delta]",
 StyleBox["t",
  FontSlant->"Italic"],
 " + ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],ExpressionUUID->
  "0ffb6922-235f-4955-900c-a34db226791b"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "n"], TraditionalForm]],ExpressionUUID->
  "b7762ee7-64e6-4957-8028-6de7d8dadd30"],
 "\[Delta]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "2"], TraditionalForm]],ExpressionUUID->
  "7408cd9b-cc6f-426e-a3d0-65c379c47a66"]
}], "Text",
 CellChangeTimes->{{3.97031570741101*^9, 3.97031572031503*^9}, {
  3.9703157732996397`*^9, 3.970315883613106*^9}, {3.970315924108774*^9, 
  3.9703159606695213`*^9}, {3.970841530110188*^9, 3.970841614495688*^9}, {
  3.970841652512681*^9, 3.9708416637195253`*^9}, {3.9708420629145107`*^9, 
  3.970842074620036*^9}, {3.970842277900745*^9, 3.97084228084415*^9}, {
  3.970900316329356*^9, 
  3.9709003262174892`*^9}},ExpressionUUID->"2bf7d5f0-c91b-4153-a8d3-\
8dc6be534728"],

Cell[TextData[{
 "This is perfectly reasonable from a constant acceleration perspective, or \
from a Taylor series perspective.  Also, if the velocity was reversed, we \
would get the following:\n2) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", 
     RowBox[{"n", "-", "1"}]], "="}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "9ef6d820-b039-4f48-8f09-82a93752e23b"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "n"], TraditionalForm]],ExpressionUUID->
  "a7eb53d2-1dab-4f33-869f-811399e8ee81"],
 " - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "n"], TraditionalForm]],ExpressionUUID->
  "f865b03a-6a56-447b-8563-1e164ca20b61"],
 "\[Delta]",
 StyleBox["t",
  FontSlant->"Italic"],
 " + ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],ExpressionUUID->
  "609a7c08-f666-4b8a-8abf-44e323743a8d"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "n"], TraditionalForm]],ExpressionUUID->
  "b0abb15f-2193-431c-a434-bf043df799c3"],
 "\[Delta]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "2"], TraditionalForm]],ExpressionUUID->
  "6471b38d-5b40-4036-9d8d-d94f1d85f67f"]
}], "Text",
 CellChangeTimes->{{3.97031570741101*^9, 3.97031572031503*^9}, {
  3.9703157732996397`*^9, 3.970315883613106*^9}, {3.970315924108774*^9, 
  3.9703159606695213`*^9}, {3.970841530110188*^9, 3.970841614495688*^9}, {
  3.970841652512681*^9, 3.9708416637195253`*^9}, {3.9708420629145107`*^9, 
  3.970842184075498*^9}, {3.9708422494760933`*^9, 3.970842263508815*^9}, {
  3.970842300764213*^9, 
  3.9708423013881893`*^9}},ExpressionUUID->"c1e6b696-b8af-4b7e-8903-\
7ec777ed58f2"],

Cell["Adding these two equations, we get", "Text",
 CellChangeTimes->{{3.970315967629005*^9, 3.970315988998745*^9}, {
   3.970316160086878*^9, 3.97031623883152*^9}, 3.9703163178164167`*^9, {
   3.970318765874383*^9, 3.970318767562475*^9}, {3.970841711785206*^9, 
   3.970841751584631*^9}, {3.9708417956482964`*^9, 3.9708418745063133`*^9}, {
   3.9708423078201733`*^9, 3.9708423107404203`*^9}, {3.9708424116688957`*^9, 
   3.970842412366651*^9}},ExpressionUUID->"327a0b9e-92da-479e-807a-\
399e970f03b5"],

Cell[TextData[{
 "3) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", 
     RowBox[{"n", "+", "1"}]], "=", 
    RowBox[{
     RowBox[{"2", 
      SubscriptBox["r", "n"]}], "-", 
     SubscriptBox["r", 
      RowBox[{"n", "-", "1"}]], "+", 
     RowBox[{
      SubscriptBox["a", "n"], 
      SuperscriptBox["\[Delta]t", "2"]}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "9c2d51ac-1fe3-44a8-9b32-da8d0cb08abc"],
 ". "
}], "Text",
 CellChangeTimes->{{3.970315967629005*^9, 3.970315988998745*^9}, {
   3.970316160086878*^9, 3.97031623883152*^9}, 3.9703163178164167`*^9, {
   3.970318765874383*^9, 3.970318767562475*^9}, {3.970841711785206*^9, 
   3.970841751584631*^9}, {3.9708417956482964`*^9, 3.9708418745063133`*^9}, {
   3.9708423078201733`*^9, 3.9708423107404203`*^9}, {3.9708424116688957`*^9, 
   3.9708424159249477`*^9}},ExpressionUUID->"2d8cb380-9aae-4442-8eae-\
201c18087aaf"],

Cell["\<\
If the potential was given by the rn2[] function, the force is its derivative.\
\>", "Text",
 CellChangeTimes->{{3.97031710047755*^9, 
  3.9703171269578333`*^9}},ExpressionUUID->"512fafcc-efc0-41e1-9f3b-\
0618d9244801"],

Cell["Here is rn2[] :", "Text",
 CellChangeTimes->{{3.970317705155507*^9, 
  3.970317715890774*^9}},ExpressionUUID->"f88f96d4-23cf-4f11-b9a3-\
3bf838df6f94"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rn2", "[", 
  RowBox[{"x", ",", "a", ",", "n"}], "]"}]], "Input",
 CellChangeTimes->{{3.97031765603552*^9, 3.970317660985732*^9}},
 CellLabel->
  "In[399]:=",ExpressionUUID->"20af83f2-6d47-4162-afcf-936314da52f5"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     SuperscriptBox["a", 
      RowBox[{"-", "n"}]]}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"a", "-", "x"}], ")"}], 
     RowBox[{"-", "n"}]], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"a", "+", "x"}], ")"}], 
     RowBox[{"-", "n"}]]}], ")"}]}]], "Output",
 CellChangeTimes->{3.970317661530726*^9, 3.970328287478477*^9, 
  3.970391043266617*^9, 3.970402296649629*^9, 3.9708203492219667`*^9, 
  3.9709977745362453`*^9, 3.971172466501115*^9, 3.971336069360965*^9, 
  3.971691407041691*^9, 3.9719476598559427`*^9, 3.97195370455096*^9, 
  3.971973791990069*^9, 3.972210359918207*^9, 3.972649054558107*^9, 
  3.973069741608789*^9, 3.975412229617135*^9, 3.978008066396442*^9, 
  3.978506519397128*^9, 3.990089367397119*^9, 3.993051998737317*^9, 
  3.9932222995104437`*^9, 3.993981232072209*^9, 3.994166457633174*^9, 
  3.994323762002157*^9, 3.9944196518172703`*^9, 3.994436806135626*^9},
 CellLabel->
  "Out[399]=",ExpressionUUID->"abee34ea-8e41-4695-97a4-9a93ea188bad"]
}, Open  ]],

