Cell[TextData[{
 "Almost 70 minutes is predicted, vs. 0.754ms with FastCorr.  Unfortunately, \
the baseline speedtest was longer (similar number of allocations, gc, lock & \
compilation time):\n\n",
 StyleBox["julia> \
cd(\[OpenCurlyDoubleQuote]/media/phil/Original/Users/phils/Documents/DSP/MD/\
dev/MD2J\[CloseCurlyDoubleQuote])\n\njulia> \
include(\[OpenCurlyDoubleQuote]./src/MD2.jl\[CloseCurlyDoubleQuote])\nMD2 \
included.\nMain.MD2\n\njulia> \
include(\[OpenCurlyDoubleQuote]./test/BaselineSpeed.jl\[CloseCurlyDoubleQuote]\
)\n\n 20.994750 seconds (20.19 M allocations: 1.578 GiB, 2.90% gc time, 152 \
lock conflicts)", "CodeText"]
}], "Text",
