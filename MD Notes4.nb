Cell[CellGroupData[{

Cell["Angular Momentum", "Subsection",
 CellChangeTimes->{{3.942952244530243*^9, 
  3.942952273593713*^9}},ExpressionUUID->"ab6fbc8b-871d-43f9-83b7-\
96207f555435"],

Cell[TextData[{
 "When applying random velocities to the particles, the velocities in the x \
and y directions will each be drawn from a zero-mean Gaussian distribution. \
The sum of velocities in the x and y direction will therefore also be \
zero-mean, but will have a substantial variance: for N particles, the \
variance will be N",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", "2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "c673d75d-ba72-4caa-93e4-46f91fe3a491"],
 ".  Therefore, after initialization, we need to measure the momentum in the \
x and y directions and subtract that average per-particle momentum from each \
particle.\n\nThe same is true for angular momentum. It just won\
\[CloseCurlyQuote]t do for the whole system to be rotating, even a little. It \
is easy to measure the angular momentum. For a particle with a vector \
position x and vector velocity v, and particle mass m, the angular momentum \
about the origin is ",
 StyleBox["L",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " = ",
 StyleBox["x",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " \[Cross] m v. In two dimensions, "
}], "Text",
 CellChangeTimes->{{3.94295228817216*^9, 3.9429523900444007`*^9}, {
  3.942952439962067*^9, 
  3.9429524571535263`*^9}},ExpressionUUID->"8551a4d7-2464-4515-bcca-\
1f3a31114232"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"A", " ", "=", 
    RowBox[{"{", 
     RowBox[{"ax", ",", "ay", ",", "az"}], "}"}]}], ";", 
   RowBox[{"V", " ", "=", 
    RowBox[{"{", 
     RowBox[{"vx", ",", "vy", ",", "vz"}], "}"}]}], ";", 
   RowBox[{"L", "=", 
    RowBox[{"Cross", "[", 
     RowBox[{"A", ",", "V"}], "]"}]}]}], "\n"}]], "Input",
 CellChangeTimes->{{3.942952472329546*^9, 3.9429525213313484`*^9}},
 CellLabel->
  "In[119]:=",ExpressionUUID->"06593714-736b-471c-8319-fb76c49d72ad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "az"}], " ", "vy"}], "+", 
    RowBox[{"ay", " ", "vz"}]}], ",", 
   RowBox[{
    RowBox[{"az", " ", "vx"}], "-", 
    RowBox[{"ax", " ", "vz"}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "ay"}], " ", "vx"}], "+", 
    RowBox[{"ax", " ", "vy"}]}]}], "}"}]], "Output",
 CellChangeTimes->CompressedData["
1:eJwVy0sowwEcwPF5E6VQotCkbCWUXCT1ExdEhLLFsOYZsoTkVUiWzYb/jDyS
HZjDTiIam0weQ2Yzz+QRNX7GDh5J+Tl8+5y+7PKGPJELi8VKpPYHhnaZUoRo
W5xcSZ58zkz96+8wcy5Jnt7D44G8um1KyS9DmBeEe3eQGr8Yjk2I8OMuLjCJ
EJignr4j0tlq/ZDUIVwUZhoVZFVtA9dXguD6pAq+IiPr35kbUm3Q/roNIvCv
e7U88vE84MIsRVjpji+PliHAnTNyfghBGgJZC6RkWbSuIR1yZjdTjvBa3Jxr
UiBU+n31GUcRLGETym0ylr9lM5GT7ur2ZzJvavbnjUx3bofqGITFOZ0uUIkg
u5b6VJO564qXFXK6LVRYMYaAmrree7LzNqPlkTw1HuS8kQPt3GOhCqFGYPdM
Gke4q5E1ek0gfJkNyV3TCLXisZ76OQS7ViAUkxyVde1fhyg7vEJN/xL/sGMV
4cyFXRmlR0jt50pbyK2ipQi7AcG6YRlO20QwhbSWKEiL23eCnmTz9kZ2yD+4
gux+
  "],
 CellLabel->
  "Out[119]=",ExpressionUUID->"ed823707-e8ee-4740-b639-396d64a24b0e"]
}, Open  ]],

Cell["This is very simple when the z components are zero.", "Text",
 CellChangeTimes->{
  3.9429525408199415`*^9},ExpressionUUID->"2ff43f29-8795-43d8-be1b-\
51350963d053"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"L", "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"az", "\[Rule]", " ", "0"}], ",", " ", 
    RowBox[{"vz", "\[Rule]", "0"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.942952547884869*^9, 3.9429525692256145`*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"dcb17643-abe6-416d-9c2d-92b60c70844e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "ay"}], " ", "vx"}], "+", 
    RowBox[{"ax", " ", "vy"}]}]}], "}"}]], "Output",
 CellChangeTimes->CompressedData["
1:eJwVz2kowwEYx/FJhrzwYoUocpTZiyFH0Vqe8EJERIRcy8wLxrSWWF4wsszf
sLlKmSlHjTe0HIvVnGuLMmdJ5AWeHCuRHM9e/Pq8/X0j66RF9V4sFiuFxn/L
cOpqELI4U0N68ji/Ysajqc/FvSI7V9k+96T1Vi4srkUoCYvwU5Kff3zumQih
