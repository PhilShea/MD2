        RowBox[{"-", "Rshell"}], ",", 
        RowBox[{"-", "Rshell"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Rshell", ",", "Rshell"}], "}"}]}], "]"}], ",", "Blue", ",", 
    RowBox[{"Disk", "[", 
     RowBox[{
      RowBox[{"{", 
