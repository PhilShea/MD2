Cell["Now we can define the function.", "Text",
 CellChangeTimes->{{3.971340892910941*^9, 
  3.9713409415396852`*^9}},ExpressionUUID->"eeb2ddbc-782e-4c77-9ff6-\
61abc8e31c8e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "gc", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gc", "::", "usage"}], "=", 
   "\"\<gc[pa,Ng] returns a length Ng array r such that r[i] contains the \n\
number of particles of pa that are within iz/Ng distance from each other, \n\
where z is the smaller of the Bx or By distances.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gc", "[", 
   RowBox[{"pa_", ",", "Ng_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", "Ng"}], "]"}]}], ",", 
      RowBox[{"Bx", "=", 
       RowBox[{"N", "[", 
        RowBox[{"pa", "[", "\"\<Bx\>\"", "]"}], "]"}]}], ",", 
      RowBox[{"By", "=", 
       RowBox[{"N", "[", 
        RowBox[{"pa", "[", "\"\<By\>\"", "]"}], "]"}]}], ",", 
      RowBox[{"pn", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"pa", "[", "\"\<pn\>\"", "]"}], ",", "1"}], "]"}], "]"}]}], 
      ",", "\n", "\t\t\t\t\t", "dr", ",", "Np", ",", "c", ",", "v", ",", "vp",
       ",", "nv"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"dr", "=", 
      RowBox[{
       RowBox[{"Min", "[", " ", 
        RowBox[{"Bx", ",", " ", "By"}], "]"}], "/", "Ng"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"This", " ", "is", " ", "the", " ", "max", " ", "Range"}], " ", 
      "*)"}], "\n", "\t", 
     RowBox[{"Print", "[", 
      RowBox[{"{", 
       RowBox[{"Bx", ",", "By", ",", "dr"}], "}"}], "]"}], ";", "\n", "\t", 
     RowBox[{"Np", "=", 
      RowBox[{"Length", "[", "pn", "]"}]}], ";", "\n", "\t", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"c", "=", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"nv", "=", 
              RowBox[{"Norm", "[", 
               RowBox[{"vp", "=", 
                RowBox[{"pbc", "[", 
                 RowBox[{
                  RowBox[{"v", "=", 
                   RowBox[{
                    RowBox[{
                    "pn", "\[LeftDoubleBracket]", "j", 
                    "\[RightDoubleBracket]"}], "-", 
                    RowBox[{
                    "pn", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}]}]}], ",", "Bx", ",", "By"}], 
                 "]"}]}], "]"}]}], ")"}], "/", "dr"}], "]"}], "+", "1"}]}], 
        ";", "\n", "\t   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"c", "\[LessEqual]", "Ng"}], ",", 
          RowBox[{
           RowBox[{
           "r", "\[LeftDoubleBracket]", "c", "\[RightDoubleBracket]"}], "+=", 
           "1"}], 
          RowBox[{"(*", 
           RowBox[{";", "\n", "\t\t", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"And", "[", 
               RowBox[{
                RowBox[{"i", "<", "3"}], ",", 
                RowBox[{"j", "<", "18"}]}], "]"}], ",", 
              RowBox[{"Print", "[", 
               RowBox[{"{", 
                RowBox[{
                "i", ",", "j", ",", "v", ",", "vp", ",", "nv", ",", "c"}], 
                "}"}], "]"}]}], "]"}]}], "*)"}], ",", "0"}], "]"}]}], ",", 
       "\n", "\t   ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Np", "-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"i", "+", "1"}], ",", "Np"}], "}"}]}], "]"}], ";", "\n", 
     "\t", "r"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.971340949675425*^9, 3.971340986356092*^9}, {
