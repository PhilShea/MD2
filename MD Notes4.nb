Cell[TextData[{
 "We can pick out the numbers as follows: the first dimension is the row, the \
second is the column, and the third is the ",
 StyleBox["Rule[x,0.3...]", "Input"],
 ". For the first point, we want row one, both columns (",
 StyleBox["all", "Input"],
 "), and finally the second part of the ",
 StyleBox["Rule[]", "Input"],
 " expression."
}], "Text",
