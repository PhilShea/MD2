 RowBox[{"{", 
  RowBox[{"a", "\[Rule]", "0.25267094769663523`"}], "}"}]], "Output",
 CellChangeTimes->{{3.994168253806807*^9, 3.994168269595727*^9}, 
   3.994323754397895*^9, 3.9944196446623096`*^9, 3.9944367992334547`*^9},
 CellLabel->
  "Out[306]=",ExpressionUUID->"0b7a7562-9f3a-415e-9dd1-9c3610831182"]
}, Open  ]],

Cell["\<\
That is pretty close to the 1/4 we were using, but we\[CloseCurlyQuote]ll \
plot that new function just to see it.\
\>", "Text",
 CellChangeTimes->{{3.9941689458357763`*^9, 
  3.9941689990192347`*^9}},ExpressionUUID->"ef3096f9-7a09-46ac-bc40-\
8fc74f507e1d"],

Cell[TextData[{
 "We can plot these results. The ",
 StyleBox["rn2[\[Alpha]x]", "Input"],
 " fit is better than ",
 Cell[BoxData[
  FormBox[
   RowBox[{"rn2", "[", "x", "]"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "cdd7487b-f96a-47a9-9bf8-a49c883cd094"],
 ", and the ",
 StyleBox["bxTan[cx]", "Input"],
 " fit is also very good."
}], "Text",
 CellChangeTimes->{{3.9935428133282213`*^9, 3.99354282934207*^9}, {
  3.993542919606711*^9, 
  3.9935430458996897`*^9}},ExpressionUUID->"dadd26a5-244f-4f30-8e07-\
a1558872f527"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xTx2", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{"b", " ", "x", " ", 
     RowBox[{"Tan", "[", 
      RowBox[{"c", " ", "x"}], "]"}]}], "//.", "fit2"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f2", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{"a", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"a79", "-", "x"}], ")"}], 
        RowBox[{"-", "2"}]], "-", 
       SuperscriptBox["a79", 
        RowBox[{"-", "2"}]]}], ")"}]}], "//.", "fit4"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
