Cell[TextData[{
 "So there is a broad, flat valley in which the particles move mostly freely \
with narrow passes that higher energy particles may approach. If we take the \
melting point to be at ",
 StyleBox["T",
  FontSlant->"Italic"],
 " = 0.01283, which is also the per particle kinetic energy, it is reasonable \
to assume that the same mean energy would find its way into potential energy. \
 Below we show the expected mean PE for both the transition temperature and \
the high fluid temp of ",
 StyleBox["T",
  FontSlant->"Italic"],
 " = 0.02, and at three times that high temperature.  "
}], "Text",
 CellChangeTimes->{{3.967012391130403*^9, 3.967012474941532*^9}, {
   3.967032481459787*^9, 3.9670325716367817`*^9}, 3.9670327123172073`*^9, {
   3.9670333718597193`*^9, 3.967033434587379*^9}, {3.9671020331233397`*^9, 
   3.9671020547316093`*^9}, {3.967102395799511*^9, 
   3.967102396951271*^9}},ExpressionUUID->"6e38ab2c-3eff-4a9b-992b-\
5f97b40fdd2c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pe12o", " ", "+", " ", 
  RowBox[{"{", 
   RowBox[{"0.01283", ",", " ", "0.02", ",", " ", 
    RowBox[{"3", "*", "0.02"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9670328000080147`*^9, 3.967032810614789*^9}, {
  3.96703335805258*^9, 3.967033363587678*^9}, {3.967102016891765*^9, 
