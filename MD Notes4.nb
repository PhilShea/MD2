   3.994323699809505*^9, 3.994419615832163*^9, 3.994436766375225*^9},
 CellLabel->
  "Out[121]=",ExpressionUUID->"809a10b6-c11b-45a1-ad8e-1d225b8572f3"]
}, Open  ]],

