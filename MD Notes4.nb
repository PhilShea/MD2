Cell[TextData[{
 "There are a few rules that must be observed to make the periodic boundary \
conditions make sense.  First, the number of rows must be even so that the \
top row fits properly beneath the bottom row (where it will be imaged). The \
number 18 was chosen sort of arbitrarily, but can be formalized as follows.  \
The inter-row spacing is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], "/", "2"}], TraditionalForm]],ExpressionUUID->
  "e33519d0-d68c-401c-beca-3ccf5d77c8ae"],
 " smaller than the column spacing, so we can have the reciprocal of that \
times the number of columns.  The result would need to be rounded to an \
integer. The table below shows a row length (number of columns), that \
squared, the raw increase fraction, and then the rounded number, the \
resulting number of particles, the box ratio, and the ration of rows to \
columns."
}], "Text",
 CellChangeTimes->{{3.977567649516169*^9, 3.97756765112426*^9}, {
  3.977568072055293*^9, 3.977568181480195*^9}, {3.977574993138986*^9, 
  3.977575231268936*^9}, {3.9775757612558117`*^9, 3.9775758506646433`*^9}, {
  3.977577167494623*^9, 
  3.977577185202058*^9}},ExpressionUUID->"588c6c95-340b-41fb-b872-\
f6f86e78281c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      SuperscriptBox["i", "2"], ",", 
      RowBox[{"N", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", 
          RowBox[{"i", "/", 
           SqrtBox["3"]}]}], ",", 
         RowBox[{"2", 
          RowBox[{
           SuperscriptBox["i", "2"], "/", 
           SqrtBox["3"]}]}]}], "}"}], "]"}], ",", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Round", "[", 
         RowBox[{"2", 
          RowBox[{"i", "/", 
           SqrtBox["3"]}]}], "]"}], 
        RowBox[{"{", 
         RowBox[{"1", ",", "i", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SqrtBox["3"], "/", "2"}], ")"}], "/", "i"}], ",", 
          RowBox[{"1", "/", "i"}]}], "}"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "15", ",", "32"}], "}"}]}], "]"}], "//", 
  "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.97757523642831*^9, 3.977575409725811*^9}, {
