Cell[CellGroupData[{

Cell["Spectral Processing", "Subsection",
 CellChangeTimes->{{3.975073028618631*^9, 
  3.975073032362637*^9}},ExpressionUUID->"9dd4fa84-3eed-486f-9583-\
310fa3cb1ad3"],

Cell[TextData[{
 "We process the temperature profiles to determine when the system is in \
equilibrium.  The current plan (started in late 2024 and still in use in \
December of \[OpenCurlyQuote]25) is to perform a 500-step block average and \
use those averages to form the key statistics (",
 StyleBox["ke.mean.rs",
  FontFamily->"Courier 10 Pitch",
  FontSize->10],
 ", ",
 StyleBox["ke.sd.rs",
  FontFamily->"Courier 10 Pitch",
  FontSize->10],
 ", etc.).  The 500-step average was to eliminate the correlations that occur \
at short time intervals."
}], "Text",
 CellChangeTimes->{{3.97507303928275*^9, 3.975073071634844*^9}, {
  3.9751369081264133`*^9, 3.975137012919251*^9}, {3.975137080161783*^9, 
  3.975137080471745*^9}, {3.975137117783945*^9, 3.975137144616354*^9}, {
  3.975143548861866*^9, 
  3.975143548862184*^9}},ExpressionUUID->"4a325f95-0ccd-420e-bc4c-\
c07e5bb0c36c"],

Cell[TextData[{
 "Each row of an MD2 data table has a ",
 StyleBox["specwidth",
  FontFamily->"Courier 10 Pitch",
  FontSize->10],
 " recorded.  This is the fraction of the spectrum of the per-step kinetic \
energy occupied by 99.5% of the energy, usually just 2% to 5% of the entire \
spectrum. The spectrums are computed as averages with 50% overlap and Hanning \
windows and are de-trended first. The default (always used) is a 4,096 point \
FFT,"
}], "Text",
 CellChangeTimes->{{3.97507303928275*^9, 3.975073071634844*^9}, {
   3.9751369081264133`*^9, 3.975137012919251*^9}, {3.975137080161783*^9, 
   3.975137080471745*^9}, {3.975137117783945*^9, 3.975137144616354*^9}, {
   3.975143549880438*^9, 3.975143581920249*^9}, {3.975143616704647*^9, 
   3.9751437815701103`*^9}, {3.975144682746525*^9, 3.975144776345661*^9}, {
   3.975170574960596*^9, 3.9751705838725843`*^9}, 3.975170627640975*^9, {
   3.9893996462687063`*^9, 
   3.989399679293058*^9}},ExpressionUUID->"cae4408a-e52b-432e-96ac-\
3dae472c2f40"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Application of the Virial Theorem", "Subsection",
 CellChangeTimes->{{3.942956045445721*^9, 
  3.9429560554528255`*^9}},ExpressionUUID->"089726ec-314a-4085-ad0a-\
5563f646c3a8"],

Cell[TextData[{
 "The Virial Theorem for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "n"}]], TraditionalForm]],ExpressionUUID->
  "a08e6567-351b-41bd-9c96-cd3975be49f7"],
 " potentials states that the total kinetic energy is related to the total \
potential energy as 2\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "T"], TraditionalForm]],ExpressionUUID->
  "1906f6f3-cd02-4c54-b5b3-3624ee677fb7"],
 "\[RightAngleBracket]=-n\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "T"], TraditionalForm]],ExpressionUUID->
  "34eb3434-6ae2-404e-988e-04ba3037cdf7"],
 "\[RightAngleBracket], where the angle brackets denote averages. Combine \
this with the pressure equation P = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", 
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox["K", "T"], "\[RightAngleBracket]"}], "("}], 
   TraditionalForm]],ExpressionUUID->"e05b93d4-f183-4732-aa21-2a9a6072d137"],
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", 
    FractionBox[
     RowBox[{"n", 
      RowBox[{"\[LeftAngleBracket]", 
       FormBox[
        SubscriptBox["U", "T"],
        TraditionalForm], "\[RightAngleBracket]"}]}], 
     RowBox[{"2", 
      RowBox[{"\[LeftAngleBracket]", 
       FormBox[
        SubscriptBox["K", "T"],
        TraditionalForm], "\[RightAngleBracket]"}]}]]}], TraditionalForm]],
  ExpressionUUID->"36a027ff-44de-4d41-8922-9bd90ef82855"],
 "), where \[Rho] is the density, the pressure becomes simply 2\[Rho]\
\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "T"], TraditionalForm]],ExpressionUUID->
  "db1cdcbb-749d-4e11-b841-ec26bc39842f"],
 "\[RightAngleBracket].  This is evidently wrong, as was shown by [",
 StyleBox["Louwerse2006",
  FontWeight->"Bold"],
 "] in three dimensions."
}], "Text",
 CellChangeTimes->{{3.942956069209253*^9, 3.942956308809636*^9}, {
  3.961924352103654*^9, 3.961924388423624*^9}, {3.98939876013484*^9, 
  3.98939882201705*^9}, {3.98939899379487*^9, 3.989398999907022*^9}, {
  3.989399614101766*^9, 
  3.989399628380165*^9}},ExpressionUUID->"adb313e2-6bcd-4c25-aeac-\
b0c954956daf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"AbsoluteTime", "[", "]"}], " ", "-", " ", 
  "MD2StartTime"}]], "Input",
 CellChangeTimes->{{3.990088041800762*^9, 3.990088063601048*^9}},
 CellLabel->
  "In[489]:=",ExpressionUUID->"e4a4b1b0-8706-4487-a739-d7eb1572d3f9"],

