889cbf8fc905"]
}, Open  ]],

Cell[TextData[{
 "It was a bit of surprise that the maximum was so far right, but that does \
make some sense in that each \[Delta]r covers a bigger swath. The area of an \
infinitesimal swath of width \[Delta]",
 StyleBox["r",
  FontSlant->"Italic"],
 " at range ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is given by the derivative of the area of a circle of radius ",
 StyleBox["r",
  FontSlant->"Italic"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9716932106952667`*^9, 3.9716932749515142`*^9}, {
   3.9716941309413233`*^9, 3.9716941830779963`*^9}, 
   3.971694944262721*^9},ExpressionUUID->"3f336d2c-e834-4458-bc58-\
0a9ddb48bf61"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{"\[Pi]", " ", 
    SuperscriptBox["r", "2"]}], ",", "r"}], "]"}]], "Input",
 CellChangeTimes->{{3.9716936027774563`*^9, 3.9716936103534117`*^9}, {
  3.971693661657839*^9, 3.97169368426587*^9}},
 CellLabel->
  "In[388]:=",ExpressionUUID->"6b25aaa3-2962-428a-a857-172cb0b8edf6"],

Cell[BoxData[
 RowBox[{"2", " ", "\[Pi]", " ", "r"}]], "Output",
 CellChangeTimes->{3.971693685033614*^9, 3.9716941101572313`*^9, 
  3.9719475979894133`*^9, 3.971953631501643*^9, 3.971973791271446*^9, 
  3.9722103592316303`*^9, 3.9726490538488007`*^9, 3.973069740901012*^9, 
  3.975412228911983*^9, 3.978008065693575*^9, 3.978506518697266*^9, 
  3.990089366473261*^9, 3.9930519978813143`*^9, 3.99322229878021*^9, 
  3.993981231252246*^9, 3.9941664569052143`*^9, 3.9943237612134943`*^9, 
  3.994419650995985*^9, 3.994436805382452*^9},
 CellLabel->
  "Out[388]=",ExpressionUUID->"be80778b-39df-40b6-8c74-0acf1267175e"]
}, Open  ]],

Cell[TextData[{
 "The actual width for our finite swatch is simply the difference in the \
areas. Here, ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is not continuous but takes discrete values given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "i"], "=", 
    RowBox[{"i", " ", "\[Delta]r"}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "e41d821f-318b-4a34-a7c4-10a93b85380a"],
 ", and the swath at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]],ExpressionUUID->
  "3b1c3f5d-79bd-4f72-b940-1fcd87b08cbd"],
 " takes in all particles found between (",
 StyleBox["i ",
  FontSlant->"Italic"],
 "-1)\[Delta]",
 StyleBox["r",
  FontSlant->"Italic"],
 " and  ",
 StyleBox["i ",
  FontSlant->"Italic"],
 "\[Delta]",
 StyleBox["r.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.971694198341858*^9, 3.971694222950478*^9}, {
  3.971694374263435*^9, 3.971694482856539*^9}, {3.971694907172901*^9, 
  3.971694940005039*^9}, {3.971694978557123*^9, 
  3.9716950238538237`*^9}},ExpressionUUID->"5f1f00bb-e8a8-40a6-b726-\
45089055a01e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"\[Pi]", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Delta]r", " ", "i"}], ")"}], "2"]}], "-", 
   RowBox[{"\[Pi]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Delta]r", " ", 
       RowBox[{"(", 
        RowBox[{"i", "-", "1"}], ")"}]}], ")"}], "2"]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.971694264086699*^9, 3.971694359967637*^9}, {
  3.971695052078148*^9, 3.971695131078972*^9}, {3.971956819784354*^9, 
