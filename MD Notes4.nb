  RowBox[{"dev3", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#1", 
         RowBox[{"Cos", "[", "#2", "]"}]}], ",", 
        RowBox[{"#1", 
         RowBox[{"Sin", "[", "#2", "]"}]}]}], "}"}], "&"}], "[", 
     RowBox[{"rr", ",", "angles"}], "]"}], "]"}]}], 
