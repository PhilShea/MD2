  "In[184]:=",ExpressionUUID->"7058a4de-d8f6-4187-b749-c50941eddfde"],

Cell[BoxData[
 RowBox[{
  RowBox[{"b", ">", "0"}], "&&", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"0", "<", "Rs", "<", 
       FractionBox[
        RowBox[{"2", " ", "b"}], "7"]}], "&&", 
      RowBox[{"3", "\[LessEqual]", "n", "\[LessEqual]", 
       FractionBox[
        RowBox[{
         RowBox[{"2", " ", "b"}], "-", "Rs"}], 
        RowBox[{"2", " ", "Rs"}]]}]}], ")"}], "||", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Rs", "\[Equal]", 
       FractionBox[
        RowBox[{"2", " ", "b"}], "7"]}], "&&", 
      RowBox[{"n", "\[Equal]", "3"}]}], ")"}]}], ")"}], "&&", 
  RowBox[{"l", "\[Equal]", 
   FractionBox[
    RowBox[{"2", " ", "b"}], 
    RowBox[{"1", "+", 
     RowBox[{"2", " ", "n"}]}]]}]}]], "Output",
