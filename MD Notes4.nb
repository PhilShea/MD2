Cell[CellGroupData[{

Cell["Nelson-Halperin Order Parameter", "Subsubsection",
 CellChangeTimes->{{3.9497506384103928`*^9, 
  3.949750657922071*^9}},ExpressionUUID->"600546c5-a82c-4e78-bbeb-\
1a9df1cb3e3a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "6"], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"k", "\[NotEqual]", "j"}]], 
     RowBox[{"exp\:f000", " ", "i", " ", "6", " ", 
      SubscriptBox["\[Theta]", 
       RowBox[{"j", ",", "k"}]], " ", 
      RowBox[{"\:f006", "/", 
       UnderscriptBox["\[Sum]", 
        RowBox[{"k", "\[NotEqual]", "j"}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"a2f0363b-6f13-4ef1-bc92-1b0080143caf"],
 ", where the sum is over all particle pairs ",
 StyleBox["j",
  FontSlant->"Italic"],
 " and ",
 StyleBox["k",
  FontSlant->"Italic"],
 " (and the ",
 StyleBox["i",
  FontSlant->"Italic"],
 " in the exponent is the\nimaginary unit) and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", 
    RowBox[{"k", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "761f3596-d208-429c-ac3d-f1fce7484540"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "is the angle of the vector from particle ",
 StyleBox["k",
  FontSlant->"Italic"],
 " to particle ",
 StyleBox["j",
  FontSlant->"Italic"],
 " with the x axis [",
 StyleBox["Halperin1978",
  FontWeight->"Bold"],
 "]. Note that the\nangle from particle ",
 StyleBox["k",
  FontSlant->"Italic"],
 " to ",
 StyleBox["j ",
  FontSlant->"Italic"],
 "is the compliment of the angle from particle ",
 StyleBox["j",
  FontSlant->"Italic"],
 " to ",
 StyleBox["k",
  FontSlant->"Italic"],
 ", so we only need to look at\neach pair."
}], "Text",
 CellChangeTimes->{{3.9497506830949097`*^9, 3.949750704218972*^9}, {
  3.949750789096636*^9, 3.949751001765329*^9}, {3.972648186161543*^9, 
