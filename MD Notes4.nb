Cell["\<\
The contour plot below shows that the center of the field is relatively \
circular.  The black dashed lines show the NHOPr distance from each of the \
six surrounding particles.\
\>", "Text",
 CellChangeTimes->{{3.993295800521079*^9, 
  3.993295884314809*^9}},ExpressionUUID->"904c2d77-68bc-4b86-bacf-\
73efd2263948"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{"Clip", "[", 
        RowBox[{
         RowBox[{"P256", "[", 
          RowBox[{"x", ",", "y"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "#"}], ",", "#"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "#"}], ",", "#"}], "}"}], ",", 
       RowBox[{"Contours", "\[Rule]", "30"}], ",", "\[IndentingNewLine]", 
       "\t", 
       RowBox[{"ColorFunction", "\[Rule]", "Hue"}], ",", 
       RowBox[{"PlotLegends", "\[Rule]", "Automatic"}]}], "]"}], "&"}], "[", 
    "a79", "]"}], ",", "\[IndentingNewLine]", "\t", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"a79", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", "0", ",", 
        RowBox[{"2", " ", "\[Pi]"}], ",", 
        RowBox[{"\[Pi]", "/", "3"}]}], "}"}]}], "]"}], "]"}], ",", 
   "\[IndentingNewLine]", "\t", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{"Dashed", ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Circle", "[", 
         RowBox[{
          RowBox[{"a79", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
             RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}]}], ",", "NHOPr"}],
          "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "0", ",", 
          RowBox[{"2", " ", "\[Pi]"}], ",", 
          RowBox[{"\[Pi]", "/", "3"}]}], "}"}]}], "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
