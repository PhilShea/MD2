Cell[CellGroupData[{

Cell["Max Motion", "Subsubsection",
 CellChangeTimes->{{3.96875551931211*^9, 
  3.9687555238719*^9}},ExpressionUUID->"aadff56d-7083-4ed2-a1ab-60ad74c062d1"],

Cell[TextData[{
 "As explained below, the particles at a temperature ",
 StyleBox["T",
  FontSlant->"Italic"],
 " will have velocities such that the velocity squared has an expectation of ",
 StyleBox["T",
  FontSlant->"Italic"],
 ", so the velocity distribution is normal with mean zero and variance ",
 StyleBox["T",
  FontSlant->"Italic"],
 ". If there are n particles, we can discuss the maximum velocity that might \
be seen across four million steps (here, assuming all steps are independent). \
So, we assume that the n particles are independent, and each of the ",
 StyleBox["N ",
  FontSlant->"Italic"],
 "steps are independent, so there are ",
 StyleBox["n\[CenterDot]N",
  FontSlant->"Italic"],
 " possible chances for the velocity to be outside -",
 StyleBox["V",
  FontSlant->"Italic"],
 " or ",
 StyleBox["V",
  FontSlant->"Italic"],
 ".  We would like the probability that any particle will cross the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "shell"], TraditionalForm]],ExpressionUUID->
  "9ab84633-d274-4ad7-ad9c-e04ff04f1a03"],
 "- ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "skin"], TraditionalForm]],ExpressionUUID->
  "e891fd8b-bb88-4764-b04b-d87e0e859c01"],
 "distance in the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "skip"], TraditionalForm]],ExpressionUUID->
  "16185243-bcdb-4b57-841b-fc3760794f86"],
 " steps between correlation runs to be small.  That velocity is either \
positive or negative such that (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "shell"], TraditionalForm]],ExpressionUUID->
  "c8be517a-058c-492e-9008-c65b570fb883"],
 "- ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "skin"], TraditionalForm]],ExpressionUUID->
  "6f1f00c8-8d55-4b9b-8d45-c867ec8c89ba"],
 ")/(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "skip"], TraditionalForm]],ExpressionUUID->
  "e7321de8-4e5b-4914-b581-12deb0d64025"],
 "\[Delta]t).  In our simulation, this speed is 1.5/(50 \[Cross] 0.01) = 3 \
(in series 3), or 1.5/(50 \[Cross] 0.0177737) = 1.6879 (in series 4). This is \
the two sided survival function, and at the high temperature of 0.021, has \
the following very small values."
}], "Text",
 CellChangeTimes->{{3.968755530999997*^9, 3.968755584568548*^9}, {
  3.968762934105466*^9, 3.9687629558336363`*^9}, {3.968763377205173*^9, 
  3.968763380101172*^9}, {3.968763456453979*^9, 3.9687634785338087`*^9}, {
  3.968763649751598*^9, 3.968763685664092*^9}, {3.968763772240899*^9, 
  3.968763835729248*^9}, {3.968764396486169*^9, 3.968764425022582*^9}, {
  3.968764577232758*^9, 3.9687646931296*^9}, {3.968764781713943*^9, 
  3.968764986101203*^9}, {3.9687650409659758`*^9, 3.968765045998787*^9}, {
  3.968765077518248*^9, 3.9687651916952753`*^9}, {3.968765488362224*^9, 
  3.9687655753785353`*^9}, {3.9687667766062393`*^9, 3.968766819398389*^9}, {
  3.968823570466858*^9, 3.968823577250939*^9}, {3.968823626620216*^9, 
  3.9688236862286253`*^9}, {3.9688254357765923`*^9, 
  3.968825626972196*^9}},ExpressionUUID->"c3b22858-3506-4aaf-9eab-\
3802b96ae5e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"2", 
     RowBox[{"SurvivalFunction", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", 
         SqrtBox[
          RowBox[{"21", "/", "1000"}]]}], "]"}], ",", "#"}], "]"}]}], "&"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "1.6879"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9687644539849033`*^9, 3.968764521727621*^9}, {
   3.968765396072462*^9, 3.968765409912653*^9}, {3.9687655805227757`*^9, 
