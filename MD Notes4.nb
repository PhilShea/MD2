 RowBox[{"InverseFunction", "[", 
  RowBox[{"xTx2", "[", "x", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.967194483890936*^9, 3.9671945221137466`*^9}, {
   3.967194643854508*^9, 3.967194723246772*^9}, 3.967617317372058*^9},
 CellLabel->
