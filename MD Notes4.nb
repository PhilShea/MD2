     RowBox[{"x", "+", "side"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      RowBox[{"side", "/", "K"}]}], ")"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.96477785174403*^9, 3.964777983744038*^9}, {
  3.964778070801455*^9, 3.964778078568378*^9}, {3.964778185289694*^9, 
