Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"     ", 
   RowBox[{"=", 
    RowBox[{
     SubscriptBox["z", 
      RowBox[{"n", "-", "1"}]], "+", 
     RowBox[{
      SubscriptBox["a", "n"], "\[Delta]t"}]}]}]}], 
  TraditionalForm]],ExpressionUUID->"8a8cacd5-72b7-4743-87ee-c2dc5cfb7f14"]], \
"Text",
 CellChangeTimes->{{3.970401810215229*^9, 3.9704018694811077`*^9}, {
   3.970838905111561*^9, 3.9708389609603853`*^9}, {3.970838996552259*^9, 
