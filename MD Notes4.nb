Cell["\<\
That\[CloseCurlyQuote]s pretty close to one, so we\[CloseCurlyQuote]ll ignore \
that fit.  We can also fit the quadratic function:\
\>", "Text",
 CellChangeTimes->{{3.99416889496418*^9, 
  3.9941689395786037`*^9}},ExpressionUUID->"f71c4d71-09f5-48bb-957e-\
9b2fe542ca68"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fit4", "=", 
  RowBox[{"FindFit", "[", 
   RowBox[{"tabP256", ",", " ", 
    RowBox[{"a", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"a79", "-", "x"}], ")"}], 
        RowBox[{"-", "2"}]], "-", 
       SuperscriptBox["a79", 
        RowBox[{"-", "2"}]]}], ")"}]}], ",", 
    RowBox[{"{", "a", "}"}], ",", "x"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.994168145141323*^9, 3.9941682680206137`*^9}},
 CellLabel->
  "In[306]:=",ExpressionUUID->"5a096e65-6186-4a63-813f-62dd2d938275"],

