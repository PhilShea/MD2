Cell[TextData[{
 "That last equation is reasonably simple. We can also fit ",
 StyleBox["rn2[", "Code"],
 StyleBox["a x", "Code",
  FontSlant->"Italic"],
 StyleBox["]", "Code"],
 "."
}], "Text",
