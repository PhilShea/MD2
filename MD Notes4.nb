Cell[CellGroupData[{

Cell["Potential Function in the Field of Particles", "Subsubsection",
 CellChangeTimes->{{3.966845077616835*^9, 3.966845134576725*^9}, {
  3.966848993221439*^9, 
  3.96684899726927*^9}},ExpressionUUID->"404c572b-eaa7-449d-a5a5-\
2d70c33d1c4e"],

Cell[TextData[{
 "We would like to know how the potential energy of a particle will vary as \
it move directly toward another particle.  We know that there are particles \
just outside the ",
 StyleBox["skin",
  FontSlant->"Italic"],
 ", so we must account for them by recomputing the distance to all particles \
as we move."
}], "Text",
 CellChangeTimes->{{3.9668451440410843`*^9, 
  3.9668452532137136`*^9}},ExpressionUUID->"2ea39a2b-607d-4e97-9cba-\
067f90497107"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "Pdx", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pdx", "::", "usage"}], "=", 
   "\"\<Pdx[\!\(\*StyleBox[\"p_Integer\",FontSlant->\"Italic\"]\)\!\(\*\
StyleBox[\",\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"pnts_Association\",\
FontSlant->\"Italic\"]\)\!\(\*StyleBox[\",\",FontSlant->\"Italic\"]\)\!\(\*\
StyleBox[\"Rskn_\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\",\",FontSlant->\"\
Italic\"]\)\!\(\*StyleBox[\(\*StyleBox[\"n_\",FontSlant->\"Italic\"] : \
\)]\)5] returns a function of \
{\!\(\*StyleBox[\"x\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\",\",FontSlant->\
\"Italic\"]\)\!\(\*StyleBox[\"y\",FontSlant->\"Italic\"]\)} which computes \
the \npotential energy of particle number \
\!\(\*StyleBox[\"p\",FontSlant->\"Italic\"]\) moved a distance of \
{\!\(\*StyleBox[\"x\",FontSlant->\"Italic\"]\), \
\!\(\*StyleBox[\"y\",FontSlant->\"Italic\"]\)} from its home (crystaline) \
position \nbased on all the other particles being in their home positions \
with a potential function of 1/\!\(\*SuperscriptBox[\(r\), \(n\)]\) and a \n\
range of \!\(\*StyleBox[\"Rskn\",FontSlant->\"Italic\"]\). The function does \
not enforce periodic boundary conditions.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Pdx", "[", 
   RowBox[{"p_Integer", ",", "pnts_Association", ",", "Rskn_", ",", 
    RowBox[{"n_:", "5"}]}], "]"}], ":=", " ", "\n", "\t", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"pntarry", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
          "pnts", "\[LeftDoubleBracket]", "\"\<pn\>\"", 
           "\[RightDoubleBracket]"}], "]"}], ",", "1"}], "]"}]}], ",", 
      "point"}], "}"}], ",", "\n", "\t\t", 
    RowBox[{
     RowBox[{"point", "=", 
      RowBox[{"N", "[", 
       RowBox[{
       "pntarry", "\[LeftDoubleBracket]", "p", "\[RightDoubleBracket]"}], 
       "]"}]}], ";", "\n", "\t\t", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", "\n", "\t\t\t", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"dev", "=", 
            RowBox[{"point", "+", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}]}]}], ",", "skinlst"}], "}"}], 
         ",", "\n", "\t\t\t", 
         RowBox[{
          RowBox[{"skinlst", "=", 
           RowBox[{"Nearest", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Delete", "[", 
               RowBox[{"pntarry", ",", "p"}], "]"}], "\[Rule]", " ", 
              "\"\<Distance\>\""}], ",", "dev", ",", 
             RowBox[{"{", 
              RowBox[{"All", ",", "Rskn"}], "}"}]}], "]"}]}], ";", "\n", 
          "\t\t\t", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Print", "[", "skinlst", "]"}], ";"}], "*)"}], "\n", 
          "\t\t\t", 
          RowBox[{"Apply", "[", 
           RowBox[{"Plus", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"rn", "[", 
                RowBox[{"#", ",", "n", ",", "Rskn"}], "]"}], "/", "2"}], 
              "&"}], " ", "/@", " ", "skinlst"}]}], "]"}]}]}], "]"}]}], 
      "]"}]}]}], "]"}]}]}], "Code",
