       SqrtBox["2"]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Rshell", ",", "Rshell"}], "}"}], "/", 
       SqrtBox["2"]}]}], "]"}]}], "}"}], "]"}]], "Input",
