   3.965123771416307*^9, 3.965722616745068*^9, 3.965900167973333*^9, 
   3.966670561195486*^9, 3.966843677950366*^9},
 CellLabel->
  "Out[203]=",ExpressionUUID->"36c88d15-d48d-4d7a-98c8-b0d570bf3930"]
}, Open  ]],

Cell[TextData[{
 "That function goes down as ",
