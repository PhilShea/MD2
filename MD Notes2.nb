Cell[TextData[{
 "The relative error of the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", 
    RowBox[{"-", "3"}]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "3495ccab-e6ce-4b27-949a-d2c4ff3dd3b1"],
 " approximation is below, going from 4% at ",
 StyleBox["n",
  FontSlant->"Italic"],
 " = 50, to less than 0.04% at 5,000:"
}], "Text",
 CellChangeTimes->{{3.943095272083059*^9, 3.9430953278233833`*^9}, {
  3.943095379783595*^9, 3.9430953957348886`*^9}, {3.9430955303909597`*^9, 
