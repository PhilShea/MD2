 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Rho]", "=", 
     RowBox[{"1", "/", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"\[Rho]", " ", "\[Pi]", 
    RowBox[{"{", 
     RowBox[{
      SuperscriptBox["3.5", "2"], ",", 
      SuperscriptBox["5", "2"]}], "}"}]}]}], "]"}]], "Input",
