Cell["See Fukshansky 2011", "Text",
 CellChangeTimes->{{3.9274493102782993`*^9, 
  3.927449321926408*^9}},ExpressionUUID->"53da6fab-c150-4242-aa9f-\
cd57ae4892d4"],

Cell[TextData[{
 "The hypotenuse (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "1"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "52b13ac3-8138-483c-aab9-6b120499050f"],
 " - ",
 StyleBox["E",
  FontSlant->"Italic"],
 ") is given by the following:"
}], "Text",
 CellChangeTimes->{{3.9275354356981916`*^9, 3.9275354513786354`*^9}, {
  3.927535497954034*^9, 
  3.927535547068039*^9}},ExpressionUUID->"6e56d301-4863-4d28-a261-\
c03ebc0a0c74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "/", "2"}], " ", "\[Equal]", 
    RowBox[{"r", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"30", " ", "Degree"}], "]"}]}]}], ",", "r"}], "]"}]], "Input",
 CellChangeTimes->{{3.9274493008919983`*^9, 3.9274493057102776`*^9}, {
  3.9274501305511713`*^9, 3.9274501549376*^9}, {3.9274501872030315`*^9, 
  3.927450234264818*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"e110982e-81e8-4d43-96c5-1b1e19e4f193"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"r", "\[Rule]", 
    FractionBox["a", 
     SqrtBox["3"]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.92745086649584*^9, 3.94274453151956*^9, 
  3.942754190997468*^9, 3.9430945970124454`*^9, 3.9431127435145106`*^9, 
  3.9433425708268356`*^9, 3.943426111581113*^9, 3.944659263012598*^9, 
  3.9456856736799784`*^9, 3.9456922032485504`*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"03839616-9678-4012-85fa-f89462df7d9a"]
}, Open  ]],

Cell["The short side is therefore", "Text",
 CellChangeTimes->{{3.927535565012191*^9, 
  3.9275355790187607`*^9}},ExpressionUUID->"d35ceeee-d24f-404e-89ed-\
27839f3bfc85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"a", "/", 
    SqrtBox["3"]}], ")"}], 
  RowBox[{"Sin", "[", 
   RowBox[{"30", " ", "Degree"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.927534728468815*^9, 3.927534765173394*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"1a02e662-9aee-45c8-9b59-104fcaef681c"],

Cell[BoxData[
 FractionBox["a", 
  RowBox[{"2", " ", 
   SqrtBox["3"]}]]], "Output",
 CellChangeTimes->{3.927534765909797*^9, 3.9427445315483365`*^9, 
  3.942754191020405*^9, 3.943094597036228*^9, 3.943112743541438*^9, 
  3.943342570935895*^9, 3.9434261116024914`*^9, 3.944659263039509*^9, 
  3.9456856737052*^9, 3.9456922032734623`*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"29e2f6f6-18c0-4cfa-9a3b-824185894979"]
}, Open  ]],

Cell["The area occupied by one particle is then:", "Text",
 CellChangeTimes->{{3.927450872262682*^9, 3.9274508900944805`*^9}, 
   3.927535405762106*^9, {3.9427454476645947`*^9, 
   3.942745449478509*^9}},ExpressionUUID->"abf10b0a-511a-418e-b5df-\
427e4902632a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"area", "=", 
  RowBox[{"12", 
   RowBox[{"(", 
    FractionBox["a", "2"], ")"}], 
   RowBox[{"(", 
    FractionBox["a", 
     RowBox[{"2", 
      SqrtBox["3"]}]], ")"}], 
   RowBox[{"(", 
    FractionBox["1", "2"], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.927450263283159*^9, 3.927450280817297*^9}, {
  3.9274503295285187`*^9, 3.9274503772562447`*^9}, {3.927536630709994*^9, 
  3.9275366892193165`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"6256a90d-f83e-48c7-b46f-72cec9856afe"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SqrtBox["3"], " ", 
   SuperscriptBox["a", "2"]}], "2"]], "Output",
 CellChangeTimes->{{3.927450367386942*^9, 3.927450379090124*^9}, 
   3.9275366902833176`*^9, 3.9427445315785847`*^9, 3.9427541910403533`*^9, 
   3.9430945970683675`*^9, 3.9431127435743556`*^9, 3.9433425709515457`*^9, 
   3.9434261116254377`*^9, 3.9446592630574603`*^9, 3.9456856737257032`*^9, 
   3.9456922032983932`*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"b3c5c7b9-de16-46a3-ba82-3d0fc4013941"]
}, Open  ]],

Cell["To achieve a specified density, solve the following:", "Text",
 CellChangeTimes->{{3.927450925014512*^9, 3.9274509374785585`*^9}, 
   3.927451150410391*^9, {3.9276396372461166`*^9, 
   3.9276396524945383`*^9}},ExpressionUUID->"d68457d4-08f4-4699-987f-\
a236aeb6556a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      SqrtBox["3"], " ", 
      SuperscriptBox["a", "2"]}], "2"], "\[Equal]", 
    RowBox[{"1", "/", "\[Rho]"}]}], ",", "a"}], "]"}]], "Input",
 CellChangeTimes->{{3.9274509447295127`*^9, 3.92745100339276*^9}, {
  3.927453996722189*^9, 3.9274540078414555`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"4fd8d35b-1165-42be-889d-041d1cf1cb3d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       SqrtBox["2"], 
       RowBox[{
        SuperscriptBox["3", 
         RowBox[{"1", "/", "4"}]], " ", 
        SqrtBox["\[Rho]"]}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", "\[Rule]", 
     FractionBox[
      SqrtBox["2"], 
      RowBox[{
       SuperscriptBox["3", 
        RowBox[{"1", "/", "4"}]], " ", 
       SqrtBox["\[Rho]"]}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9274509882484026`*^9, 3.9274510041838627`*^9}, 
   3.92745400937763*^9, 3.942744531737108*^9, 3.9427541910603228`*^9, 
   3.9430945972484894`*^9, 3.9431127435982847`*^9, 3.943342571810714*^9, 
   3.9434261117085333`*^9, 3.94465926326291*^9, 3.945685673939623*^9, 
   3.9456922033263226`*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"1cd783d8-7229-4c1e-b575-732efe4a2518"]
}, Open  ]],

Cell[TextData[{
 "The paper from 1980 claimed a density of \[Rho] = 1/\[Pi] and an ",
 StyleBox["a",
  FontSlant->"Italic"],
 " of about 1.9\[Sigma]"
}], "Text",
 CellChangeTimes->{{3.9276396783180943`*^9, 3.9276397093267508`*^9}, {
  3.9276398769158497`*^9, 3.927639903549054*^9}, {3.9276406362785068`*^9, 
  3.927640643007394*^9}},ExpressionUUID->"4074ba1a-1cca-4561-a217-\
30a2b736d1f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Alpha]79", "=", 
  RowBox[{"Simplify", "[", 
   FractionBox[
    SqrtBox["2"], 
    RowBox[{
     SuperscriptBox["3", 
      RowBox[{"1", "/", "4"}]], " ", 
     SqrtBox[
      RowBox[{"1", "/", "\[Pi]"}]]}]], "]"}]}]], "Input",
 CellChangeTimes->{{3.942918320995417*^9, 3.9429183309544015`*^9}, {
  3.942918842994274*^9, 3.942918843186692*^9}, {3.9429190050023637`*^9, 
  3.942919013383706*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"8acedad9-067f-4464-a4c5-bfd247b549f9"],

Cell[BoxData[
 FractionBox[
  SqrtBox[
   RowBox[{"2", " ", "\[Pi]"}]], 
  SuperscriptBox["3", 
   RowBox[{"1", "/", "4"}]]]], "Output",
 CellChangeTimes->{3.9429183326534095`*^9, 3.942919015052183*^9, 
  3.9430945973302917`*^9, 3.9431127436341887`*^9, 3.9433425724042993`*^9, 
  3.9434261117838917`*^9, 3.9446592633589563`*^9, 3.9456856740352955`*^9, 
  3.9456922033562665`*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"c59708f2-46d7-4423-b498-b4e7283864d4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"a79", "=", 
  RowBox[{"N", "[", "\[Alpha]79", "]"}]}]], "Input",
 CellChangeTimes->{{3.927639733007172*^9, 3.9276397505837674`*^9}, {
   3.9282429363873253`*^9, 3.9282429392663965`*^9}, 3.9429183434858627`*^9, {
   3.942919021088645*^9, 3.94291902478283*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"c865db76-5fca-40b8-832b-35aa9f610921"],

Cell[BoxData["1.9046256137279145`"], "Output",
 CellChangeTimes->{3.9276397518207855`*^9, 3.928242940082279*^9, 
  3.94274453178183*^9, 3.9427541910862303`*^9, 3.942918345765269*^9, 
  3.9429190255157175`*^9, 3.9430945973482494`*^9, 3.94311274365314*^9, 
  3.943342572498048*^9, 3.9434261118072567`*^9, 3.9446592634098206`*^9, 
  3.945685674064569*^9, 3.9456922033861904`*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"46488e68-139f-4a0c-a70d-dc76fc59e99c"]
}, Open  ]],

Cell[TextData[{
 "The box dimensions can be decided for a desired density.  \[Rho] = N/(4 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "x"], TraditionalForm]],ExpressionUUID->
  "282d871e-a92e-4b88-8962-62cabaece390"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "y"], TraditionalForm]],ExpressionUUID->
  "0d13698d-508c-4361-bceb-4a5b5ebefe81"],
 ") = ",
 StyleBox["N",
  FontSlant->"Italic"],
 "/(2",
 Cell[BoxData[
  FormBox[
   SqrtBox["3"], TraditionalForm]],ExpressionUUID->
  "e3ea0a4f-3982-4618-98e5-ae3dda235ce0"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["b", "x", "2"], TraditionalForm]],ExpressionUUID->
  "b709a499-8987-4b92-8460-2bf7668df918"],
 ") (where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "y"], " "}], TraditionalForm]],ExpressionUUID->
  "24df03b8-7016-4d45-b506-78ebeeb845cc"],
 "= ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], 
    RowBox[{
     SubscriptBox["b", "x"], "/", "2"}]}], TraditionalForm]],ExpressionUUID->
  "38c8bbfa-cb92-4784-8cc8-d70fbd89dcd6"]
}], "Text",
 CellChangeTimes->{{3.927639970214085*^9, 3.9276401100700855`*^9}, {
  3.9276401857071857`*^9, 
  3.9276402704140744`*^9}},ExpressionUUID->"d208f14f-4df2-497a-bd37-\
c4f627531c05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Bx", "[", 
   RowBox[{"K_", ",", "\[Rho]_"}], "]"}], "=", 
  SqrtBox[
   FractionBox["K", 
    RowBox[{"2", 
     SqrtBox["3"], "\[Rho]"}]]]}]], "Code",
 CellChangeTimes->{{3.927640393010669*^9, 3.927640505560068*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"8de99e80-03ae-4850-9eb9-2cc9bb7a5049"],

Cell[BoxData[
 FractionBox[
  SqrtBox[
   FractionBox["K", "\[Rho]"]], 
  RowBox[{
   SqrtBox["2"], " ", 
   SuperscriptBox["3", 
    RowBox[{"1", "/", "4"}]]}]]], "Output",
 CellChangeTimes->{{3.9427445310428*^9, 3.9427445318052464`*^9}, {
  3.9427541907152224`*^9, 3.9427541911001935`*^9}, {3.943094596457967*^9, 
  3.943094597370163*^9}, {3.943112743135524*^9, 3.94311274367209*^9}, {
  3.943342569060707*^9, 3.943342572513646*^9}, {3.943426111134905*^9, 
  3.9434261118298273`*^9}, {3.944659261951353*^9, 3.9446592634237823`*^9}, {
  3.9456856730226793`*^9, 3.9456856740863295`*^9}, {3.9456922028366294`*^9, 
  3.945692203418103*^9}},
 CellLabel->"Out[22]=",ExpressionUUID->"8088bdb3-3612-4910-afac-1544bd960ee2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Bx", "[", 
  RowBox[{"256", ",", " ", 
   RowBox[{"1", "/", "\[Pi]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9276405272417655`*^9, 3.9276405974470234`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"dec5cb8d-4b61-44a0-b921-509bcc6168e0"],

Cell[BoxData[
 FractionBox[
  RowBox[{"8", " ", 
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]]}], 
  SuperscriptBox["3", 
   RowBox[{"1", "/", "4"}]]]], "Output",
 CellChangeTimes->{{3.927640555106674*^9, 3.9276405983742933`*^9}, 
   3.942744531826519*^9, 3.942754191116185*^9, 3.9430945973891115`*^9, 
   3.9431127436920376`*^9, 3.943342572544916*^9, 3.943426111855425*^9, 
   3.944659263462702*^9, 3.9456856741076155`*^9, 3.945692203450986*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"e42cddd1-52f4-48e1-a966-d6a1eafd9df4"]
}, Open  ]],

Cell[TextData[{
 "The particle positions then will be Nr rows each having Nc particles (this \
assumes N is composite).  The following function will place a row of ",
 StyleBox["n",
  FontSlant->"Italic"],
 " particles spaced by ",
 StyleBox["a",
  FontSlant->"Italic"],
 " starting at position {",
 StyleBox["x",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y",
  FontSlant->"Italic"],
 "}:"
}], "Text",
 CellChangeTimes->{{3.9274511699422364`*^9, 3.9274512523824453`*^9}, {
  3.9275368596505795`*^9, 3.92753686186639*^9}, {3.9427454687501974`*^9, 
  3.9427454715029144`*^9}, {3.9427455127506027`*^9, 
  3.942745609126521*^9}},ExpressionUUID->"b7415082-43ec-4286-8ae2-\
63bf56b14bf4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", " ", "placeR", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"placeR", "::", "usage"}], "=", 
  "\"\<placeR[n, a, x, y] will place a row of \
\!\(\*StyleBox[\"n\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\" \",FontSlant->\
\"Italic\"]\)particles spaced by \
\!\(\*StyleBox[\"a\",FontSlant->\"Italic\"]\) starting \nat position \
{\!\(\*StyleBox[\"x\",FontSlant->\"Italic\"]\), \
\!\(\*StyleBox[\"y\",FontSlant->\"Italic\"]\)}\>\""}], "\n", 
 RowBox[{
  RowBox[{"placeR", "[", 
   RowBox[{"n_", ",", " ", "a_", ",", " ", "x_", ",", " ", "y_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", " ", "+", " ", 
