  "Out[126]=",ExpressionUUID->"4e0b6441-c99a-494b-b98b-28b0ecc56415"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Beta]e2", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"\[Beta]e", "//.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["x", "i"], "\[Rule]", " ", "i"}], ",", 
       RowBox[{"Sx", "\[Rule]", 
        SqrtBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["n", "2"], "-", "1"}], ")"}], "/", "12"}]]}], ",", 
       RowBox[{
        OverscriptBox["x", "_"], "\[Rule]", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", "+", "1"}], ")"}], "/", "2"}]}], ",", " ", 
       RowBox[{
        OverscriptBox["y", "_"], "\[Rule]", " ", 
        RowBox[{
         FractionBox["1", "n"], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "1"}], "n"], 
          SubscriptBox["y", "i"]}]}]}]}], "}"}]}], ",", 
    RowBox[{"Assumptions", "\[Rule]", " ", 
     RowBox[{"n", ">", "3"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9428231587845564`*^9, 3.9428232763394337`*^9}, {
  3.9428233068361177`*^9, 3.942823327243251*^9}, {3.9428233800062866`*^9, 
  3.9428233858448877`*^9}, {3.9428306658124237`*^9, 3.9428307106322527`*^9}, {
  3.942830753465069*^9, 3.942830763162761*^9}, {3.9433488351894755`*^9, 
  3.94334887887894*^9}, {3.9433494406843586`*^9, 3.9433494407630033`*^9}},
 CellLabel->"In[96]:=",ExpressionUUID->"4df4f3ca-764d-436c-9d9c-05d695c56ea0"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", "6"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "n"}], ")"}], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     SubscriptBox["y", "i"]}]}], "+", 
   RowBox[{"12", " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{"i", " ", 
      SubscriptBox["y", "i"]}]}]}]}], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "n"}], ")"}]}]]], "Output",
 CellChangeTimes->{3.9433488809387355`*^9, 3.943349447028117*^9, 
  3.9433549879652863`*^9, 3.943426116919952*^9},
 CellLabel->"Out[96]=",ExpressionUUID->"c2757de9-48fb-46a2-b90a-fe651e546491"]
}, Open  ]],

Cell["We can combine the two sums in the numerator:", "Text",
 CellChangeTimes->{{3.9428311055138817`*^9, 3.942831120478923*^9}, 
   3.9428312584305096`*^9, {3.9433429113914075`*^9, 
   3.94334291406263*^9}},ExpressionUUID->"7b491b81-af46-42a5-865c-\
d758cc41dc5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Beta]e3", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"12", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], "n"], 
       RowBox[{
        SubscriptBox["y", "i"], 
        RowBox[{"(", 
         RowBox[{"i", "-", 
          FractionBox[
           RowBox[{"n", "+", "1"}], "2"]}], ")"}]}]}]}], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "n"}], ")"}]}]], ",", 
    RowBox[{"Assumptions", "\[Rule]", " ", 
     RowBox[{"n", ">", "3"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.942831265004998*^9, 3.9428313439728994`*^9}, 
   3.9428318432704897`*^9, {3.9430947365488358`*^9, 3.9430947436194143`*^9}, 
   3.943350024193986*^9, {3.9433506330347567`*^9, 3.9433507567239885`*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"935747bb-a27e-43a3-ac7a-012429ead1db"],

Cell[BoxData[
 FractionBox[
  RowBox[{"12", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "n"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"i", "+", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "-", "n"}], ")"}]}]}], ")"}], " ", 
     SubscriptBox["y", "i"]}]}]}], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "n"}], ")"}]}]]], "Output",
 CellChangeTimes->{
  3.9428314611416883`*^9, 3.9430946035902295`*^9, 3.9430947495082545`*^9, 
   3.943112746817005*^9, 3.943342595873417*^9, {3.9433507342605915`*^9, 
   3.9433507626610074`*^9}, 3.9434261171234207`*^9},
 CellLabel->"Out[97]=",ExpressionUUID->"e59d66a3-7aeb-4fcc-928f-f1381a9fccaa"]
}, Open  ]],

Cell[TextData[{
 "The coefficients of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "940924bf-6d8e-443e-9872-b1a8649da773"],
 " will sum to be the multiplier of the mean of ",
 StyleBox["y",
  FontSlant->"Italic"],
 " (which is the average temperature), sums to zero (so teh slope doesn\
\[CloseCurlyQuote]t depend on teh avereage temperature)."
}], "Text",
 CellChangeTimes->{{3.9430947712265406`*^9, 3.9430949120396595`*^9}, {
  3.9433551105786347`*^9, 
  3.9433551248833857`*^9}},ExpressionUUID->"e86a34ee-7e8f-430b-863d-\
307a2cc2eb38"],

