     RowBox[{"3.5", ",", "5"}], "]"}], "/", 
    RowBox[{"rn", "[", 
     RowBox[{"a79", ",", "5"}], "]"}]}], ",", 
   RowBox[{
    RowBox[{"f", "[", "3.5", "]"}], "/", 
