Cell[TextData[{
 "Now we need to distribute the sums, and realize that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "n"], 
    SubscriptBox["y", "i"]}], "=", 
   RowBox[{"n", " ", 
    OverscriptBox["y", "_"]}]}]],
  CellChangeTimes->{{3.9435341417067204`*^9, 3.9435343101235127`*^9}, {
   3.9435344518848963`*^9, 3.9435345230057344`*^9}, {3.9435349165655146`*^9, 
   3.9435351716606617`*^9}, {3.9435352030477805`*^9, 3.943535207982132*^9}, {
   3.943535971688207*^9, 3.9435359835477114`*^9}},ExpressionUUID->
  "edbddc14-794e-4d93-b058-f39df9381dba"],
 " and that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["y", "^"], "i"], "=", 
    RowBox[{
     OverscriptBox["\[Alpha]", "^"], "+", 
     RowBox[{
      OverscriptBox["\[Beta]", "^"], " ", "i"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "3138fb3b-0d84-42d7-966d-3b860e05228c"],
 " (where we implicitly make ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "i"], "=", "i"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "9f68fffd-7232-4bc1-9fc7-2f036666b57f"],
 ")"
}], "Text",
