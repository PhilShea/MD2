Cell[TextData[{
 "However, the MD2 code has never really dealt with the step, in that the \
velocity of a particle crossing the step was never diminished in the \
direction it crossed. In effect, the step was not there, but the potential \
energy calculation reported it.  If ",
 StyleBox["rn[]", "Input"],
 " was defined with the step subtracted, the force would be unchanged, but \
the potential would be a little lower. The step height is at ",
 StyleBox["r ",
  FontSlant->"Italic"],
 "= 7/2, so the excess P.E. per particle is given by:"
}], "Text",
 CellChangeTimes->{{3.9429444124765234`*^9, 3.9429446165332947`*^9}, {
  3.9429447539168625`*^9, 3.9429447548046064`*^9}, {3.942949405213391*^9, 
  3.9429494709102845`*^9}, {3.942949509735155*^9, 
  3.942949550462047*^9}},ExpressionUUID->"a3539ba0-e7cd-4cfa-87e3-\
b3098bc5ffd6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"step", "=", 
  RowBox[{"N", "[", 
   RowBox[{"6", 
    RowBox[{
     RowBox[{"rn", "[", 
      RowBox[{
       RowBox[{"7", "/", "2"}], ",", "5"}], "]"}], "/", "2"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9429446640127516`*^9, 3.942944748253991*^9}, {
  3.942949423167242*^9, 3.942949455398794*^9}, {3.9429496064071007`*^9, 
  3.942949606910737*^9}, {3.942950471765786*^9, 3.9429504728603005`*^9}},
 CellLabel->
  "In[184]:=",ExpressionUUID->"875db403-10f3-4cd3-95a6-aa1cd41b88b5"],

Cell[BoxData["0.005711905753555066`"], "Output",
 CellChangeTimes->{
  3.9429446755626183`*^9, 3.9429447486973157`*^9, 3.9429495386431017`*^9, {
   3.9429495842606688`*^9, 3.942949610505108*^9}, 3.942950428659109*^9, {
   3.942950465259906*^9, 3.942950473317206*^9}},
 CellLabel->
  "Out[184]=",ExpressionUUID->"087d9a21-8a19-4ea8-bedd-5ccc3041e3c8"]
}, Open  ]],

