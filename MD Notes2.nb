Cell[TextData[{
 "However, the MD2 code has never really dealt with the step, in that the \
velocity of a particle crossing the step was never diminished in the \
direction it crossed. In effect, the step was not there, but the potential \
energy calculation reported it.  If ",
 StyleBox["rn[]", "Input"],
 " was defined with the step subtracted, the force would be unchanged, but \
the potential would be a little lower. The step is at ",
 StyleBox["r ",
  FontSlant->"Italic"],
 "= 7/2, so the excess P.E. per particle when they are at rest in their \
minimum P.E. positions is given by:"
}], "Text",
 CellChangeTimes->{{3.9429444124765234`*^9, 3.9429446165332947`*^9}, {
  3.9429447539168625`*^9, 3.9429447548046064`*^9}, {3.942949405213391*^9, 
  3.9429494709102845`*^9}, {3.942949509735155*^9, 3.942949550462047*^9}, {
  3.943112820404013*^9, 
  3.9431128578923483`*^9}},ExpressionUUID->"a3539ba0-e7cd-4cfa-87e3-\
b3098bc5ffd6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"step", "=", 
  RowBox[{"N", "[", 
   RowBox[{"12", 
    RowBox[{
     RowBox[{"rn", "[", 
      RowBox[{
       RowBox[{"7", "/", "2"}], ",", "5"}], "]"}], "/", "2"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9429446640127516`*^9, 3.942944748253991*^9}, {
  3.942949423167242*^9, 3.942949455398794*^9}, {3.9429496064071007`*^9, 
  3.942949606910737*^9}, {3.942950471765786*^9, 3.9429504728603005`*^9}, {
