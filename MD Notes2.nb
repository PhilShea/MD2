Cell["See Fukshansky 2011", "Text",
 CellChangeTimes->{{3.9274493102782993`*^9, 
  3.927449321926408*^9}},ExpressionUUID->"53da6fab-c150-4242-aa9f-\
cd57ae4892d4"],

Cell[TextData[{
 "The hypotenuse (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "1"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "52b13ac3-8138-483c-aab9-6b120499050f"],
 " - ",
 StyleBox["E",
  FontSlant->"Italic"],
 ") is given by the following:"
}], "Text",
 CellChangeTimes->{{3.9275354356981916`*^9, 3.9275354513786354`*^9}, {
  3.927535497954034*^9, 
  3.927535547068039*^9}},ExpressionUUID->"6e56d301-4863-4d28-a261-\
c03ebc0a0c74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "/", "2"}], " ", "\[Equal]", 
    RowBox[{"r", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"30", " ", "Degree"}], "]"}]}]}], ",", "r"}], "]"}]], "Input",
 CellChangeTimes->{{3.9274493008919983`*^9, 3.9274493057102776`*^9}, {
  3.9274501305511713`*^9, 3.9274501549376*^9}, {3.9274501872030315`*^9, 
  3.927450234264818*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"e110982e-81e8-4d43-96c5-1b1e19e4f193"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"r", "\[Rule]", 
    FractionBox["a", 
     SqrtBox["3"]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.92745086649584*^9, 3.94274453151956*^9, 
  3.942754190997468*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"23be8563-bb3f-4f28-9bd3-0fd5267ce23f"]
}, Open  ]],

Cell["The short side is therefore", "Text",
 CellChangeTimes->{{3.927535565012191*^9, 
  3.9275355790187607`*^9}},ExpressionUUID->"d35ceeee-d24f-404e-89ed-\
27839f3bfc85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"a", "/", 
    SqrtBox["3"]}], ")"}], 
  RowBox[{"Sin", "[", 
   RowBox[{"30", " ", "Degree"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.927534728468815*^9, 3.927534765173394*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"1a02e662-9aee-45c8-9b59-104fcaef681c"],

Cell[BoxData[
 FractionBox["a", 
  RowBox[{"2", " ", 
   SqrtBox["3"]}]]], "Output",
 CellChangeTimes->{3.927534765909797*^9, 3.9427445315483365`*^9, 
  3.942754191020405*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"4359a6d0-0059-4ee0-9ea4-f83e9e3ec484"]
}, Open  ]],

Cell["The area occupied by one particle is then:", "Text",
 CellChangeTimes->{{3.927450872262682*^9, 3.9274508900944805`*^9}, 
   3.927535405762106*^9, {3.9427454476645947`*^9, 
   3.942745449478509*^9}},ExpressionUUID->"abf10b0a-511a-418e-b5df-\
427e4902632a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"area", "=", 
  RowBox[{"12", 
   RowBox[{"(", 
    FractionBox["a", "2"], ")"}], 
   RowBox[{"(", 
    FractionBox["a", 
     RowBox[{"2", 
      SqrtBox["3"]}]], ")"}], 
   RowBox[{"(", 
    FractionBox["1", "2"], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.927450263283159*^9, 3.927450280817297*^9}, {
  3.9274503295285187`*^9, 3.9274503772562447`*^9}, {3.927536630709994*^9, 
  3.9275366892193165`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"6256a90d-f83e-48c7-b46f-72cec9856afe"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SqrtBox["3"], " ", 
   SuperscriptBox["a", "2"]}], "2"]], "Output",
 CellChangeTimes->{{3.927450367386942*^9, 3.927450379090124*^9}, 
   3.9275366902833176`*^9, 3.9427445315785847`*^9, 3.9427541910403533`*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"3ae67364-bc36-40db-a5b5-5e66344fcacf"]
}, Open  ]],

Cell["To achieve a specified density, solve the following:", "Text",
 CellChangeTimes->{{3.927450925014512*^9, 3.9274509374785585`*^9}, 
   3.927451150410391*^9, {3.9276396372461166`*^9, 
   3.9276396524945383`*^9}},ExpressionUUID->"d68457d4-08f4-4699-987f-\
a236aeb6556a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      SqrtBox["3"], " ", 
      SuperscriptBox["a", "2"]}], "2"], "\[Equal]", 
    RowBox[{"1", "/", "\[Rho]"}]}], ",", "a"}], "]"}]], "Input",
 CellChangeTimes->{{3.9274509447295127`*^9, 3.92745100339276*^9}, {
  3.927453996722189*^9, 3.9274540078414555`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"4fd8d35b-1165-42be-889d-041d1cf1cb3d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       SqrtBox["2"], 
       RowBox[{
        SuperscriptBox["3", 
         RowBox[{"1", "/", "4"}]], " ", 
        SqrtBox["\[Rho]"]}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", "\[Rule]", 
     FractionBox[
      SqrtBox["2"], 
      RowBox[{
       SuperscriptBox["3", 
        RowBox[{"1", "/", "4"}]], " ", 
       SqrtBox["\[Rho]"]}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9274509882484026`*^9, 3.9274510041838627`*^9}, 
   3.92745400937763*^9, 3.942744531737108*^9, 3.9427541910603228`*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"e7dc7383-ba97-4514-8a19-4023a8b73731"]
}, Open  ]],

Cell[TextData[{
 "The paper from 1980 claimed a density of \[Rho] = 1/\[Pi] and an ",
 StyleBox["a",
  FontSlant->"Italic"],
 " of about 1.9\[Sigma]"
}], "Text",
 CellChangeTimes->{{3.9276396783180943`*^9, 3.9276397093267508`*^9}, {
  3.9276398769158497`*^9, 3.927639903549054*^9}, {3.9276406362785068`*^9, 
  3.927640643007394*^9}},ExpressionUUID->"4074ba1a-1cca-4561-a217-\
30a2b736d1f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Alpha]79", "=", 
  RowBox[{"Simplify", "[", 
   FractionBox[
    SqrtBox["2"], 
    RowBox[{
     SuperscriptBox["3", 
      RowBox[{"1", "/", "4"}]], " ", 
     SqrtBox[
      RowBox[{"1", "/", "\[Pi]"}]]}]], "]"}]}]], "Input",
 CellChangeTimes->{{3.942918320995417*^9, 3.9429183309544015`*^9}, {
  3.942918842994274*^9, 3.942918843186692*^9}, {3.9429190050023637`*^9, 
  3.942919013383706*^9}},
 CellLabel->
  "In[156]:=",ExpressionUUID->"8acedad9-067f-4464-a4c5-bfd247b549f9"],

Cell[BoxData[
 FractionBox[
  SqrtBox[
   RowBox[{"2", " ", "\[Pi]"}]], 
  SuperscriptBox["3", 
   RowBox[{"1", "/", "4"}]]]], "Output",
 CellChangeTimes->{3.9429183326534095`*^9, 3.942919015052183*^9},
 CellLabel->
  "Out[156]=",ExpressionUUID->"9ea84af7-462e-4f26-818f-a06dc9fa3129"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"a79", "=", 
  RowBox[{"N", "[", "\[Alpha]79", "]"}]}]], "Input",
 CellChangeTimes->{{3.927639733007172*^9, 3.9276397505837674`*^9}, {
   3.9282429363873253`*^9, 3.9282429392663965`*^9}, 3.9429183434858627`*^9, {
   3.942919021088645*^9, 3.94291902478283*^9}},
 CellLabel->
  "In[157]:=",ExpressionUUID->"c865db76-5fca-40b8-832b-35aa9f610921"],

Cell[BoxData["1.9046256137279145`"], "Output",
 CellChangeTimes->{3.9276397518207855`*^9, 3.928242940082279*^9, 
  3.94274453178183*^9, 3.9427541910862303`*^9, 3.942918345765269*^9, 
  3.9429190255157175`*^9},
 CellLabel->
  "Out[157]=",ExpressionUUID->"5591dda6-f3f8-41c9-bfc4-19349715dd3f"]
}, Open  ]],

Cell[TextData[{
 "The box dimensions can be decided for a desired density.  \[Rho] = N/(4 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "x"], TraditionalForm]],ExpressionUUID->
  "282d871e-a92e-4b88-8962-62cabaece390"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "y"], TraditionalForm]],ExpressionUUID->
  "0d13698d-508c-4361-bceb-4a5b5ebefe81"],
 ") = ",
 StyleBox["N",
  FontSlant->"Italic"],
 "/(2",
 Cell[BoxData[
  FormBox[
   SqrtBox["3"], TraditionalForm]],ExpressionUUID->
  "e3ea0a4f-3982-4618-98e5-ae3dda235ce0"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["b", "x", "2"], TraditionalForm]],ExpressionUUID->
  "b709a499-8987-4b92-8460-2bf7668df918"],
 ") (where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "y"], " "}], TraditionalForm]],ExpressionUUID->
  "24df03b8-7016-4d45-b506-78ebeeb845cc"],
 "= ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], 
    RowBox[{
     SubscriptBox["b", "x"], "/", "2"}]}], TraditionalForm]],ExpressionUUID->
  "38c8bbfa-cb92-4784-8cc8-d70fbd89dcd6"]
}], "Text",
 CellChangeTimes->{{3.927639970214085*^9, 3.9276401100700855`*^9}, {
  3.9276401857071857`*^9, 
  3.9276402704140744`*^9}},ExpressionUUID->"d208f14f-4df2-497a-bd37-\
c4f627531c05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Bx", "[", 
   RowBox[{"K_", ",", "\[Rho]_"}], "]"}], "=", 
  SqrtBox[
   FractionBox["K", 
    RowBox[{"2", 
     SqrtBox["3"], "\[Rho]"}]]]}]], "Code",
 CellChangeTimes->{{3.927640393010669*^9, 3.927640505560068*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"8de99e80-03ae-4850-9eb9-2cc9bb7a5049"],

Cell[BoxData[
 FractionBox[
  SqrtBox[
   FractionBox["K", "\[Rho]"]], 
  RowBox[{
   SqrtBox["2"], " ", 
   SuperscriptBox["3", 
    RowBox[{"1", "/", "4"}]]}]]], "Output",
 CellChangeTimes->{{3.9427445310428*^9, 3.9427445318052464`*^9}, {
  3.9427541907152224`*^9, 3.9427541911001935`*^9}},
 CellLabel->"Out[19]=",ExpressionUUID->"3c7f812d-2dbd-4b2e-a9ca-5c0c431a93ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Bx", "[", 
  RowBox[{"256", ",", " ", 
   RowBox[{"1", "/", "\[Pi]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9276405272417655`*^9, 3.9276405974470234`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"dec5cb8d-4b61-44a0-b921-509bcc6168e0"],

Cell[BoxData[
 FractionBox[
  RowBox[{"8", " ", 
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]]}], 
  SuperscriptBox["3", 
   RowBox[{"1", "/", "4"}]]]], "Output",
 CellChangeTimes->{{3.927640555106674*^9, 3.9276405983742933`*^9}, 
   3.942744531826519*^9, 3.942754191116185*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"d6c4364f-5098-45c1-ac33-5b4292557ff8"]
}, Open  ]],

Cell[TextData[{
 "The particle positions then will be Nr rows each having Nc particles (this \
assumes N is composite).  The following function will place a row of ",
 StyleBox["n",
  FontSlant->"Italic"],
 " particles spaced by ",
 StyleBox["a",
  FontSlant->"Italic"],
 " starting at position {",
 StyleBox["x",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y",
  FontSlant->"Italic"],
 "}:"
}], "Text",
 CellChangeTimes->{{3.9274511699422364`*^9, 3.9274512523824453`*^9}, {
  3.9275368596505795`*^9, 3.92753686186639*^9}, {3.9427454687501974`*^9, 
  3.9427454715029144`*^9}, {3.9427455127506027`*^9, 
  3.942745609126521*^9}},ExpressionUUID->"b7415082-43ec-4286-8ae2-\
63bf56b14bf4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", " ", "placeR", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"placeR", "::", "usage"}], "=", 
  "\"\<placeR[n, a, x, y] will place a row of \
\!\(\*StyleBox[\"n\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\" \",FontSlant->\
\"Italic\"]\)particles spaced by \
\!\(\*StyleBox[\"a\",FontSlant->\"Italic\"]\) starting \nat position \
{\!\(\*StyleBox[\"x\",FontSlant->\"Italic\"]\), \
\!\(\*StyleBox[\"y\",FontSlant->\"Italic\"]\)}\>\""}], "\n", 
 RowBox[{
  RowBox[{"placeR", "[", 
   RowBox[{"n_", ",", " ", "a_", ",", " ", "x_", ",", " ", "y_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", " ", "+", " ", 
       RowBox[{"i", " ", "a"}]}], ",", " ", "y"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.9274516528692226`*^9, 3.927451765687502*^9}, {
  3.927454390681399*^9, 3.927454391832137*^9}, {3.927454529064745*^9, 
  3.927454537511648*^9}, {3.9276104646039996`*^9, 3.927610466045453*^9}, {
  3.9429168924189234`*^9, 3.9429168934930964`*^9}, {3.942917113118123*^9, 
  3.9429171363167562`*^9}},ExpressionUUID->"af66744b-e987-4461-b00f-\
4fcf76cec08e"],

Cell["Here is an example:", "Text",
 CellChangeTimes->{{3.942745635902999*^9, 
  3.9427456392620974`*^9}},ExpressionUUID->"7cc05edf-6b46-4c03-b2d8-\
b9f5a4cad94b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"placeR", "[", 
  RowBox[{"4", ",", " ", ".3", ",", " ", 
   RowBox[{".3", "/", "4"}], ",", " ", "0"}], "]"}]], "Input",
 CellChangeTimes->{{3.9274523207934847`*^9, 3.9274523493603015`*^9}, {
  3.9276104416681414`*^9, 3.92761046137895*^9}, {3.942916828403306*^9, 
  3.9429168900185785`*^9}},ExpressionUUID->"7033a43e-e6ca-460a-9e92-\
5ebc2055a2cb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.075`", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.375`", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.6749999999999999`", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.9749999999999999`", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.927452350954206*^9, 3.9274544077476377`*^9, 
  3.9274545438439894`*^9, 3.927610500032957*^9, 3.9427445318658886`*^9, 
  3.942754191148065*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"05fde6b9-1129-4fd1-9a34-4f970d5ee871"]
}, Open  ]],

Cell["\<\
This function will fill a rectangle, and the two parameter version will make \
the standard rectangle.\
\>", "Text",
 CellChangeTimes->{{3.942745646806391*^9, 3.942745650269972*^9}, {
  3.9427456873819847`*^9, 3.942745698549962*^9}, {3.942745778910468*^9, 
  3.9427458145977263`*^9}},ExpressionUUID->"a3c02cc8-a8b7-43bb-afe7-\
d2024d156bf7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", " ", "fill", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fill", "::", "usage"}], "=", 
   "\"\<fill[ Bx, By, K] will place \
\!\(\*StyleBox[\"K\",FontSlant->\"Italic\"]\) particles in a hexagonal grid \
in a rectangle of \nsize 2\!\(\*StyleBox[\"Bx\",FontSlant->\"Italic\"]\) x \
2\!\(\*StyleBox[\"By\",FontSlant->\"Italic\"]\).  If N is not a perfect \
square such that all the rows have the same number of \nparticles, it may be \
adjusted to fit the dimensions. Returns a two element list {parms, pnts}; \
parms is a list {\[Rho], a, Nc, Nr,Bx,By} \nrepectivley the density, the \
particle spacing, the number of rows and columns, and the\ninput box \
parmaeters.  pnts is a list of {x, y} coordinates of the K particle \
positions.\n\nfill[ Bx, K] (the two parameter version) will set By to the \
default of (\!\(\*SqrtBox[\(3\)]\)/2)Bx.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fill", "[", 
    RowBox[{"Bx_", ",", " ", "By_", ",", " ", "K_"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]", "=", 
        RowBox[{"K", "/", 
         RowBox[{"(", 
          RowBox[{"4", " ", "Bx", " ", "By"}], ")"}]}]}], ",", " ", "a", ",", 
       " ", "Nc", ",", " ", "Nr", ",", " ", "r", ",", " ", "c"}], "}"}], ",", 
     " ", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"a", "=", 
       SqrtBox[
        RowBox[{"2", "/", 
         RowBox[{"(", 
          RowBox[{"\[Rho]", 
           SqrtBox["3"]}], ")"}]}]]}], ";", " ", 
      RowBox[{"c", "=", 
       RowBox[{
        SqrtBox["3"], "/", "2"}]}], ";", " ", 
      RowBox[{"Nc", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"2", " ", 
         RowBox[{"Bx", "/", "a"}]}], "]"}]}], ";", " ", 
      RowBox[{"Nr", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"K", "/", "Nc"}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\[Rho]", ",", " ", "a", ",", " ", "Nr", ",", " ", "Nc", ",", " ", 
          "Bx", ",", " ", "By"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"placeR", "[", 
           RowBox[{"Nc", ",", " ", "a", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "/", "4"}], ")"}], 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"2", 
                 RowBox[{"Mod", "[", 
                  RowBox[{"i", ",", "2"}], "]"}]}]}], ")"}]}], "-", "Bx"}], 
            ",", 
            RowBox[{
             RowBox[{"a", " ", "c", 
              RowBox[{"(", 
               RowBox[{"i", "+", 
                RowBox[{"1", "/", "2"}]}], ")"}]}], "-", "By"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"Nr", "-", "1"}]}], "}"}]}], "]"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"fill", "[", 
    RowBox[{"Bx_", ",", " ", "K_"}], "]"}], ":=", " ", 
   RowBox[{"fill", "[", 
    RowBox[{"Bx", ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SqrtBox["3"], "/", "2"}], ")"}], "Bx"}], ",", "K"}], 
    "]"}]}]}]}], "Code",
 CellChangeTimes->{{3.9274517737321415`*^9, 3.927451971047587*^9}, {
