Cell[TextData[{
 "We can find the nearest points in the following way. Note that when the \
points are left in symbolic form, the distance returned is the square for \
some unknown reason. Applying ",
 StyleBox["N[]", "Input"],
 " to the list and the point yields the desired results."
}], "Text",
 CellChangeTimes->{{3.942950694590345*^9, 
  3.9429507240357847`*^9}},ExpressionUUID->"e1ed152f-210d-400a-9844-\
