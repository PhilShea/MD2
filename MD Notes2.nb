         RowBox[{
          RowBox[{"pnts256", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "/", "2"}]}]}],
        "]"}]}], "}"}], "]"}]}], "]"}]}], "Input",
