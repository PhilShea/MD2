      RowBox[{"1", "/", "4"}]]}], 
    RowBox[{"128", " ", 
     SqrtBox["2"], " ", 
     SuperscriptBox["\[Pi]", 
      RowBox[{"5", "/", "2"}]]}]]}], "}"}]], "Output",
