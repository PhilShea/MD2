Cell[TextData[{
 "The red circles above show that they do not overlap. They could be set to 2",
 StyleBox["a",
  FontSlant->"Italic"],
 " so that they would touch. There would be a few more interacting particles \
then, and at initialization, six particles would be sitting on the skin."
}], "Text",
 CellChangeTimes->{{3.942943825336157*^9, 
  3.9429438351578074`*^9}},ExpressionUUID->"e9de53f8-4e82-4efb-b9ac-\
