Cell["\<\
Combining everything together, the overall multiplier must be squared, which \
will divide the factor of twelve out:\
\>", "Text",
 CellChangeTimes->{{3.94309500907106*^9, 3.9430950170477448`*^9}, {
  3.9430950829509506`*^9, 
  3.9430951336628556`*^9}},ExpressionUUID->"0735cb0f-5ac4-48d7-8fb1-\
002f174a62b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"n2", "[", "n_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"12", " "}], 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "n"}], ")"}]}]], ")"}], "2"], 
     FractionBox["1", "12"], " ", "n", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["n", "2"]}], ")"}]}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"n", ">", "3"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9428308020189915`*^9, 3.942830814255619*^9}, {
   3.942833372812808*^9, 3.94283348595052*^9}, {3.9428336200207796`*^9, 
   3.9428336238294387`*^9}, 3.9430949807816515`*^9, {3.9433551701596866`*^9, 
   3.943355174723467*^9}},
 CellLabel->
  "In[100]:=",ExpressionUUID->"c799f27b-d310-40fc-b49c-116015fd14ff"],

Cell[BoxData[
 FractionBox[
  RowBox[{"12", " ", "n"}], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}], ")"}], "3"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "n"}], ")"}]}]]], "Output",
 CellChangeTimes->{{3.9428308074440713`*^9, 3.942830814898055*^9}, 
   3.9428334877638893`*^9, 3.942833625598729*^9, 3.943094604066915*^9, 
   3.9430949926925898`*^9, 3.9431127469147725`*^9, 3.943342596732568*^9, 
   3.943355182045687*^9, 3.9434261171850443`*^9},
 CellLabel->
  "Out[100]=",ExpressionUUID->"44d27313-5ef5-4c58-854a-87fe5b32b671"]
}, Open  ]],

Cell[TextData[{
 "That function goes down as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", 
    RowBox[{"-", "3"}]], TraditionalForm]],ExpressionUUID->
  "986690ad-b92a-48fd-9770-6c034a0d909e"],
 ", and the standard deviation as the square root of that."
}], "Text",
