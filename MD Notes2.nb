  3.9497461028114853`*^9, 3.9497600426475573`*^9, 3.964688715637339*^9, 
  3.9651166049314833`*^9, 3.965123759778319*^9, 3.965722605640685*^9, 
  3.965900156295005*^9, 3.966670544779181*^9, 3.966843665795494*^9},
