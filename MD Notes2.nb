         "pnts256", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
         ",", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.942954393311425*^9, 3.942954453025726*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"fb4a9aa3-44d2-4cad-a3f1-95ee48a8616b"],

Cell[BoxData["2786.807451181374`"], "Output",
 CellChangeTimes->{{3.942954448056425*^9, 3.942954453819075*^9}, 
   3.9430945989309616`*^9, 3.9431127442515593`*^9, 3.943342581230294*^9, 
   3.9434261131207037`*^9, 3.9446592656731987`*^9, 3.9456856757899003`*^9, 
   3.9456922042618484`*^9},
 CellLabel->"Out[52]=",ExpressionUUID->"cf861081-c91d-4cd9-af01-53e87d02f522"]
}, Open  ]],

Cell["One measurement of L was around 58. \[Omega] is then", "Text",
 CellChangeTimes->{{3.9429544695360956`*^9, 
  3.9429544777855244`*^9}},ExpressionUUID->"3c028f7e-8286-44d9-94cf-\
81026534141a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"58", "/", "S"}]], "Input",
 CellChangeTimes->{{3.9429544839508038`*^9, 3.942954487126733*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"4c04879e-b7bc-43df-8056-f46c1a0e97c0"],

Cell[BoxData["0.020812345673689385`"], "Output",
 CellChangeTimes->{3.942954488398145*^9, 3.9430945989489126`*^9, 
  3.943112744269489*^9, 3.9433425812771845`*^9, 3.943426113148603*^9, 
  3.944659265724063*^9, 3.945685675807578*^9, 3.9456922042847586`*^9},
 CellLabel->"Out[53]=",ExpressionUUID->"f1fbb325-cfe4-46f1-bed2-b158d1a91430"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"%", "/", 
  RowBox[{"(", 
   RowBox[{"2", "\[Pi]"}], ")"}]}]], "Input",
 CellChangeTimes->{{3.9429544950471077`*^9, 3.9429545033755827`*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"85aaf2ca-8872-4e55-982c-65990047dd4f"],

Cell[BoxData["0.0033123876913048883`"], "Output",
 CellChangeTimes->{3.942954503909355*^9, 3.9430945989718513`*^9, 
  3.9431127442874427`*^9, 3.943342581292778*^9, 3.94342611317348*^9, 
  3.944659265734068*^9, 3.9456856758255053`*^9, 3.9456922043067007`*^9},
 CellLabel->"Out[54]=",ExpressionUUID->"ba734ed6-e6ed-46a7-b0bf-bb9f7883480d"]
}, Open  ]],

