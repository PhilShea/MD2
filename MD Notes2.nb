Cell[TextData[{
 " We can combine the sums, and convince ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to get to a form useful in sums."
}], "Text",
 CellChangeTimes->{{3.9435348973464484`*^9, 3.9435349020909605`*^9}, {
   3.9435352118898892`*^9, 3.943535227426785*^9}, 
