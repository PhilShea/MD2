427e4902632a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"area", "=", 
  RowBox[{"12", 
   RowBox[{"(", 
    FractionBox["a", "2"], ")"}], 
   RowBox[{"(", 
    FractionBox["a", 
     RowBox[{"2", 
      SqrtBox["3"]}]], ")"}], 
   RowBox[{"(", 
    FractionBox["1", "2"], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.927450263283159*^9, 3.927450280817297*^9}, {
