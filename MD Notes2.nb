Cell[CellGroupData[{

Cell["Potential Function in the Field of Particles", "Subsubsection",
 CellChangeTimes->{{3.966845077616835*^9, 3.966845134576725*^9}, {
  3.966848993221439*^9, 
  3.96684899726927*^9}},ExpressionUUID->"404c572b-eaa7-449d-a5a5-\
2d70c33d1c4e"],

Cell[TextData[{
 "We would like to know how the potential energy of a particle will vary as \
it move directly toward another particle.  We know that there are particles \
just outside the ",
 StyleBox["skin",
  FontSlant->"Italic"],
 ", so we must account for them by recomputing the distance to all particles \
as we move."
}], "Text",
 CellChangeTimes->{{3.9668451440410843`*^9, 
  3.9668452532137136`*^9}},ExpressionUUID->"2ea39a2b-607d-4e97-9cba-\
067f90497107"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Pdx", "[", " ", 
   RowBox[{"x_", ",", "p_List", ",", "pnts_List", ",", "Rskn_"}], "]"}], ":=",
   " ", "\n", "\t", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"skinlst", "=", 
      RowBox[{"Nearest", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
            "pnts", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
            "]"}], ",", "1"}], "]"}], "\[Rule]", " ", "\"\<Distance\>\""}], 
        ",", 
        RowBox[{"N", "[", 
         RowBox[{"p", "+", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0"}], "}"}]}], "]"}], ",", "\n", 
        "\t\t\t\t\t\t\t", 
        RowBox[{"{", 
         RowBox[{"All", ",", "Rskn"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
    "\t\t\t", 
    RowBox[{"Apply", "[", 
     RowBox[{"Plus", ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"rn", "[", 
          RowBox[{"#", ",", "5", ",", "Rskn"}], "]"}], "/", "2"}], "&"}], "/@", 
       RowBox[{"skinlst", "\[LeftDoubleBracket]", 
        RowBox[{"2", ";;"}], "\[RightDoubleBracket]"}]}]}], "]"}]}], 
   "]"}]}]], "Code",
 CellChangeTimes->{{3.966845274420845*^9, 3.966845299754554*^9}, {
  3.9668453317689*^9, 3.966845515000997*^9}, {3.966845582611753*^9, 
  3.966845634910494*^9}, {3.966845665397234*^9, 3.96684572221008*^9}, {
  3.966845899276092*^9, 3.966845976578476*^9}, {3.966846168273459*^9, 
  3.9668461742491426`*^9}, {3.966847128259218*^9, 3.966847133947239*^9}, {
  3.9668472894400387`*^9, 3.966847294791888*^9}, {3.9668480359144697`*^9, 
  3.9668480982476273`*^9}},
 CellLabel->
  "In[287]:=",ExpressionUUID->"c57074c3-95bb-49c8-9533-9322b0b4a99c"],

