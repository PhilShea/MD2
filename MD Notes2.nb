Cell[TextData[{
 "We need to build the periodic boundary conditions into these results, but \
we\[CloseCurlyQuote]ll save that for the ",
 StyleBox["Julia",
  FontSlant->"Italic"],
 " code.  Let\[CloseCurlyQuote]s look at a particle near the middle of the \
array. When creating the million point system, we wrap N[] around Bx[] to \
cause each value to be turned into a real number, otherwise the particle list \
gets very long as a symbolic expression."
}], "Text",
 CellChangeTimes->{{3.964775897460989*^9, 3.964775932262104*^9}, {
  3.964775996127864*^9, 3.9647760141766233`*^9}, {3.964776704534437*^9, 
  3.96477676349861*^9}, {3.964777259689117*^9, 3.964777280184999*^9}, {
  3.966669233717231*^9, 
  3.966669238725101*^9}},ExpressionUUID->"0fabd57e-71f1-4097-a5b7-\
0a70c76fa31d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pnts1M", "=", 
   RowBox[{"fill", "[", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"Bx", "[", 
       RowBox[{
        SuperscriptBox["2", "20"], ",", " ", 
        RowBox[{"1", "/", "\[Pi]"}]}], "]"}], "]"}], ",", 
     SuperscriptBox["2", "20"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"pnts1M", "\[LeftDoubleBracket]", "1", 
  "\[RightDoubleBracket]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p1M", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"pnts1M", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
      ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"po", "=", 
  RowBox[{"p1M", "\[LeftDoubleBracket]", 
   RowBox[{
    SuperscriptBox["2", "19"], "-", "512"}], 
   "\[RightDoubleBracket]"}]}]}], "Input",
