Cell[CellGroupData[{

Cell[TextData[{
 "Potentials ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["r", "n"]}], TraditionalForm]],ExpressionUUID->
  "cd0d6d57-8355-4cd8-9f36-5a7c3b198faf"]
}], "Subsubsection",
 CellChangeTimes->{{3.9280504782932286`*^9, 3.928050493588919*^9}, {
  3.928242631689312*^9, 3.928242667355645*^9}, {3.9428427180310884`*^9, 
  3.9428427190710497`*^9}},ExpressionUUID->"364469d3-26eb-473c-bf9e-\
dfa30b85fcb9"],

Cell["The standard repulsive potential is given by:", "Text",
 CellChangeTimes->{{3.9283350509269667`*^9, 
  3.928335091790043*^9}},ExpressionUUID->"81299764-0a72-401c-aace-\
802af7341f9a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "rn", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rn", "[", 
   RowBox[{"r_", ",", " ", "n_"}], "]"}], ":=", " ", 
  RowBox[{"1", "/", 
   SuperscriptBox["r", "n"]}]}]}], "Code",
 CellChangeTimes->{{3.9282414657552395`*^9, 3.9282415485225077`*^9}, {
  3.928242371037327*^9, 3.928242417826324*^9}, {3.928242675853885*^9, 
  3.92824269425854*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"1c297c56-900e-4cba-90ce-547fc19a6cae"],

Cell["Here is the form for a particular n:", "Text",
 CellChangeTimes->{{3.928335072974101*^9, 
  3.92833508821398*^9}},ExpressionUUID->"89b50f1f-93fd-4f5e-a6c3-\
a685c40466ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rn", "[", 
  RowBox[{"r", ",", "5"}], "]"}]], "Input",
 CellChangeTimes->{{3.928241592356372*^9, 3.928241606994564*^9}, {
  3.928242390435633*^9, 3.9282423926674995`*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"1d949a3c-da33-4016-813d-55dac1613224"],

Cell[BoxData[
 FractionBox["1", 
  SuperscriptBox["r", "5"]]], "Output",
 CellChangeTimes->{{3.9282423934896684`*^9, 3.9282424218660903`*^9}, 
   3.9282426982580385`*^9, 3.9427445329187164`*^9, 3.942754191529044*^9},
 CellLabel->"Out[39]=",ExpressionUUID->"afac6fb2-563c-4c2f-a8fd-eec694b0e7ee"]
}, Open  ]],

Cell["And here are some interesting values of that. ", "Text",
 CellChangeTimes->{{3.928335097446002*^9, 3.9283351158700213`*^9}, {
  3.9429160354274316`*^9, 
  3.9429160369069805`*^9}},ExpressionUUID->"1245f17d-cc99-4249-af68-\
19ec589fc2ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"test", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "2"}], ",", " ", "1", ",", " ", "2", ",", "a79", ",", 
      " ", "3", ",", " ", "3.4999", ",", " ", 
      RowBox[{"7", "/", "2"}], ",", " ", "4", ",", " ", "nnnd", ",", " ", 
      "tnnnd"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "explicit", " ", "rationals", " ", "are", " ", "good", " ", 
    "test", " ", "values", " ", "whose", " ", "results", " ", "are", " ", 
    "easily", " ", "done", " ", "in", " ", "your", " ", "head", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"except", " ", "for", " ", 
        RowBox[{"7", "/", "2"}]}], ",", " ", 
       RowBox[{
       "which", " ", "is", " ", "the", " ", "skin", " ", "distance"}]}], 
      ")"}], ".", " ", "a79"}], " ", "is", " ", "the", " ", 
    RowBox[{"1", "/", "pi"}], " ", 
    RowBox[{"density", ".", " ", "3.4999"}], " ", "is", " ", "just", " ", 
    "inside", " ", "the", " ", "3.5", " ", "skin", " ", 
    RowBox[{"value", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Map", "[", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"rn", "[", 
     RowBox[{"#", ",", "5"}], "]"}], "&"}], ",", "test"}], "]"}]}], "Input",
 CellChangeTimes->{{3.928242476348831*^9, 3.9282425357218494`*^9}, 
   3.9282430015802145`*^9, {3.942916050443539*^9, 3.942916134043098*^9}, {
   3.9429185599768543`*^9, 
   3.9429186161545715`*^9}},ExpressionUUID->"641e2b3f-dbfc-42cb-a8cd-\
970d4eb7b6aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"32", ",", "1", ",", 
   FractionBox["1", "32"], ",", "0.03989807087757093`", ",", 
   FractionBox["1", "243"], ",", "0.0019042406033458856`", ",", 
   FractionBox["32", "16807"], ",", 
   FractionBox["1", "1024"], ",", 
   FractionBox["1", 
    RowBox[{"12", " ", 
     SqrtBox["2"], " ", 
     SuperscriptBox["3", 
      RowBox[{"1", "/", "4"}]], " ", 
     SuperscriptBox["\[Pi]", 
      RowBox[{"5", "/", "2"}]]}]], ",", "0.0012468147149240917`"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9282430040357265`*^9, 3.942744532950733*^9, 
  3.942754191553009*^9, 3.942918569658945*^9},
 CellLabel->
  "Out[154]=",ExpressionUUID->"3c9fa59f-0e46-47ee-b4e4-617803761e4c"]
}, Open  ]],

Cell["The force is the derivative with respect to r:", "Text",
