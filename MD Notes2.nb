       RowBox[{"(", 
        RowBox[{"i", "-", 
         FractionBox[
          RowBox[{"n", "+", "1"}], "2"]}], ")"}], " ", 
       SubscriptBox["y", "i"]}], ")"}]}]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
    SqrtBox[
     RowBox[{"2", "+", 
      SuperscriptBox["n", "2"]}]]}]]}]], "Input",
 CellChangeTimes->{{3.942831265004998*^9, 3.9428313439728994`*^9}, 
