Cell[CellGroupData[{

Cell["Distribution of Regressions of Uncorrelated Data", "Subsection",
 CellChangeTimes->{{3.942746711756838*^9, 
  3.9427467317944613`*^9}},ExpressionUUID->"712dbf40-4477-4fab-bd7c-\
23785cabdc88"],

Cell["\<\
The difficulty of deciding when the temperature profiles are truly \
uncorrelated requires we examine the distribution of the slope estimate.\
\>", "Text",
 CellChangeTimes->{{3.942746738716707*^9, 
  3.94274680396509*^9}},ExpressionUUID->"57c8da0c-8e97-4e07-afdb-\
44a5ca17ff85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Beta]e", " ", "=", " ", 
  FractionBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{
      SubscriptBox["x", "i"], 
      SubscriptBox["y", "i"]}]}], "-", 
    RowBox[{"n", " ", 
     OverscriptBox["x", "_"], " ", 
     OverscriptBox["y", "_"], " "}]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"n", "-", "1"}], ")"}], "Sx"}]]}]], "Input",
 CellChangeTimes->{{3.94282123800653*^9, 3.9428215488823967`*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"4a88f33c-7366-41e7-a57c-280ca2d50ab2"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", "n"}], " ", 
    OverscriptBox["x", "_"], " ", 
    OverscriptBox["y", "_"]}], "+", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "n"], 
    RowBox[{
     SubscriptBox["x", "i"], " ", 
     SubscriptBox["y", "i"]}]}]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "Sx"}]]], "Output",
 CellChangeTimes->{3.9428222878839808`*^9},
 CellLabel->"Out[82]=",ExpressionUUID->"c4ec879c-524e-4286-ae23-0b29a13f26c5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Beta]e2", "=", 
  RowBox[{"\[Beta]e", "//.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "i"], "\[Rule]", " ", "i"}], ",", 
     RowBox[{"Sx", "\[Rule]", 
      SqrtBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["n", "2"], "+", "2"}], ")"}], "/", "12"}]]}], ",", 
     RowBox[{
      OverscriptBox["x", "_"], "\[Rule]", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "+", "1"}], ")"}], "/", "2"}]}], ",", " ", 
     RowBox[{
      OverscriptBox["y", "_"], "\[Rule]", " ", 
      RowBox[{
       FractionBox["1", "n"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "n"], 
        SubscriptBox["y", "i"]}]}]}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9428231587845564`*^9, 3.9428232763394337`*^9}, {
  3.9428233068361177`*^9, 3.942823327243251*^9}, {3.9428233800062866`*^9, 
  3.9428233858448877`*^9}, {3.9428306658124237`*^9, 3.9428307106322527`*^9}, {
  3.942830753465069*^9, 3.942830763162761*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"4df4f3ca-764d-436c-9d9c-05d695c56ea0"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   SqrtBox["3"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "n"}], ")"}], " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], "n"], 
       SubscriptBox["y", "i"]}]}], "+", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "n"], 
      RowBox[{"i", " ", 
       SubscriptBox["y", "i"]}]}]}], ")"}]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
   SqrtBox[
    RowBox[{"2", "+", 
     SuperscriptBox["n", "2"]}]]}]]], "Output",
 CellChangeTimes->{3.942830765778345*^9, 3.9428307981618576`*^9},
 CellLabel->"Out[86]=",ExpressionUUID->"fd68f92e-0f9a-4d4f-b3b6-21eb40f03f47"]
}, Open  ]],

Cell["We can combine the two sums:", "Text",
 CellChangeTimes->{{3.9428311055138817`*^9, 3.942831120478923*^9}, 
   3.9428312584305096`*^9},ExpressionUUID->"7b491b81-af46-42a5-865c-\
