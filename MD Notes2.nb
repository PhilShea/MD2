Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Apart", "[", 
  RowBox[{"12", " ", "n", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"3", " ", "n"}], "+", 
      SuperscriptBox["n", "2"]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"6", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}], "^", "2"}], 
