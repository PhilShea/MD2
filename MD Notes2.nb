Cell[TextData[{
 "The number of particles expected in a circular region of radius ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", " ", "\[Pi]", " ", 
    SuperscriptBox["r", "2"]}], TraditionalForm]],ExpressionUUID->
  "ebaae6c5-494d-4c13-9a86-82e0933b9505"],
 ", but with the density \[Rho] = 1/\[Pi], the expected number of particles \
is simply ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", "2"], TraditionalForm]],ExpressionUUID->
  "e1f096b3-f203-47e6-be36-ef8635872b97"]
}], "Text",
 CellChangeTimes->{{3.9283203783520756`*^9, 3.9283203988708954`*^9}, {
  3.9283205552386456`*^9, 3.9283206980012445`*^9}, {3.928335190303476*^9, 
  3.9283352194220967`*^9}, {3.9427465917904177`*^9, 
  3.942746595590197*^9}},ExpressionUUID->"7fa00920-d894-422b-a298-\
883cada76999"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Rho]", "=", 
     RowBox[{"1", "/", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"\[Rho]", " ", "\[Pi]", 
    RowBox[{"{", 
     RowBox[{
      SuperscriptBox["3.5", "2"], ",", 
      SuperscriptBox["5", "2"]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9283204056569376`*^9, 3.9283204527439995`*^9}, {
  3.9283204985451965`*^9, 3.9283205000650187`*^9}, {3.9283208161833897`*^9, 
  3.928320874122922*^9}},
