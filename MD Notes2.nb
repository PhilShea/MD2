Cell[CellGroupData[{

Cell["Layout of the Initial Positions", "Subsection",
 CellChangeTimes->{{3.9274463401751847`*^9, 
  3.9274463811261883`*^9}},ExpressionUUID->"78b1f6c0-ffaa-41b9-a79a-\
bcb82fa12834"],

Cell[CellGroupData[{

Cell["Area of Veroni Cell", "Subsubsection",
 CellChangeTimes->{{3.9274511342547026`*^9, 
  3.927451140943118*^9}},ExpressionUUID->"9c681390-d23d-48f4-9a91-\
651ec13cd00b"],

Cell[TextData[{
 "The initial position is based on a hexagonal grid oriented to the box \
sides.  Let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "x"], TraditionalForm]],ExpressionUUID->
  "382d14ce-589f-462a-a3c2-9807062bb11a"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "y"], TraditionalForm]],ExpressionUUID->
  "553e91f1-4857-47d7-9d23-802cf81953dd"],
 " be half the sides of the box; the box has corners {{",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["b", "x"]}], TraditionalForm]],ExpressionUUID->
  "085d01d9-0936-4b84-8959-2e3241b63591"],
 ",",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["b", "y"]}], TraditionalForm]],ExpressionUUID->
  "973687f0-7acc-44d0-a84c-0ef5435b6cea"],
 "},{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "x"], TraditionalForm]],ExpressionUUID->
  "96315612-90aa-4f60-8582-4ba6477c36b4"],
 ",",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["b", "y"]}], TraditionalForm]],ExpressionUUID->
  "13f5cd39-318d-4896-acc5-3c34028c4ab3"],
 "}, {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "x"], TraditionalForm]],ExpressionUUID->
  "90ba97b4-8612-4df8-9547-1d5b0b63a54b"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "y"], TraditionalForm]],ExpressionUUID->
  "f043b8b5-18f8-466c-b2d5-6d7ab6d58402"],
 "},{",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["b", "x"]}], TraditionalForm]],ExpressionUUID->
  "dfd10a19-1ae7-494e-8a7d-fac664c94f88"],
 ",",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["b", "y"]}], TraditionalForm]],ExpressionUUID->
  "f2201093-9446-40ac-befe-83f86236d2a4"],
 "}}   The box area is then the product of these, and the density is \[Rho] = \
",
 StyleBox["N",
  FontSlant->"Italic"],
 " / (",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", 
    SubscriptBox["b", "x"]}], TraditionalForm]],ExpressionUUID->
  "d6c04a41-5263-47db-ab7e-65fb37f5ab64"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "y"], TraditionalForm]],ExpressionUUID->
  "50afb646-819b-4c9c-b0de-face345d9a25"],
 "), where ",
 StyleBox["N",
  FontSlant->"Italic"],
 " is the number of particles in the system.  In the figure below, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "1"], TraditionalForm]],ExpressionUUID->
  "182aaaf8-7a82-43a5-801e-962d2ecdb84f"],
 " is the center particle, and positions ",
 StyleBox["H",
  FontSlant->"Italic"],
 ", ",
 StyleBox["I",
  FontSlant->"Italic"],
 ", ",
 StyleBox["J",
  FontSlant->"Italic"],
 ", ",
 StyleBox["K",
  FontSlant->"Italic"],
 ", ",
 StyleBox["L",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["M",
  FontSlant->"Italic"],
 " are the adjacent particles.  Let the hexagonal lattice have particle \
spacing ",
 StyleBox["a",
  FontSlant->"Italic"],
 " (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "1"], TraditionalForm]],ExpressionUUID->
  "6c11628d-8f47-4e58-98bc-cb173aef0aa1"],
 " - ",
 StyleBox["J",
  FontSlant->"Italic"],
 " below). The Veroni cell around each particle consists of twelve 30-60-90 \
right triangles with sides ",
 StyleBox["a",
  FontSlant->"Italic"],
 "/2 (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "1"], TraditionalForm]],ExpressionUUID->
  "e47656b3-a906-4cb5-aceb-ce6665365235"],
 "-",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "7f8e5ae2-0a77-41f0-bbf4-5767d83188e7"],
 " in the figure below), ",
 StyleBox["a",
  FontSlant->"Italic"],
 "/(2",
 Cell[BoxData[
  FormBox[
   SqrtBox["3"], TraditionalForm]],ExpressionUUID->
  "1bca41b2-3e73-4f57-8a97-d2a1e7b52c96"],
 ") (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], "-", "E"}], TraditionalForm]],ExpressionUUID->
  "21623b84-f6d6-4ed7-8f1c-0afb239fa61a"],
 "), and hypotenuse ",
 StyleBox["a",
  FontSlant->"Italic"],
 "/",
 Cell[BoxData[
  FormBox[
   SqrtBox["3"], TraditionalForm]],ExpressionUUID->
  "9c4e25b9-8c4d-427e-b8e3-5bb34d1be194"],
 " (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "1"], TraditionalForm]],ExpressionUUID->
  "c70e476a-5cee-4325-a3d9-3167023bc9b4"],
 " - ",
 StyleBox["E",
  FontSlant->"Italic"],
 "; the \[OpenCurlyQuote] marks are from the ",
 ButtonBox["GeoGebra",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.geogebra.org/geometry"], None},
  ButtonNote->"https://www.geogebra.org/geometry"],
 " drawing program indicating how many time the point was used in the \
drawing)."
}], "Text",
 CellChangeTimes->{{3.927446392950659*^9, 3.927446440630265*^9}, {
  3.927446800574597*^9, 3.9274469201748314`*^9}, {3.9274469599343286`*^9, 
  3.9274470599914913`*^9}, {3.927447096039418*^9, 3.9274471346074057`*^9}, {
  3.9274492935994487`*^9, 3.927449295159344*^9}, {3.9274493297113957`*^9, 
  3.927449427719349*^9}, {3.9274495399597073`*^9, 3.927449607948492*^9}, {
  3.9274497303353095`*^9, 3.92744998999903*^9}, {3.927450023984519*^9, 
  3.9274500239865417`*^9}, {3.927450785079818*^9, 3.9274508136842856`*^9}, {
  3.9274545965368867`*^9, 3.9274547974165106`*^9}, {3.9275345649577417`*^9, 
  3.927534585453701*^9}, {3.9427448801443768`*^9, 3.9427448824725122`*^9}, {
  3.942744938017127*^9, 
  3.9427450034497538`*^9}},ExpressionUUID->"f87ccbac-c808-42a8-bd15-\
6569b83ff1c1"],

