Cell["\<\
So, with that high value of L, it would take a time of almost 302, or 30,000 \
time steps to make a full rotation. However, only a small rotation would be a \
problem with the crystal interfaces at the boundaries.

The maximum range is a bit over 19:\
\>", "Text",
 CellChangeTimes->{{3.94295454508173*^9, 
  3.9429545756388874`*^9}},ExpressionUUID->"fa215e17-651c-4767-b877-\
966912819d69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Map", "[", 
   RowBox[{"Norm", ",", 
    RowBox[{"N", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
       "pnts256", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",",
        "1"}], "]"}], "]"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.942954588414214*^9, 3.942954633847855*^9}},
 CellLabel->
  "In[210]:=",ExpressionUUID->"ccc47457-1594-47af-bc91-545f2856c3e1"],

Cell[BoxData["19.25933461950068`"], "Output",
 CellChangeTimes->{3.9429546346673875`*^9},
 CellLabel->
  "Out[210]=",ExpressionUUID->"488be952-1f8d-41db-8555-05b2a1042f6e"]
}, Open  ]],

Cell["\<\
This means that even the farthest particles will only get less than 1% of the \
total angular momentum, but this is still more than twice what they would get \
if the momentum was evenly divided among the 256 particles.\
\>", "Text",
 CellChangeTimes->{{3.9429546440261393`*^9, 
  3.9429546501904106`*^9}},ExpressionUUID->"1edc9fcc-4e5e-4cc7-807c-\
9c10d77468d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"S", "/", "%"}]], "Input",
 CellChangeTimes->{{3.942954661047196*^9, 3.942954662111546*^9}},
 CellLabel->
  "In[211]:=",ExpressionUUID->"671ab381-9720-4d63-8346-907f2c62c4ec"],

Cell[BoxData["144.6990514594229`"], "Output",
 CellChangeTimes->{3.942954662531505*^9},
 CellLabel->
  "Out[211]=",ExpressionUUID->"44c310d8-1724-455f-8235-01fff7930fae"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Initialization", "Section",
 CellChangeTimes->{{3.9429547353590975`*^9, 
  3.9429547400625267`*^9}},ExpressionUUID->"21e6c9f2-69cb-465b-8fff-\
9e0f9bedbc88"],

Cell[TextData[{
 "For the following, see Reif, pg. 249, eq. 7.5.7. The mean kinetic energy of \
a a particle in any dimension is (1/2)",
 StyleBox["kT",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["k",
  FontSlant->"Italic"],
 " is in units of temperature per unit of energy, and ",
 StyleBox["T",
  FontSlant->"Italic"],
 " is the temperature in units defined by ",
 StyleBox["k",
  FontSlant->"Italic"],
 ". The energy of a particle of mass m = 1 is 1/2",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["v",
     FontSlant->"Plain"], "2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "f12a21eb-aaf0-4003-8888-947b9a655b44"],
 " which can be broken into x and y components (\[LeftAngleBracket]E\
\[RightAngleBracket] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     SubsuperscriptBox["v", "x", "2"]}], "+"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "ad5d3023-8e39-4f5a-889b-dd5081ca6fb3"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubsuperscriptBox["v", "y", "2"]}], TraditionalForm]],ExpressionUUID->
  "f27cf8f5-6eb2-4d91-b229-1cc4514c8a7e"],
 "=",
 StyleBox["k T",
  FontSlant->"Italic"],
 " , so that defining ",
 StyleBox["k",
  FontSlant->"Italic"],
 " = 1, each component has an expected velocity squared of ",
 StyleBox["T",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.94295475659188*^9, 3.942954832840407*^9}, {
   3.9429549048866634`*^9, 3.942955016399521*^9}, 
   3.9429550511669893`*^9},ExpressionUUID->"efc1b200-f557-41d5-90d9-\
aa34350a12d1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ngt", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ngt", "[", 
    RowBox[{"n_", ",", "T_"}], "]"}], "=", 
   RowBox[{"GammaDistribution", "[", 
    RowBox[{"n", ",", 
     RowBox[{"2", " ", "T"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Mean", "[", 
    RowBox[{"ngt", "[", 
     RowBox[{"n", ",", "T"}], "]"}], "]"}], ",", 
   RowBox[{"Variance", "[", 
    RowBox[{"ngt", "[", 
     RowBox[{"n", ",", "T"}], "]"}], "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.9429550533417025`*^9, 3.942955184833103*^9}},
 CellLabel->
  "In[215]:=",ExpressionUUID->"f3734364-e7c8-4f93-8305-abd1cea08f90"],

