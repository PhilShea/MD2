Cell[BoxData[
 RowBox[{"pe", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"6", 
      RowBox[{"rn", "[", 
       RowBox[{"a79", ",", "5"}], "]"}]}], "+", 
     RowBox[{"6", 
      RowBox[{"rn", "[", 
       RowBox[{
        RowBox[{"nnnd", " ", "a79"}], ",", "5"}], "]"}]}]}], ")"}], "/", 
   "2"}]}]], "Input",
 CellChangeTimes->{{3.9429250543263235`*^9, 3.942925090408185*^9}, 
