  "In[126]:=",ExpressionUUID->"cefcf213-4551-42c9-b5f1-f0d4d0cf5335"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"1", "+", "n"}], "2"], ",", 
   RowBox[{
    FractionBox["1", "6"], " ", "n", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "n"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"2", " ", "n"}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "12"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["n", "2"]}], ")"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9433483376521287`*^9, 3.943348399249817*^9, 
  3.943348542826657*^9, 3.9433488244858365`*^9, 3.943426116820727*^9, 
