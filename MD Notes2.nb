  RowBox[{"12.25`", ",", "25"}], "}"}]], "Output",
 CellChangeTimes->{3.92832087561755*^9, 3.9427445330441628`*^9, 
  3.9427541916168094`*^9},
 CellLabel->"Out[45]=",ExpressionUUID->"a4cf9d72-f1e5-4a7e-baa9-458a43be4925"]
}, Open  ]],

Cell[TextData[{
 "The minimum potential energy of the system on a per particle basis is the \
energy of six particles at ",
 StyleBox["a",
  FontSlant->"Italic"],
 ", and six more at ",
 StyleBox["nnnd",
  FontSlant->"Italic"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["3"], "a"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "e921f0f1-5b31-4d37-95bb-a9a25ad3084b"],
 ". Therefore the minimum potential energy per particle is half the sum of \
all twelve (since we ascribe half the potential energy to each pair)."
}], "Text",
 CellChangeTimes->{{3.942841186240711*^9, 3.942841236464803*^9}, {
   3.942841520552524*^9, 3.942841566705343*^9}, 3.942918672759761*^9, {
   3.9429187734794016`*^9, 3.942918776855931*^9}, {3.942919213030286*^9, 
   3.9429193642626657`*^9}},ExpressionUUID->"f9b0ed2e-b30e-418c-a9fb-\
168241e8c94d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pe", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"6", 
      RowBox[{"rn", "[", 
       RowBox[{"a79", ",", "5"}], "]"}]}], "+", 
     RowBox[{"6", 
      RowBox[{"rn", "[", 
       RowBox[{"nnnd", ",", "5"}], "]"}]}]}], ")"}], "/", "2"}]}]], "Input",
 CellChangeTimes->{{3.9429250543263235`*^9, 3.942925090408185*^9}, 
   3.9429439622958965`*^9, {3.942950448934276*^9, 3.9429504496930203`*^9}},
 CellLabel->
  "In[182]:=",ExpressionUUID->"95a8e345-54fe-4a6d-b6bb-3ec1aefedb99"],

