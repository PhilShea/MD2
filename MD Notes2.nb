Cell["And here are some interesting values of that. ", "Text",
 CellChangeTimes->{{3.928335097446002*^9, 3.9283351158700213`*^9}, {
  3.9429160354274316`*^9, 
  3.9429160369069805`*^9}},ExpressionUUID->"1245f17d-cc99-4249-af68-\
19ec589fc2ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"test", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "2"}], ",", " ", "1", ",", " ", "2", ",", "a79", ",", 
      " ", "3", ",", " ", "3.4999", ",", " ", 
      RowBox[{"7", "/", "2"}], ",", " ", "4", ",", " ", "nnnd", ",", " ", 
      "tnnnd"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "explicit", " ", "rationals", " ", "are", " ", "good", " ", 
    "test", " ", "values", " ", "whose", " ", "results", " ", "are", " ", 
    "easily", " ", "done", " ", "in", " ", "your", " ", "head", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"except", " ", "for", " ", 
        RowBox[{"7", "/", "2"}]}], ",", " ", 
       RowBox[{
       "which", " ", "is", " ", "the", " ", "skin", " ", "distance"}]}], 
      ")"}], ".", " ", "a79"}], " ", "is", " ", "the", " ", 
    RowBox[{"1", "/", "pi"}], " ", 
    RowBox[{"density", ".", " ", "3.4999"}], " ", "is", " ", "just", " ", 
    "inside", " ", "the", " ", "3.5", " ", "skin", " ", 
    RowBox[{"value", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Map", "[", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"rn", "[", 
     RowBox[{"#", ",", "5"}], "]"}], "&"}], ",", "test"}], "]"}]}], "Input",
 CellChangeTimes->{{3.928242476348831*^9, 3.9282425357218494`*^9}, 
   3.9282430015802145`*^9, {3.942916050443539*^9, 3.942916134043098*^9}, {
