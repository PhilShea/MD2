Cell[TextData[{
 "Here is a 256 particle array, with a focus on particle 189.  The red circle \
is the ",
 StyleBox["skin",
  FontSlant->"Italic"],
 " range of 3.5, and the green circle is the correlation range (the ",
 StyleBox["shell",
  FontSlant->"Italic"],
 ") of 5.  The magenta circled particle is the next nearest particle on the \
row, and the blue circled particle is the second next nearest particle, just \
inside the ",
 StyleBox["skin",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.942746233133216*^9, 3.9427462939565983`*^9}, {
  3.942746328069157*^9, 3.9427463915410285`*^9}, {3.9429179455763564`*^9, 
  3.9429180217921295`*^9}, {3.949746127039822*^9, 3.949746127383781*^9}, {
  3.96469112388739*^9, 
  3.964691133687118*^9}},ExpressionUUID->"8da80821-6b84-4a06-b731-\
03db7cafc4ea"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pnts256arr", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
     "pnts256", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
     "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
