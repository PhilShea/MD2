Cell[CellGroupData[{

Cell["Angular Momentum", "Subsection",
 CellChangeTimes->{{3.942952244530243*^9, 
  3.942952273593713*^9}},ExpressionUUID->"ab6fbc8b-871d-43f9-83b7-\
96207f555435"],

Cell[TextData[{
 "When applying random velocities to the particles, the velocities in the x \
and y directions will each be drawn from a zero-mean Gaussian distribution. \
The sum of velocities in the x and y direction will therefore also be \
zero-mean, but will have a substantial variance: for N particles, the \
variance will be N",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", "2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "c673d75d-ba72-4caa-93e4-46f91fe3a491"],
 ".  Therefore, after initialization, we need to measure the momentum in the \
x and y directions and subtract that average per-particle momentum from each \
particle.\n\nThe same is true for angular momentum. It just won\
\[CloseCurlyQuote]t do for the whole system to be rotating, even a little. It \
is easy to measure the angular momentum. For a particle with a vector \
position x and vector velocity v, and particle mass m, the angular momentum \
about the origin is ",
 StyleBox["L",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " = ",
 StyleBox["x",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " \[Cross] m v. In two dimensions, "
}], "Text",
 CellChangeTimes->{{3.94295228817216*^9, 3.9429523900444007`*^9}, {
  3.942952439962067*^9, 
  3.9429524571535263`*^9}},ExpressionUUID->"8551a4d7-2464-4515-bcca-\
1f3a31114232"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"A", " ", "=", 
    RowBox[{"{", 
     RowBox[{"ax", ",", "ay", ",", "az"}], "}"}]}], ";", 
   RowBox[{"V", " ", "=", 
    RowBox[{"{", 
     RowBox[{"vx", ",", "vy", ",", "vz"}], "}"}]}], ";", 
   RowBox[{"L", "=", 
    RowBox[{"Cross", "[", 
     RowBox[{"A", ",", "V"}], "]"}]}]}], "\n"}]], "Input",
 CellChangeTimes->{{3.942952472329546*^9, 3.9429525213313484`*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"06593714-736b-471c-8319-fb76c49d72ad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "az"}], " ", "vy"}], "+", 
    RowBox[{"ay", " ", "vz"}]}], ",", 
   RowBox[{
    RowBox[{"az", " ", "vx"}], "-", 
    RowBox[{"ax", " ", "vz"}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "ay"}], " ", "vx"}], "+", 
    RowBox[{"ax", " ", "vy"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9429525244855704`*^9, 3.9429541134950137`*^9, 
  3.942954220999002*^9, 3.943094598591682*^9, 3.9431127441797304`*^9, 
  3.9433425796525707`*^9, 3.943426112949177*^9, 3.944659265376546*^9, 
  3.945685675563108*^9, 3.9456922040962625`*^9},
 CellLabel->"Out[49]=",ExpressionUUID->"4b12da2e-14fc-4c37-9bd3-c12d29d2546e"]
}, Open  ]],

Cell["This is very simple when the z components are zero.", "Text",
 CellChangeTimes->{
  3.9429525408199415`*^9},ExpressionUUID->"2ff43f29-8795-43d8-be1b-\
51350963d053"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"L", "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"az", "\[Rule]", " ", "0"}], ",", " ", 
    RowBox[{"vz", "\[Rule]", "0"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.942952547884869*^9, 3.9429525692256145`*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"dcb17643-abe6-416d-9c2d-92b60c70844e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "ay"}], " ", "vx"}], "+", 
    RowBox[{"ax", " ", "vy"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.942952570029441*^9, 3.9429541168461018`*^9, 
  3.942954250853371*^9, 3.9430945987040625`*^9, 3.943112744209654*^9, 
  3.9433425796838083`*^9, 3.9434261129720864`*^9, 3.944659265468746*^9, 
  3.9456856755831904`*^9, 3.9456922041201987`*^9},
 CellLabel->"Out[50]=",ExpressionUUID->"0da53e66-4751-41dc-8f28-f4d9958b6cf2"]
}, Open  ]],

Cell[TextData[{
 "The total angular momentum is then L =",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "N"], 
    RowBox[{
     SubscriptBox["x", "i"], "\[Cross]"}]}], TraditionalForm]],
  ExpressionUUID->"a23a154c-d55c-4782-9388-e2832a35b021"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["v",
     FontSlant->"Plain"], "i"], TraditionalForm]],ExpressionUUID->
  "d04aba2d-c4a6-466f-8526-a3aaa7cc823d"],
 ", where we assume m = 1. This can also be considered as an average rotation \
rate \:2126, and the angular momentum can then also be expressed as L =",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "N"], 
    SubscriptBox["r", "i"]}], TraditionalForm]],ExpressionUUID->
  "0307da3a-a61d-4d92-93e7-4d4af72bca79"],
 "\[Omega] =\[Omega]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "N"], 
    SubscriptBox["r", "i"]}], TraditionalForm]],ExpressionUUID->
  "344f0f48-ac4f-4cc5-92bd-7ce0496b93f5"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]],ExpressionUUID->
  "2bc250cc-4d90-4d49-ae8f-f7379f751b87"],
 " is the radial component of the particle ",
 StyleBox["i",
  FontSlant->"Italic"],
 " in cylindrical coordinates (that is, its distance from the origin). If S = \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "N"], 
    SubscriptBox["r", "i"]}], TraditionalForm]],ExpressionUUID->
  "b674da4a-9f6a-4f3a-af78-cc493394c4ea"],
 ", then the average rotation rate is given by \[Omega] = L/S, and therefore \
the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th particle\[CloseCurlyQuote]s share of the rotation is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["l", "i"], TraditionalForm]],ExpressionUUID->
  "681139f3-5e87-4e21-98ce-ce89974691de"],
 " = \[Omega] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]],ExpressionUUID->
  "1d8341f4-28bf-4695-9ec3-b2a2a3a15853"],
 StyleBox[".",
  FontSlant->"Italic"],
 "\n\nWe can calculate \[Omega], and then say that",
 StyleBox[" l = ax vy - ay vx",
  FontSlant->"Italic"],
 ". This is insufficient to calculate a velocity vector, but the velocity \
vector is orthogonal to the particle vector, so their dot product will be \
zero."
}], "Text",
 CellChangeTimes->{{3.9429526313012633`*^9, 3.942952742163919*^9}, {
   3.9429527757396107`*^9, 3.942952939297472*^9}, {3.942953819680935*^9, 
   3.942953896781039*^9}, 3.942953930344862*^9, {3.9429542587215*^9, 
   3.942954284193178*^9}},ExpressionUUID->"861843d7-bc5d-4d3a-bd02-\
f56966c42fdb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"l", "==", 
     RowBox[{
      RowBox[{"ax", " ", "vy"}], "-", 
      RowBox[{"ay", " ", "vx"}]}]}], "&&", 
    RowBox[{
     RowBox[{
      RowBox[{"ax", " ", "vx"}], "+", 
      RowBox[{"ay", " ", "vy"}]}], "==", "0"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"vx", ",", "vy"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.942953934077441*^9, 3.942953960327491*^9}, {
  3.942954020511532*^9, 3.942954069841302*^9}, {3.9429541313209743`*^9, 
  3.942954168226289*^9}, {3.9429541985047646`*^9, 3.9429541993853273`*^9}, {
  3.9429542991365366`*^9, 3.942954335081326*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"f8fa00d8-68bd-4ca0-bb35-d1593b27c462"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"vx", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"ay", " ", "l"}], 
       RowBox[{
        SuperscriptBox["ax", "2"], "+", 
        SuperscriptBox["ay", "2"]}]]}]}], ",", 
    RowBox[{"vy", "\[Rule]", 
     FractionBox[
      RowBox[{"ax", " ", "l"}], 
      RowBox[{
       SuperscriptBox["ax", "2"], "+", 
       SuperscriptBox["ay", "2"]}]]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.942954046560178*^9, 3.942954073879737*^9}, {
   3.9429541208260565`*^9, 3.9429541719660945`*^9}, {3.9429543205031443`*^9, 
   3.942954336367437*^9}, 3.9430945987598715`*^9, 3.943112744228598*^9, 
   3.9433425797618885`*^9, 3.9434261129981976`*^9, 3.9446592655146236`*^9, 
   3.9456856756545095`*^9, 3.945692204238881*^9},
 CellLabel->"Out[51]=",ExpressionUUID->"ed820016-869d-4c17-841e-c1177d862954"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Numerical Assessments", "Subsubsection",
 CellChangeTimes->{{3.942954360943286*^9, 
  3.9429543647035093`*^9}},ExpressionUUID->"e26152a8-7741-4471-81b1-\
ca29eb1f4869"],

Cell["The value of S is large:", "Text",
 CellChangeTimes->{{3.942954370894974*^9, 
  3.9429543814874763`*^9}},ExpressionUUID->"b4b3ab47-3e6a-4788-aefa-\
