Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"F5", "=", 
  FractionBox[
   RowBox[{
    SubscriptBox["\[Nu]", "2"], 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "n"}], " ", 
        SuperscriptBox[
         OverscriptBox["y", "_"], "2"]}], "-", 
       RowBox[{"n", " ", 
        SuperscriptBox["\[Alpha]", "2"]}], "-", 
       RowBox[{"2", " ", "\[Alpha]", " ", "\[Beta]", 
        RowBox[{"(", 
         RowBox[{"n", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "+", "1"}], ")"}], "/", "2"}]}], ")"}]}], "-", 
       RowBox[{
        SuperscriptBox["\[Beta]", "2"], 
        FractionBox["1", "6"], " ", "n", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "n"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "n"}]}], ")"}]}], "+", 
       RowBox[{"2", "\[Alpha]", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "1"}], "n"], 
         SubscriptBox["y", "i"]}]}], "+", 
       RowBox[{"2", "\[Beta]", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "1"}], "n"], 
         RowBox[{"i", " ", 
          SubscriptBox["y", "i"]}]}]}]}], ")"}], "]"}]}], 
   RowBox[{
    SubscriptBox["\[Nu]", "1"], " ", 
    RowBox[{"(", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "n"], 
      RowBox[{"Expand", "[", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "\[Alpha]"}], "-", 
          RowBox[{"i", " ", "\[Beta]"}], "+", 
          SubscriptBox["y", "i"]}], ")"}], "2"], "]"}]}], ")"}]}]]}]], "Input",
 CellChangeTimes->{{3.943546779713642*^9, 3.9435468808175235`*^9}, {
  3.943548375058728*^9, 3.943548386288432*^9}, {3.943549183007941*^9, 
