Cell[CellGroupData[{

Cell["Initialization", "Section",
 CellChangeTimes->{{3.9429547353590975`*^9, 
  3.9429547400625267`*^9}},ExpressionUUID->"21e6c9f2-69cb-465b-8fff-\
9e0f9bedbc88"],

Cell[TextData[{
 "For the following, see Reif, pg. 249, eq. 7.5.7. The mean kinetic energy of \
a a particle in any dimension is (1/2)",
 StyleBox["kT",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["k",
  FontSlant->"Italic"],
 " is in units of temperature per unit of energy, and ",
 StyleBox["T",
  FontSlant->"Italic"],
 " is the temperature in units defined by ",
 StyleBox["k",
  FontSlant->"Italic"],
 ". The energy of a particle of mass m = 1 is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["v",
      FontSlant->"Plain"], "2"], "/", "2"}], TraditionalForm]],
  ExpressionUUID->"f12a21eb-aaf0-4003-8888-947b9a655b44"],
 " which can be broken into x and y components (\[LeftAngleBracket]E\
\[RightAngleBracket] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     SubsuperscriptBox["v", "x", "2"]}], "+"}], TraditionalForm]],
  ExpressionUUID->"ad5d3023-8e39-4f5a-889b-dd5081ca6fb3"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubsuperscriptBox["v", "y", "2"]}], TraditionalForm]],ExpressionUUID->
  "f27cf8f5-6eb2-4d91-b229-1cc4514c8a7e"],
 "=",
 StyleBox["k T",
  FontSlant->"Italic"],
 " ), so that defining ",
 StyleBox["k",
  FontSlant->"Italic"],
 " = 1, each component has an expected velocity squared of ",
 StyleBox["T",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.94295475659188*^9, 3.942954832840407*^9}, {
   3.9429549048866634`*^9, 3.942955016399521*^9}, 3.9429550511669893`*^9, {
   3.9456873571129603`*^9, 3.9456873626653395`*^9}, 
   3.9519296630145273`*^9},ExpressionUUID->"efc1b200-f557-41d5-90d9-\
aa34350a12d1"],

