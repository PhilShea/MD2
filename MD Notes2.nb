     RowBox[{"p1", ",", "p3"}], "]"}], "/", "\[Alpha]79"}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "next", " ", "nearest", " ", "neighbor", " ", "distance", " ", "in", " ", 
    RowBox[{"1", "/", "\[Pi]"}], " ", "density", " ", "units"}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.9429183763369355`*^9, 3.942918436408779*^9}, {
  3.9429187946495147`*^9, 3.9429188105687103`*^9}, {3.94291905954556*^9, 
  3.9429190967755785`*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"e6b28383-aa52-4de8-8b6d-2c496b1a7b9c"],

Cell[BoxData[
 SqrtBox["3"]], "Output",
 CellChangeTimes->{3.9429183811512804`*^9, 3.9429184368429303`*^9, 
  3.9429190677493205`*^9, 3.9430945985230894`*^9, 3.943112744104931*^9, 
  3.9433425796056757`*^9, 3.943426112856516*^9, 3.944659265254511*^9, 
  3.945685675463277*^9, 3.9456922039955406`*^9},
 CellLabel->"Out[45]=",ExpressionUUID->"1249ae9c-9f4c-4339-95bc-db06b32662c4"]
}, Open  ]],

