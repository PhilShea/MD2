   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{"Red", ",", 
      RowBox[{"Circle", "[", 
       RowBox[{"p4", ",", "Rskin"}], "]"}]}], "}"}], "]"}], ",", 
   RowBox[{"Graphics", "[", " ", 
    RowBox[{"{", 
     RowBox[{"Magenta", ",", 
      RowBox[{"Circle", "[", 
