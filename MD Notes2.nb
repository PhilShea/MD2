Cell[TextData[{
 "We can find the nearest points in the following way. Note that when the \
points are left in symbolic form, the distance returned is the square for \
some unknown reason, so we apply ",
 StyleBox["N[]", "Input"],
 " to ",
 StyleBox["pnts256", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.942950694590345*^9, 3.9429507240357847`*^9}, {
  3.945686715033635*^9, 3.945686736711401*^9}, {3.9456878421206007`*^9, 
  3.9456879248211374`*^9}},ExpressionUUID->"e1ed152f-210d-400a-9844-\
1d6f07bc6a0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Nearest", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{
       "pnts256", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
       "]"}], ",", "1"}], "]"}], "\[Rule]", " ", "All"}], ",", 
   RowBox[{"N", "[", "p2", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "3.5"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.942950597580103*^9, 3.9429506794856634`*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"1752845f-3fbc-4c07-86cb-6c2cbcdf50ea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Element\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"10.951597278935507`", ",", "5.7730895816541565`"}], "}"}]}], 
     ",", 
     RowBox[{"\<\"Index\"\>", "\[Rule]", "190"}], ",", 
     RowBox[{"\<\"Distance\"\>", "\[Rule]", "0.`"}]}], 
    "\[RightAssociation]"}], ",", 
