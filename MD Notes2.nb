Cell["\<\
This function will fill a rectangle, and the two parameter version will make \
the standard rectangle.\
\>", "Text",
 CellChangeTimes->{{3.942745646806391*^9, 3.942745650269972*^9}, {
  3.9427456873819847`*^9, 3.942745698549962*^9}, {3.942745778910468*^9, 
  3.9427458145977263`*^9}},ExpressionUUID->"a3c02cc8-a8b7-43bb-afe7-\
d2024d156bf7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", " ", "fill", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fill", "::", "usage"}], "=", 
   "\"\<fill[ Bx, By, K] will place \
\!\(\*StyleBox[\"K\",FontSlant->\"Italic\"]\) particles in a hexagonal grid \
in a rectangle of \nsize 2\!\(\*StyleBox[\"Bx\",FontSlant->\"Italic\"]\) x \
2\!\(\*StyleBox[\"By\",FontSlant->\"Italic\"]\).  If N is not a perfect \
square such that all the rows have the same number of \nparticles, it may be \
adjusted to fit the dimensions. Returns a two element list {parms, pnts}; \n\
parms is a list {\[Rho], a, Nc, Nr, Bx, By} \nrepectivley the density, the \
particle spacing, the number of columns and rows, and the\ninput box \
parmaeters.  pnts is a nested list of {x, y} coordinates of the K particle \
positions\n(fill[]\[LeftDoubleBracket]1\[RightDoubleBracket] is {\[Rho], a, \
Nc, Nr, Bx, By}; fil[]\[LeftDoubleBracket]2\[RightDoubleBracket] is pnts = \
{{{x11,y11},[x12,y12}...{x1Nc,y1Nc}},\n\
{{x21,y21},...},...{{xNr1,yNr1},...,{xNrNc,yNrNc}}}.  Thus, point one's \
coordinates are best\naccessed via Flatten[ pnts,1]\[LeftDoubleBracket]1\
\[RightDoubleBracket]).\n\nfill[ Bx, K] (the two parameter version) will set \
By to the default of (\!\(\*SqrtBox[\(3\)]\)/2)Bx.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fill", "[", 
    RowBox[{"Bx_", ",", " ", "By_", ",", " ", "K_"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]", "=", 
        RowBox[{"K", "/", 
         RowBox[{"(", 
          RowBox[{"4", "Bx", " ", "By"}], ")"}]}]}], ",", "a", ",", "Nc", ",",
        "Nr", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"a", "=", 
       SqrtBox[
        RowBox[{"2", "/", 
         RowBox[{"(", 
          RowBox[{"\[Rho]", 
           SqrtBox["3"]}], ")"}]}]]}], ";", " ", 
      RowBox[{"c", "=", 
       RowBox[{
        SqrtBox["3"], "/", "2"}]}], ";", " ", 
      RowBox[{"Nc", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"2", " ", 
         RowBox[{"Bx", "/", "a"}]}], "]"}]}], ";", " ", 
      RowBox[{"Nr", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"K", "/", "Nc"}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\[Rho]", ",", " ", "a", ",", " ", "Nr", ",", " ", "Nc", ",", " ", 
          "Bx", ",", " ", "By"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"placeR", "[", 
           RowBox[{"Nc", ",", " ", "a", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "/", "4"}], ")"}], 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"2", 
                 RowBox[{"Mod", "[", 
                  RowBox[{"i", ",", "2"}], "]"}]}]}], ")"}]}], "-", "Bx"}], 
            ",", 
            RowBox[{
             RowBox[{"a", " ", "c", 
              RowBox[{"(", 
               RowBox[{"i", "+", 
                RowBox[{"1", "/", "2"}]}], ")"}]}], "-", "By"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"Nr", "-", "1"}]}], "}"}]}], "]"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fill", "[", 
   RowBox[{"Bx_", ",", " ", "K_"}], "]"}], ":=", " ", 
  RowBox[{"fill", "[", 
   RowBox[{"Bx", ",", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SqrtBox["3"], "/", "2"}], ")"}], "Bx"}], ",", "K"}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.9274517737321415`*^9, 3.927451971047587*^9}, {
   3.9274520365123625`*^9, 3.927452060785068*^9}, {3.9274520990161605`*^9, 
   3.9274522078405757`*^9}, {3.927452266328218*^9, 3.927452302872484*^9}, {
   3.9274523819448175`*^9, 3.927452511029167*^9}, {3.927454028632973*^9, 
   3.927454032153223*^9}, {3.927454319861769*^9, 3.9274543216512527`*^9}, {
   3.927454397149021*^9, 3.9274543982505703`*^9}, {3.927454439043581*^9, 
   3.9274544423124595`*^9}, {3.9274545522286873`*^9, 
   3.9274545592424603`*^9}, {3.927534100839722*^9, 3.9275341503507357`*^9}, {
   3.927534327544532*^9, 3.927534328294099*^9}, {3.927610278087444*^9, 
