       RowBox[{"-", "\[Alpha]"}], "-", 
       RowBox[{"i", " ", "\[Beta]"}], "+", 
       SubscriptBox["y", "i"]}], ")"}], "2"]}]}]]], "Output",
 CellChangeTimes->{
  3.943546420136614*^9, {3.943546519051136*^9, 3.9435465627212315`*^9}},
