Cell[CellGroupData[{

Cell["Distribution of Regressions of Uncorrelated Data", "Subsection",
 CellChangeTimes->{{3.942746711756838*^9, 
  3.9427467317944613`*^9}},ExpressionUUID->"712dbf40-4477-4fab-bd7c-\
23785cabdc88"],

Cell["\<\
The difficulty of deciding when the temperature profiles are truly \
uncorrelated requires we examine the distribution of the slope estimate.\
\>", "Text",
 CellChangeTimes->{{3.942746738716707*^9, 
  3.94274680396509*^9}},ExpressionUUID->"57c8da0c-8e97-4e07-afdb-\
44a5ca17ff85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Beta]e", " ", "=", " ", 
  FractionBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{
      SubscriptBox["x", "i"], 
      SubscriptBox["y", "i"]}]}], "-", 
    RowBox[{"n", " ", 
     OverscriptBox["x", "_"], " ", 
     OverscriptBox["y", "_"], " "}]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"n", "-", "1"}], ")"}], 
    SuperscriptBox["Sx", "2"]}]]}]], "Input",
 CellChangeTimes->{{3.94282123800653*^9, 3.9428215488823967`*^9}, {
  3.9430946391905394`*^9, 3.9430946407861323`*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"4a88f33c-7366-41e7-a57c-280ca2d50ab2"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", "n"}], " ", 
    OverscriptBox["x", "_"], " ", 
    OverscriptBox["y", "_"]}], "+", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "n"], 
    RowBox[{
     SubscriptBox["x", "i"], " ", 
     SubscriptBox["y", "i"]}]}]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
   SuperscriptBox["Sx", "2"]}]]], "Output",
 CellChangeTimes->{3.9428222878839808`*^9, 3.9430946033208838`*^9, 
  3.943094642843786*^9, 3.943112746609559*^9, 3.9433425954828634`*^9, 
  3.9433549832503433`*^9, 3.9434261167273855`*^9, 3.944659270594777*^9, 
  3.945685679671653*^9, 3.9456922069557714`*^9},
 CellLabel->"Out[95]=",ExpressionUUID->"037ce60a-8cf7-4266-88db-b39d13d23006"]
}, Open  ]],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["S", "x", "2"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "1c580a1a-5539-45a7-8207-20ec6eedcd09"],
 " is the variance of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "441fa32f-c06a-4778-b0ce-e401ca62fe01"],
 ".  In our case, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "550cc14d-e8a2-4b69-964e-ae5eef66db44"],
 " is simply the series 1:",
 StyleBox["n",
  FontSlant->"Italic"],
 "., so we can replace ",
 Cell[BoxData[
  OverscriptBox["x", "_"]],
  CellChangeTimes->{{3.94282123800653*^9, 3.9428215488823967`*^9}, {
   3.9430946391905394`*^9, 3.9430946407861323`*^9}},ExpressionUUID->
  "024736c3-fa77-43ba-8389-21c4b4e09b24"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["S", "x", "2"], TraditionalForm]],ExpressionUUID->
  "39c1c56e-910f-4b69-8351-838c4fa63e78"],
 " with exact values (and we use the actual variance, not the sample \
variance, of ",
 StyleBox["x",
  FontSlant->"Italic"],
 "; ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "needs to know that these numbers are the full population or it will return \
the sample variance):"
}], "Text",
 CellChangeTimes->{{3.943342627043442*^9, 3.943342724111041*^9}, {
  3.943342763198685*^9, 3.9433428216100397`*^9}, {3.943349371483864*^9, 
  3.9433493945874557`*^9}},ExpressionUUID->"78af779c-cdae-40ba-b337-\
ca3107d5cfa5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Variance", "[", 
  RowBox[{"DiscreteUniformDistribution", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "n"}], "}"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9433490399986815`*^9, 3.943349101476782*^9}, {
  3.943349283638974*^9, 3.9433493050534625`*^9}},
 CellLabel->"In[96]:=",ExpressionUUID->"3d661f35-a487-4f5a-960a-bc3c89c575ee"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "12"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    SuperscriptBox["n", "2"]}], ")"}]}]], "Output",
 CellChangeTimes->{3.9433491018852997`*^9, 3.94334930671714*^9, 
  3.9434261167701263`*^9, 3.94465927074123*^9, 3.945685679743373*^9, 
  3.9456922069777184`*^9},
 CellLabel->"Out[96]=",ExpressionUUID->"8af0c0df-4089-4d37-963f-e1441c397bad"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "n"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], "n"], "i"}]}], ",", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "n"], 
      SuperscriptBox["i", "2"]}], ",", 
     RowBox[{
      FractionBox["1", "n"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], "n"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"i", "-", 
          FractionBox[
           RowBox[{"n", "+", "1"}], "2"]}], ")"}], "2"]}]}]}], "}"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", " ", 
    RowBox[{"n", ">", "3"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.943348331869464*^9, 3.943348398741678*^9}, {
  3.9433484801831956`*^9, 3.943348528269395*^9}, {3.9433487938617606`*^9, 
  3.943348823750801*^9}, {3.9435491471948633`*^9, 3.943549157645511*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"cefcf213-4551-42c9-b5f1-f0d4d0cf5335"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"1", "+", "n"}], "2"], ",", 
   RowBox[{
    FractionBox["1", "6"], " ", "n", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "n"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"2", " ", "n"}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "12"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["n", "2"]}], ")"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9433483376521287`*^9, 3.943348399249817*^9, 
  3.943348542826657*^9, 3.9433488244858365`*^9, 3.943426116820727*^9, 
  3.943549159509202*^9, 3.9446592709406424`*^9, 3.9456856799703975`*^9, 
  3.94569220703753*^9},
 CellLabel->"Out[97]=",ExpressionUUID->"04298b7f-6192-452d-8f36-35e4c55c1673"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Beta]e2", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"\[Beta]e", "//.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["x", "i"], "\[Rule]", " ", "i"}], ",", 
       RowBox[{"Sx", "\[Rule]", 
        SqrtBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["n", "2"], "-", "1"}], ")"}], "/", "12"}]]}], ",", 
       RowBox[{
        OverscriptBox["x", "_"], "\[Rule]", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", "+", "1"}], ")"}], "/", "2"}]}], ",", " ", 
       RowBox[{
        OverscriptBox["y", "_"], "\[Rule]", " ", 
        RowBox[{
         FractionBox["1", "n"], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "1"}], "n"], 
          SubscriptBox["y", "i"]}]}]}]}], "}"}]}], ",", 
    RowBox[{"Assumptions", "\[Rule]", " ", 
     RowBox[{"n", ">", "3"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9428231587845564`*^9, 3.9428232763394337`*^9}, {
  3.9428233068361177`*^9, 3.942823327243251*^9}, {3.9428233800062866`*^9, 
  3.9428233858448877`*^9}, {3.9428306658124237`*^9, 3.9428307106322527`*^9}, {
  3.942830753465069*^9, 3.942830763162761*^9}, {3.9433488351894755`*^9, 
  3.94334887887894*^9}, {3.9433494406843586`*^9, 3.9433494407630033`*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"4df4f3ca-764d-436c-9d9c-05d695c56ea0"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", "6"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "n"}], ")"}], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     SubscriptBox["y", "i"]}]}], "+", 
   RowBox[{"12", " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{"i", " ", 
      SubscriptBox["y", "i"]}]}]}]}], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "n"}], ")"}]}]]], "Output",
 CellChangeTimes->{3.9433488809387355`*^9, 3.943349447028117*^9, 
  3.9433549879652863`*^9, 3.943426116919952*^9, 3.944659271042371*^9, 
  3.9456856801922445`*^9, 3.9456922071382613`*^9},
 CellLabel->"Out[98]=",ExpressionUUID->"170862cb-cc19-4b3c-a183-184294532bc5"]
}, Open  ]],

Cell["We can combine the two sums in the numerator:", "Text",
 CellChangeTimes->{{3.9428311055138817`*^9, 3.942831120478923*^9}, 
   3.9428312584305096`*^9, {3.9433429113914075`*^9, 
   3.94334291406263*^9}},ExpressionUUID->"7b491b81-af46-42a5-865c-\
d758cc41dc5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Beta]e3", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"12", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], "n"], 
       RowBox[{
        SubscriptBox["y", "i"], 
        RowBox[{"(", 
         RowBox[{"i", "-", 
          FractionBox[
           RowBox[{"n", "+", "1"}], "2"]}], ")"}]}]}]}], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "n"}], ")"}]}]], ",", 
    RowBox[{"Assumptions", "\[Rule]", " ", 
     RowBox[{"n", ">", "3"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.942831265004998*^9, 3.9428313439728994`*^9}, 
