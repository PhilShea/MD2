Cell[TextData[{
 "We might be able to correlate 16K particles in a reasonable amount of time \
(134M correlations), but the million particle system requires over a half ",
 StyleBox["trillion",
  FontSlant->"Italic"],
 " comparisons, each of which requiring two squaring operations. There are a \
few references of faster ways (see ",
 ButtonBox["Kim2025",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://journals.plos.org/plosone/article?id=10.1371/journal.pone.\
0311163"], None},
  ButtonNote->
   "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.\
0311163"],
 ", ",
 ButtonBox["Awhile2012",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.sciencedirect.com/science/article/abs/pii/\
S0010465512000057"], None},
  ButtonNote->
   "https://www.sciencedirect.com/science/article/abs/pii/S0010465512000057"],
 ", or ",
 ButtonBox["Gro\[SZ]2019",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://diglib.eg.org/server/api/core/bitstreams/79528ffd-9609-4232-\
bb81-57819e7ae747/content"], None},
  ButtonNote->
   "https://diglib.eg.org/server/api/core/bitstreams/79528ffd-9609-4232-bb81-\
57819e7ae747/content"],
 ") that include divide and conquer, spatial hashing, and various tree based \
algorithms. ",
 ButtonBox["Gro\[SZ]2019",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://diglib.eg.org/server/api/core/bitstreams/79528ffd-9609-4232-\
bb81-57819e7ae747/content"], None},
  ButtonNote->
   "https://diglib.eg.org/server/api/core/bitstreams/79528ffd-9609-4232-bb81-\
57819e7ae747/content"],
 " appears closest to the amount of effort I\[CloseCurlyQuote]m willing to \
expend in this regard. The idea is to sort the particles by both x and y \
coordinates, and find those within the square grid defined by the particles \
position {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "31b71616-b380-413b-95c4-4f8d1ed41b52"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "b8cbf871-dd70-4acd-8fa6-51b5f654eafc"],
 "}\[PlusMinus]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "shell"], TraditionalForm]],ExpressionUUID->
  "cce6e893-fe4a-4eb7-837e-83cc19cf297e"],
 ".  This is bigger than the circle currently used, as its size is 4",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["R", "shell"], "2"], TraditionalForm]],ExpressionUUID->
  "9ac7a4cc-479b-4dd5-a4b3-c369050f3730"],
 " vs. \[Pi]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["R", "shell"], "2"], TraditionalForm]],ExpressionUUID->
  "27c1de72-a355-420a-a4b5-6656658c5203"],
 ". At our density of 1/\[Pi], that is "
}], "Text",
 CellChangeTimes->{{3.9646885425938272`*^9, 3.964688685652487*^9}, {
  3.964769291584115*^9, 3.9647693304326487`*^9}, {3.964769361872889*^9, 
  3.964769406399987*^9}, {3.964769461537891*^9, 3.9647694778739634`*^9}, {
  3.9647701566886*^9, 3.9647701630882*^9}, {3.9647703631381063`*^9, 
  3.964770375418066*^9}, {3.9647704153054867`*^9, 3.964770459314995*^9}, {
  3.964770669556881*^9, 3.9647708091263533`*^9}, {3.964771494895393*^9, 
  3.964771808440263*^9}, {3.964772000853086*^9, 
  3.964772010797872*^9}},ExpressionUUID->"b9a227cc-2fc7-4378-80a1-\
ee2244aed23b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"4", 
      SuperscriptBox["Rshell", "2"]}], " ", "-", " ", 
     RowBox[{"\[Pi]", " ", 
      SuperscriptBox["Rshell", "2"]}]}], ")"}], "/", "\[Pi]"}], 
  "]"}]], "Input",
