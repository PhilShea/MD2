 RowBox[{"{", 
  RowBox[{"32", ",", "1", ",", 
   FractionBox["1", "32"], ",", "0.03989807087757093`", ",", 
   FractionBox["1", "243"], ",", "0.0019042406033458856`", ",", 
   FractionBox["32", "16807"], ",", 
   FractionBox["1", "1024"], ",", 
   FractionBox["1", 
    RowBox[{"9", " ", 
     SqrtBox["3"]}]], ",", 
