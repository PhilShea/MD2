Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "plotPnts", "]"}], ";"}], "\n", " ", 
   RowBox[{
    RowBox[{"plotPnts", "[", "pnts_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Bx", "=", 
         RowBox[{"pnts", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "5"}], "\[RightDoubleBracket]"}]}], ",", " ", 
        RowBox[{"By", "=", 
         RowBox[{"pnts", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "6"}], "\[RightDoubleBracket]"}]}], ",", " ", 
        "box"}], "}"}], ",", 
      RowBox[{
       RowBox[{"box", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "Bx"}], ",", " ", "Bx"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "By"}], ",", " ", "By"}], "}"}]}], "}"}]}], ";", 
       "\n", " ", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
           "pnts", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
           ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", " ", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"1.1", "box"}]}], ",", " ", 
         RowBox[{"GridLines", "\[Rule]", "box"}]}], "]"}]}]}], 
     "]"}]}]}]}]], "Code",
