     RowBox[{"(", 
      RowBox[{"Expand", "[", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["y", "i"], "-", 
            OverscriptBox["y", "_"]}], ")"}], "2"], "-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["y", "i"], "-", 
            SubscriptBox[
             OverscriptBox["y", "^"], "i"]}], ")"}], "2"]}], "]"}], "]"}], 
      ")"}]}]}], 
   RowBox[{
