    RowBox[{"{", 
     RowBox[{"Green", ",", " ", "Dashed", ",", 
      RowBox[{"Circle", "[", 
       RowBox[{"p1", ",", " ", "Rshell"}], "]"}]}], "}"}], "]"}], ",", 
   RowBox[{"Graphics", "[", " ", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", " ", 
      RowBox[{"Circle", "[", 
       RowBox[{"p3", ",", "0.5"}], "]"}]}], "}"}], "]"}], ",", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{"Pink", ",", " ", 
      RowBox[{"Circle", "[", " ", 
       RowBox[{"p1", ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
