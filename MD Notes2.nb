Cell[CellGroupData[{

Cell["Application of the Virial Theorem", "Section",
 CellChangeTimes->{{3.942956045445721*^9, 
  3.9429560554528255`*^9}},ExpressionUUID->"089726ec-314a-4085-ad0a-\
5563f646c3a8"],

Cell[TextData[{
 "The Virial Theorem for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"-", "n"}]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "8bc1ffd7-b0ea-4cb2-a8ee-b404d4f19325"],
 " potentials states that the total kinetic energy is related to the total \
potential energy as 2\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "T"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "1906f6f3-cd02-4c54-b5b3-3624ee677fb7"],
 "\[RightAngleBracket]=-n\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "T"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "34eb3434-6ae2-404e-988e-04ba3037cdf7"],
 "\[RightAngleBracket], where the angle brackets denote averages. Combine \
this with the pressure equation P = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"Subscript", "[", 
      RowBox[{"K", ",", " ", "T"}], "]"}], "\[RightAngleBracket]"}], "("}], 
   TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "e05b93d4-f183-4732-aa21-2a9a6072d137"],
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", 
    FractionBox[
     RowBox[{"n", 
      RowBox[{"\[LeftAngleBracket]", 
       FormBox[
        SubscriptBox["U", "T"],
        TraditionalForm], "\[RightAngleBracket]"}]}], 
     RowBox[{"2", 
      RowBox[{"\[LeftAngleBracket]", 
       FormBox[
        SubscriptBox["K", "T"],
        TraditionalForm], "\[RightAngleBracket]"}]}]]}], TraditionalForm]],
  ExpressionUUID->"36a027ff-44de-4d41-8922-9bd90ef82855"],
 "), where \[Rho] is the density, the pressure becomes simply 2\[Rho]\
\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "T"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "db1cdcbb-749d-4e11-b841-ec26bc39842f"],
 "\[RightAngleBracket]"
}], "Text",
 CellChangeTimes->{{3.942956069209253*^9, 
  3.942956308809636*^9}},ExpressionUUID->"adb313e2-6bcd-4c25-aeac-\
b0c954956daf"],

