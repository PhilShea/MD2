 RowBox[{
  RowBox[{"n0", "=", "256"}], ";", 
  RowBox[{"T0", "=", "0.015"}], ";", 
  RowBox[{"ns", "[", 
   RowBox[{"n0", ",", "T0"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9429555121884165`*^9, 3.9429555500460787`*^9}, {
