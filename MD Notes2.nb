Cell[TextData[{
 "First successful test for 65,536 particles was 0.009s, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "18"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "2dbffca6-8603-46fd-b38f-7b3e8b073612"],
