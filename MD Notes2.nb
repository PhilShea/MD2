  RowBox[{"(*", " ", 
   RowBox[{"Focal", " ", "point"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p2", "=", 
    RowBox[{
    "pnts256arr", "\[LeftDoubleBracket]", "190", "\[RightDoubleBracket]"}]}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Next", " ", "point", " ", "on", " ", "row"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p3", "=", 
    RowBox[{
    "pnts256arr", "\[LeftDoubleBracket]", "207", "\[RightDoubleBracket]"}]}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"next", " ", "nearest", " ", "neighbor"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p4", "=", 
    RowBox[{"pnts256arr", "\[LeftDoubleBracket]", 
     RowBox[{"189", "-", "4"}], "\[RightDoubleBracket]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"secondary", " ", "shell", " ", "center"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rskin", " ", "=", " ", "3.5"}], ";", " ", 
  RowBox[{"Rshell", " ", "=", " ", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"p256", ",", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
