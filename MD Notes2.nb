Cell[BoxData[
 RowBox[{"F2", "=", 
  FractionBox[
   RowBox[{
    SubscriptBox["\[Nu]", "2"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{"(", 
      RowBox[{"Expand", "[", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["y", "i"], "-", 
            OverscriptBox["y", "_"]}], ")"}], "2"], "-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["y", "i"], "-", 
            SubscriptBox[
             OverscriptBox["y", "^"], "i"]}], ")"}], "2"]}], "]"}], "]"}], 
      ")"}]}]}], 
   RowBox[{
    SubscriptBox["\[Nu]", "1"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
