Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["T1", 
        RowBox[{"2", "/", "n"}]], " ", "\[Rho]1"}], "\[Equal]", 
      RowBox[{
       SuperscriptBox["T2", 
        RowBox[{"2", "/", "n"}]], " ", "\[Rho]2"}]}], ",", 
     RowBox[{
      FractionBox["P1", 
       RowBox[{"T1", " ", "\[Rho]1"}]], "\[Equal]", 
      FractionBox["P2", 
       RowBox[{"T2", " ", "\[Rho]2"}]]}], ",", 
     RowBox[{"n", "\[GreaterEqual]", "1"}]}], "}"}], ",", 
