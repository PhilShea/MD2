Cell[TextData[{
 "This creates an 11\[Cross]9 array which extends well beyond the field.  We \
clearly need to make the size of the box conform to the shape of the field so \
that it can be easily and evenly divided.  The way to do that is to make the \
divisions such that either edge of the box is no smaller than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "shell"], TraditionalForm]],ExpressionUUID->
  "8578c3ab-5c3d-4a28-b0a8-b52b424c57cd"],
 ".  The box size can be set as follows: In  case like this, we might want to \
make ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "shell"], TraditionalForm]],ExpressionUUID->
  "a77d127c-a864-4035-984e-dacceedaaabc"],
 " such that it 2",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "shell"], TraditionalForm]],ExpressionUUID->
  "387f77cc-4fa9-40fa-8196-30e3dd0c508b"],
 "/3 divides 2Bx. In this case, 2Bx should be 9\[Cross]2",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "shell"], TraditionalForm]],ExpressionUUID->
  "73752d04-8e76-43da-bee4-f18a36507736"],
 "/3."
}], "Text",
 CellChangeTimes->{{3.965816060397149*^9, 3.965816108813344*^9}, {
  3.9658161407337723`*^9, 3.965816177421762*^9}, {3.965816497217847*^9, 
  3.965816545621419*^9}, {3.96581657614364*^9, 3.965816590899238*^9}, {
  3.96581991107666*^9, 3.965819930156389*^9}, {3.965901141258395*^9, 
  3.96590120632498*^9}, {3.965901246758656*^9, 3.965901358834228*^9}, {
  3.965901390331582*^9, 3.965901456973234*^9}, {3.965903110248131*^9, 
  3.9659031373434677`*^9}, {3.965987197742193*^9, 3.965987433984644*^9}, {
  3.96598748441776*^9, 
  3.9659874854173727`*^9}},ExpressionUUID->"3c0d3025-ca7a-44dd-8905-\
b99711ce0b63"],

