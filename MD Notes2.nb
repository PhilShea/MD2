Cell[BoxData[
 RowBox[{"1", "/", "%"}]], "Input",
 CellChangeTimes->{{3.9429545081838017`*^9, 3.9429545103676715`*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"1787bc12-b798-4aa5-8ca4-2d7a950f92dd"],

Cell[BoxData["301.89702812416203`"], "Output",
 CellChangeTimes->{3.9429545114832783`*^9, 3.9430945989888067`*^9, 
  3.9431127443034286`*^9, 3.9433425813084*^9, 3.9434261132267094`*^9, 
  3.9446592657450075`*^9, 3.9456856758424606`*^9, 3.945692204330665*^9},
 CellLabel->"Out[55]=",ExpressionUUID->"cbccc9e5-480f-4a7a-bcdd-f03f4920d9e3"]
}, Open  ]],

Cell["\<\
So, with that high value of L, it would take a time of almost 302, or 30,000 \
time steps to make a full rotation. However, only a small rotation would be a \
problem with the crystal interfaces at the boundaries.

The maximum range is a bit over 19:\
\>", "Text",
 CellChangeTimes->{{3.94295454508173*^9, 
  3.9429545756388874`*^9}},ExpressionUUID->"fa215e17-651c-4767-b877-\
966912819d69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Map", "[", 
   RowBox[{"Norm", ",", 
    RowBox[{"N", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
       "pnts256", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",",
        "1"}], "]"}], "]"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.942954588414214*^9, 3.942954633847855*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"ccc47457-1594-47af-bc91-545f2856c3e1"],

Cell[BoxData["19.25933461950068`"], "Output",
 CellChangeTimes->{3.9429546346673875`*^9, 3.943094599008752*^9, 
  3.943112744320381*^9, 3.9433425813240423`*^9, 3.943426113252228*^9, 
  3.944659265776946*^9, 3.9456856758600626`*^9, 3.9456922043535767`*^9},
 CellLabel->"Out[56]=",ExpressionUUID->"42e575e3-25a3-44f9-a029-8aad359b24f1"]
}, Open  ]],

Cell["\<\
This means that even the farthest particles will only get less than 1% of the \
total angular momentum, but this is still more than twice what they would get \
if the momentum was evenly divided among the 256 particles.\
\>", "Text",
 CellChangeTimes->{{3.9429546440261393`*^9, 
  3.9429546501904106`*^9}},ExpressionUUID->"1edc9fcc-4e5e-4cc7-807c-\
9c10d77468d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"S", "/", "%"}]], "Input",
 CellChangeTimes->{{3.942954661047196*^9, 3.942954662111546*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"671ab381-9720-4d63-8346-907f2c62c4ec"],

Cell[BoxData["144.6990514594229`"], "Output",
 CellChangeTimes->{3.942954662531505*^9, 3.9430945990311394`*^9, 
  3.9431127443383055`*^9, 3.9433425813552637`*^9, 3.9434261132746115`*^9, 
  3.9446592658098364`*^9, 3.9456856758770156`*^9, 3.94569220437953*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"e2bf844d-f52e-42b9-9dfa-b8b610288115"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Initialization", "Section",
 CellChangeTimes->{{3.9429547353590975`*^9, 
  3.9429547400625267`*^9}},ExpressionUUID->"21e6c9f2-69cb-465b-8fff-\
9e0f9bedbc88"],

Cell[TextData[{
 "For the following, see Reif, pg. 249, eq. 7.5.7. The mean kinetic energy of \
a a particle in any dimension is (1/2)",
 StyleBox["kT",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["k",
  FontSlant->"Italic"],
 " is in units of temperature per unit of energy, and ",
 StyleBox["T",
  FontSlant->"Italic"],
 " is the temperature in units defined by ",
 StyleBox["k",
  FontSlant->"Italic"],
 ". The energy of a particle of mass m = 1 is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["v",
      FontSlant->"Plain"], "2"], "/", "2"}], TraditionalForm]],
  ExpressionUUID->"f12a21eb-aaf0-4003-8888-947b9a655b44"],
 " which can be broken into x and y components (\[LeftAngleBracket]E\
\[RightAngleBracket] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
