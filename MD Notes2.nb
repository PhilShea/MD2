    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"1", "/", 
       SqrtBox["2"]}]}], ")"}], "r"}], "+", 
   RowBox[{"2", "r", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"1", "/", 
       SqrtBox["2"]}]}], ")"}], 
    SqrtBox["2"], "r"}]}], "]"}]], "Input",
