    SuperscriptBox["T", "2"]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.942955174245143*^9, 3.9429551855088177`*^9}},
 CellLabel->
  "Out[217]=",ExpressionUUID->"edbfa2a7-fc59-4e76-8501-8ae307f103c7"]
}, Open  ]],

