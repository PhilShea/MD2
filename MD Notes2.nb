 RowBox[{"pe", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"6", 
      RowBox[{"rn", "[", 
       RowBox[{"a79", ",", "5"}], "]"}]}], "+", 
     RowBox[{"6", 
      RowBox[{"rn", "[", 
       RowBox[{
        RowBox[{"nnnd", " ", "a79"}], ",", "5"}], "]"}]}]}], ")"}], "/", 
   "2"}]}]], "Input",
